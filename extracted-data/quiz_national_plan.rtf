    <div class="qb"><div class="q">17. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2 \u3605 \u3633 \u3657 \u3591 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3604 \u3633 \u3594 \u3609 \u3637 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3585 \u3634 \u3619 \u3648 \u3604 \u3636 \u3609 \u3607 \u3634 \u3591 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623  (TTDI) \u3586 \u3629 \u3591 \u3652 \u3607 \u3618 \u3652 \u3623 \u3657 \u3652 \u3617 \u3656 \u3648 \u3585 \u3636 \u3609 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
