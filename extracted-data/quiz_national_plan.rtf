    <div class="qb"><div class="q">18. "\uc0\u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3600 \u3634 \u3609 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3652 \u3615 \u3615 \u3657 \u3634 \u3607 \u3637 \u3656 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3650 \u3621 \u3585 " \u3588 \u3639 \u3629 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
