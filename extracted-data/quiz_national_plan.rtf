    <h1>\uc0\u3649 \u3609 \u3623 \u3586 \u3657 \u3629 \u3626 \u3629 \u3610 : \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636  20 \u3611 \u3637  (\u3614 .\u3624 . 2561 \'96 2580) (100 \u3586 \u3657 \u3629 )</h1>\
\
    <div class="qb"><div class="q">1. \uc0\u3623 \u3636 \u3626 \u3633 \u3618 \u3607 \u3633 \u3624 \u3609 \u3660 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618  \u3605 \u3634 \u3617 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3588 \u3639 \u3629 \u3586 \u3657 \u3629 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . "\u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591  \u3617 \u3633 \u3656 \u3591 \u3588 \u3633 \u3656 \u3591  \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609  \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3657 \u3623  \u3604 \u3657 \u3623 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3605 \u3634 \u3617 \u3627 \u3621 \u3633 \u3585 \u3611 \u3619 \u3633 \u3594 \u3597 \u3634 \u3586 \u3629 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3629 \u3648 \u3614 \u3637 \u3618 \u3591 "<br>\u3586 . "\u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3586 \u3629 \u3591 \u3629 \u3634 \u3648 \u3595 \u3637 \u3618 \u3609  \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3650 \u3621 \u3585 "<br>\u3588 . "\u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3591 \u3610 \u3626 \u3640 \u3586  \u3626 \u3633 \u3591 \u3588 \u3617 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617  \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3594 \u3637 \u3623 \u3636 \u3605 \u3607 \u3637 \u3656 \u3604 \u3637 "<br>\u3591 . "\u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3585 \u3657 \u3634 \u3623 \u3652 \u3585 \u3621  \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618  \u3651 \u3626 \u3656 \u3651 \u3592 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 "</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . "\u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591  \u3617 \u3633 \u3656 \u3591 \u3588 \u3633 \u3656 \u3591  \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609  \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3657 \u3623  \u3604 \u3657 \u3623 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3605 \u3634 \u3617 \u3627 \u3621 \u3633 \u3585 \u3611 \u3619 \u3633 \u3594 \u3597 \u3634 \u3586 \u3629 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3629 \u3648 \u3614 \u3637 \u3618 \u3591 "</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3623 \u3636 \u3626 \u3633 \u3618 \u3607 \u3633 \u3624 \u3609 \u3660 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3607 \u3637 \u3656 \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3651 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3588 \u3639 \u3629  \'93\u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591  \u3617 \u3633 \u3656 \u3591 \u3588 \u3633 \u3656 \u3591  \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609  \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3657 \u3623  \u3604 \u3657 \u3623 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3605 \u3634 \u3617 \u3627 \u3621 \u3633 \u3585 \u3611 \u3619 \u3633 \u3594 \u3597 \u3634 \u3586 \u3629 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3629 \u3648 \u3614 \u3637 \u3618 \u3591 \'94 \u3595 \u3638 \u3656 \u3591 \u3648 \u3611 \u3655 \u3609 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3627 \u3621 \u3633 \u3585 \u3651 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div></div>\
\
    <div class="qb"><div class="q">2. \uc0\u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3593 \u3610 \u3633 \u3610 \u3609 \u3637 \u3657 \u3617 \u3637 \u3585 \u3619 \u3629 \u3610 \u3619 \u3632 \u3618 \u3632 \u3648 \u3623 \u3621 \u3634 \u3585 \u3637 \u3656 \u3611 \u3637 </div>\
    <div class="c">\uc0\u3585 . 10 \u3611 \u3637 <br>\u3586 . 15 \u3611 \u3637 <br>\u3588 . 20 \u3611 \u3637 <br>\u3591 . 25 \u3611 \u3637 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . 20 \u3611 \u3637 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636  (\u3614 .\u3624 . 2561 - 2580) \u3617 \u3637 \u3585 \u3619 \u3629 \u3610 \u3619 \u3632 \u3618 \u3632 \u3648 \u3623 \u3621 \u3634  20 \u3611 \u3637 </div></div>\
\
    <div class="qb"><div class="q">3. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3588 \u3623 \u3634 \u3617 \u3627 \u3617 \u3634 \u3618 \u3586 \u3629 \u3591  \'93\u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \'94 \u3605 \u3634 \u3617 \u3623 \u3636 \u3626 \u3633 \u3618 \u3607 \u3633 \u3624 \u3609 \u3660 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3586 \u3618 \u3634 \u3618 \u3605 \u3633 \u3623 \u3607 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3629 \u3618 \u3656 \u3634 \u3591 \u3605 \u3656 \u3629 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591 \u3649 \u3621 \u3632 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 <br>\u3586 . \u3585 \u3634 \u3619 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 \u3592 \u3634 \u3585 \u3616 \u3633 \u3618 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3607 \u3633 \u3657 \u3591 \u3616 \u3634 \u3618 \u3651 \u3609 \u3649 \u3621 \u3632 \u3616 \u3634 \u3618 \u3609 \u3629 \u3585 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3588 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3592 \u3619 \u3636 \u3597 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3607 \u3635 \u3621 \u3634 \u3618 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 <br>\u3591 . \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 \u3612 \u3621 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3607 \u3656 \u3634 \u3648 \u3607 \u3637 \u3618 \u3617 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 \u3592 \u3634 \u3585 \u3616 \u3633 \u3618 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3607 \u3633 \u3657 \u3591 \u3616 \u3634 \u3618 \u3651 \u3609 \u3649 \u3621 \u3632 \u3616 \u3634 \u3618 \u3609 \u3629 \u3585 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591  \u3627 \u3617 \u3634 \u3618 \u3606 \u3638 \u3591  \u3585 \u3634 \u3619 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 \u3592 \u3634 \u3585 \u3616 \u3633 \u3618 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3607 \u3633 \u3657 \u3591 \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3649 \u3621 \u3632 \u3616 \u3634 \u3618 \u3609 \u3629 \u3585 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3651 \u3609 \u3607 \u3640 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610  \u3649 \u3621 \u3632 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3651 \u3609 \u3607 \u3640 \u3585 \u3617 \u3636 \u3605 \u3636 </div></div>\
\
    <div class="qb"><div class="q">4. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3588 \u3623 \u3634 \u3617 \u3627 \u3617 \u3634 \u3618 \u3586 \u3629 \u3591  \'93\u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3591 \u3588 \u3633 \u3656 \u3591 \'94 \u3605 \u3634 \u3617 \u3623 \u3636 \u3626 \u3633 \u3618 \u3607 \u3633 \u3624 \u3609 \u3660 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3591 \u3610 \u3648 \u3619 \u3637 \u3618 \u3610 \u3619 \u3657 \u3629 \u3618 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3633 \u3588 \u3588 \u3637 <br>\u3586 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3650 \u3604 \u3618 \u3651 \u3594 \u3657 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3629 \u3618 \u3656 \u3634 \u3591 \u3614 \u3629 \u3604 \u3637 <br>\u3588 . \u3585 \u3634 \u3619 \u3586 \u3618 \u3634 \u3618 \u3605 \u3633 \u3623 \u3607 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3629 \u3618 \u3656 \u3634 \u3591 \u3605 \u3656 \u3629 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591 \u3592 \u3609 \u3648 \u3586 \u3657 \u3634 \u3626 \u3641 \u3656 \u3585 \u3621 \u3640 \u3656 \u3617 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3626 \u3641 \u3591 <br>\u3591 . \u3585 \u3634 \u3619 \u3617 \u3637 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3648 \u3617 \u3639 \u3629 \u3591 \u3607 \u3637 \u3656 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3649 \u3621 \u3632 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3585 \u3634 \u3619 \u3586 \u3618 \u3634 \u3618 \u3605 \u3633 \u3623 \u3607 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3629 \u3618 \u3656 \u3634 \u3591 \u3605 \u3656 \u3629 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591 \u3592 \u3609 \u3648 \u3586 \u3657 \u3634 \u3626 \u3641 \u3656 \u3585 \u3621 \u3640 \u3656 \u3617 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3626 \u3641 \u3591 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3591 \u3588 \u3633 \u3656 \u3591  \u3627 \u3617 \u3634 \u3618 \u3606 \u3638 \u3591  \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3617 \u3637 \u3585 \u3634 \u3619 \u3586 \u3618 \u3634 \u3618 \u3605 \u3633 \u3623 \u3586 \u3629 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3629 \u3618 \u3656 \u3634 \u3591 \u3605 \u3656 \u3629 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591 \u3649 \u3621 \u3632 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3592 \u3609 \u3648 \u3586 \u3657 \u3634 \u3626 \u3641 \u3656 \u3585 \u3621 \u3640 \u3656 \u3617 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3626 \u3641 \u3591 </div></div>\
\
    <div class="qb"><div class="q">5. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3588 \u3623 \u3634 \u3617 \u3627 \u3617 \u3634 \u3618 \u3586 \u3629 \u3591  \'93\u3588 \u3623 \u3634 \u3617 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \'94 \u3605 \u3634 \u3617 \u3623 \u3636 \u3626 \u3633 \u3618 \u3607 \u3633 \u3624 \u3609 \u3660 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3651 \u3609 \u3594 \u3637 \u3623 \u3636 \u3605  \u3617 \u3637 \u3591 \u3634 \u3609 \u3649 \u3621 \u3632 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3607 \u3637 \u3656 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 <br>\u3586 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3592 \u3619 \u3636 \u3597 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3651 \u3594 \u3657 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636 \u3592 \u3609 \u3648 \u3585 \u3636 \u3609 \u3614 \u3629 \u3604 \u3637 <br>\u3588 . \u3585 \u3634 \u3619 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3585 \u3633 \u3610 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3605 \u3656 \u3634 \u3591 \u3654  \u3651 \u3609 \u3605 \u3621 \u3634 \u3604 \u3650 \u3621 \u3585 <br>\u3591 . \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3651 \u3609 \u3648 \u3629 \u3585 \u3619 \u3634 \u3594 \u3649 \u3621 \u3632 \u3629 \u3608 \u3636 \u3611 \u3652 \u3605 \u3618 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3592 \u3619 \u3636 \u3597 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3651 \u3594 \u3657 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636 \u3592 \u3609 \u3648 \u3585 \u3636 \u3609 \u3614 \u3629 \u3604 \u3637 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3588 \u3623 \u3634 \u3617 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609  \u3627 \u3617 \u3634 \u3618 \u3606 \u3638 \u3591  \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3592 \u3619 \u3636 \u3597 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3651 \u3594 \u3657 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636 \u3592 \u3609 \u3648 \u3585 \u3636 \u3609 \u3614 \u3629 \u3604 \u3637 \u3649 \u3621 \u3632 \u3652 \u3617 \u3656 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3621 \u3616 \u3634 \u3623 \u3632 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 </div></div>\
\
    <div class="qb"><div class="q">6. \uc0\u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3604 \u3657 \u3623 \u3618 \u3585 \u3637 \u3656 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 </div>\
    <div class="c">\uc0\u3585 . 4 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 <br>\u3586 . 5 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 <br>\u3588 . 6 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 <br>\u3591 . 7 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . 6 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3604 \u3657 \u3623 \u3618  6 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3627 \u3621 \u3633 \u3585  \u3652 \u3604 \u3657 \u3649 \u3585 \u3656  \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 , \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 , \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 , \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3650 \u3629 \u3585 \u3634 \u3626 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 , \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3610 \u3609 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3594 \u3637 \u3623 \u3636 \u3605 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 , \u3649 \u3621 \u3632 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3626 \u3617 \u3604 \u3640 \u3621 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 </div></div>\
\
    <div class="qb"><div class="q">7. \uc0\u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3605 \u3634 \u3617 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3588 \u3639 \u3629 \u3586 \u3657 \u3629 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3594 \u3634 \u3605 \u3636 \u3614 \u3633 \u3602 \u3609 \u3634  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3585 \u3657 \u3634 \u3623 \u3652 \u3585 \u3621  \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3640 \u3586 <br>\u3586 . \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3594 \u3634 \u3605 \u3636 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591  \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3640 \u3586  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3618 \u3656 \u3634 \u3591 \u3605 \u3656 \u3629 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591  \u3626 \u3633 \u3591 \u3588 \u3617 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617  \u3600 \u3634 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 <br>\u3588 . \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3594 \u3634 \u3605 \u3636 \u3617 \u3633 \u3656 \u3591 \u3588 \u3633 \u3656 \u3591  \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3629 \u3618 \u3641 \u3656 \u3604 \u3637 \u3585 \u3636 \u3609 \u3604 \u3637  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3648 \u3586 \u3657 \u3617 \u3649 \u3586 \u3655 \u3591  \u3626 \u3633 \u3591 \u3588 \u3617 \u3648 \u3607 \u3656 \u3634 \u3648 \u3607 \u3637 \u3618 \u3617 <br>\u3591 . \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3594 \u3634 \u3605 \u3636 \u3626 \u3591 \u3610 \u3626 \u3640 \u3586  \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3629 \u3648 \u3614 \u3637 \u3618 \u3591  \u3626 \u3633 \u3591 \u3588 \u3617 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3594 \u3634 \u3605 \u3636 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591  \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3640 \u3586  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3618 \u3656 \u3634 \u3591 \u3605 \u3656 \u3629 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591  \u3626 \u3633 \u3591 \u3588 \u3617 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617  \u3600 \u3634 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3627 \u3621 \u3633 \u3585 \u3588 \u3639 \u3629  \'93\u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3594 \u3634 \u3605 \u3636 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591  \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3640 \u3586  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3618 \u3656 \u3634 \u3591 \u3605 \u3656 \u3629 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591  \u3626 \u3633 \u3591 \u3588 \u3617 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617  \u3600 \u3634 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \'94</div></div>\
\
    <div class="qb"><div class="q">8. \uc0\u3586 \u3657 \u3629 \u3651 \u3604  \u3652 \u3617 \u3656 \u3651 \u3594 \u3656  \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3605 \u3634 \u3617 \u3607 \u3656 \u3637 \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 </div>\
    <div class="c">\uc0\u3585 . \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 <br>\u3586 . \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 <br>\u3588 . \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 <br>\u3591 . \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3626 \u3617 \u3604 \u3640 \u3621 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3652 \u3617 \u3656 \u3652 \u3604 \u3657 \u3606 \u3641 \u3585 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3611 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3627 \u3621 \u3633 \u3585  \u3649 \u3605 \u3656 \u3648 \u3611 \u3655 \u3609 \u3626 \u3656 \u3623 \u3609 \u3627 \u3609 \u3638 \u3656 \u3591 \u3607 \u3637 \u3656 \u3649 \u3607 \u3619 \u3585 \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3604 \u3657 \u3634 \u3609 \u3629 \u3639 \u3656 \u3609 \u3654  \u3648 \u3594 \u3656 \u3609  \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 </div></div>\
\
    <div class="qb"><div class="q">9. \uc0\u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3617 \u3637 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3635 \u3588 \u3633 \u3597 \u3588 \u3639 \u3629 \u3586 \u3657 \u3629 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3594 \u3634 \u3605 \u3636 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591  \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3640 \u3586 <br>\u3586 . \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3629 \u3618 \u3656 \u3634 \u3591 \u3617 \u3637 \u3648 \u3626 \u3606 \u3637 \u3618 \u3619 \u3616 \u3634 \u3614 \u3649 \u3621 \u3632 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 <br>\u3588 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617  \u3649 \u3621 \u3632 \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3627 \u3621 \u3639 \u3656 \u3629 \u3617 \u3621 \u3657 \u3635 \u3651 \u3609 \u3607 \u3640 \u3585 \u3617 \u3636 \u3605 \u3636 <br>\u3591 . \u3588 \u3609 \u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3588 \u3609 \u3604 \u3637  \u3588 \u3609 \u3648 \u3585 \u3656 \u3591  \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3594 \u3634 \u3605 \u3636 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591  \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3640 \u3586 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591  \u3588 \u3639 \u3629  \'93\u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3594 \u3634 \u3605 \u3636 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591  \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3640 \u3586 \'94</div></div>\
\
    <div class="qb"><div class="q">10. \uc0\u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3626 \u3635 \u3588 \u3633 \u3597  3 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3588 \u3639 \u3629 \u3586 \u3657 \u3629 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3605 \u3656 \u3629 \u3618 \u3629 \u3604 \u3629 \u3604 \u3637 \u3605 , \u3611 \u3619 \u3633 \u3610 \u3611 \u3633 \u3592 \u3592 \u3640 \u3610 \u3633 \u3609 , \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3640 \u3603 \u3588 \u3656 \u3634 \u3651 \u3627 \u3617 \u3656 \u3651 \u3609 \u3629 \u3609 \u3634 \u3588 \u3605 <br>\u3586 . \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3585 \u3625 \u3605 \u3619 , \u3605 \u3656 \u3629 \u3618 \u3629 \u3604 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 , \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3648 \u3611 \u3655 \u3609 \u3648 \u3621 \u3636 \u3624 <br>\u3588 . \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3652 \u3607 \u3618 , \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3621 \u3585 , \u3626 \u3641 \u3656 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 <br>\u3591 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3609 , \u3626 \u3619 \u3657 \u3634 \u3591 \u3591 \u3634 \u3609 , \u3626 \u3619 \u3657 \u3634 \u3591 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3605 \u3656 \u3629 \u3618 \u3629 \u3604 \u3629 \u3604 \u3637 \u3605 , \u3611 \u3619 \u3633 \u3610 \u3611 \u3633 \u3592 \u3592 \u3640 \u3610 \u3633 \u3609 , \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3640 \u3603 \u3588 \u3656 \u3634 \u3651 \u3627 \u3617 \u3656 \u3651 \u3609 \u3629 \u3609 \u3634 \u3588 \u3605 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609  \u3617 \u3640 \u3656 \u3591 \u3614 \u3633 \u3602 \u3609 \u3634 \u3610 \u3609 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604  3 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619  \u3652 \u3604 \u3657 \u3649 \u3585 \u3656  (1) \'93\u3605 \u3656 \u3629 \u3618 \u3629 \u3604 \u3629 \u3604 \u3637 \u3605 \'94 (2) \'93\u3611 \u3619 \u3633 \u3610 \u3611 \u3633 \u3592 \u3592 \u3640 \u3610 \u3633 \u3609 \'94 \u3649 \u3621 \u3632  (3) \'93\u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3640 \u3603 \u3588 \u3656 \u3634 \u3651 \u3627 \u3617 \u3656 \u3651 \u3609 \u3629 \u3609 \u3634 \u3588 \u3605 \'94</div></div>\
\
    <div class="qb"><div class="q">11. \uc0\u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 \u3588 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3614 \u3633 \u3602 \u3609 \u3634 \u3588 \u3609 \u3651 \u3609 \u3607 \u3640 \u3585 \u3617 \u3636 \u3605 \u3636 \u3649 \u3621 \u3632 \u3651 \u3609 \u3607 \u3640 \u3585 \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3588 \u3609 \u3604 \u3637  \u3648 \u3585 \u3656 \u3591  \u3649 \u3621 \u3632 \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 <br>\u3586 . \u3648 \u3614 \u3656 \u3636 \u3617 \u3612 \u3621 \u3636 \u3605 \u3616 \u3634 \u3614 \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 \u3651 \u3627 \u3657 \u3626 \u3641 \u3591 \u3586 \u3638 \u3657 \u3609 \u3607 \u3633 \u3604 \u3648 \u3607 \u3637 \u3618 \u3617 \u3609 \u3634 \u3609 \u3634 \u3594 \u3634 \u3605 \u3636 <br>\u3588 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 \u3649 \u3627 \u3656 \u3591 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3605 \u3621 \u3629 \u3604 \u3594 \u3637 \u3623 \u3636 \u3605 <br>\u3591 . \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3627 \u3621 \u3639 \u3656 \u3629 \u3617 \u3621 \u3657 \u3635 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3614 \u3633 \u3602 \u3609 \u3634 \u3588 \u3609 \u3651 \u3609 \u3607 \u3640 \u3585 \u3617 \u3636 \u3605 \u3636 \u3649 \u3621 \u3632 \u3651 \u3609 \u3607 \u3640 \u3585 \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3588 \u3609 \u3604 \u3637  \u3648 \u3585 \u3656 \u3591  \u3649 \u3621 \u3632 \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3626 \u3635 \u3588 \u3633 \u3597 \u3588 \u3639 \u3629 \u3648 \u3614 \u3656 \u3639 \u3629 \u3614 \u3633 \u3602 \u3609 \u3634 \u3588 \u3609 \u3651 \u3609 \u3607 \u3640 \u3585 \u3617 \u3636 \u3605 \u3636 \u3649 \u3621 \u3632 \u3651 \u3609 \u3607 \u3640 \u3585 \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3588 \u3609 \u3604 \u3637  \u3648 \u3585 \u3656 \u3591  \u3649 \u3621 \u3632 \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 </div></div>\
\
    <div class="qb"><div class="q">12. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3650 \u3629 \u3585 \u3634 \u3626 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 </div>\
    <div class="c">\uc0\u3585 . \u3604 \u3638 \u3591 \u3614 \u3621 \u3633 \u3591 \u3586 \u3629 \u3591 \u3616 \u3634 \u3588 \u3626 \u3656 \u3623 \u3609 \u3605 \u3656 \u3634 \u3591 \u3654  \u3617 \u3634 \u3619 \u3656 \u3623 \u3617 \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3586 . \u3607 \u3635 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3607 \u3640 \u3585 \u3588 \u3609 \u3617 \u3637 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3626 \u3641 \u3591 \u3586 \u3638 \u3657 \u3609 \u3649 \u3621 \u3632 \u3614 \u3657 \u3609 \u3592 \u3634 \u3585 \u3588 \u3623 \u3634 \u3617 \u3618 \u3634 \u3585 \u3592 \u3609 <br>\u3588 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3619 \u3632 \u3610 \u3610 \u3626 \u3623 \u3633 \u3626 \u3604 \u3636 \u3585 \u3634 \u3619 \u3606 \u3657 \u3623 \u3609 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 <br>\u3591 . \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3600 \u3634 \u3609 \u3619 \u3634 \u3585 \u3651 \u3627 \u3657 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3648 \u3586 \u3657 \u3617 \u3649 \u3586 \u3655 \u3591 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3604 \u3638 \u3591 \u3614 \u3621 \u3633 \u3591 \u3586 \u3629 \u3591 \u3616 \u3634 \u3588 \u3626 \u3656 \u3623 \u3609 \u3605 \u3656 \u3634 \u3591 \u3654  \u3617 \u3634 \u3619 \u3656 \u3623 \u3617 \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3609 \u3637 \u3657 \u3651 \u3627 \u3657 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3604 \u3638 \u3591 \u3648 \u3629 \u3634 \u3614 \u3621 \u3633 \u3591 \u3586 \u3629 \u3591 \u3616 \u3634 \u3588 \u3626 \u3656 \u3623 \u3609 \u3605 \u3656 \u3634 \u3591  \u3654  \u3607 \u3633 \u3657 \u3591 \u3616 \u3634 \u3588 \u3648 \u3629 \u3585 \u3594 \u3609  \u3611 \u3619 \u3632 \u3594 \u3634 \u3626 \u3633 \u3591 \u3588 \u3617  \u3594 \u3640 \u3617 \u3594 \u3609 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609  \u3617 \u3634 \u3619 \u3656 \u3623 \u3617 \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 </div></div>\
\
    <div class="qb"><div class="q">13. \uc0\u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3610 \u3609 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3594 \u3637 \u3623 \u3636 \u3605 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3585 \u3633 \u3610 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 \u3588 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3609 \u3635 \u3652 \u3611 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3610 \u3619 \u3619 \u3621 \u3640 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3651 \u3609 \u3607 \u3640 \u3585 \u3617 \u3636 \u3605 \u3636 <br>\u3586 . \u3621 \u3604 \u3585 \u3634 \u3619 \u3611 \u3621 \u3656 \u3629 \u3618 \u3585 \u3658 \u3634 \u3595 \u3648 \u3619 \u3639 \u3629 \u3609 \u3585 \u3619 \u3632 \u3592 \u3585 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 <br>\u3588 . \u3648 \u3614 \u3656 \u3636 \u3617 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3611 \u3656 \u3634 \u3652 \u3617 \u3657 \u3651 \u3627 \u3657 \u3652 \u3604 \u3657 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  50 \u3586 \u3629 \u3591 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3591 . \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3586 \u3618 \u3632 \u3649 \u3621 \u3632 \u3586 \u3629 \u3591 \u3648 \u3626 \u3637 \u3618 \u3629 \u3618 \u3656 \u3634 \u3591 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3609 \u3635 \u3652 \u3611 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3610 \u3619 \u3619 \u3621 \u3640 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3651 \u3609 \u3607 \u3640 \u3585 \u3617 \u3636 \u3605 \u3636 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3626 \u3635 \u3588 \u3633 \u3597 \u3588 \u3639 \u3629 \u3609 \u3635 \u3652 \u3611 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3610 \u3619 \u3619 \u3621 \u3640 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609  (SDGs) \u3651 \u3609 \u3607 \u3640 \u3585 \u3617 \u3636 \u3605 \u3636 </div></div>\
\
    <div class="qb"><div class="q">14. \uc0\u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3626 \u3635 \u3588 \u3633 \u3597 \u3607 \u3656 \u3637 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3626 \u3617 \u3604 \u3640 \u3621 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3618 \u3638 \u3604 \u3606 \u3639 \u3629 \u3588 \u3639 \u3629 \u3586 \u3657 \u3629 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \'93\u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3648 \u3614 \u3639 \u3656 \u3629 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3626 \u3656 \u3623 \u3609 \u3619 \u3623 \u3617 \'94<br>\u3586 . \'93\u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3586 \u3609 \u3634 \u3604 \u3648 \u3621 \u3655 \u3585  \u3588 \u3621 \u3656 \u3629 \u3591 \u3605 \u3633 \u3623  \u3649 \u3621 \u3632 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 \u3626 \u3641 \u3591 \u3626 \u3640 \u3604 \'94<br>\u3588 . \'93\u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618  \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626  \u3649 \u3621 \u3632 \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3652 \u3604 \u3657 \'94<br>\u3591 . \'93\u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619  \u3607 \u3635 \u3591 \u3634 \u3609 \u3648 \u3594 \u3636 \u3591 \u3619 \u3640 \u3585  \u3649 \u3621 \u3632 \u3617 \u3640 \u3656 \u3591 \u3612 \u3621 \u3626 \u3633 \u3617 \u3620 \u3607 \u3608 \u3636 \u3660 \'94</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \'93\u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3648 \u3614 \u3639 \u3656 \u3629 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3626 \u3656 \u3623 \u3609 \u3619 \u3623 \u3617 \'94</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3626 \u3617 \u3604 \u3640 \u3621 \u3631  \u3617 \u3637 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3648 \u3614 \u3656 \u3639 \u3629 \u3611 \u3619 \u3633 \u3610 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3637 \u3656 \u3618 \u3638 \u3604 \u3627 \u3621 \u3633 \u3585  \'93\u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3648 \u3614 \u3639 \u3656 \u3629 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3626 \u3656 \u3623 \u3609 \u3619 \u3623 \u3617 \'94</div></div>\
\
    <div class="qb"><div class="q">15. \uc0\u3585 \u3619 \u3629 \u3610 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591 \u3607 \u3656 \u3637 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3609 \u3635 \u3617 \u3634 \u3651 \u3594 \u3657 \u3648 \u3619 \u3637 \u3618 \u3585 \u3623 \u3656 \u3634 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591 \u3649 \u3610 \u3610 \u3629 \u3591 \u3588 \u3660 \u3619 \u3623 \u3617 <br>\u3586 . \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3648 \u3594 \u3636 \u3591 \u3619 \u3640 \u3585 <br>\u3588 . \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3607 \u3637 \u3656 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 <br>\u3591 . \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3586 \u3629 \u3591 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591 \u3649 \u3610 \u3610 \u3629 \u3591 \u3588 \u3660 \u3619 \u3623 \u3617 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3651 \u3594 \u3657 \u3585 \u3619 \u3629 \u3610 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3651 \u3627 \u3617 \u3656 \u3607 \u3637 \u3656 \u3648 \u3619 \u3637 \u3618 \u3585 \u3623 \u3656 \u3634  \'93\u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3649 \u3610 \u3610 \u3629 \u3591 \u3588 \u3660 \u3619 \u3623 \u3617 \'94 \u3595 \u3638 \u3656 \u3591 \u3588 \u3619 \u3629 \u3610 \u3588 \u3621 \u3640 \u3617 \u3617 \u3636 \u3605 \u3636 \u3605 \u3656 \u3634 \u3591 \u3654  \u3607 \u3637 \u3656 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3618 \u3591 \u3585 \u3633 \u3609 </div></div>\
\
    <div class="qb"><div class="q">16. \uc0\u3586 \u3657 \u3629 \u3651 \u3604  \u3652 \u3617 \u3656 \u3651 \u3594 \u3656  \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 </div>\
    <div class="c">\uc0\u3585 . \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3629 \u3618 \u3641 \u3656 \u3604 \u3637  \u3585 \u3636 \u3609 \u3604 \u3637  \u3649 \u3621 \u3632 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3640 \u3586 <br>\u3586 . \u3585 \u3629 \u3591 \u3607 \u3633 \u3614 \u3617 \u3637 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656 \u3649 \u3621 \u3632 \u3617 \u3637 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3607 \u3637 \u3656 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 \u3651 \u3609 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 <br>\u3588 . \u3610 \u3657 \u3634 \u3609 \u3648 \u3617 \u3639 \u3629 \u3591 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3651 \u3609 \u3607 \u3640 \u3585 \u3617 \u3636 \u3605 \u3636 \u3649 \u3621 \u3632 \u3607 \u3640 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 <br>\u3591 . \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3617 \u3637 \u3610 \u3607 \u3610 \u3634 \u3607 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3648 \u3611 \u3655 \u3609 \u3607 \u3637 \u3656 \u3594 \u3639 \u3656 \u3609 \u3594 \u3617 \u3649 \u3621 \u3632 \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 \u3585 \u3634 \u3619 \u3618 \u3629 \u3617 \u3619 \u3633 \u3610 \u3650 \u3604 \u3618 \u3611 \u3619 \u3632 \u3594 \u3634 \u3588 \u3617 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3629 \u3591 \u3607 \u3633 \u3614 \u3617 \u3637 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656 \u3649 \u3621 \u3632 \u3617 \u3637 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3607 \u3637 \u3656 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 \u3651 \u3609 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3652 \u3617 \u3656 \u3652 \u3604 \u3657 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3651 \u3627 \u3657 \u3585 \u3629 \u3591 \u3607 \u3633 \u3614 \u3617 \u3637 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604  \u3649 \u3605 \u3656 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3617 \u3637 \u3586 \u3637 \u3604 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3607 \u3637 \u3656 \u3614 \u3619 \u3657 \u3629 \u3617 \u3648 \u3614 \u3637 \u3618 \u3591 \u3614 \u3629 \u3651 \u3609 \u3585 \u3634 \u3619 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3649 \u3621 \u3632 \u3619 \u3633 \u3610 \u3617 \u3639 \u3629 \u3616 \u3633 \u3618 \u3588 \u3640 \u3585 \u3588 \u3634 \u3617 </div></div>\
\
    <div class="qb"><div class="q">17. \uc0\u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3586 \u3657 \u3629 \u3651 \u3604 \u3607 \u3637 \u3656 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3588 \u3623 \u3634 \u3617 \u3626 \u3591 \u3610 \u3648 \u3619 \u3637 \u3618 \u3610 \u3619 \u3657 \u3629 \u3618 \u3649 \u3621 \u3632 \u3626 \u3633 \u3609 \u3605 \u3636 \u3626 \u3640 \u3586 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3586 \u3638 \u3657 \u3609 \u3585 \u3633 \u3610 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3619 \u3633 \u3585 \u3625 \u3634 \u3588 \u3623 \u3634 \u3617 \u3626 \u3591 \u3610 \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3586 . \u3585 \u3634 \u3619 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3649 \u3621 \u3632 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3607 \u3637 \u3656 \u3617 \u3637 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3605 \u3656 \u3629 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 <br>\u3588 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3651 \u3627 \u3657 \u3614 \u3619 \u3657 \u3629 \u3617 \u3648 \u3612 \u3594 \u3636 \u3597 \u3616 \u3633 \u3618 \u3588 \u3640 \u3585 \u3588 \u3634 \u3617 <br>\u3591 . \u3585 \u3634 \u3619 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3588 \u3623 \u3634 \u3617 \u3619 \u3656 \u3623 \u3617 \u3617 \u3639 \u3629 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3585 \u3633 \u3610 \u3629 \u3634 \u3648 \u3595 \u3637 \u3618 \u3609 \u3649 \u3621 \u3632 \u3609 \u3634 \u3609 \u3634 \u3594 \u3634 \u3605 \u3636 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3634 \u3619 \u3619 \u3633 \u3585 \u3625 \u3634 \u3588 \u3623 \u3634 \u3617 \u3626 \u3591 \u3610 \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3619 \u3633 \u3585 \u3625 \u3634 \u3588 \u3623 \u3634 \u3617 \u3626 \u3591 \u3610 \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3607 \u3637 \u3656 \u3617 \u3640 \u3656 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3588 \u3623 \u3634 \u3617 \u3626 \u3591 \u3610 \u3648 \u3619 \u3637 \u3618 \u3610 \u3619 \u3657 \u3629 \u3618 \u3649 \u3621 \u3632 \u3626 \u3633 \u3609 \u3605 \u3636 \u3626 \u3640 \u3586 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3586 \u3657 \u3638 \u3609 \u3585 \u3633 \u3610 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3594 \u3634 \u3605 \u3636 \u3610 \u3657 \u3634 \u3609 \u3648 \u3617 \u3639 \u3629 \u3591 </div></div>\
\
    <div class="qb"><div class="q">18. \uc0\u3585 \u3634 \u3619 \u3609 \u3657 \u3629 \u3617 \u3609 \u3635 \u3649 \u3621 \u3632 \u3648 \u3612 \u3618 \u3649 \u3614 \u3619 \u3656 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3614 \u3619 \u3632 \u3619 \u3634 \u3594 \u3634  \u3649 \u3621 \u3632 \u3627 \u3621 \u3633 \u3585 \u3611 \u3619 \u3633 \u3594 \u3597 \u3634 \u3586 \u3629 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3629 \u3648 \u3614 \u3637 \u3618 \u3591  \u3592 \u3633 \u3604 \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3651 \u3604 \u3586 \u3629 \u3591 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3592 \u3591 \u3619 \u3633 \u3585 \u3616 \u3633 \u3585 \u3604 \u3637 \u3605 \u3656 \u3629 \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3627 \u3621 \u3633 \u3585 \u3586 \u3629 \u3591 \u3594 \u3634 \u3605 \u3636 <br>\u3586 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3609 \u3651 \u3609 \u3607 \u3640 \u3585 \u3616 \u3634 \u3588 \u3626 \u3656 \u3623 \u3609 \u3651 \u3627 \u3657 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3648 \u3586 \u3657 \u3617 \u3649 \u3586 \u3655 \u3591 <br>\u3588 . \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3651 \u3609 \u3611 \u3633 \u3592 \u3592 \u3640 \u3610 \u3633 \u3609 <br>\u3591 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3626 \u3633 \u3609 \u3605 \u3636 \u3626 \u3640 \u3586 \u3629 \u3618 \u3656 \u3634 \u3591 \u3606 \u3634 \u3623 \u3619 \u3651 \u3609 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604 \u3594 \u3634 \u3618 \u3649 \u3604 \u3609 \u3616 \u3634 \u3588 \u3651 \u3605 \u3657 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3592 \u3591 \u3619 \u3633 \u3585 \u3616 \u3633 \u3585 \u3604 \u3637 \u3605 \u3656 \u3629 \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3627 \u3621 \u3633 \u3585 \u3586 \u3629 \u3591 \u3594 \u3634 \u3605 \u3636 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3609 \u3657 \u3629 \u3617 \u3609 \u3635 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3614 \u3619 \u3632 \u3619 \u3634 \u3594 \u3634 \u3648 \u3611 \u3655 \u3609 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3651 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3592 \u3591 \u3619 \u3633 \u3585 \u3616 \u3633 \u3585 \u3604 \u3637 \u3605 \u3656 \u3629 \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3627 \u3621 \u3633 \u3585 \u3586 \u3629 \u3591 \u3594 \u3634 \u3605 \u3636 </div></div>\
\
    <div class="qb"><div class="q">19. \uc0\u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3618 \u3634 \u3648 \u3626 \u3614 \u3605 \u3636 \u3604  \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660  \u3649 \u3621 \u3632 \u3629 \u3634 \u3594 \u3597 \u3634 \u3585 \u3619 \u3619 \u3617 \u3607 \u3634 \u3591 \u3652 \u3595 \u3648 \u3610 \u3629 \u3619 \u3660  \u3592 \u3633 \u3604 \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3651 \u3604 \u3586 \u3629 \u3591 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3649 \u3621 \u3632 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3607 \u3637 \u3656 \u3617 \u3637 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3605 \u3656 \u3629 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 <br>\u3586 . \u3585 \u3634 \u3619 \u3619 \u3633 \u3585 \u3625 \u3634 \u3588 \u3623 \u3634 \u3617 \u3626 \u3591 \u3610 \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3588 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3651 \u3627 \u3657 \u3614 \u3619 \u3657 \u3629 \u3617 \u3648 \u3612 \u3594 \u3636 \u3597 \u3616 \u3633 \u3618 \u3588 \u3640 \u3585 \u3588 \u3634 \u3617 <br>\u3591 . \u3585 \u3634 \u3619 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3588 \u3623 \u3634 \u3617 \u3619 \u3656 \u3623 \u3617 \u3617 \u3639 \u3629 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3585 \u3633 \u3610 \u3609 \u3634 \u3609 \u3634 \u3594 \u3634 \u3605 \u3636 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3634 \u3619 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3649 \u3621 \u3632 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3607 \u3637 \u3656 \u3617 \u3637 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3605 \u3656 \u3629 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3649 \u3621 \u3632 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3607 \u3637 \u3656 \u3617 \u3637 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3605 \u3656 \u3629 \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591  \u3588 \u3619 \u3629 \u3610 \u3588 \u3621 \u3640 \u3617 \u3606 \u3638 \u3591 \u3611 \u3633 \u3597 \u3627 \u3634 \u3629 \u3634 \u3594 \u3597 \u3634 \u3585 \u3619 \u3619 \u3617 \u3586 \u3657 \u3634 \u3617 \u3594 \u3634 \u3605 \u3636 \u3649 \u3621 \u3632 \u3616 \u3633 \u3618 \u3588 \u3640 \u3585 \u3588 \u3634 \u3617 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3651 \u3627 \u3617 \u3656 \u3654  \u3648 \u3594 \u3656 \u3609  \u3629 \u3634 \u3594 \u3597 \u3634 \u3585 \u3619 \u3619 \u3617 \u3607 \u3634 \u3591 \u3652 \u3595 \u3648 \u3610 \u3629 \u3619 \u3660 </div></div>\
\
    <div class="qb"><div class="q">20. \uc0\u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3614 \u3619 \u3632 \u3619 \u3634 \u3594 \u3607 \u3634 \u3609  \'93\u3648 \u3586 \u3657 \u3634 \u3651 \u3592  \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591  \u3614 \u3633 \u3602 \u3609 \u3634 \'94 \u3606 \u3641 \u3585 \u3609 \u3635 \u3617 \u3634 \u3651 \u3594 \u3657 \u3648 \u3611 \u3655 \u3609 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3627 \u3621 \u3633 \u3585 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3651 \u3609 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656 \u3594 \u3634 \u3618 \u3649 \u3604 \u3609 \u3616 \u3634 \u3588 \u3605 \u3632 \u3623 \u3633 \u3609 \u3605 \u3585 <br>\u3586 . \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3626 \u3634 \u3617 \u3648 \u3627 \u3621 \u3637 \u3656 \u3618 \u3617 \u3607 \u3629 \u3591 \u3588 \u3635 <br>\u3588 . \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604 \u3594 \u3634 \u3618 \u3649 \u3604 \u3609 \u3616 \u3634 \u3588 \u3651 \u3605 \u3657 <br>\u3591 . \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3648 \u3586 \u3605 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3636 \u3648 \u3624 \u3625 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604 \u3594 \u3634 \u3618 \u3649 \u3604 \u3609 \u3616 \u3634 \u3588 \u3651 \u3605 \u3657 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3614 \u3619 \u3632 \u3619 \u3634 \u3594 \u3607 \u3634 \u3609  \'93\u3648 \u3586 \u3657 \u3634 \u3651 \u3592  \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591  \u3614 \u3633 \u3602 \u3609 \u3634 \'94 \u3648 \u3611 \u3655 \u3609 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3627 \u3621 \u3633 \u3585 \u3607 \u3637 \u3656 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3588 \u3623 \u3634 \u3617 \u3652 \u3617 \u3656 \u3626 \u3591 \u3610 \u3651 \u3609 \u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604 \u3594 \u3634 \u3618 \u3649 \u3604 \u3609 \u3616 \u3634 \u3588 \u3651 \u3605 \u3657 </div></div>\
\
    <div class="qb"><div class="q">21. \uc0\u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3626 \u3617 \u3640 \u3607 \u3607 \u3634 \u3609 \u3640 \u3616 \u3634 \u3614 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3586 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3651 \u3604 \u3586 \u3629 \u3591 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3619 \u3633 \u3585 \u3625 \u3634 \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591 \u3649 \u3621 \u3632 \u3612 \u3621 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3607 \u3634 \u3591 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636 \u3649 \u3621 \u3632 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 \u3607 \u3633 \u3657 \u3591 \u3607 \u3634 \u3591 \u3610 \u3585 \u3649 \u3621 \u3632 \u3607 \u3634 \u3591 \u3607 \u3632 \u3648 \u3621 <br>\u3586 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3591 \u3634 \u3609 \u3586 \u3656 \u3634 \u3623 \u3585 \u3619 \u3629 \u3591 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636 <br>\u3588 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3612 \u3609 \u3638 \u3585 \u3614 \u3621 \u3633 \u3591 \u3629 \u3635 \u3609 \u3634 \u3592 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636 <br>\u3591 . \u3585 \u3634 \u3619 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3649 \u3621 \u3632 \u3619 \u3633 \u3585 \u3625 \u3634 \u3604 \u3640 \u3621 \u3618 \u3616 \u3634 \u3614 \u3626 \u3616 \u3634 \u3623 \u3632 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3634 \u3619 \u3619 \u3633 \u3585 \u3625 \u3634 \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591 \u3649 \u3621 \u3632 \u3612 \u3621 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3607 \u3634 \u3591 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636 \u3649 \u3621 \u3632 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 \u3607 \u3633 \u3657 \u3591 \u3607 \u3634 \u3591 \u3610 \u3585 \u3649 \u3621 \u3632 \u3607 \u3634 \u3591 \u3607 \u3632 \u3648 \u3621 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3626 \u3617 \u3640 \u3607 \u3607 \u3634 \u3609 \u3640 \u3616 \u3634 \u3614 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3648 \u3611 \u3655 \u3609 \u3626 \u3656 \u3623 \u3609 \u3627 \u3609 \u3638 \u3656 \u3591 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3619 \u3633 \u3585 \u3625 \u3634 \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591 \u3649 \u3621 \u3632 \u3612 \u3621 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3586 \u3629 \u3591 \u3594 \u3634 \u3605 \u3636 \u3607 \u3634 \u3591 \u3607 \u3632 \u3648 \u3621 </div></div>\
\
    <div class="qb"><div class="q">22. \'93\uc0\u3648 \u3585 \u3625 \u3605 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \'94 \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3651 \u3609 \u3604 \u3657 \u3634 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 <br>\u3586 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3610 \u3609 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3594 \u3637 \u3623 \u3636 \u3605 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3585 \u3633 \u3610 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 <br>\u3588 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3650 \u3629 \u3585 \u3634 \u3626 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 <br>\u3591 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3626 \u3617 \u3604 \u3640 \u3621 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \'93\u3648 \u3585 \u3625 \u3605 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \'94 \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3649 \u3619 \u3585 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 </div></div>\
\
    <div class="qb"><div class="q">23. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3621 \u3633 \u3585 \u3625 \u3603 \u3632 \u3586 \u3629 \u3591  \'93\u3648 \u3585 \u3625 \u3605 \u3619 \u3629 \u3633 \u3605 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3614 \u3657 \u3639 \u3609 \u3606 \u3636 \u3656 \u3609 \'94</div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3607 \u3635 \u3648 \u3585 \u3625 \u3605 \u3619 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3651 \u3594 \u3657 \u3626 \u3634 \u3619 \u3648 \u3588 \u3617 \u3637 <br>\u3586 . \u3585 \u3634 \u3619 \u3609 \u3635 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3617 \u3634 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3607 \u3635 \u3615 \u3634 \u3619 \u3660 \u3617 <br>\u3588 . \u3585 \u3634 \u3619 \u3609 \u3635 \u3616 \u3641 \u3617 \u3636 \u3611 \u3633 \u3597 \u3597 \u3634 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609 \u3617 \u3634 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3649 \u3621 \u3632 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3605 \u3619 <br>\u3591 . \u3585 \u3634 \u3619 \u3649 \u3611 \u3619 \u3619 \u3641 \u3611 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3648 \u3585 \u3625 \u3605 \u3619 \u3651 \u3627 \u3657 \u3617 \u3637 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3626 \u3641 \u3591 \u3586 \u3638 \u3657 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3585 \u3634 \u3619 \u3609 \u3635 \u3616 \u3641 \u3617 \u3636 \u3611 \u3633 \u3597 \u3597 \u3634 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609 \u3617 \u3634 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3649 \u3621 \u3632 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3605 \u3619 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3585 \u3625 \u3605 \u3619 \u3629 \u3633 \u3605 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3614 \u3639 \u3657 \u3609 \u3606 \u3636 \u3656 \u3609  \u3588 \u3639 \u3629 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3609 \u3635 \u3629 \u3633 \u3605 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3649 \u3621 \u3632 \u3616 \u3641 \u3617 \u3636 \u3611 \u3633 \u3597 \u3597 \u3634 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609 \u3617 \u3634 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3605 \u3619 \u3607 \u3637 \u3656 \u3617 \u3637 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3656 \u3636 \u3617 </div></div>\
\
    <div class="qb"><div class="q">24. \uc0\u3585 \u3634 \u3619 \u3648 \u3614 \u3656 \u3636 \u3617 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3649 \u3621 \u3632 \u3611 \u3619 \u3636 \u3617 \u3634 \u3603 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3648 \u3585 \u3625 \u3605 \u3619 \u3629 \u3636 \u3609 \u3607 \u3619 \u3637 \u3618 \u3660  \u3648 \u3611 \u3655 \u3609 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3585 \u3625 \u3605 \u3619 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 <br>\u3586 . \u3648 \u3585 \u3625 \u3605 \u3619 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614 <br>\u3588 . \u3648 \u3585 \u3625 \u3605 \u3619 \u3649 \u3611 \u3619 \u3619 \u3641 \u3611 <br>\u3591 . \u3648 \u3585 \u3625 \u3605 \u3619 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3648 \u3585 \u3625 \u3605 \u3619 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3585 \u3625 \u3605 \u3619 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3607 \u3637 \u3656 \u3626 \u3629 \u3604 \u3588 \u3621 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3617 \u3634 \u3605 \u3619 \u3600 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618  \u3649 \u3621 \u3632 \u3617 \u3640 \u3656 \u3591 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3648 \u3621 \u3636 \u3585 \u3651 \u3594 \u3657 \u3626 \u3634 \u3619 \u3648 \u3588 \u3617 \u3637 \u3651 \u3609 \u3616 \u3634 \u3588 \u3648 \u3585 \u3625 \u3605 \u3619  \u3595 \u3638 \u3656 \u3591 \u3619 \u3623 \u3617 \u3606 \u3638 \u3591 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3648 \u3585 \u3625 \u3605 \u3619 \u3629 \u3636 \u3609 \u3607 \u3619 \u3637 \u3618 \u3660 </div></div>\
\
    <div class="qb"><div class="q">25. \uc0\u3585 \u3634 \u3619 \u3609 \u3635 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3611 \u3633 \u3597 \u3597 \u3634 \u3611 \u3619 \u3632 \u3604 \u3636 \u3625 \u3600 \u3660 \u3649 \u3621 \u3632 \u3650 \u3604 \u3619 \u3609 \u3617 \u3634 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3607 \u3635 \u3615 \u3634 \u3619 \u3660 \u3617  \u3626 \u3629 \u3604 \u3588 \u3621 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3651 \u3604 \u3617 \u3634 \u3585 \u3607 \u3656 \u3637 \u3626 \u3640 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3585 \u3625 \u3605 \u3619 \u3649 \u3611 \u3619 \u3619 \u3641 \u3611 <br>\u3586 . \u3648 \u3585 \u3625 \u3605 \u3619 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 <br>\u3588 . \u3648 \u3585 \u3625 \u3605 \u3619 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614 <br>\u3591 . \u3648 \u3585 \u3625 \u3605 \u3619 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3648 \u3585 \u3625 \u3605 \u3619 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3585 \u3625 \u3605 \u3619 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632  (Smart Farming) \u3588 \u3639 \u3629 \u3585 \u3634 \u3619 \u3609 \u3635 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3626 \u3617 \u3633 \u3618 \u3651 \u3627 \u3617 \u3656  \u3648 \u3594 \u3656 \u3609  \u3611 \u3633 \u3597 \u3597 \u3634 \u3611 \u3619 \u3632 \u3604 \u3636 \u3625 \u3600 \u3660  \u3648 \u3595 \u3655 \u3609 \u3648 \u3595 \u3629 \u3619 \u3660  \u3649 \u3621 \u3632 \u3650 \u3604 \u3619 \u3609  \u3617 \u3634 \u3611 \u3619 \u3632 \u3618 \u3640 \u3585 \u3605 \u3660 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3605 \u3619 \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3614 \u3656 \u3636 \u3617 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 </div></div>\
\
    <div class="qb"><div class="q">26. \uc0\u3586 \u3657 \u3629 \u3651 \u3604  \u3652 \u3617 \u3656 \u3651 \u3594 \u3656  \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3649 \u3627 \u3656 \u3591 \u3629 \u3609 \u3634 \u3588 \u3605  \u3605 \u3634 \u3617 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 </div>\
    <div class="c">\uc0\u3585 . \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614 <br>\u3586 . \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \u3588 \u3619 \u3610 \u3623 \u3591 \u3592 \u3619 <br>\u3588 . \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3626 \u3636 \u3656 \u3591 \u3607 \u3629 \u3649 \u3621 \u3632 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3609 \u3640 \u3656 \u3591 \u3627 \u3656 \u3617 \u3649 \u3610 \u3610 \u3604 \u3633 \u3657 \u3591 \u3648 \u3604 \u3636 \u3617 <br>\u3591 . \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621  \u3586 \u3657 \u3629 \u3617 \u3641 \u3621  \u3649 \u3621 \u3632 \u3611 \u3633 \u3597 \u3597 \u3634 \u3611 \u3619 \u3632 \u3604 \u3636 \u3625 \u3600 \u3660 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3626 \u3636 \u3656 \u3591 \u3607 \u3629 \u3649 \u3621 \u3632 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3609 \u3640 \u3656 \u3591 \u3627 \u3656 \u3617 \u3649 \u3610 \u3610 \u3604 \u3633 \u3657 \u3591 \u3648 \u3604 \u3636 \u3617 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3626 \u3636 \u3656 \u3591 \u3607 \u3629 \u3649 \u3621 \u3632 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3609 \u3640 \u3656 \u3591 \u3627 \u3656 \u3617 \u3649 \u3610 \u3610 \u3604 \u3633 \u3657 \u3591 \u3648 \u3604 \u3636 \u3617 \u3652 \u3617 \u3656 \u3592 \u3633 \u3604 \u3648 \u3611 \u3655 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3649 \u3627 \u3656 \u3591 \u3629 \u3609 \u3634 \u3588 \u3605 \u3605 \u3634 \u3617 \u3607 \u3637 \u3656 \u3619 \u3632 \u3610 \u3640 \u3652 \u3623 \u3657  \u3595 \u3638 \u3656 \u3591 \u3592 \u3632 \u3648 \u3609 \u3657 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3607 \u3637 \u3656 \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3604 \u3657 \u3623 \u3618 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3586 \u3633 \u3657 \u3609 \u3626 \u3641 \u3591 </div></div>\
\
    <div class="qb"><div class="q">27. \uc0\u3585 \u3634 \u3619 \u3612 \u3621 \u3633 \u3585 \u3604 \u3633 \u3609 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3612 \u3656 \u3634 \u3609 \u3586 \u3629 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3652 \u3611 \u3626 \u3641 \u3656 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3652 \u3615 \u3615 \u3657 \u3634 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632  \u3629 \u3618 \u3641 \u3656 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3586 \u3609 \u3626 \u3656 \u3591 \u3649 \u3621 \u3632 \u3650 \u3621 \u3592 \u3636 \u3626 \u3605 \u3636 \u3585 \u3626 \u3660 <br>\u3586 . \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3588 . \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 <br>\u3591 . \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3586 \u3609 \u3626 \u3656 \u3591 \u3649 \u3621 \u3632 \u3650 \u3621 \u3592 \u3636 \u3626 \u3605 \u3636 \u3585 \u3626 \u3660 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3652 \u3615 \u3615 \u3657 \u3634 \u3648 \u3611 \u3655 \u3609 \u3626 \u3656 \u3623 \u3609 \u3627 \u3609 \u3638 \u3656 \u3591 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3586 \u3609 \u3626 \u3656 \u3591 \u3649 \u3621 \u3632 \u3650 \u3621 \u3592 \u3636 \u3626 \u3605 \u3636 \u3585 \u3626 \u3660  \u3648 \u3614 \u3656 \u3639 \u3629 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3600 \u3634 \u3609 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3586 \u3629 \u3591 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 </div></div>\
\
    <div class="qb"><div class="q">28. \uc0\u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3648 \u3594 \u3636 \u3591 \u3626 \u3635 \u3619 \u3634 \u3597 \u3607 \u3634 \u3591 \u3607 \u3632 \u3648 \u3621 \u3649 \u3621 \u3632 \u3594 \u3634 \u3618 \u3613 \u3633 \u3656 \u3591  \u3648 \u3611 \u3655 \u3609 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3656 \u3637 \u3618 \u3623 \u3648 \u3594 \u3636 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3619 \u3619 \u3588 \u3660 \u3649 \u3621 \u3632 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617 <br>\u3586 . \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3648 \u3594 \u3636 \u3591 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 <br>\u3588 . \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3626 \u3635 \u3619 \u3634 \u3597 \u3607 \u3634 \u3591 \u3609 \u3657 \u3635 <br>\u3591 . \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3618 \u3591 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3626 \u3635 \u3619 \u3634 \u3597 \u3607 \u3634 \u3591 \u3609 \u3657 \u3635 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3607 \u3634 \u3591 \u3609 \u3657 \u3635  \u3648 \u3594 \u3656 \u3609  \u3648 \u3619 \u3639 \u3629 \u3626 \u3635 \u3619 \u3634 \u3597 \u3649 \u3621 \u3632 \u3648 \u3619 \u3639 \u3629 \u3618 \u3629 \u3619 \u3660 \u3594  \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3626 \u3635 \u3619 \u3634 \u3597 \u3607 \u3634 \u3591 \u3609 \u3657 \u3635 </div></div>\
\
    <div class="qb"><div class="q">29. \uc0\u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3586 \u3605 \u3614 \u3633 \u3602 \u3609 \u3634 \u3614 \u3636 \u3648 \u3624 \u3625 \u3616 \u3634 \u3588 \u3605 \u3632 \u3623 \u3633 \u3609 \u3629 \u3629 \u3585  (EEC) \u3648 \u3611 \u3655 \u3609 \u3626 \u3656 \u3623 \u3609 \u3627 \u3609 \u3638 \u3656 \u3591 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609  \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3652 \u3607 \u3618  \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3621 \u3585 <br>\u3586 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3627 \u3621 \u3634 \u3585 \u3627 \u3621 \u3634 \u3618 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 <br>\u3588 . \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3649 \u3627 \u3656 \u3591 \u3629 \u3609 \u3634 \u3588 \u3605 <br>\u3591 . \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3610 \u3609 \u3614 \u3657 \u3639 \u3609 \u3600 \u3634 \u3609 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3618 \u3640 \u3588 \u3651 \u3627 \u3617 \u3656 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609  \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3652 \u3607 \u3618  \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3621 \u3585 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634  EEC \u3648 \u3611 \u3655 \u3609 \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 \u3626 \u3635 \u3588 \u3633 \u3597 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609  \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3652 \u3607 \u3618  \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3621 \u3585  \u3648 \u3614 \u3639 \u3656 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3648 \u3586 \u3605 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3636 \u3648 \u3624 \u3625 \u3607 \u3656 \u3637 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 </div></div>\
\
    <div class="qb"><div class="q">30. \uc0\u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3610 \u3609 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3618 \u3640 \u3588 \u3651 \u3627 \u3617 \u3656  \u3588 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606  \'93\u3612 \u3621 \u3636 \u3605 \u3648 \u3585 \u3656 \u3591  \u3586 \u3634 \u3618 \u3648 \u3585 \u3656 \u3591 \'94 \u3649 \u3621 \u3632 \u3617 \u3637 \u3608 \u3619 \u3619 \u3617 \u3634 \u3616 \u3636 \u3610 \u3634 \u3621 <br>\u3586 . \u3648 \u3614 \u3656 \u3636 \u3617 \u3592 \u3635 \u3609 \u3623 \u3609 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3648 \u3619 \u3636 \u3656 \u3617 \u3605 \u3657 \u3609  (Startup) \u3651 \u3627 \u3657 \u3617 \u3634 \u3585 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 \u3651 \u3609 \u3629 \u3634 \u3648 \u3595 \u3637 \u3618 \u3609 <br>\u3588 . \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3619 \u3634 \u3618 \u3651 \u3627 \u3597 \u3656 \u3586 \u3618 \u3634 \u3618 \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3652 \u3611 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3591 . \u3621 \u3604 \u3592 \u3635 \u3609 \u3623 \u3609 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3619 \u3634 \u3618 \u3618 \u3656 \u3629 \u3618 \u3649 \u3621 \u3632 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3588 \u3623 \u3610 \u3619 \u3623 \u3617 \u3585 \u3636 \u3592 \u3585 \u3634 \u3619 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606  \'93\u3612 \u3621 \u3636 \u3605 \u3648 \u3585 \u3656 \u3591  \u3586 \u3634 \u3618 \u3648 \u3585 \u3656 \u3591 \'94 \u3649 \u3621 \u3632 \u3617 \u3637 \u3608 \u3619 \u3619 \u3617 \u3634 \u3616 \u3636 \u3610 \u3634 \u3621 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3588 \u3639 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3618 \u3640 \u3588 \u3651 \u3627 \u3617 \u3656 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3612 \u3641 \u3657 \u3607 \u3637 \u3656  \'93\u3612 \u3621 \u3636 \u3605 \u3648 \u3585 \u3656 \u3591  \u3586 \u3634 \u3618 \u3648 \u3585 \u3656 \u3591 \'94 \u3627 \u3619 \u3639 \u3629  \'93\u3595 \u3639 \u3657 \u3629 \u3648 \u3611 \u3655 \u3609  \u3586 \u3634 \u3618 \u3648 \u3611 \u3655 \u3609 \'94 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3648 \u3611 \u3655 \u3609 \u3648 \u3621 \u3636 \u3624  \u3649 \u3621 \u3632 \u3617 \u3637 \u3608 \u3619 \u3619 \u3617 \u3634 \u3616 \u3636 \u3610 \u3634 \u3621 </div></div>\
\
    <div class="qb"><div class="q">31. \uc0\u3588 \u3640 \u3603 \u3621 \u3633 \u3585 \u3625 \u3603 \u3632 \u3586 \u3629 \u3591  \'93\u3588 \u3609 \u3652 \u3607 \u3618 \u3651 \u3609 \u3629 \u3609 \u3634 \u3588 \u3605 \'94 \u3605 \u3634 \u3617 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 \u3588 \u3639 \u3629 \u3586 \u3657 \u3629 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3614 \u3619 \u3657 \u3629 \u3617 \u3607 \u3633 \u3657 \u3591 \u3585 \u3634 \u3618  \u3651 \u3592  \u3626 \u3605 \u3636 \u3611 \u3633 \u3597 \u3597 \u3634  \u3617 \u3637 \u3607 \u3633 \u3585 \u3625 \u3632 \u3651 \u3609 \u3624 \u3605 \u3623 \u3619 \u3619 \u3625 \u3607 \u3656 \u3637  21 \u3649 \u3621 \u3632 \u3648 \u3611 \u3655 \u3609 \u3614 \u3621 \u3648 \u3617 \u3639 \u3629 \u3591 \u3604 \u3637 \u3586 \u3629 \u3591 \u3594 \u3634 \u3605 \u3636 <br>\u3586 . \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3648 \u3594 \u3637 \u3656 \u3618 \u3623 \u3594 \u3634 \u3597 \u3604 \u3657 \u3634 \u3609 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3649 \u3621 \u3632 \u3616 \u3634 \u3625 \u3634 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3588 . \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3648 \u3611 \u3655 \u3609 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3649 \u3621 \u3632 \u3626 \u3619 \u3657 \u3634 \u3591 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 <br>\u3591 . \u3617 \u3637 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614 \u3604 \u3637  \u3617 \u3637 \u3629 \u3634 \u3618 \u3640 \u3618 \u3639 \u3609 \u3618 \u3634 \u3623  \u3649 \u3621 \u3632 \u3614 \u3656 \u3638 \u3591 \u3614 \u3634 \u3605 \u3609 \u3648 \u3629 \u3591 \u3652 \u3604 \u3657 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3614 \u3619 \u3657 \u3629 \u3617 \u3607 \u3633 \u3657 \u3591 \u3585 \u3634 \u3618  \u3651 \u3592  \u3626 \u3605 \u3636 \u3611 \u3633 \u3597 \u3597 \u3634  \u3617 \u3637 \u3607 \u3633 \u3585 \u3625 \u3632 \u3651 \u3609 \u3624 \u3605 \u3623 \u3619 \u3619 \u3625 \u3607 \u3656 \u3637  21 \u3649 \u3621 \u3632 \u3648 \u3611 \u3655 \u3609 \u3614 \u3621 \u3648 \u3617 \u3639 \u3629 \u3591 \u3604 \u3637 \u3586 \u3629 \u3591 \u3594 \u3634 \u3605 \u3636 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3609 \u3636 \u3618 \u3634 \u3617  \'93\u3588 \u3609 \u3652 \u3607 \u3618 \u3651 \u3609 \u3629 \u3609 \u3634 \u3588 \u3605 \'94 \u3623 \u3656 \u3634 \u3592 \u3632 \u3605 \u3657 \u3629 \u3591 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3614 \u3619 \u3657 \u3629 \u3617 \u3607 \u3633 \u3657 \u3591 \u3585 \u3634 \u3618  \u3651 \u3592  \u3626 \u3605 \u3636 \u3611 \u3633 \u3597 \u3597 \u3634  \u3617 \u3637 \u3607 \u3633 \u3585 \u3625 \u3632 \u3607 \u3637 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3651 \u3609 \u3624 \u3605 \u3623 \u3619 \u3619 \u3625 \u3607 \u3637 \u3656  21 \u3649 \u3621 \u3632 \u3648 \u3611 \u3655 \u3609 \u3614 \u3621 \u3648 \u3617 \u3639 \u3629 \u3591 \u3604 \u3637 \u3586 \u3629 \u3591 \u3594 \u3634 \u3605 \u3636 </div></div>\
\
    <div class="qb"><div class="q">32. \uc0\u3585 \u3634 \u3619 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3588 \u3623 \u3634 \u3617 \u3595 \u3639 \u3656 \u3629 \u3626 \u3633 \u3605 \u3618 \u3660  \u3623 \u3636 \u3609 \u3633 \u3618  \u3588 \u3640 \u3603 \u3608 \u3619 \u3619 \u3617  \u3592 \u3619 \u3636 \u3618 \u3608 \u3619 \u3619 \u3617  \u3651 \u3609 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3585 \u3634 \u3619 \u3626 \u3629 \u3609  \u3592 \u3633 \u3604 \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3588 \u3656 \u3634 \u3609 \u3636 \u3618 \u3617 \u3649 \u3621 \u3632 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617 <br>\u3586 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3588 \u3609 \u3605 \u3621 \u3629 \u3604 \u3594 \u3656 \u3623 \u3591 \u3594 \u3637 \u3623 \u3636 \u3605 <br>\u3588 . \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 <br>\u3591 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3616 \u3634 \u3614 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 \u3607 \u3656 \u3637 \u3648 \u3629 \u3657 \u3639 \u3629 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3588 \u3656 \u3634 \u3609 \u3636 \u3618 \u3617 \u3649 \u3621 \u3632 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3611 \u3621 \u3641 \u3585 \u3613 \u3633 \u3591 \u3588 \u3640 \u3603 \u3608 \u3619 \u3619 \u3617  \u3592 \u3619 \u3636 \u3618 \u3608 \u3619 \u3619 \u3617  \u3648 \u3611 \u3655 \u3609 \u3626 \u3656 \u3623 \u3609 \u3627 \u3609 \u3638 \u3656 \u3591 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3588 \u3656 \u3634 \u3609 \u3636 \u3618 \u3617 \u3649 \u3621 \u3632 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617  \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3588 \u3609 \u3652 \u3607 \u3618 \u3617 \u3637 \u3588 \u3640 \u3603 \u3608 \u3619 \u3619 \u3617 \u3648 \u3611 \u3655 \u3609 \u3623 \u3636 \u3606 \u3637 \u3651 \u3609 \u3585 \u3634 \u3619 \u3604 \u3635 \u3648 \u3609 \u3636 \u3609 \u3594 \u3637 \u3623 \u3636 \u3605 </div></div>\
\
    <div class="qb"><div class="q">33. \uc0\u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3633 \u3585 \u3625 \u3632 \u3607 \u3637 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3651 \u3609 \u3624 \u3605 \u3623 \u3619 \u3619 \u3625 \u3607 \u3637 \u3656  21 \u3648 \u3594 \u3656 \u3609  \u3585 \u3634 \u3619 \u3588 \u3636 \u3604 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660  \u3626 \u3633 \u3591 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3611 \u3633 \u3597 \u3627 \u3634 \u3607 \u3637 \u3656 \u3595 \u3633 \u3610 \u3595 \u3657 \u3629 \u3609  \u3588 \u3623 \u3619 \u3648 \u3609 \u3657 \u3609 \u3651 \u3609 \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3651 \u3604 \u3648 \u3611 \u3655 \u3609 \u3614 \u3636 \u3648 \u3624 \u3625 </div>\
    <div class="c">\uc0\u3585 . \u3594 \u3656 \u3623 \u3591 \u3585 \u3634 \u3619 \u3605 \u3633 \u3657 \u3591 \u3588 \u3619 \u3619 \u3616 \u3660 /\u3611 \u3600 \u3617 \u3623 \u3633 \u3618 <br>\u3586 . \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3648 \u3619 \u3637 \u3618 \u3609 /\u3623 \u3633 \u3618 \u3619 \u3640 \u3656 \u3609 <br>\u3588 . \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 <br>\u3591 . \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3648 \u3619 \u3637 \u3618 \u3609 /\u3623 \u3633 \u3618 \u3619 \u3640 \u3656 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3648 \u3619 \u3637 \u3618 \u3609 /\u3623 \u3633 \u3618 \u3619 \u3640 \u3656 \u3609 \u3648 \u3611 \u3655 \u3609 \u3594 \u3656 \u3623 \u3591 \u3626 \u3635 \u3588 \u3633 \u3597 \u3651 \u3609 \u3585 \u3634 \u3619 \u3611 \u3621 \u3641 \u3585 \u3613 \u3633 \u3591 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3633 \u3585 \u3625 \u3632 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3607 \u3637 \u3656 \u3626 \u3629 \u3604 \u3619 \u3633 \u3610 \u3585 \u3633 \u3610 \u3607 \u3633 \u3585 \u3625 \u3632 \u3651 \u3609 \u3624 \u3605 \u3623 \u3619 \u3619 \u3625 \u3607 \u3656 \u3637  21 \u3648 \u3614 \u3656 \u3639 \u3629 \u3623 \u3634 \u3591 \u3619 \u3634 \u3585 \u3600 \u3634 \u3609 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3651 \u3609 \u3629 \u3609 \u3634 \u3588 \u3605 </div></div>\
\
    <div class="qb"><div class="q">34. \uc0\u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3610 \u3607 \u3610 \u3634 \u3607 \u3588 \u3619 \u3641 \u3592 \u3634 \u3585  \'93\u3588 \u3619 \u3641 \u3626 \u3629 \u3609 \'94 \u3648 \u3611 \u3655 \u3609  \'93\u3650 \u3588 \u3657 \u3594 \'94 \u3627 \u3619 \u3639 \u3629  \'93\u3612 \u3641 \u3657 \u3629 \u3635 \u3609 \u3623 \u3618 \u3585 \u3634 \u3619 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \'94 \u3648 \u3611 \u3655 \u3609 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3607 \u3637 \u3656 \u3605 \u3629 \u3610 \u3626 \u3609 \u3629 \u3591 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3651 \u3609 \u3624 \u3605 \u3623 \u3619 \u3619 \u3625 \u3607 \u3637 \u3656  21<br>\u3586 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3588 \u3609 \u3605 \u3621 \u3629 \u3604 \u3594 \u3656 \u3623 \u3591 \u3594 \u3637 \u3623 \u3636 \u3605 <br>\u3588 . \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3588 \u3656 \u3634 \u3609 \u3636 \u3618 \u3617 \u3649 \u3621 \u3632 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617 <br>\u3591 . \u3585 \u3634 \u3619 \u3605 \u3619 \u3632 \u3627 \u3609 \u3633 \u3585 \u3606 \u3638 \u3591 \u3614 \u3627 \u3640 \u3611 \u3633 \u3597 \u3597 \u3634 \u3586 \u3629 \u3591 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 \u3607 \u3637 \u3656 \u3627 \u3621 \u3634 \u3585 \u3627 \u3621 \u3634 \u3618 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3607 \u3637 \u3656 \u3605 \u3629 \u3610 \u3626 \u3609 \u3629 \u3591 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3651 \u3609 \u3624 \u3605 \u3623 \u3619 \u3619 \u3625 \u3607 \u3637 \u3656  21</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3650 \u3593 \u3617 \u3610 \u3607 \u3610 \u3634 \u3607 \u3588 \u3619 \u3641 \u3648 \u3611 \u3655 \u3609  "\u3650 \u3588 \u3657 \u3594 " \u3648 \u3611 \u3655 \u3609 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3626 \u3635 \u3588 \u3633 \u3597 \u3651 \u3609 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657  \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3609 \u3657 \u3609 \u3651 \u3627 \u3657 \u3612 \u3641 \u3657 \u3648 \u3619 \u3637 \u3618 \u3609 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3649 \u3621 \u3632 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3652 \u3604 \u3657 \u3604 \u3657 \u3623 \u3618 \u3605 \u3609 \u3648 \u3629 \u3591 </div></div>\
\
    <div class="qb"><div class="q">35. \uc0\u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3648 \u3607 \u3637 \u3618 \u3610 \u3650 \u3629 \u3609 \u3611 \u3619 \u3632 \u3626 \u3610 \u3585 \u3634 \u3619 \u3603 \u3660 \u3649 \u3621 \u3632 \u3608 \u3609 \u3634 \u3588 \u3634 \u3619 \u3627 \u3609 \u3656 \u3623 \u3618 \u3585 \u3636 \u3605  \u3648 \u3611 \u3655 \u3609 \u3585 \u3621 \u3652 \u3585 \u3626 \u3635 \u3588 \u3633 \u3597 \u3651 \u3609 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3605 \u3621 \u3629 \u3604 \u3594 \u3637 \u3623 \u3636 \u3605 <br>\u3586 . \u3585 \u3634 \u3619 \u3648 \u3614 \u3656 \u3636 \u3617 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 \u3619 \u3632 \u3610 \u3610 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 <br>\u3588 . \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3650 \u3593 \u3617 \u3610 \u3607 \u3610 \u3634 \u3607 \u3588 \u3619 \u3641 <br>\u3591 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 \u3648 \u3614 \u3656 \u3639 \u3629 \u3648 \u3611 \u3655 \u3609 \u3648 \u3621 \u3636 \u3624 \u3607 \u3634 \u3591 \u3623 \u3636 \u3594 \u3634 \u3585 \u3634 \u3619 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3605 \u3621 \u3629 \u3604 \u3594 \u3637 \u3623 \u3636 \u3605 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3619 \u3632 \u3610 \u3610 \u3648 \u3607 \u3637 \u3618 \u3610 \u3650 \u3629 \u3609 \u3611 \u3619 \u3632 \u3626 \u3610 \u3585 \u3634 \u3619 \u3603 \u3660 \u3649 \u3621 \u3632 \u3608 \u3609 \u3634 \u3588 \u3634 \u3619 \u3627 \u3609 \u3656 \u3623 \u3618 \u3585 \u3636 \u3605 \u3648 \u3611 \u3655 \u3609 \u3585 \u3621 \u3652 \u3585 \u3607 \u3637 \u3656 \u3594 \u3656 \u3623 \u3618 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3605 \u3621 \u3629 \u3604 \u3594 \u3637 \u3623 \u3636 \u3605  \u3607 \u3635 \u3651 \u3627 \u3657 \u3588 \u3609 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3633 \u3585 \u3625 \u3632 \u3588 \u3623 \u3634 \u3617 \u3619 \u3641 \u3657 \u3652 \u3604 \u3657 \u3649 \u3617 \u3657 \u3592 \u3632 \u3629 \u3629 \u3585 \u3592 \u3634 \u3585 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 \u3652 \u3611 \u3649 \u3621 \u3657 \u3623 </div></div>\
\
    <div class="qb"><div class="q">36. \uc0\u3585 \u3634 \u3619 \u3605 \u3619 \u3632 \u3627 \u3609 \u3633 \u3585 \u3606 \u3638 \u3591 \u3614 \u3627 \u3640 \u3611 \u3633 \u3597 \u3597 \u3634 \u3586 \u3629 \u3591 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 \u3607 \u3637 \u3656 \u3627 \u3621 \u3634 \u3585 \u3627 \u3621 \u3634 \u3618  \u3627 \u3617 \u3634 \u3618 \u3606 \u3638 \u3591 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3618 \u3629 \u3617 \u3619 \u3633 \u3610 \u3623 \u3656 \u3634 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3607 \u3637 \u3656 \u3650 \u3604 \u3604 \u3648 \u3604 \u3656 \u3609 \u3649 \u3605 \u3585 \u3605 \u3656 \u3634 \u3591 \u3585 \u3633 \u3609 \u3651 \u3609 \u3627 \u3621 \u3634 \u3618 \u3604 \u3657 \u3634 \u3609  \u3648 \u3594 \u3656 \u3609  \u3616 \u3634 \u3625 \u3634  \u3604 \u3609 \u3605 \u3619 \u3637  \u3585 \u3637 \u3628 \u3634 <br>\u3586 . \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3609 \u3633 \u3585 \u3648 \u3619 \u3637 \u3618 \u3609 \u3648 \u3619 \u3637 \u3618 \u3609 \u3607 \u3640 \u3585 \u3623 \u3636 \u3594 \u3634 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3607 \u3656 \u3634 \u3648 \u3607 \u3637 \u3618 \u3617 \u3585 \u3633 \u3609 <br>\u3588 . \u3585 \u3634 \u3619 \u3648 \u3609 \u3657 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3593 \u3614 \u3634 \u3632 \u3612 \u3641 \u3657 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3614 \u3636 \u3648 \u3624 \u3625 <br>\u3591 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 \u3607 \u3656 \u3637 \u3648 \u3609 \u3657 \u3609 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3648 \u3621 \u3636 \u3624 \u3607 \u3634 \u3591 \u3623 \u3636 \u3594 \u3634 \u3585 \u3634 \u3619 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3634 \u3619 \u3618 \u3629 \u3617 \u3619 \u3633 \u3610 \u3623 \u3656 \u3634 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3607 \u3637 \u3656 \u3650 \u3604 \u3604 \u3648 \u3604 \u3656 \u3609 \u3649 \u3605 \u3585 \u3605 \u3656 \u3634 \u3591 \u3585 \u3633 \u3609 \u3651 \u3609 \u3627 \u3621 \u3634 \u3618 \u3604 \u3657 \u3634 \u3609  \u3648 \u3594 \u3656 \u3609  \u3616 \u3634 \u3625 \u3634  \u3604 \u3609 \u3605 \u3619 \u3637  \u3585 \u3637 \u3628 \u3634 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3614 \u3627 \u3640 \u3611 \u3633 \u3597 \u3597 \u3634 \u3588 \u3639 \u3629 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3607 \u3637 \u3656 \u3623 \u3656 \u3634 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3607 \u3637 \u3656 \u3627 \u3621 \u3634 \u3585 \u3627 \u3621 \u3634 \u3618 \u3649 \u3621 \u3632 \u3650 \u3604 \u3604 \u3648 \u3604 \u3656 \u3609 \u3649 \u3605 \u3585 \u3605 \u3656 \u3634 \u3591 \u3585 \u3633 \u3609 \u3652 \u3611 \u3651 \u3609 \u3649 \u3605 \u3656 \u3621 \u3632 \u3610 \u3640 \u3588 \u3588 \u3621  \u3595 \u3638 \u3656 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3617 \u3640 \u3656 \u3591 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3605 \u3634 \u3617 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3609 \u3633 \u3657 \u3609 \u3654 </div></div>\
\
    <div class="qb"><div class="q">37. \uc0\u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3619 \u3629 \u3610 \u3619 \u3641 \u3657 \u3604 \u3657 \u3634 \u3609 \u3626 \u3640 \u3586 \u3616 \u3634 \u3623 \u3632  (Health Literacy) \u3617 \u3637 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3617 \u3637 \u3621 \u3633 \u3585 \u3625 \u3603 \u3632 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3617 \u3637 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3651 \u3609 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3626 \u3640 \u3586 \u3616 \u3634 \u3623 \u3632 \u3607 \u3637 \u3656 \u3604 \u3637 \u3652 \u3604 \u3657 \u3604 \u3657 \u3623 \u3618 \u3605 \u3609 \u3648 \u3629 \u3591 <br>\u3586 . \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3607 \u3633 \u3656 \u3623 \u3606 \u3638 \u3591 <br>\u3588 . \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3619 \u3641 \u3657 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3650 \u3619 \u3588 \u3616 \u3633 \u3618 \u3652 \u3586 \u3657 \u3648 \u3592 \u3655 \u3610 \u3605 \u3656 \u3634 \u3591 \u3654  \u3648 \u3611 \u3655 \u3609 \u3629 \u3618 \u3656 \u3634 \u3591 \u3604 \u3637 <br>\u3591 . \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3605 \u3634 \u3617 \u3588 \u3635 \u3649 \u3609 \u3632 \u3609 \u3635 \u3586 \u3629 \u3591 \u3649 \u3614 \u3607 \u3618 \u3660 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3588 \u3619 \u3656 \u3591 \u3588 \u3619 \u3633 \u3604 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3617 \u3637 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3651 \u3609 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3626 \u3640 \u3586 \u3616 \u3634 \u3623 \u3632 \u3607 \u3637 \u3656 \u3604 \u3637 \u3652 \u3604 \u3657 \u3604 \u3657 \u3623 \u3618 \u3605 \u3609 \u3648 \u3629 \u3591 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3588 \u3623 \u3634 \u3617 \u3619 \u3629 \u3610 \u3619 \u3641 \u3657 \u3604 \u3657 \u3634 \u3609 \u3626 \u3640 \u3586 \u3616 \u3634 \u3623 \u3632  (Health Literacy) \u3588 \u3639 \u3629 \u3607 \u3633 \u3585 \u3625 \u3632 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3586 \u3629 \u3591 \u3610 \u3640 \u3588 \u3588 \u3621 \u3651 \u3609 \u3585 \u3634 \u3619 \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591  \u3607 \u3635 \u3588 \u3623 \u3634 \u3617 \u3648 \u3586 \u3657 \u3634 \u3651 \u3592  \u3649 \u3621 \u3632 \u3651 \u3594 \u3657 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3648 \u3614 \u3639 \u3656 \u3629 \u3585 \u3634 \u3619 \u3605 \u3633 \u3604 \u3626 \u3636 \u3609 \u3651 \u3592 \u3604 \u3657 \u3634 \u3609 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614  \u3595 \u3638 \u3656 \u3591 \u3609 \u3635 \u3652 \u3611 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3626 \u3640 \u3586 \u3616 \u3634 \u3623 \u3632 \u3586 \u3629 \u3591 \u3605 \u3609 \u3648 \u3629 \u3591 \u3652 \u3604 \u3657 </div></div>\
\
    <div class="qb"><div class="q">38. \uc0\u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3648 \u3585 \u3636 \u3604 \u3629 \u3618 \u3656 \u3634 \u3591 \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614  \u3648 \u3611 \u3655 \u3609 \u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3619 \u3634 \u3585 \u3600 \u3634 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 \u3651 \u3609 \u3594 \u3656 \u3623 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3594 \u3656 \u3623 \u3591 \u3585 \u3634 \u3619 \u3605 \u3633 \u3657 \u3591 \u3588 \u3619 \u3619 \u3616 \u3660 /\u3611 \u3600 \u3617 \u3623 \u3633 \u3618 <br>\u3586 . \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3648 \u3619 \u3637 \u3618 \u3609 <br>\u3588 . \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3619 \u3640 \u3656 \u3609 <br>\u3591 . \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3594 \u3656 \u3623 \u3591 \u3585 \u3634 \u3619 \u3605 \u3633 \u3657 \u3591 \u3588 \u3619 \u3619 \u3616 \u3660 /\u3611 \u3600 \u3617 \u3623 \u3633 \u3618 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3588 \u3609 \u3648 \u3619 \u3636 \u3656 \u3617 \u3605 \u3657 \u3609 \u3605 \u3633 \u3657 \u3591 \u3649 \u3605 \u3656 \u3594 \u3656 \u3623 \u3591 \u3585 \u3634 \u3619 \u3605 \u3633 \u3657 \u3591 \u3588 \u3619 \u3619 \u3616 \u3660 \u3649 \u3621 \u3632 \u3611 \u3600 \u3617 \u3623 \u3633 \u3618  \u3650 \u3604 \u3618 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3648 \u3605 \u3619 \u3637 \u3618 \u3617 \u3588 \u3623 \u3634 \u3617 \u3614 \u3619 \u3657 \u3629 \u3617 \u3586 \u3629 \u3591 \u3614 \u3656 \u3629 \u3649 \u3617 \u3656  \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3629 \u3609 \u3634 \u3617 \u3633 \u3618 \u3649 \u3617 \u3656 \u3649 \u3621 \u3632 \u3648 \u3604 \u3655 \u3585  \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3648 \u3604 \u3655 \u3585 \u3617 \u3637 \u3614 \u3633 \u3602 \u3609 \u3634 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3626 \u3617 \u3623 \u3633 \u3618 </div></div>\
\
    <div class="qb"><div class="q">39. \uc0\u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3637 \u3628 \u3634 \u3648 \u3614 \u3656 \u3639 \u3629 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3648 \u3621 \u3636 \u3624 \u3649 \u3621 \u3632 \u3585 \u3637 \u3628 \u3634 \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3634 \u3619 \u3629 \u3634 \u3594 \u3637 \u3614  \u3592 \u3633 \u3604 \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3585 \u3634 \u3619 \u3585 \u3637 \u3628 \u3634 \u3651 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3640 \u3603 \u3588 \u3656 \u3634 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3586 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3616 \u3634 \u3614 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 \u3607 \u3656 \u3637 \u3648 \u3629 \u3657 \u3639 \u3629 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 <br>\u3588 . \u3585 \u3634 \u3619 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3651 \u3627 \u3657 \u3588 \u3609 \u3652 \u3607 \u3618 \u3617 \u3637 \u3626 \u3640 \u3586 \u3616 \u3634 \u3623 \u3632 \u3607 \u3637 \u3656 \u3604 \u3637 <br>\u3591 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3588 \u3609 \u3605 \u3621 \u3629 \u3604 \u3594 \u3656 \u3623 \u3591 \u3594 \u3637 \u3623 \u3636 \u3605 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3634 \u3619 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3585 \u3634 \u3619 \u3585 \u3637 \u3628 \u3634 \u3651 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3640 \u3603 \u3588 \u3656 \u3634 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3633 \u3585 \u3625 \u3632 \u3604 \u3657 \u3634 \u3609 \u3585 \u3637 \u3628 \u3634 \u3626 \u3641 \u3656 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3648 \u3621 \u3636 \u3624 \u3649 \u3621 \u3632 \u3585 \u3637 \u3628 \u3634 \u3648 \u3614 \u3639 \u3656 \u3629 \u3585 \u3634 \u3619 \u3629 \u3634 \u3594 \u3637 \u3614 \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3650 \u3604 \u3618 \u3605 \u3619 \u3591 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3633 \u3623 \u3586 \u3657 \u3629 \u3585 \u3634 \u3619 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3585 \u3634 \u3619 \u3585 \u3637 \u3628 \u3634 \u3631 </div></div>\
\
    <div class="qb"><div class="q">40. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3648 \u3611 \u3655 \u3609 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3650 \u3629 \u3585 \u3634 \u3626 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 </div>\
    <div class="c">\uc0\u3585 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617  \u3649 \u3621 \u3632 \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3627 \u3621 \u3639 \u3656 \u3629 \u3617 \u3621 \u3657 \u3635 \u3651 \u3609 \u3607 \u3640 \u3585 \u3617 \u3636 \u3605 \u3636 <br>\u3586 . \u3607 \u3635 \u3651 \u3627 \u3657 \u3588 \u3609 \u3592 \u3609 \u3627 \u3617 \u3604 \u3652 \u3611 \u3592 \u3634 \u3585 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 <br>\u3588 . \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3607 \u3640 \u3585 \u3588 \u3609 \u3617 \u3637 \u3607 \u3637 \u3656 \u3604 \u3636 \u3609 \u3607 \u3635 \u3585 \u3636 \u3609 \u3648 \u3611 \u3655 \u3609 \u3586 \u3629 \u3591 \u3605 \u3609 \u3648 \u3629 \u3591 <br>\u3591 . \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 \u3607 \u3640 \u3585 \u3588 \u3609 \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 \u3588 \u3656 \u3634 \u3592 \u3657 \u3634 \u3591 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617  \u3649 \u3621 \u3632 \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3627 \u3621 \u3639 \u3656 \u3629 \u3617 \u3621 \u3657 \u3635 \u3651 \u3609 \u3607 \u3640 \u3585 \u3617 \u3636 \u3605 \u3636 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3627 \u3621 \u3633 \u3585 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3609 \u3637 \u3657 \u3588 \u3639 \u3629 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617  \u3649 \u3621 \u3632 \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3627 \u3621 \u3639 \u3656 \u3629 \u3617 \u3621 \u3657 \u3635 \u3651 \u3609 \u3607 \u3640 \u3585 \u3617 \u3636 \u3605 \u3636  \u3607 \u3633 \u3657 \u3591 \u3607 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3626 \u3633 \u3591 \u3588 \u3617 </div></div>\
\
    <div class="qb"><div class="q">41. \uc0\u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3619 \u3632 \u3610 \u3610 \u3616 \u3634 \u3625 \u3637 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3588 \u3640 \u3657 \u3617 \u3588 \u3619 \u3629 \u3591 \u3612 \u3641 \u3657 \u3610 \u3619 \u3636 \u3650 \u3616 \u3588  \u3617 \u3637 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3648 \u3614 \u3656 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588 \u3649 \u3621 \u3632 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617 <br>\u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3648 \u3614 \u3656 \u3636 \u3617 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3651 \u3627 \u3657 \u3585 \u3633 \u3610 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 <br>\u3588 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3621 \u3604 \u3616 \u3634 \u3619 \u3632 \u3588 \u3656 \u3634 \u3651 \u3594 \u3657 \u3592 \u3656 \u3634 \u3618 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 <br>\u3591 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588 \u3649 \u3621 \u3632 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3619 \u3632 \u3610 \u3610 \u3616 \u3634 \u3625 \u3637 \u3617 \u3637 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588 \u3651 \u3609 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3648 \u3585 \u3655 \u3610 \u3649 \u3621 \u3632 \u3609 \u3635 \u3652 \u3611 \u3651 \u3594 \u3657 \u3592 \u3633 \u3604 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619  \u3626 \u3656 \u3623 \u3609 \u3585 \u3634 \u3619 \u3588 \u3640 \u3657 \u3617 \u3588 \u3619 \u3629 \u3591 \u3612 \u3641 \u3657 \u3610 \u3619 \u3636 \u3650 \u3616 \u3588 \u3585 \u3655 \u3648 \u3614 \u3656 \u3639 \u3629 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3585 \u3634 \u3619 \u3606 \u3641 \u3585 \u3648 \u3629 \u3634 \u3648 \u3611 \u3619 \u3637 \u3618 \u3610  \u3595 \u3638 \u3656 \u3591 \u3621 \u3657 \u3623 \u3609 \u3648 \u3611 \u3655 \u3609 \u3652 \u3611 \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617 </div></div>\
\
    <div class="qb"><div class="q">42. \uc0\u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3592 \u3634 \u3618 \u3585 \u3634 \u3619 \u3606 \u3639 \u3629 \u3588 \u3619 \u3629 \u3591 \u3607 \u3637 \u3656 \u3604 \u3636 \u3609 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619  \u3648 \u3611 \u3655 \u3609 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3651 \u3604 \u3650 \u3604 \u3618 \u3605 \u3619 \u3591 </div>\
    <div class="c">\uc0\u3585 . \u3611 \u3633 \u3597 \u3627 \u3634 \u3588 \u3623 \u3634 \u3617 \u3648 \u3627 \u3621 \u3639 \u3656 \u3629 \u3617 \u3621 \u3657 \u3635 <br>\u3586 . \u3611 \u3633 \u3597 \u3627 \u3634 \u3627 \u3609 \u3637 \u3657 \u3626 \u3636 \u3609 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 <br>\u3588 . \u3611 \u3633 \u3597 \u3627 \u3634 \u3585 \u3634 \u3619 \u3610 \u3640 \u3585 \u3619 \u3640 \u3585 \u3611 \u3656 \u3634 <br>\u3591 . \u3611 \u3633 \u3597 \u3627 \u3634 \u3585 \u3634 \u3619 \u3623 \u3656 \u3634 \u3591 \u3591 \u3634 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3611 \u3633 \u3597 \u3627 \u3634 \u3588 \u3623 \u3634 \u3617 \u3648 \u3627 \u3621 \u3639 \u3656 \u3629 \u3617 \u3621 \u3657 \u3635 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3592 \u3634 \u3618 \u3585 \u3634 \u3619 \u3606 \u3639 \u3629 \u3588 \u3619 \u3629 \u3591 \u3607 \u3637 \u3656 \u3604 \u3636 \u3609 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617 \u3648 \u3611 \u3655 \u3609 \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3588 \u3623 \u3634 \u3617 \u3648 \u3627 \u3621 \u3639 \u3656 \u3629 \u3617 \u3621 \u3657 \u3635 \u3651 \u3609 \u3585 \u3634 \u3619 \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619  \u3595 \u3638 \u3656 \u3591 \u3648 \u3611 \u3655 \u3609 \u3619 \u3634 \u3585 \u3600 \u3634 \u3609 \u3586 \u3629 \u3591 \u3611 \u3633 \u3597 \u3627 \u3634 \u3629 \u3639 \u3656 \u3609 \u3654 </div></div>\
\
    <div class="qb"><div class="q">43. \uc0\u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3627 \u3621 \u3633 \u3585 \u3611 \u3619 \u3632 \u3585 \u3633 \u3609 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 \u3607 \u3637 \u3656 \u3588 \u3619 \u3629 \u3610 \u3588 \u3621 \u3640 \u3617 \u3588 \u3609 \u3607 \u3640 \u3585 \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618  \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3636 \u3656 \u3591 \u3648 \u3614 \u3639 \u3656 \u3629 \u3619 \u3629 \u3591 \u3619 \u3633 \u3610 \u3626 \u3633 \u3591 \u3588 \u3617 \u3621 \u3633 \u3585 \u3625 \u3603 \u3632 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3626 \u3633 \u3591 \u3588 \u3617 \u3626 \u3641 \u3591 \u3623 \u3633 \u3618 <br>\u3586 . \u3626 \u3633 \u3591 \u3588 \u3617 \u3648 \u3617 \u3639 \u3629 \u3591 <br>\u3588 . \u3626 \u3633 \u3591 \u3588 \u3617 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 <br>\u3591 . \u3626 \u3633 \u3591 \u3588 \u3617 \u3614 \u3627 \u3640 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3626 \u3633 \u3591 \u3588 \u3617 \u3626 \u3641 \u3591 \u3623 \u3633 \u3618 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3617 \u3639 \u3656 \u3629 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3648 \u3586 \u3657 \u3634 \u3626 \u3641 \u3656 \u3626 \u3633 \u3591 \u3588 \u3617 \u3626 \u3641 \u3591 \u3623 \u3633 \u3618 \u3629 \u3618 \u3656 \u3634 \u3591 \u3626 \u3617 \u3610 \u3641 \u3619 \u3603 \u3660  \u3592 \u3632 \u3617 \u3637 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 \u3648 \u3614 \u3636 \u3656 \u3617 \u3586 \u3638 \u3657 \u3609 \u3592 \u3635 \u3609 \u3623 \u3609 \u3617 \u3634 \u3585  \u3627 \u3621 \u3633 \u3585 \u3611 \u3619 \u3632 \u3585 \u3633 \u3609 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 \u3607 \u3656 \u3637 \u3588 \u3619 \u3629 \u3610 \u3588 \u3621 \u3640 \u3617 \u3592 \u3638 \u3591 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3636 \u3656 \u3591 \u3651 \u3609 \u3585 \u3634 \u3619 \u3604 \u3641 \u3649 \u3621 \u3611 \u3619 \u3632 \u3594 \u3634 \u3585 \u3619 \u3585 \u3621 \u3640 \u3656 \u3617 \u3609 \u3637 \u3657 </div></div>\
\
    <div class="qb"><div class="q">44. \uc0\u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3592 \u3634 \u3618 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3592 \u3619 \u3636 \u3597 \u3607 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592  \u3626 \u3633 \u3591 \u3588 \u3617  \u3649 \u3621 \u3632 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637  \u3617 \u3637 \u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3627 \u3621 \u3633 \u3585 \u3648 \u3614 \u3656 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3627 \u3621 \u3639 \u3656 \u3629 \u3617 \u3621 \u3657 \u3635 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3648 \u3617 \u3639 \u3629 \u3591 \u3627 \u3621 \u3633 \u3585 \u3585 \u3633 \u3610 \u3614 \u3639 \u3657 \u3609 \u3607 \u3656 \u3637 \u3629 \u3656 \u3639 \u3609  \u3649 \u3621 \u3632 \u3626 \u3619 \u3657 \u3634 \u3591 \u3591 \u3634 \u3609 \u3651 \u3609 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 <br>\u3586 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3648 \u3617 \u3639 \u3629 \u3591 \u3651 \u3627 \u3617 \u3656 \u3648 \u3614 \u3656 \u3639 \u3629 \u3619 \u3629 \u3591 \u3619 \u3633 \u3610 \u3585 \u3634 \u3619 \u3586 \u3618 \u3634 \u3618 \u3605 \u3633 \u3623 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3585 \u3619 <br>\u3588 . \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604 <br>\u3591 . \u3648 \u3614 \u3656 \u3636 \u3617 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3626 \u3656 \u3623 \u3609 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3627 \u3621 \u3639 \u3656 \u3629 \u3617 \u3621 \u3657 \u3635 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3648 \u3617 \u3639 \u3629 \u3591 \u3627 \u3621 \u3633 \u3585 \u3585 \u3633 \u3610 \u3614 \u3639 \u3657 \u3609 \u3607 \u3656 \u3637 \u3629 \u3656 \u3639 \u3609  \u3649 \u3621 \u3632 \u3626 \u3619 \u3657 \u3634 \u3591 \u3591 \u3634 \u3609 \u3651 \u3609 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3592 \u3634 \u3618 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3592 \u3619 \u3636 \u3597 \u3617 \u3637 \u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3648 \u3614 \u3639 \u3656 \u3629 \u3621 \u3604 \u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3592 \u3640 \u3585 \u3605 \u3633 \u3623 \u3586 \u3629 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3592 \u3619 \u3636 \u3597 \u3651 \u3609 \u3648 \u3617 \u3639 \u3629 \u3591 \u3651 \u3627 \u3597 \u3656  \u3585 \u3619 \u3632 \u3592 \u3634 \u3618 \u3650 \u3629 \u3585 \u3634 \u3626 \u3607 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3626 \u3633 \u3591 \u3588 \u3617 \u3652 \u3611 \u3626 \u3641 \u3656 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588  \u3649 \u3621 \u3632 \u3626 \u3619 \u3657 \u3634 \u3591 \u3591 \u3634 \u3609 \u3651 \u3609 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 </div></div>\
\
    <div class="qb"><div class="q">45. \uc0\u3585 \u3634 \u3619 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3614 \u3621 \u3633 \u3591 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 \u3605 \u3634 \u3617 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636  \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3604 \u3638 \u3591 \u3614 \u3621 \u3633 \u3591 \u3586 \u3629 \u3591 \u3585 \u3621 \u3640 \u3656 \u3617 \u3588 \u3609 \u3623 \u3633 \u3618 \u3651 \u3604 \u3617 \u3634 \u3619 \u3656 \u3623 \u3617 \u3614 \u3633 \u3602 \u3609 \u3634 </div>\
    <div class="c">\uc0\u3585 . \u3588 \u3609 \u3626 \u3634 \u3617 \u3623 \u3633 \u3618  \u3588 \u3639 \u3629  \u3648 \u3618 \u3634 \u3623 \u3594 \u3609  \u3588 \u3609 \u3623 \u3633 \u3618 \u3607 \u3635 \u3591 \u3634 \u3609  \u3649 \u3621 \u3632 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 <br>\u3586 . \u3648 \u3593 \u3614 \u3634 \u3632 \u3585 \u3621 \u3640 \u3656 \u3617 \u3648 \u3618 \u3634 \u3623 \u3594 \u3609 \u3588 \u3609 \u3619 \u3640 \u3656 \u3609 \u3651 \u3627 \u3617 \u3656 <br>\u3588 . \u3648 \u3593 \u3614 \u3634 \u3632 \u3585 \u3621 \u3640 \u3656 \u3617 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 \u3607 \u3637 \u3656 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3610 \u3585 \u3634 \u3619 \u3603 \u3660 <br>\u3591 . \u3648 \u3593 \u3614 \u3634 \u3632 \u3585 \u3621 \u3640 \u3656 \u3617 \u3588 \u3609 \u3623 \u3633 \u3618 \u3607 \u3635 \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3585 \u3635 \u3621 \u3633 \u3591 \u3627 \u3621 \u3633 \u3585 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3588 \u3609 \u3626 \u3634 \u3617 \u3623 \u3633 \u3618  \u3588 \u3639 \u3629  \u3648 \u3618 \u3634 \u3623 \u3594 \u3609  \u3588 \u3609 \u3623 \u3633 \u3618 \u3607 \u3635 \u3591 \u3634 \u3609  \u3649 \u3621 \u3632 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3614 \u3621 \u3633 \u3591 \u3586 \u3629 \u3591 \u3588 \u3609 \u3626 \u3634 \u3617 \u3623 \u3633 \u3618  \u3588 \u3639 \u3629  \u3648 \u3618 \u3634 \u3623 \u3594 \u3609  \u3588 \u3609 \u3623 \u3633 \u3618 \u3607 \u3635 \u3591 \u3634 \u3609  \u3649 \u3621 \u3632 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640  \u3651 \u3627 \u3657 \u3617 \u3634 \u3648 \u3611 \u3655 \u3609 \u3585 \u3635 \u3621 \u3633 \u3591 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3656 \u3623 \u3617 \u3585 \u3633 \u3609 </div></div>\
\
    <div class="qb"><div class="q">46. \uc0\u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3633 \u3591 \u3588 \u3617  (Social Enterprise) \u3648 \u3611 \u3655 \u3609 \u3626 \u3656 \u3623 \u3609 \u3627 \u3609 \u3638 \u3656 \u3591 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3614 \u3621 \u3633 \u3591 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 <br>\u3586 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3627 \u3621 \u3639 \u3656 \u3629 \u3617 \u3621 \u3657 \u3635  \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617 <br>\u3588 . \u3585 \u3634 \u3619 \u3648 \u3614 \u3656 \u3636 \u3617 \u3586 \u3637 \u3604 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3586 \u3629 \u3591 \u3594 \u3640 \u3617 \u3594 \u3609 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609 <br>\u3591 . \u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3592 \u3634 \u3618 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3592 \u3619 \u3636 \u3597 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3634 \u3619 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3614 \u3621 \u3633 \u3591 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3648 \u3614 \u3639 \u3656 \u3629 \u3626 \u3633 \u3591 \u3588 \u3617 \u3648 \u3611 \u3655 \u3609 \u3585 \u3621 \u3652 \u3585 \u3627 \u3609 \u3638 \u3656 \u3591 \u3651 \u3609 \u3585 \u3634 \u3619 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3614 \u3621 \u3633 \u3591 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 \u3651 \u3627 \u3657 \u3648 \u3586 \u3657 \u3634 \u3617 \u3634 \u3617 \u3637 \u3626 \u3656 \u3623 \u3609 \u3619 \u3656 \u3623 \u3617 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div></div>\
\
    <div class="qb"><div class="q">47. \uc0\u3585 \u3634 \u3619 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3586 \u3629 \u3591 \u3594 \u3640 \u3617 \u3594 \u3609 \u3651 \u3609 \u3585 \u3634 \u3619 \u3614 \u3656 \u3638 \u3591 \u3605 \u3609 \u3648 \u3629 \u3591 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3614 \u3656 \u3638 \u3591 \u3614 \u3634 \u3585 \u3633 \u3609 \u3648 \u3629 \u3591  \u3626 \u3629 \u3604 \u3588 \u3621 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3627 \u3621 \u3633 \u3585 \u3611 \u3619 \u3633 \u3594 \u3597 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3627 \u3621 \u3633 \u3585 \u3611 \u3619 \u3633 \u3594 \u3597 \u3634 \u3586 \u3629 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3629 \u3648 \u3614 \u3637 \u3618 \u3591 <br>\u3586 . \u3627 \u3621 \u3633 \u3585 \u3608 \u3619 \u3619 \u3617 \u3634 \u3616 \u3636 \u3610 \u3634 \u3621 <br>\u3588 . \u3627 \u3621 \u3633 \u3585 \u3611 \u3619 \u3632 \u3594 \u3634 \u3619 \u3633 \u3600 <br>\u3591 . \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3627 \u3621 \u3633 \u3585 \u3611 \u3619 \u3633 \u3594 \u3597 \u3634 \u3586 \u3629 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3629 \u3648 \u3614 \u3637 \u3618 \u3591 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3614 \u3656 \u3638 \u3591 \u3605 \u3609 \u3648 \u3629 \u3591 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3614 \u3638 \u3656 \u3591 \u3614 \u3634 \u3585 \u3633 \u3609 \u3648 \u3629 \u3591 \u3648 \u3611 \u3655 \u3609 \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3611 \u3619 \u3633 \u3594 \u3597 \u3634 \u3586 \u3629 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3629 \u3648 \u3614 \u3637 \u3618 \u3591  \u3595 \u3638 \u3656 \u3591 \u3617 \u3640 \u3656 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3586 \u3657 \u3617 \u3649 \u3586 \u3655 \u3591 \u3592 \u3634 \u3585 \u3616 \u3634 \u3618 \u3651 \u3609 \u3594 \u3640 \u3617 \u3594 \u3609 </div></div>\
\
    <div class="qb"><div class="q">48. \uc0\u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3607 \u3635  "\u3649 \u3612 \u3609 \u3649 \u3617 \u3656 \u3610 \u3607 \u3594 \u3640 \u3617 \u3594 \u3609 " \u3617 \u3637 \u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3626 \u3636 \u3656 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3626 \u3632 \u3607 \u3657 \u3629 \u3609 \u3611 \u3633 \u3597 \u3627 \u3634 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3649 \u3607 \u3657 \u3592 \u3619 \u3636 \u3591 \u3586 \u3629 \u3591 \u3594 \u3640 \u3617 \u3594 \u3609 <br>\u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3594 \u3640 \u3617 \u3594 \u3609 \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3650 \u3604 \u3618 \u3605 \u3619 \u3591 \u3592 \u3634 \u3585 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 <br>\u3588 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3594 \u3657 \u3648 \u3611 \u3655 \u3609 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3651 \u3609 \u3585 \u3634 \u3619 \u3605 \u3656 \u3629 \u3619 \u3629 \u3591 \u3585 \u3633 \u3610 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 <br>\u3591 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3612 \u3641 \u3657 \u3609 \u3635 \u3594 \u3640 \u3617 \u3594 \u3609 \u3619 \u3640 \u3656 \u3609 \u3651 \u3627 \u3617 \u3656 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3626 \u3632 \u3607 \u3657 \u3629 \u3609 \u3611 \u3633 \u3597 \u3627 \u3634 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3649 \u3607 \u3657 \u3592 \u3619 \u3636 \u3591 \u3586 \u3629 \u3591 \u3594 \u3640 \u3617 \u3594 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3649 \u3612 \u3609 \u3649 \u3617 \u3656 \u3610 \u3607 \u3594 \u3640 \u3617 \u3594 \u3609 \u3592 \u3633 \u3604 \u3607 \u3635 \u3586 \u3638 \u3657 \u3609 \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3594 \u3640 \u3617 \u3594 \u3609 \u3652 \u3604 \u3657 \u3617 \u3637 \u3626 \u3656 \u3623 \u3609 \u3619 \u3656 \u3623 \u3617 \u3651 \u3609 \u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634  \u3649 \u3621 \u3632 \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3649 \u3612 \u3609 \u3609 \u3633 \u3657 \u3609 \u3626 \u3632 \u3607 \u3657 \u3629 \u3609 \u3611 \u3633 \u3597 \u3627 \u3634 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3649 \u3607 \u3657 \u3592 \u3619 \u3636 \u3591 \u3586 \u3629 \u3591 \u3588 \u3609 \u3651 \u3609 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 </div></div>\
\
    <div class="qb"><div class="q">49. \uc0\u3649 \u3609 \u3623 \u3588 \u3636 \u3604  "\u3648 \u3605 \u3636 \u3610 \u3650 \u3605  \u3626 \u3617 \u3604 \u3640 \u3621  \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 " \u3648 \u3611 \u3655 \u3609 \u3627 \u3633 \u3623 \u3651 \u3592 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3651 \u3609 \u3604 \u3657 \u3634 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3610 \u3609 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3594 \u3637 \u3623 \u3636 \u3605 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 <br>\u3586 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 <br>\u3588 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3650 \u3629 \u3585 \u3634 \u3626 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 <br>\u3591 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3626 \u3617 \u3604 \u3640 \u3621 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3610 \u3609 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3594 \u3637 \u3623 \u3636 \u3605 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3649 \u3609 \u3623 \u3588 \u3636 \u3604  \'93\u3648 \u3605 \u3636 \u3610 \u3650 \u3605  \u3626 \u3617 \u3604 \u3640 \u3621  \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \'94 \u3648 \u3611 \u3655 \u3609 \u3627 \u3633 \u3623 \u3651 \u3592 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3610 \u3609 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3594 \u3637 \u3623 \u3636 \u3605 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617  \u3595 \u3638 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592  \u3626 \u3633 \u3591 \u3588 \u3617  \u3649 \u3621 \u3632 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 \u3652 \u3611 \u3614 \u3619 \u3657 \u3629 \u3617 \u3654  \u3585 \u3633 \u3609 </div></div>\
\
    <div class="qb"><div class="q">50. \uc0\u3585 \u3634 \u3619 \u3648 \u3614 \u3636 \u3656 \u3617 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3586 \u3629 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3600 \u3634 \u3609 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614 \u3651 \u3627 \u3657 \u3626 \u3629 \u3604 \u3588 \u3621 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609  \u3648 \u3611 \u3655 \u3609 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3610 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3637 \u3648 \u3586 \u3637 \u3618 \u3623 <br>\u3586 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3610 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3616 \u3634 \u3588 \u3607 \u3632 \u3648 \u3621 <br>\u3588 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3610 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 \u3607 \u3656 \u3637 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3616 \u3634 \u3614 \u3616 \u3641 \u3617 \u3636 \u3629 \u3634 \u3585 \u3634 \u3624 <br>\u3591 . \u3614 \u3633 \u3602 \u3609 \u3634 \u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656 \u3648 \u3617 \u3639 \u3629 \u3591  \u3594 \u3609 \u3610 \u3607  \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3648 \u3594 \u3636 \u3591 \u3609 \u3636 \u3648 \u3623 \u3624 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3610 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3637 \u3648 \u3586 \u3637 \u3618 \u3623 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3610 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3637 \u3648 \u3586 \u3637 \u3618 \u3623  \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3610 \u3609 \u3600 \u3634 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636 \u3649 \u3621 \u3632 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 \u3607 \u3656 \u3637 \u3604 \u3637  \u3595 \u3638 \u3656 \u3591 \u3619 \u3623 \u3617 \u3606 \u3638 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3600 \u3634 \u3609 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614 </div></div>\
\
    <div class="qb"><div class="q">51. \uc0\u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619  3R (Reduce, Reuse, Recycle) \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3586 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3611 \u3633 \u3597 \u3627 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3611 \u3633 \u3597 \u3627 \u3634 \u3586 \u3618 \u3632 \u3649 \u3621 \u3632 \u3617 \u3621 \u3614 \u3636 \u3625 <br>\u3586 . \u3611 \u3633 \u3597 \u3627 \u3634 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 <br>\u3588 . \u3611 \u3633 \u3597 \u3627 \u3634 \u3585 \u3634 \u3619 \u3586 \u3634 \u3604 \u3649 \u3588 \u3621 \u3609 \u3609 \u3657 \u3635 <br>\u3591 . \u3611 \u3633 \u3597 \u3627 \u3634 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3626 \u3616 \u3634 \u3614 \u3616 \u3641 \u3617 \u3636 \u3629 \u3634 \u3585 \u3634 \u3624 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3611 \u3633 \u3597 \u3627 \u3634 \u3586 \u3618 \u3632 \u3649 \u3621 \u3632 \u3617 \u3621 \u3614 \u3636 \u3625 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : 3R \u3588 \u3639 \u3629 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3586 \u3618 \u3632 \u3649 \u3621 \u3632 \u3586 \u3629 \u3591 \u3648 \u3626 \u3637 \u3618  \u3650 \u3604 \u3618 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3621 \u3604 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657  (Reduce) \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3595 \u3657 \u3635  (Reuse) \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3609 \u3635 \u3585 \u3621 \u3633 \u3610 \u3617 \u3634 \u3651 \u3594 \u3657 \u3651 \u3627 \u3617 \u3656  (Recycle)</div></div>\
\
    <div class="qb"><div class="q">52. \uc0\u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617  "\u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3595 \u3639 \u3657 \u3629 \u3592 \u3633 \u3604 \u3592 \u3657 \u3634 \u3591 \u3626 \u3637 \u3648 \u3586 \u3637 \u3618 \u3623 " \u3651 \u3609 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600  \u3617 \u3637 \u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3648 \u3614 \u3656 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3650 \u3616 \u3588 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 <br>\u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3621 \u3604 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3649 \u3621 \u3632 \u3648 \u3614 \u3656 \u3636 \u3617 \u3588 \u3623 \u3634 \u3617 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626 \u3651 \u3609 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3595 \u3639 \u3657 \u3629 \u3592 \u3633 \u3604 \u3592 \u3657 \u3634 \u3591 <br>\u3588 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3611 \u3619 \u3632 \u3627 \u3618 \u3633 \u3604 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3586 \u3629 \u3591 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 <br>\u3591 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3619 \u3634 \u3618 \u3618 \u3656 \u3629 \u3618 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3650 \u3616 \u3588 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3595 \u3639  \u3657 \u3629 \u3592 \u3633 \u3604 \u3592 \u3657 \u3634 \u3591 \u3626 \u3637 \u3648 \u3586 \u3637 \u3618 \u3623 \u3588 \u3639 \u3629 \u3585 \u3634 \u3619 \u3607 \u3637  \u3656 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3648 \u3621 \u3639 \u3629 \u3585 \u3595 \u3639  \u3657 \u3629 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3607 \u3637  \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617  \u3648 \u3614 \u3656 \u3639 \u3629 \u3648 \u3611 \u3655 \u3609 \u3605 \u3657 \u3609 \u3649 \u3610 \u3610 \u3649 \u3621 \u3632 \u3626 \u3619 \u3657 \u3634 \u3591 \u3605 \u3621 \u3634 \u3604 \u3651 \u3627 \u3657 \u3585 \u3633 \u3610 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3648 \u3627 \u3621 \u3656 \u3634 \u3609 \u3637 \u3657 </div></div>\
\
    <div class="qb"><div class="q">53. \uc0\u3585 \u3634 \u3619 \u3621 \u3604 \u3585 \u3634 \u3619 \u3611 \u3621 \u3656 \u3629 \u3618 \u3585 \u3658 \u3634 \u3595 \u3648 \u3619 \u3639 \u3629 \u3609 \u3585 \u3619 \u3632 \u3592 \u3585  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 \u3605 \u3656 \u3635  \u3648 \u3611 \u3655 \u3609 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3610 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 \u3607 \u3656 \u3637 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3616 \u3634 \u3614 \u3616 \u3641 \u3617 \u3636 \u3629 \u3634 \u3585 \u3634 \u3624 <br>\u3586 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3610 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3637 \u3648 \u3586 \u3637 \u3618 \u3623 <br>\u3588 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3610 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3616 \u3634 \u3588 \u3607 \u3632 \u3648 \u3621 <br>\u3591 . \u3614 \u3633 \u3602 \u3609 \u3634 \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591 \u3609 \u3657 \u3635  \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609  \u3649 \u3621 \u3632 \u3648 \u3585 \u3625 \u3605 \u3619 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3610 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 \u3607 \u3656 \u3637 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3616 \u3634 \u3614 \u3616 \u3641 \u3617 \u3636 \u3629 \u3634 \u3585 \u3634 \u3624 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3621 \u3604 \u3585 \u3658 \u3634 \u3595 \u3648 \u3619 \u3639 \u3629 \u3609 \u3585 \u3619 \u3632 \u3592 \u3585 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 \u3605 \u3656 \u3635 \u3648 \u3611 \u3655 \u3609 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3650 \u3604 \u3618 \u3605 \u3619 \u3591 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3610 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3616 \u3634 \u3614 \u3616 \u3641 \u3617 \u3636 \u3629 \u3634 \u3585 \u3634 \u3624 </div></div>\
\
    <div class="qb"><div class="q">54. \uc0\u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634  \'93\u3648 \u3617 \u3639 \u3629 \u3591 \u3609 \u3656 \u3634 \u3629 \u3618 \u3641 \u3656  \u3594 \u3609 \u3610 \u3607 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591  \u3648 \u3585 \u3625 \u3605 \u3619 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609  \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3648 \u3594 \u3636 \u3591 \u3609 \u3636 \u3648 \u3623 \u3624 \'94 \u3648 \u3611 \u3655 \u3609 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3614 \u3633 \u3602 \u3609 \u3634 \u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656 \u3648 \u3617 \u3639 \u3629 \u3591  \u3594 \u3609 \u3610 \u3607  \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3648 \u3594 \u3636 \u3591 \u3609 \u3636 \u3648 \u3623 \u3624 <br>\u3586 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3610 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3637 \u3648 \u3586 \u3637 \u3618 \u3623 <br>\u3588 . \u3614 \u3633 \u3602 \u3609 \u3634 \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591 \u3609 \u3657 \u3635  \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609  \u3649 \u3621 \u3632 \u3648 \u3585 \u3625 \u3605 \u3619 <br>\u3591 . \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3607 \u3633 \u3624 \u3609 \u3660 \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3635 \u3627 \u3609 \u3604 \u3629 \u3609 \u3634 \u3588 \u3605 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3614 \u3633 \u3602 \u3609 \u3634 \u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656 \u3648 \u3617 \u3639 \u3629 \u3591  \u3594 \u3609 \u3610 \u3607  \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3648 \u3594 \u3636 \u3591 \u3609 \u3636 \u3648 \u3623 \u3624 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656 \u3648 \u3617 \u3639 \u3629 \u3591  \u3594 \u3609 \u3610 \u3607  \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3648 \u3594 \u3636 \u3591 \u3609 \u3636 \u3648 \u3623 \u3624  \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3607 \u3637 \u3656 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3612 \u3633 \u3591 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3651 \u3627 \u3657 \u3648 \u3627 \u3617 \u3634 \u3632 \u3626 \u3617 \u3649 \u3621 \u3632 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 </div></div>\
\
    <div class="qb"><div class="q">55. \uc0\u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3609 \u3657 \u3635 \u3648 \u3594 \u3636 \u3591 \u3621 \u3640 \u3656 \u3617 \u3609 \u3657 \u3635 \u3607 \u3633 \u3657 \u3591 \u3619 \u3632 \u3610 \u3610  \u3617 \u3637 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3648 \u3614 \u3656 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3614 \u3656 \u3636 \u3617 \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591 \u3604 \u3657 \u3634 \u3609 \u3609 \u3657 \u3635 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3611 \u3633 \u3597 \u3627 \u3634 \u3609 \u3657 \u3635 \u3607 \u3656 \u3623 \u3617 \u3649 \u3621 \u3632 \u3616 \u3633 \u3618 \u3649 \u3621 \u3657 \u3591 <br>\u3588 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3648 \u3614 \u3656 \u3636 \u3617 \u3612 \u3621 \u3636 \u3605 \u3616 \u3634 \u3614 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3609 \u3657 \u3635 \u3651 \u3609 \u3616 \u3634 \u3588 \u3648 \u3585 \u3625 \u3605 \u3619 <br>\u3591 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3607 \u3640 \u3585 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 \u3617 \u3637 \u3609 \u3657 \u3635 \u3626 \u3632 \u3629 \u3634 \u3604 \u3651 \u3594 \u3657 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3614 \u3656 \u3636 \u3617 \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591 \u3604 \u3657 \u3634 \u3609 \u3609 \u3657 \u3635 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3609 \u3657 \u3635 \u3648 \u3594 \u3636 \u3591 \u3621 \u3640 \u3656 \u3617 \u3609 \u3657 \u3635 \u3607 \u3633 \u3657 \u3591 \u3619 \u3632 \u3610 \u3610 \u3617 \u3637 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3641 \u3591 \u3626 \u3640 \u3604 \u3648 \u3614 \u3639 \u3656 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3604 \u3657 \u3634 \u3609 \u3609 \u3657 \u3635 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3651 \u3627 \u3657 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3592 \u3633 \u3604 \u3626 \u3619 \u3619 \u3609 \u3657 \u3635 \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3634 \u3619 \u3629 \u3640 \u3611 \u3650 \u3616 \u3588 \u3610 \u3619 \u3636 \u3650 \u3616 \u3588  \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3619 \u3617  \u3649 \u3621 \u3632 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3614 \u3637 \u3618 \u3591 \u3614 \u3629 </div></div>\
\
    <div class="qb"><div class="q">56. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3626 \u3617 \u3604 \u3640 \u3621 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 </div>\
    <div class="c">\uc0\u3585 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3607 \u3656 \u3637 \u3617 \u3640 \u3656 \u3591 \u3612 \u3621 \u3626 \u3633 \u3617 \u3620 \u3607 \u3608 \u3636 \u3660 \u3649 \u3621 \u3632 \u3605 \u3629 \u3610 \u3626 \u3609 \u3629 \u3591 \u3588 \u3623 \u3634 \u3617 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 <br>\u3586 . \u3621 \u3604 \u3586 \u3609 \u3634 \u3604 \u3586 \u3629 \u3591 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3621 \u3591 \u3651 \u3627 \u3657 \u3617 \u3634 \u3585 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 <br>\u3588 . \u3609 \u3635 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3617 \u3634 \u3651 \u3594 \u3657 \u3651 \u3609 \u3607 \u3640 \u3585 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 <br>\u3591 . \u3648 \u3614 \u3656 \u3636 \u3617 \u3648 \u3591 \u3636 \u3609 \u3648 \u3604 \u3639 \u3629 \u3609 \u3649 \u3621 \u3632 \u3626 \u3623 \u3633 \u3626 \u3604 \u3636 \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3649 \u3585 \u3656 \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3607 \u3656 \u3637 \u3617 \u3640 \u3656 \u3591 \u3612 \u3621 \u3626 \u3633 \u3617 \u3620 \u3607 \u3608 \u3636 \u3660 \u3649 \u3621 \u3632 \u3605 \u3629 \u3610 \u3626 \u3609 \u3629 \u3591 \u3588 \u3623 \u3634 \u3617 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3652 \u3617 \u3656 \u3617 \u3637 \u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 \u3611 \u3619 \u3634 \u3585 \u3599 \u3651 \u3609 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3605 \u3657 \u3609 \u3593 \u3610 \u3633 \u3610  \u3649 \u3605 \u3656 \u3592 \u3634 \u3585 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3586 \u3657 \u3629 \u3626 \u3629 \u3610 \u3586 \u3657 \u3629 \u3629 \u3639 \u3656 \u3609 \u3607 \u3637 \u3656 \u3648 \u3627 \u3621 \u3639 \u3629  \u3588 \u3635 \u3605 \u3629 \u3610 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591 \u3588 \u3639 \u3629 \u3586 \u3657 \u3629  \u3585 .</div></div>\
\
    <div class="qb"><div class="q">57. \uc0\u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3605 \u3636 \u3604 \u3605 \u3656 \u3629 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3652 \u3604 \u3657 \u3650 \u3604 \u3618 \u3591 \u3656 \u3634 \u3618  \u3626 \u3632 \u3604 \u3623 \u3585  \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623  \u3612 \u3656 \u3634 \u3609 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621  \u3648 \u3611 \u3655 \u3609 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3637 \u3656 \u3618 \u3638 \u3604 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 <br>\u3586 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3591 \u3634 \u3609 \u3649 \u3610 \u3610 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 <br>\u3588 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3586 \u3609 \u3634 \u3604 \u3648 \u3621 \u3655 \u3585 \u3621 \u3591  \u3648 \u3627 \u3617 \u3634 \u3632 \u3626 \u3617 \u3585 \u3633 \u3610 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 <br>\u3591 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3637 \u3656 \u3618 \u3638 \u3604 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3652 \u3617 \u3656 \u3617 \u3637 \u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 \u3611 \u3619 \u3634 \u3585 \u3599 \u3651 \u3609 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3605 \u3657 \u3609 \u3593 \u3610 \u3633 \u3610  \u3649 \u3605 \u3656 \u3592 \u3634 \u3585 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3586 \u3657 \u3629 \u3626 \u3629 \u3610 \u3586 \u3657 \u3629 \u3629 \u3639 \u3656 \u3609 \u3607 \u3637 \u3656 \u3648 \u3627 \u3621 \u3639 \u3629  \u3588 \u3635 \u3605 \u3629 \u3610 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591 \u3588 \u3639 \u3629 \u3586 \u3657 \u3629  \u3585 .</div></div>\
\
    <div class="qb"><div class="q">58. \uc0\u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3648 \u3611 \u3655 \u3609 \u3585 \u3621 \u3652 \u3585 \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3649 \u3621 \u3632 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3618 \u3591 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3586 \u3629 \u3591 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3651 \u3609 \u3607 \u3640 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3651 \u3627 \u3657 \u3617 \u3637 \u3648 \u3629 \u3585 \u3616 \u3634 \u3614  \u3626 \u3629 \u3604 \u3588 \u3621 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3591 \u3634 \u3609 \u3649 \u3610 \u3610 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3650 \u3604 \u3618 \u3617 \u3637 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3648 \u3611 \u3655 \u3609 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 <br>\u3586 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3637 \u3656 \u3618 \u3638 \u3604 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 <br>\u3588 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626  \u3611 \u3621 \u3629 \u3604 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 <br>\u3591 . \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3648 \u3611 \u3655 \u3609 \u3588 \u3609 \u3604 \u3637 \u3649 \u3621 \u3632 \u3648 \u3585 \u3656 \u3591 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3591 \u3634 \u3609 \u3649 \u3610 \u3610 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3650 \u3604 \u3618 \u3617 \u3637 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3648 \u3611 \u3655 \u3609 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3652 \u3617 \u3656 \u3617 \u3637 \u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 \u3611 \u3619 \u3634 \u3585 \u3599 \u3651 \u3609 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3605 \u3657 \u3609 \u3593 \u3610 \u3633 \u3610  \u3649 \u3605 \u3656 \u3592 \u3634 \u3585 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3586 \u3657 \u3629 \u3626 \u3629 \u3610 \u3586 \u3657 \u3629 \u3629 \u3639 \u3656 \u3609 \u3607 \u3637 \u3656 \u3648 \u3627 \u3621 \u3639 \u3629  \u3588 \u3635 \u3605 \u3629 \u3610 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591 \u3588 \u3639 \u3629 \u3586 \u3657 \u3629  \u3585 .</div></div>\
\
    <div class="qb"><div class="q">59. \uc0\u3585 \u3634 \u3619 \u3606 \u3656 \u3634 \u3618 \u3650 \u3629 \u3609 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 \u3651 \u3627 \u3657 \u3616 \u3634 \u3588 \u3626 \u3656 \u3623 \u3609 \u3629 \u3656 \u3639 \u3609 \u3619 \u3633 \u3610 \u3652 \u3611 \u3604 \u3635 \u3648 \u3609 \u3636 \u3609 \u3585 \u3634 \u3619  \u3649 \u3621 \u3632 \u3618 \u3640 \u3610 \u3648 \u3621 \u3636 \u3585 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 \u3607 \u3637 \u3656 \u3652 \u3617 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609  \u3648 \u3611 \u3655 \u3609 \u3652 \u3611 \u3605 \u3634 \u3617 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3586 \u3609 \u3634 \u3604 \u3648 \u3621 \u3655 \u3585 \u3621 \u3591  \u3648 \u3627 \u3617 \u3634 \u3632 \u3626 \u3617 \u3585 \u3633 \u3610 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 <br>\u3586 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618  \u3607 \u3633 \u3609 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 <br>\u3588 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3591 \u3634 \u3609 \u3649 \u3610 \u3610 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 <br>\u3591 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3637 \u3656 \u3618 \u3638 \u3604 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3586 \u3609 \u3634 \u3604 \u3648 \u3621 \u3655 \u3585 \u3621 \u3591  \u3648 \u3627 \u3617 \u3634 \u3632 \u3626 \u3617 \u3585 \u3633 \u3610 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3652 \u3617 \u3656 \u3617 \u3637 \u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 \u3611 \u3619 \u3634 \u3585 \u3599 \u3651 \u3609 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3605 \u3657 \u3609 \u3593 \u3610 \u3633 \u3610  \u3649 \u3605 \u3656 \u3592 \u3634 \u3585 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3586 \u3657 \u3629 \u3626 \u3629 \u3610 \u3586 \u3657 \u3629 \u3629 \u3639 \u3656 \u3609 \u3607 \u3637 \u3656 \u3648 \u3627 \u3621 \u3639 \u3629  \u3588 \u3635 \u3605 \u3629 \u3610 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591 \u3588 \u3639 \u3629 \u3586 \u3657 \u3629  \u3585 .</div></div>\
\
    <div class="qb"><div class="q">60. \uc0\u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3629 \u3591 \u3588 \u3660 \u3585 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3618 \u3639 \u3604 \u3627 \u3618 \u3640 \u3656 \u3609  \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3611 \u3619 \u3633 \u3610 \u3605 \u3633 \u3623 \u3648 \u3586 \u3657 \u3634 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3648 \u3611 \u3655 \u3609 \u3626 \u3635 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 \u3626 \u3617 \u3633 \u3618 \u3651 \u3627 \u3617 \u3656  \u3649 \u3621 \u3632 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3591 \u3634 \u3609 \u3648 \u3607 \u3618 \u3637 \u3610 \u3652 \u3604 \u3657 \u3585 \u3633 \u3610 \u3617 \u3634 \u3605 \u3619 \u3600 \u3634 \u3609 \u3626 \u3634 \u3585 \u3621  \u3626 \u3629 \u3604 \u3588 \u3621 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618  \u3607 \u3633 \u3609 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591  \u3649 \u3621 \u3632 \u3617 \u3637 \u3586 \u3637 \u3604 \u3626 \u3617 \u3619 \u3619 \u3606 \u3609 \u3632 \u3626 \u3641 \u3591 <br>\u3586 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3586 \u3609 \u3634 \u3604 \u3648 \u3621 \u3655 \u3585 \u3621 \u3591  \u3648 \u3627 \u3617 \u3634 \u3632 \u3626 \u3617 \u3585 \u3633 \u3610 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 <br>\u3588 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3591 \u3634 \u3609 \u3649 \u3610 \u3610 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 <br>\u3591 . \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3648 \u3611 \u3655 \u3609 \u3588 \u3609 \u3604 \u3637 \u3649 \u3621 \u3632 \u3648 \u3585 \u3656 \u3591 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618  \u3607 \u3633 \u3609 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591  \u3649 \u3621 \u3632 \u3617 \u3637 \u3586 \u3637 \u3604 \u3626 \u3617 \u3619 \u3619 \u3606 \u3609 \u3632 \u3626 \u3641 \u3591 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3652 \u3617 \u3656 \u3617 \u3637 \u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 \u3611 \u3619 \u3634 \u3585 \u3599 \u3651 \u3609 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3605 \u3657 \u3609 \u3593 \u3610 \u3633 \u3610  \u3649 \u3605 \u3656 \u3592 \u3634 \u3585 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3586 \u3657 \u3629 \u3626 \u3629 \u3610 \u3586 \u3657 \u3629 \u3629 \u3639 \u3656 \u3609 \u3607 \u3637 \u3656 \u3648 \u3627 \u3621 \u3639 \u3629  \u3588 \u3635 \u3605 \u3629 \u3610 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591 \u3588 \u3639 \u3629 \u3586 \u3657 \u3629  \u3585 .</div></div>\
\
    <div class="qb"><div class="q">61. \uc0\u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3611 \u3619 \u3640 \u3591 \u3619 \u3632 \u3610 \u3610 \u3588 \u3656 \u3634 \u3605 \u3629 \u3610 \u3649 \u3607 \u3609 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3592 \u3641 \u3591 \u3651 \u3592 \u3651 \u3627 \u3657 \u3588 \u3609 \u3604 \u3637 \u3588 \u3609 \u3648 \u3585 \u3656 \u3591 \u3607 \u3635 \u3591 \u3634 \u3609 \u3651 \u3609 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600  \u3648 \u3611 \u3655 \u3609 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3648 \u3611 \u3655 \u3609 \u3588 \u3609 \u3604 \u3637 \u3649 \u3621 \u3632 \u3648 \u3585 \u3656 \u3591  \u3618 \u3638 \u3604 \u3627 \u3621 \u3633 \u3585 \u3588 \u3640 \u3603 \u3608 \u3619 \u3619 \u3617  \u3592 \u3619 \u3636 \u3618 \u3608 \u3619 \u3619 \u3617 <br>\u3586 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3586 \u3609 \u3634 \u3604 \u3648 \u3621 \u3655 \u3585 \u3621 \u3591  \u3648 \u3627 \u3617 \u3634 \u3632 \u3626 \u3617 \u3585 \u3633 \u3610 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 <br>\u3588 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618  \u3607 \u3633 \u3609 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 <br>\u3591 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626  \u3611 \u3621 \u3629 \u3604 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3648 \u3611 \u3655 \u3609 \u3588 \u3609 \u3604 \u3637 \u3649 \u3621 \u3632 \u3648 \u3585 \u3656 \u3591  \u3618 \u3638 \u3604 \u3627 \u3621 \u3633 \u3585 \u3588 \u3640 \u3603 \u3608 \u3619 \u3619 \u3617  \u3592 \u3619 \u3636 \u3618 \u3608 \u3619 \u3619 \u3617 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3652 \u3617 \u3656 \u3617 \u3637 \u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 \u3611 \u3619 \u3634 \u3585 \u3599 \u3651 \u3609 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3605 \u3657 \u3609 \u3593 \u3610 \u3633 \u3610  \u3649 \u3605 \u3656 \u3592 \u3634 \u3585 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3586 \u3657 \u3629 \u3626 \u3629 \u3610 \u3586 \u3657 \u3629 \u3629 \u3639 \u3656 \u3609 \u3607 \u3637 \u3656 \u3648 \u3627 \u3621 \u3639 \u3629  \u3588 \u3635 \u3605 \u3629 \u3610 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591 \u3588 \u3639 \u3629 \u3586 \u3657 \u3629  \u3585 .</div></div>\
\
    <div class="qb"><div class="q">62. \uc0\u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617 \u3649 \u3618 \u3585 \u3649 \u3618 \u3632 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3626 \u3656 \u3623 \u3609 \u3610 \u3640 \u3588 \u3588 \u3621 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3626 \u3656 \u3623 \u3609 \u3619 \u3623 \u3617 \u3586 \u3629 \u3591 \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600  \u3648 \u3611 \u3655 \u3609 \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3626 \u3635 \u3588 \u3633 \u3597 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3611 \u3633 \u3597 \u3627 \u3634 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3614 \u3620 \u3605 \u3636 \u3617 \u3636 \u3594 \u3629 \u3610 <br>\u3586 . \u3611 \u3633 \u3597 \u3627 \u3634 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 \u3651 \u3609 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 <br>\u3588 . \u3611 \u3633 \u3597 \u3627 \u3634 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3649 \u3610 \u3610 \u3605 \u3656 \u3634 \u3591 \u3588 \u3609 \u3605 \u3656 \u3634 \u3591 \u3607 \u3635 <br>\u3591 . \u3611 \u3633 \u3597 \u3627 \u3634 \u3586 \u3634 \u3604 \u3649 \u3588 \u3621 \u3609 \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 \u3607 \u3637 \u3656 \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3611 \u3633 \u3597 \u3627 \u3634 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3614 \u3620 \u3605 \u3636 \u3617 \u3636 \u3594 \u3629 \u3610 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3652 \u3617 \u3656 \u3617 \u3637 \u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 \u3611 \u3619 \u3634 \u3585 \u3599 \u3651 \u3609 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3605 \u3657 \u3609 \u3593 \u3610 \u3633 \u3610  \u3649 \u3605 \u3656 \u3592 \u3634 \u3585 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3586 \u3657 \u3629 \u3626 \u3629 \u3610 \u3586 \u3657 \u3629 \u3629 \u3639 \u3656 \u3609 \u3607 \u3637 \u3656 \u3648 \u3627 \u3621 \u3639 \u3629  \u3588 \u3635 \u3605 \u3629 \u3610 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591 \u3588 \u3639 \u3629 \u3586 \u3657 \u3629  \u3585 .</div></div>\
\
    <div class="qb"><div class="q">63. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3605 \u3634 \u3617 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 </div>\
    <div class="c">\uc0\u3585 . \u3617 \u3637 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3648 \u3607 \u3656 \u3634 \u3607 \u3656 \u3637 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609  \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618  \u3648 \u3611 \u3655 \u3609 \u3626 \u3634 \u3585 \u3621  \u3649 \u3621 \u3632 \u3648 \u3629 \u3657 \u3639 \u3629 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 <br>\u3586 . \u3617 \u3637 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3588 \u3619 \u3629 \u3610 \u3588 \u3621 \u3640 \u3617 \u3607 \u3640 \u3585 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3648 \u3614 \u3656 \u3639 \u3629 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3607 \u3635 \u3612 \u3636 \u3604 <br>\u3588 . \u3617 \u3637 \u3610 \u3607 \u3621 \u3591 \u3650 \u3607 \u3625 \u3607 \u3637 \u3656 \u3619 \u3640 \u3609 \u3649 \u3619 \u3591 \u3648 \u3614 \u3639 \u3656 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3591 \u3610 \u3648 \u3619 \u3637 \u3618 \u3610 \u3619 \u3657 \u3629 \u3618 <br>\u3591 . \u3618 \u3585 \u3648 \u3621 \u3636 \u3585 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3621 \u3657 \u3634 \u3626 \u3617 \u3633 \u3618 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 \u3649 \u3621 \u3632 \u3619 \u3656 \u3634 \u3591 \u3586 \u3638 \u3657 \u3609 \u3651 \u3627 \u3617 \u3656 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3617 \u3637 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3648 \u3607 \u3656 \u3634 \u3607 \u3656 \u3637 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609  \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618  \u3648 \u3611 \u3655 \u3609 \u3626 \u3634 \u3585 \u3621  \u3649 \u3621 \u3632 \u3648 \u3629 \u3657 \u3639 \u3629 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3652 \u3617 \u3656 \u3617 \u3637 \u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 \u3611 \u3619 \u3634 \u3585 \u3599 \u3651 \u3609 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3605 \u3657 \u3609 \u3593 \u3610 \u3633 \u3610  \u3649 \u3605 \u3656 \u3592 \u3634 \u3585 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3586 \u3657 \u3629 \u3626 \u3629 \u3610 \u3586 \u3657 \u3629 \u3629 \u3639 \u3656 \u3609 \u3607 \u3637 \u3656 \u3648 \u3627 \u3621 \u3639 \u3629  \u3588 \u3635 \u3605 \u3629 \u3610 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591 \u3588 \u3639 \u3629 \u3586 \u3657 \u3629  \u3585 .</div></div>\
\
    <div class="qb"><div class="q">64. \uc0\u3585 \u3634 \u3619 \u3629 \u3635 \u3609 \u3623 \u3618 \u3588 \u3623 \u3634 \u3617 \u3618 \u3640 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 \u3605 \u3634 \u3617 \u3627 \u3621 \u3633 \u3585 \u3609 \u3636 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617  \u3627 \u3617 \u3634 \u3618 \u3606 \u3638 \u3591 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3618 \u3640 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 \u3607 \u3637 \u3656 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614  \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617  \u3652 \u3617 \u3656 \u3648 \u3621 \u3639 \u3629 \u3585 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 <br>\u3586 . \u3585 \u3634 \u3619 \u3605 \u3633 \u3604 \u3626 \u3636 \u3609 \u3588 \u3604 \u3637 \u3588 \u3623 \u3634 \u3617 \u3629 \u3618 \u3656 \u3634 \u3591 \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623 <br>\u3588 . \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3588 \u3623 \u3634 \u3617 \u3594 \u3656 \u3623 \u3618 \u3648 \u3627 \u3621 \u3639 \u3629 \u3604 \u3657 \u3634 \u3609 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3649 \u3585 \u3656 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3607 \u3640 \u3585 \u3588 \u3609 <br>\u3591 . \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3588 \u3619 \u3656 \u3591 \u3588 \u3619 \u3633 \u3604 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3617 \u3637 \u3586 \u3657 \u3629 \u3618 \u3585 \u3648 \u3623 \u3657 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3618 \u3640 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 \u3607 \u3637 \u3656 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614  \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617  \u3652 \u3617 \u3656 \u3648 \u3621 \u3639 \u3629 \u3585 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3627 \u3621 \u3633 \u3585 \u3609 \u3636 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 \u3651 \u3609 \u3585 \u3634 \u3619 \u3629 \u3635 \u3609 \u3623 \u3618 \u3588 \u3623 \u3634 \u3617 \u3618 \u3640 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617  \u3627 \u3617 \u3634 \u3618 \u3606 \u3638 \u3591  \u3585 \u3634 \u3619 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3651 \u3594 \u3657 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588  \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617  \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626  \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3652 \u3604 \u3657  \u3649 \u3621 \u3632 \u3652 \u3617 \u3656 \u3648 \u3621 \u3639 \u3629 \u3585 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3605 \u3656 \u3629 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 </div></div>\
\
    <div class="qb"><div class="q">65. \uc0\u3619 \u3633 \u3600 \u3608 \u3619 \u3619 \u3617 \u3609 \u3641 \u3597 \u3649 \u3627 \u3656 \u3591 \u3619 \u3634 \u3594 \u3629 \u3634 \u3603 \u3634 \u3592 \u3633 \u3585 \u3619 \u3652 \u3607 \u3618  \u3617 \u3634 \u3605 \u3619 \u3634 \u3651 \u3604 \u3607 \u3656 \u3637 \u3610 \u3633 \u3597 \u3597 \u3633 \u3605 \u3636 \u3651 \u3627 \u3657 \u3619 \u3633 \u3600 \u3614 \u3638 \u3591 \u3592 \u3633 \u3604 \u3651 \u3627 \u3657 \u3617 \u3637 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 </div>\
    <div class="c">\uc0\u3585 . \u3617 \u3634 \u3605 \u3619 \u3634  65<br>\u3586 . \u3617 \u3634 \u3605 \u3619 \u3634  1<br>\u3588 . \u3617 \u3634 \u3605 \u3619 \u3634  25<br>\u3591 . \u3617 \u3634 \u3605 \u3619 \u3634  77</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3617 \u3634 \u3605 \u3619 \u3634  65</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3619 \u3633 \u3600 \u3608 \u3619 \u3619 \u3617 \u3609 \u3641 \u3597 \u3649 \u3627 \u3656 \u3591 \u3619 \u3634 \u3594 \u3629 \u3634 \u3603 \u3634 \u3592 \u3633 \u3585 \u3619 \u3652 \u3607 \u3618  \u3614 \u3640 \u3607 \u3608 \u3624 \u3633 \u3585 \u3619 \u3634 \u3594  2560 \u3617 \u3634 \u3605 \u3619 \u3634  65 \u3610 \u3633 \u3597 \u3597 \u3633 \u3605 \u3636 \u3651 \u3627 \u3657 \u3619 \u3633 \u3600 \u3614 \u3638 \u3591 \u3592 \u3633 \u3604 \u3651 \u3627 \u3657 \u3617 \u3637 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3648 \u3611 \u3655 \u3609 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 </div></div>\
\
    <div class="qb"><div class="q">66. \uc0\u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3612 \u3621 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3605 \u3634 \u3617 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3604 \u3657 \u3623 \u3618 \u3585 \u3637 \u3656 \u3604 \u3657 \u3634 \u3609 </div>\
    <div class="c">\uc0\u3585 . 6 \u3604 \u3657 \u3634 \u3609 <br>\u3586 . 5 \u3604 \u3657 \u3634 \u3609 <br>\u3588 . 7 \u3604 \u3657 \u3634 \u3609 <br>\u3591 . 4 \u3604 \u3657 \u3634 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . 6 \u3604 \u3657 \u3634 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3612 \u3621 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3605 \u3634 \u3617 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3604 \u3657 \u3623 \u3618  6 \u3604 \u3657 \u3634 \u3609 \u3627 \u3621 \u3633 \u3585  \u3595 \u3638 \u3656 \u3591 \u3626 \u3632 \u3607 \u3657 \u3629 \u3609 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3651 \u3609 \u3617 \u3636 \u3605 \u3636 \u3605 \u3656 \u3634 \u3591 \u3654 </div></div>\
\
    <div class="qb"><div class="q">67. \uc0\u3586 \u3657 \u3629 \u3651 \u3604  \u3652 \u3617 \u3656 \u3651 \u3594 \u3656  \u3627 \u3609 \u3638 \u3656 \u3591 \u3651 \u3609 \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3612 \u3621 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3605 \u3634 \u3617 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 </div>\
    <div class="c">\uc0\u3585 . \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3651 \u3609 \u3648 \u3623 \u3607 \u3637 \u3650 \u3621 \u3585 <br>\u3586 . \u3588 \u3623 \u3634 \u3617 \u3629 \u3618 \u3641 \u3656 \u3604 \u3637 \u3617 \u3637 \u3626 \u3640 \u3586 \u3586 \u3629 \u3591 \u3588 \u3609 \u3652 \u3607 \u3618 \u3649 \u3621 \u3632 \u3626 \u3633 \u3591 \u3588 \u3617 \u3652 \u3607 \u3618 <br>\u3588 . \u3586 \u3637 \u3604 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609  \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3592 \u3634 \u3618 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 <br>\u3591 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3651 \u3609 \u3648 \u3623 \u3607 \u3637 \u3650 \u3621 \u3585 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3648 \u3611 \u3655 \u3609 \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3651 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3618 \u3656 \u3629 \u3618  \u3649 \u3605 \u3656 \u3652 \u3617 \u3656 \u3651 \u3594 \u3656  1 \u3651 \u3609  6 \u3604 \u3657 \u3634 \u3609 \u3627 \u3621 \u3633 \u3585 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3612 \u3621 \u3616 \u3634 \u3614 \u3619 \u3623 \u3617 </div></div>\
\
    <div class="qb"><div class="q">68. \uc0\u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3651 \u3609 \u3594 \u3656 \u3623 \u3591 \u3619 \u3632 \u3618 \u3632 \u3648 \u3623 \u3621 \u3634 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636  \u3592 \u3632 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3617 \u3604 \u3640 \u3621 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3651 \u3609 \u3604 \u3657 \u3634 \u3609 \u3651 \u3604 \u3610 \u3657 \u3634 \u3591 </div>\
    <div class="c">\uc0\u3585 . \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592  \u3626 \u3633 \u3591 \u3588 \u3617  \u3649 \u3621 \u3632 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 <br>\u3586 . \u3585 \u3634 \u3619 \u3648 \u3617 \u3639 \u3629 \u3591  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592  \u3649 \u3621 \u3632 \u3626 \u3633 \u3591 \u3588 \u3617 <br>\u3588 . \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637  \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 <br>\u3591 . \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3605 \u3619  \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592  \u3626 \u3633 \u3591 \u3588 \u3617  \u3649 \u3621 \u3632 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3592 \u3632 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3617 \u3604 \u3640 \u3621 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592  \u3626 \u3633 \u3591 \u3588 \u3617  \u3649 \u3621 \u3632 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 </div></div>\
\
    <div class="qb"><div class="q">69. \uc0\u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3588 \u3623 \u3634 \u3617 \u3619 \u3656 \u3623 \u3617 \u3617 \u3639 \u3629 \u3607 \u3637 \u3656 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3588 \u3639 \u3629 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3611 \u3619 \u3632 \u3594 \u3634 \u3619 \u3633 \u3600 <br>\u3586 . \u3619 \u3633 \u3600 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 <br>\u3588 . \u3626 \u3627 \u3585 \u3619 \u3603  \u3660 <br>\u3591 . \u3629 \u3591 \u3588 \u3660 \u3585 \u3619 \u3629 \u3636 \u3626 \u3619 \u3632 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3611 \u3619 \u3632 \u3594 \u3634 \u3619 \u3633 \u3600 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3617 \u3637 \u3626 \u3656 \u3623 \u3609 \u3619 \u3656 \u3623 \u3617 \u3586 \u3629 \u3591 \u3607 \u3640 \u3585 \u3616 \u3634 \u3588 \u3626 \u3656 \u3623 \u3609 \u3651 \u3609 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610  \'93\u3611 \u3619 \u3632 \u3594 \u3634 \u3619 \u3633 \u3600 \'94 \u3648 \u3614 \u3639 \u3656 \u3629 \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 </div></div>\
\
    <div class="qb"><div class="q">70. \'93\uc0\u3585 \u3634 \u3619 \u3605 \u3656 \u3629 \u3618 \u3629 \u3604 \u3629 \u3604 \u3637 \u3605 \'94 \u3651 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609  \u3627 \u3617 \u3634 \u3618 \u3606 \u3638 \u3591 \u3586 \u3657 \u3629 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3609 \u3635 \u3619 \u3634 \u3585 \u3648 \u3627 \u3591 \u3657 \u3634 \u3607 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592  \u3629 \u3633 \u3605 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660  \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617  \u3617 \u3634 \u3611 \u3619 \u3632 \u3618 \u3640 \u3585 \u3605 \u3660 \u3612 \u3626 \u3617 \u3612 \u3626 \u3634 \u3609 \u3585 \u3633 \u3610 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 <br>\u3586 . \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 \u3611 \u3619 \u3632 \u3623 \u3633 \u3605 \u3636 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3648 \u3614 \u3656 \u3639 \u3629 \u3648 \u3611 \u3655 \u3609 \u3610 \u3607 \u3648 \u3619 \u3637 \u3618 \u3609 <br>\u3588 . \u3585 \u3634 \u3619 \u3615 \u3657 \u3639 \u3609 \u3615 \u3641 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3604 \u3633 \u3657 \u3591 \u3648 \u3604 \u3636 \u3617 \u3607 \u3637 \u3656 \u3648 \u3588 \u3618 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597 <br>\u3591 . \u3585 \u3634 \u3619 \u3629 \u3609 \u3640 \u3619 \u3633 \u3585 \u3625 \u3660 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3648 \u3614 \u3603 \u3637 \u3648 \u3585 \u3656 \u3634 \u3649 \u3585 \u3656 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3634 \u3619 \u3609 \u3635 \u3619 \u3634 \u3585 \u3648 \u3627 \u3591 \u3657 \u3634 \u3607 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592  \u3629 \u3633 \u3605 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660  \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617  \u3617 \u3634 \u3611 \u3619 \u3632 \u3618 \u3640 \u3585 \u3605 \u3660 \u3612 \u3626 \u3617 \u3612 \u3626 \u3634 \u3609 \u3585 \u3633 \u3610 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \'93\u3585 \u3634 \u3619 \u3605 \u3656 \u3629 \u3618 \u3629 \u3604 \u3629 \u3604 \u3637 \u3605 \'94 \u3588 \u3639 \u3629  \u3585 \u3634 \u3619 \u3609 \u3635 \u3592 \u3640 \u3604 \u3648 \u3604 \u3656 \u3609 \u3607 \u3637 \u3656 \u3617 \u3637 \u3629 \u3618 \u3641 \u3656 \u3648 \u3604 \u3636 \u3617  \u3607 \u3633 \u3657 \u3591 \u3604 \u3657 \u3634 \u3609 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617  \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619  \u3649 \u3621 \u3632 \u3629 \u3633 \u3605 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660  \u3617 \u3634 \u3611 \u3619 \u3632 \u3618 \u3640 \u3585 \u3605 \u3660 \u3651 \u3594 \u3657 \u3585 \u3633 \u3610 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3648 \u3614 \u3639 \u3656 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3656 \u3636 \u3617 </div></div>\
\
    <div class="qb"><div class="q">71. \uc0\u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3650 \u3588 \u3619 \u3591 \u3586 \u3656 \u3634 \u3618 \u3619 \u3632 \u3610 \u3610 \u3588 \u3617 \u3609 \u3634 \u3588 \u3617 \u3649 \u3621 \u3632 \u3586 \u3609 \u3626 \u3656 \u3591  \u3592 \u3633 \u3604 \u3629 \u3618 \u3641  \u3656 \u3651 \u3609 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3651 \u3604 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 </div>\
    <div class="c">\uc0\u3585 . \u3611 \u3619 \u3633 \u3610 \u3611 \u3633 \u3592 \u3592 \u3640 \u3610 \u3633 \u3609 <br>\u3586 . \u3605 \u3656 \u3629 \u3618 \u3629 \u3604 \u3629 \u3604 \u3637 \u3605 <br>\u3588 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3640 \u3603 \u3588 \u3656 \u3634 \u3651 \u3627 \u3617 \u3656 \u3651 \u3609 \u3629 \u3609 \u3634 \u3588 \u3605 <br>\u3591 . \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3652 \u3607 \u3618  \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3621 \u3585 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3611 \u3619 \u3633 \u3610 \u3611 \u3633 \u3592 \u3592 \u3640 \u3610 \u3633 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \'93\u3611 \u3619 \u3633 \u3610 \u3611 \u3633 \u3592 \u3592 \u3640 \u3610 \u3633 \u3609 \'94 \u3588 \u3639 \u3629 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609 \u3605 \u3656 \u3634 \u3591 \u3654  \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3651 \u3609 \u3611 \u3633 \u3592 \u3592 \u3640 \u3610 \u3633 \u3609  \u3648 \u3614 \u3639 \u3656 \u3629 \u3611 \u3641 \u3607 \u3634 \u3591 \u3652 \u3611 \u3626 \u3641 \u3656 \u3629 \u3609 \u3634 \u3588 \u3605 </div></div>\
\
    <div class="qb"><div class="q">72. \'93\uc0\u3588 \u3609 \u3652 \u3607 \u3618 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3614 \u3619 \u3657 \u3629 \u3617 \u3607 \u3633 \u3657 \u3591 \u3585 \u3634 \u3618  \u3651 \u3592  \u3626 \u3605 \u3636 \u3611 \u3633 \u3597 \u3597 \u3634  \u3617 \u3637 \u3614 \u3633 \u3602 \u3609 \u3634 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3604 \u3637 \u3619 \u3629 \u3610 \u3604 \u3657 \u3634 \u3609 \u3649 \u3621 \u3632 \u3617 \u3637 \u3626 \u3640 \u3586 \u3616 \u3634 \u3623 \u3632 \u3607 \u3637 \u3656 \u3604 \u3637 \u3651 \u3609 \u3607 \u3640 \u3585 \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \'94 \u3648 \u3611 \u3655 \u3609 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3586 \u3657 \u3629 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 <br>\u3586 . \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3650 \u3629 \u3585 \u3634 \u3626 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 <br>\u3588 . \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 <br>\u3591 . \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3610 \u3609 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3594 \u3637 \u3623 \u3636 \u3605 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3586 \u3657 \u3629 \u3588 \u3623 \u3634 \u3617 \u3604 \u3633 \u3591 \u3585 \u3621 \u3656 \u3634 \u3623 \u3648 \u3611 \u3655 \u3609 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3627 \u3621 \u3633 \u3585 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3617 \u3609 \u3640 \u3625 \u3618  \u3660 </div></div>\
\
    <div class="qb"><div class="q">73. \uc0\u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3605 \u3633 \u3623 \u3605 \u3633 \u3657 \u3591 \u3651 \u3609 \u3585 \u3634 \u3619 \u3585 \u3635 \u3627 \u3609 \u3604 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3649 \u3621 \u3632 \u3649 \u3612 \u3609 \u3591 \u3634 \u3609  \u3648 \u3611 \u3655 \u3609 \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3610 \u3609 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3594 \u3637 \u3623 \u3636 \u3605 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 <br>\u3586 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 <br>\u3588 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3626 \u3617 \u3604 \u3640 \u3621 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 <br>\u3591 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3650 \u3629 \u3585 \u3634 \u3626 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3610 \u3609 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3594 \u3637 \u3623 \u3636 \u3605 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3610 \u3609 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3594 \u3637 \u3623 \u3636 \u3605 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3585 \u3633 \u3610 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 \u3592 \u3632 \u3651 \u3594 \u3657 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3605 \u3633 \u3623 \u3605 \u3633 \u3657 \u3591  (Area-based) \u3651 \u3609 \u3585 \u3634 \u3619 \u3585 \u3635 \u3627 \u3609 \u3604 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3649 \u3621 \u3632 \u3649 \u3612 \u3609 \u3591 \u3634 \u3609 </div></div>\
\
    <div class="qb"><div class="q">74. \uc0\u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3626 \u3635 \u3588 \u3633 \u3597 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 \u3586 \u3657 \u3629 \u3627 \u3609 \u3638 \u3656 \u3591 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591  \u3588 \u3639 \u3629 \u3585 \u3634 \u3619 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3649 \u3621 \u3632 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3607 \u3637 \u3656 \u3617 \u3637 \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3611 \u3633 \u3592 \u3592 \u3640 \u3610 \u3633 \u3609  \u3649 \u3621 \u3632 \u3607 \u3656 \u3637 \u3629 \u3634 \u3592 \u3592 \u3632 \u3648 \u3585 \u3636 \u3604 \u3586 \u3638 \u3657 \u3609 \u3651 \u3609 \u3629 \u3609 \u3634 \u3588 \u3605  \u3650 \u3604 \u3618 \u3651 \u3594 \u3657 \u3585 \u3621 \u3652 \u3585 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3621 \u3652 \u3585 \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3649 \u3610 \u3610 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 <br>\u3586 . \u3585 \u3621 \u3652 \u3585 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3607 \u3627 \u3634 \u3619 <br>\u3588 . \u3585 \u3621 \u3652 \u3585 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3607 \u3641 \u3605 <br>\u3591 . \u3585 \u3621 \u3652 \u3585 \u3607 \u3634 \u3591 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3621 \u3652 \u3585 \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3649 \u3610 \u3610 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3585 \u3621 \u3652 \u3585 \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3649 \u3610 \u3610 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3592 \u3634 \u3585 \u3607 \u3640 \u3585 \u3616 \u3634 \u3588 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3586 \u3657 \u3629 \u3591 </div></div>\
\
    <div class="qb"><div class="q">75. \uc0\u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634  \'93\u3648 \u3585 \u3625 \u3605 \u3619 \u3649 \u3611 \u3619 \u3619 \u3641 \u3611 \'94 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3651 \u3594 \u3657 \u3629 \u3632 \u3652 \u3619 \u3648 \u3614 \u3639 \u3656 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3649 \u3605 \u3585 \u3605 \u3656 \u3634 \u3591 \u3649 \u3621 \u3632 \u3648 \u3614 \u3656 \u3636 \u3617 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 <br>\u3586 . \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 \u3613 \u3637 \u3617 \u3639 \u3629 <br>\u3588 . \u3623 \u3633 \u3605 \u3606 \u3640 \u3604 \u3636 \u3610 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3626 \u3641 \u3591 <br>\u3591 . \u3585 \u3634 \u3619 \u3605 \u3621 \u3634 \u3604 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3585 \u3625 \u3605 \u3619 \u3649 \u3611 \u3619 \u3619 \u3641 \u3611 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3651 \u3594 \u3657 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3651 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3649 \u3605 \u3585 \u3605 \u3656 \u3634 \u3591 \u3649 \u3621 \u3632 \u3648 \u3614 \u3636 \u3656 \u3617 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3651 \u3627 \u3657 \u3585 \u3633 \u3610 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3648 \u3585 \u3625 \u3605 \u3619 </div></div>\
\
    <div class="qb"><div class="q">76. \uc0\u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609  \'93\u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \'94 (Medical Hub) \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \u3588 \u3619 \u3610 \u3623 \u3591 \u3592 \u3619 <br>\u3586 . \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3648 \u3594 \u3636 \u3591 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614  \u3588 \u3623 \u3634 \u3617 \u3591 \u3634 \u3617  \u3649 \u3621 \u3632 \u3649 \u3614 \u3607 \u3618 \u3660 \u3649 \u3612 \u3609 \u3652 \u3607 \u3618 <br>\u3588 . \u3585 \u3634 \u3619 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3651 \u3627 \u3657 \u3588 \u3609 \u3652 \u3607 \u3618 \u3617 \u3637 \u3626 \u3640 \u3586 \u3616 \u3634 \u3623 \u3632 \u3607 \u3637 \u3656 \u3604 \u3637 <br>\u3591 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3627 \u3621 \u3633 \u3585 \u3611 \u3619 \u3632 \u3585 \u3633 \u3609 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 \u3607 \u3656 \u3637 \u3588 \u3619 \u3629 \u3610 \u3588 \u3621 \u3640 \u3617 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \u3588 \u3619 \u3610 \u3623 \u3591 \u3592 \u3619 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \u3588 \u3619 \u3610 \u3623 \u3591 \u3592 \u3619 </div></div>\
\
    <div class="qb"><div class="q">77. \'93\uc0\u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609  \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3652 \u3607 \u3618  \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3621 \u3585 \'94 \u3617 \u3637 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3629 \u3634 \u3648 \u3595 \u3637 \u3618 \u3609  \u3649 \u3621 \u3632 \u3592 \u3640 \u3604 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3605 \u3656 \u3629 \u3607 \u3637 \u3656 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 \u3648 \u3629 \u3648 \u3594 \u3637 \u3618 <br>\u3586 . \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3607 \u3656 \u3637 \u3617 \u3637 \u3619 \u3632 \u3610 \u3610 \u3650 \u3621 \u3592 \u3636 \u3626 \u3605 \u3636 \u3585 \u3626 \u3660 \u3607 \u3637 \u3656 \u3604 \u3637 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 \u3651 \u3609 \u3650 \u3621 \u3585 <br>\u3588 . \u3611 \u3619 \u3632 \u3605 \u3641 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3591 . \u3648 \u3588 \u3619 \u3639 \u3629 \u3586 \u3656 \u3634 \u3618 \u3588 \u3617 \u3609 \u3634 \u3588 \u3617 \u3607 \u3637 \u3656 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618 \u3649 \u3621 \u3632 \u3588 \u3619 \u3629 \u3610 \u3588 \u3621 \u3640 \u3617 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3629 \u3634 \u3648 \u3595 \u3637 \u3618 \u3609  \u3649 \u3621 \u3632 \u3592 \u3640 \u3604 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3605 \u3656 \u3629 \u3607 \u3637 \u3656 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 \u3648 \u3629 \u3648 \u3594 \u3637 \u3618 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3609 \u3637 \u3657 \u3588 \u3639 \u3629 \u3585 \u3634 \u3619 \u3607 \u3635 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3588 \u3617 \u3609 \u3634 \u3588 \u3617 \u3586 \u3609 \u3626 \u3656 \u3591 \u3586 \u3629 \u3591 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 \u3648 \u3629 \u3648 \u3594 \u3637 \u3618 </div></div>\
\
    <div class="qb"><div class="q">78. \uc0\u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634  "\u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 " \u3648 \u3609 \u3657 \u3609 \u3651 \u3627 \u3657 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3604 \u3657 \u3634 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3649 \u3621 \u3632 \u3651 \u3594 \u3657 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3605 \u3621 \u3629 \u3604 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 <br>\u3586 . \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609 \u3629 \u3618 \u3656 \u3634 \u3591 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 <br>\u3588 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3648 \u3588 \u3619 \u3639 \u3629 \u3586 \u3656 \u3634 \u3618 \u3607 \u3634 \u3591 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3607 \u3637 \u3656 \u3585 \u3623 \u3657 \u3634 \u3591 \u3586 \u3623 \u3634 \u3591 <br>\u3591 . \u3585 \u3634 \u3619 \u3648 \u3592 \u3619 \u3592 \u3634 \u3605 \u3656 \u3629 \u3619 \u3629 \u3591 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3649 \u3621 \u3632 \u3651 \u3594 \u3657 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3605 \u3621 \u3629 \u3604 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632  \u3627 \u3617 \u3634 \u3618 \u3606 \u3638 \u3591  \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3649 \u3621 \u3632 \u3651 \u3594 \u3657 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3651 \u3609 \u3585 \u3634 \u3619 \u3604 \u3635 \u3648 \u3609 \u3636 \u3609 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 </div></div>\
\
    <div class="qb"><div class="q">79. \uc0\u3585 \u3634 \u3619 \u3611 \u3621 \u3641 \u3585 \u3613 \u3633 \u3591 \u3588 \u3656 \u3634 \u3609 \u3636 \u3618 \u3617 \u3649 \u3621 \u3632 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617 \u3650 \u3604 \u3618 \u3651 \u3594 \u3657  "\u3594 \u3640 \u3617 \u3594 \u3609 \u3648 \u3611 \u3655 \u3609 \u3600 \u3634 \u3609 " \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3651 \u3588 \u3619 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3605 \u3657 \u3609 \u3649 \u3610 \u3610 </div>\
    <div class="c">\uc0\u3585 . \u3612 \u3641 \u3657 \u3609 \u3635 \u3594 \u3640 \u3617 \u3594 \u3609 <br>\u3586 . \u3648 \u3618 \u3634 \u3623 \u3594 \u3609 \u3651 \u3609 \u3594 \u3640 \u3617 \u3594 \u3609 <br>\u3588 . \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 \u3651 \u3609 \u3594 \u3640 \u3617 \u3594 \u3609 <br>\u3591 . \u3629 \u3634 \u3626 \u3634 \u3626 \u3617 \u3633 \u3588 \u3619 \u3626 \u3634 \u3608 \u3634 \u3619 \u3603 \u3626 \u3640 \u3586 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3612 \u3641 \u3657 \u3609 \u3635 \u3594 \u3640 \u3617 \u3594 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3594 \u3640 \u3617 \u3594 \u3609 \u3648 \u3611 \u3655 \u3609 \u3600 \u3634 \u3609 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3612 \u3641 \u3657 \u3609 \u3635 \u3594 \u3640 \u3617 \u3594 \u3609 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3605 \u3657 \u3609 \u3649 \u3610 \u3610 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3617 \u3637 \u3588 \u3640 \u3603 \u3608 \u3619 \u3619 \u3617 \u3592 \u3619 \u3636 \u3618 \u3608 \u3619 \u3619 \u3617  \u3648 \u3614 \u3656 \u3639 \u3629 \u3648 \u3611 \u3655 \u3609 \u3649 \u3610 \u3610 \u3629 \u3618 \u3656 \u3634 \u3591 \u3607 \u3637 \u3656 \u3604 \u3637 \u3649 \u3585 \u3656 \u3588 \u3609 \u3651 \u3609 \u3594 \u3640 \u3617 \u3594 \u3609 </div></div>\
\
    <div class="qb"><div class="q">80. \uc0\u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 \u3617 \u3637 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3627 \u3621 \u3633 \u3591 \u3648 \u3585 \u3625 \u3637 \u3618 \u3603  \u3648 \u3611 \u3655 \u3609 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3651 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3588 \u3609 \u3651 \u3609 \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 <br>\u3586 . \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 <br>\u3588 . \u3594 \u3656 \u3623 \u3591 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3612 \u3656 \u3634 \u3609 <br>\u3591 . \u3605 \u3621 \u3629 \u3604 \u3594 \u3656 \u3623 \u3591 \u3594 \u3637 \u3623 \u3636 \u3605 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 \u3607 \u3635 \u3591 \u3634 \u3609 \u3627 \u3621 \u3633 \u3591 \u3648 \u3585 \u3625 \u3637 \u3618 \u3603 \u3648 \u3611 \u3655 \u3609 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3588 \u3609 \u3651 \u3609 \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640  \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 \u3618 \u3633 \u3591 \u3588 \u3591 \u3648 \u3611 \u3655 \u3609 \u3614 \u3621 \u3633 \u3591 \u3651 \u3609 \u3585 \u3634 \u3619 \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div></div>\
\
    <div class="qb"><div class="q">81. \uc0\u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660 \u3649 \u3610 \u3610 \u3648 \u3611 \u3636 \u3604  (MOOCs) \u3648 \u3611 \u3655 \u3609 \u3626 \u3656 \u3623 \u3609 \u3627 \u3609 \u3638 \u3656 \u3591 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3605 \u3621 \u3629 \u3604 \u3594 \u3637 \u3623 \u3636 \u3605 <br>\u3586 . \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 \u3651 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3629 \u3640 \u3604 \u3617 \u3624 \u3638 \u3585 \u3625 \u3634 <br>\u3588 . \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3613 \u3638 \u3585 \u3629 \u3610 \u3619 \u3617 \u3623 \u3636 \u3594 \u3634 \u3594 \u3637 \u3614 <br>\u3591 . \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3612 \u3621 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3605 \u3621 \u3629 \u3604 \u3594 \u3637 \u3623 \u3636 \u3605 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660 \u3649 \u3610 \u3610 \u3648 \u3611 \u3636 \u3604  (Massive Open Online Courses) \u3648 \u3611 \u3655 \u3609 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3626 \u3635 \u3588 \u3633 \u3597 \u3651 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3605 \u3621 \u3629 \u3604 \u3594 \u3637 \u3623 \u3636 \u3605 \u3651 \u3627 \u3657 \u3588 \u3609 \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591 \u3588 \u3623 \u3634 \u3617 \u3619 \u3641 \u3657 \u3652 \u3604 \u3657 \u3607 \u3640 \u3585 \u3607 \u3637 \u3656 \u3607 \u3640 \u3585 \u3648 \u3623 \u3621 \u3634 </div></div>\
\
    <div class="qb"><div class="q">82. \uc0\u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 \u3649 \u3610 \u3610 \u3617 \u3640 \u3656 \u3591 \u3648 \u3611 \u3657 \u3634  \u3617 \u3637 \u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3648 \u3614 \u3656 \u3639 \u3629 \u3594 \u3656 \u3623 \u3618 \u3648 \u3627 \u3621 \u3639 \u3629 \u3585 \u3621 \u3640 \u3656 \u3617 \u3651 \u3604 \u3648 \u3611 \u3655 \u3609 \u3614 \u3636 \u3648 \u3624 \u3625 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3621 \u3640 \u3656 \u3617 \u3588 \u3609 \u3618 \u3634 \u3585 \u3592 \u3609 \u3649 \u3621 \u3632 \u3585 \u3621 \u3640 \u3656 \u3617 \u3612 \u3641 \u3657 \u3604 \u3657 \u3629 \u3618 \u3650 \u3629 \u3585 \u3634 \u3626 \u3650 \u3604 \u3618 \u3605 \u3619 \u3591 <br>\u3586 . \u3585 \u3621 \u3640 \u3656 \u3617 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3649 \u3621 \u3632 \u3612 \u3641 \u3657 \u3651 \u3594 \u3657 \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 <br>\u3588 . \u3585 \u3621 \u3640 \u3656 \u3617 \u3648 \u3604 \u3655 \u3585 \u3649 \u3621 \u3632 \u3648 \u3618 \u3634 \u3623 \u3594 \u3609 <br>\u3591 . \u3585 \u3621 \u3640 \u3656 \u3617 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 \u3649 \u3621 \u3632 \u3612 \u3641 \u3657 \u3614 \u3636 \u3585 \u3634 \u3619 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3621 \u3640 \u3656 \u3617 \u3588 \u3609 \u3618 \u3634 \u3585 \u3592 \u3609 \u3649 \u3621 \u3632 \u3585 \u3621 \u3640 \u3656 \u3617 \u3612 \u3641 \u3657 \u3604 \u3657 \u3629 \u3618 \u3650 \u3629 \u3585 \u3634 \u3626 \u3650 \u3604 \u3618 \u3605 \u3619 \u3591 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 \u3649 \u3610 \u3610 \u3617 \u3640 \u3656 \u3591 \u3648 \u3611 \u3657 \u3634  (Targeted Social Investment) \u3617 \u3637 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3648 \u3614 \u3639 \u3656 \u3629 \u3594 \u3656 \u3623 \u3618 \u3648 \u3627 \u3621 \u3639 \u3629 \u3585 \u3621 \u3640 \u3656 \u3617 \u3607 \u3637 \u3656 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3588 \u3623 \u3634 \u3617 \u3594 \u3656 \u3623 \u3618 \u3648 \u3627 \u3621 \u3639 \u3629 \u3648 \u3611 \u3655 \u3609 \u3614 \u3636 \u3648 \u3624 \u3625  \u3648 \u3594 \u3656 \u3609  \u3588 \u3609 \u3618 \u3634 \u3585 \u3592 \u3609 \u3649 \u3621 \u3632 \u3612 \u3641 \u3657 \u3604 \u3657 \u3629 \u3618 \u3650 \u3629 \u3585 \u3634 \u3626  \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3605 \u3619 \u3591 \u3592 \u3640 \u3604 </div></div>\
\
    <div class="qb"><div class="q">83. \uc0\u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617 \u3651 \u3609 \u3585 \u3634 \u3619 \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3618 \u3640 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617  \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3585 \u3621 \u3652 \u3585 \u3594 \u3656 \u3623 \u3618 \u3648 \u3627 \u3621 \u3639 \u3629 \u3651 \u3588 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3612 \u3641 \u3657 \u3617 \u3637 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3609 \u3657 \u3629 \u3618 \u3651 \u3609 \u3585 \u3634 \u3619 \u3605 \u3656 \u3629 \u3626 \u3641 \u3657 \u3588 \u3604 \u3637 <br>\u3586 . \u3612 \u3641 \u3657 \u3585 \u3619 \u3632 \u3607 \u3635 \u3588 \u3623 \u3634 \u3617 \u3612 \u3636 \u3604 \u3607 \u3637 \u3656 \u3585 \u3621 \u3633 \u3610 \u3651 \u3592 <br>\u3588 . \u3648 \u3592 \u3657 \u3634 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3651 \u3609 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3618 \u3640 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 <br>\u3591 . \u3614 \u3618 \u3634 \u3609 \u3651 \u3609 \u3588 \u3604 \u3637 \u3626 \u3635 \u3588 \u3633 \u3597 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3612 \u3641 \u3657 \u3617 \u3637 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3609 \u3657 \u3629 \u3618 \u3651 \u3609 \u3585 \u3634 \u3619 \u3605 \u3656 \u3629 \u3626 \u3641 \u3657 \u3588 \u3604 \u3637 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3614 \u3639 \u3656 \u3629 \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3627 \u3621 \u3639 \u3656 \u3629 \u3617 \u3621 \u3657 \u3635 \u3651 \u3609 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3618 \u3640 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617  \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3585 \u3621 \u3652 \u3585 \u3594 \u3656 \u3623 \u3618 \u3648 \u3627 \u3621 \u3639 \u3629 \u3612 \u3641 \u3657 \u3617 \u3637 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3609 \u3657 \u3629 \u3618 \u3651 \u3627 \u3657 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591 \u3588 \u3623 \u3634 \u3617 \u3618 \u3640 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3605 \u3656 \u3629 \u3626 \u3641 \u3657 \u3588 \u3604 \u3637 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3607 \u3656 \u3634 \u3648 \u3607 \u3637 \u3618 \u3617 </div></div>\
\
    <div class="qb"><div class="q">84. \uc0\u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634  \'93\u3648 \u3617 \u3639 \u3629 \u3591 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 \'94 (Smart City) \u3648 \u3611 \u3655 \u3609 \u3626 \u3656 \u3623 \u3609 \u3627 \u3609 \u3638 \u3656 \u3591 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3619 \u3632 \u3610 \u3610 \u3648 \u3617 \u3639 \u3629 \u3591 \u3607 \u3637 \u3656 \u3648 \u3629 \u3657 \u3639 \u3629 \u3605 \u3656 \u3629 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3594 \u3637 \u3623 \u3636 \u3605 \u3649 \u3621 \u3632 \u3626 \u3633 \u3591 \u3588 \u3617 \u3607 \u3637 \u3656 \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3649 \u3621 \u3632 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 <br>\u3586 . \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3651 \u3609 \u3648 \u3586 \u3605 \u3648 \u3617 \u3639 \u3629 \u3591 <br>\u3588 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3611 \u3633 \u3597 \u3627 \u3634 \u3585 \u3634 \u3619 \u3592 \u3619 \u3634 \u3592 \u3619 \u3649 \u3621 \u3632 \u3617 \u3621 \u3614 \u3636 \u3625 <br>\u3591 . \u3585 \u3634 \u3619 \u3648 \u3614 \u3656 \u3636 \u3617 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3648 \u3617 \u3639 \u3629 \u3591 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3594 \u3637 \u3623 \u3636 \u3605 \u3649 \u3621 \u3632 \u3626 \u3633 \u3591 \u3588 \u3617 \u3607 \u3637 \u3656 \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3649 \u3621 \u3632 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3617 \u3639 \u3629 \u3591 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632  (Smart City) \u3648 \u3611 \u3655 \u3609 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3651 \u3609 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3619 \u3632 \u3610 \u3610 \u3648 \u3617 \u3639 \u3629 \u3591 \u3651 \u3627 \u3657 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3605 \u3629 \u3610 \u3626 \u3609 \u3629 \u3591 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3594 \u3637 \u3623 \u3636 \u3605 \u3649 \u3621 \u3632 \u3626 \u3633 \u3591 \u3588 \u3617 \u3607 \u3637 \u3656 \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3649 \u3621 \u3632 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3607 \u3640 \u3585 \u3588 \u3609 </div></div>\
\
    <div class="qb"><div class="q">85. \uc0\u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3607 \u3640 \u3585 \u3648 \u3614 \u3624 \u3617 \u3637 \u3626 \u3656 \u3623 \u3609 \u3619 \u3656 \u3623 \u3617 \u3619 \u3633 \u3610 \u3612 \u3636 \u3604 \u3594 \u3629 \u3610 \u3588 \u3619 \u3629 \u3610 \u3588 \u3619 \u3633 \u3623 \u3649 \u3621 \u3632 \u3619 \u3656 \u3623 \u3617 \u3585 \u3633 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3626 \u3633 \u3591 \u3588 \u3617  \u3648 \u3611 \u3655 \u3609 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588 \u3607 \u3634 \u3591 \u3648 \u3614 \u3624 \u3649 \u3621 \u3632 \u3610 \u3607 \u3610 \u3634 \u3607 \u3586 \u3629 \u3591 \u3626 \u3605 \u3619 \u3637 <br>\u3586 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 \u3648 \u3586 \u3657 \u3617 \u3649 \u3586 \u3655 \u3591 \u3607 \u3656 \u3637 \u3649 \u3610 \u3656 \u3591 \u3611 \u3633 \u3609 <br>\u3588 . \u3619 \u3629 \u3591 \u3619 \u3633 \u3610 \u3626 \u3633 \u3591 \u3588 \u3617 \u3626 \u3641 \u3591 \u3623 \u3633 \u3618 \u3629 \u3618 \u3656 \u3634 \u3591 \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 <br>\u3591 . \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3614 \u3621 \u3633 \u3591 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588 \u3607 \u3634 \u3591 \u3648 \u3614 \u3624 \u3649 \u3621 \u3632 \u3610 \u3607 \u3610 \u3634 \u3607 \u3586 \u3629 \u3591 \u3626 \u3605 \u3619 \u3637 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588 \u3607 \u3634 \u3591 \u3648 \u3614 \u3624 \u3649 \u3621 \u3632 \u3610 \u3607 \u3610 \u3634 \u3607 \u3586 \u3629 \u3591 \u3626 \u3605 \u3619 \u3637  \u3617 \u3637 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3607 \u3640 \u3585 \u3648 \u3614 \u3624 \u3617 \u3637 \u3626 \u3656 \u3623 \u3609 \u3619 \u3656 \u3623 \u3617 \u3651 \u3609 \u3585 \u3634 \u3619 \u3619 \u3633 \u3610 \u3612 \u3636 \u3604 \u3594 \u3629 \u3610 \u3588 \u3619 \u3629 \u3610 \u3588 \u3619 \u3633 \u3623 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3626 \u3633 \u3591 \u3588 \u3617 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3607 \u3656 \u3634 \u3648 \u3607 \u3637 \u3618 \u3617 \u3585 \u3633 \u3609 </div></div>\
\
    <div class="qb"><div class="q">86. \uc0\u3585 \u3634 \u3619 \u3648 \u3614 \u3656 \u3636 \u3617 \u3586 \u3637 \u3604 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3586 \u3629 \u3591 \u3594 \u3640 \u3617 \u3594 \u3609 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609 \u3651 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3605 \u3609 \u3648 \u3629 \u3591  \u3626 \u3629 \u3604 \u3588 \u3621 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3592 \u3634 \u3618 \u3629 \u3635 \u3609 \u3634 \u3592 <br>\u3586 . \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3619 \u3623 \u3617 \u3624 \u3641 \u3609 \u3618 \u3660 \u3629 \u3635 \u3609 \u3634 \u3592 <br>\u3588 . \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3617 \u3637 \u3626 \u3656 \u3623 \u3609 \u3619 \u3656 \u3623 \u3617 <br>\u3591 . \u3627 \u3621 \u3633 \u3585 \u3608 \u3619 \u3619 \u3617 \u3634 \u3616 \u3636 \u3610 \u3634 \u3621 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3592 \u3634 \u3618 \u3629 \u3635 \u3609 \u3634 \u3592 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3648 \u3614 \u3636 \u3656 \u3617 \u3586 \u3637 \u3604 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3627 \u3657 \u3594 \u3640 \u3617 \u3594 \u3609 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3605 \u3609 \u3648 \u3629 \u3591 \u3652 \u3604 \u3657  \u3626 \u3629 \u3604 \u3588 \u3621 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3592 \u3634 \u3618 \u3629 \u3635 \u3609 \u3634 \u3592  (Decentralization)</div></div>\
\
    <div class="qb"><div class="q">87. \uc0\u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609  (SDGs) \u3586 \u3629 \u3591 \u3626 \u3627 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3634 \u3605 \u3636  \u3606 \u3641 \u3585 \u3609 \u3635 \u3617 \u3634 \u3651 \u3594 \u3657 \u3648 \u3611 \u3655 \u3609 \u3585 \u3619 \u3629 \u3610 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3651 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3610 \u3609 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3594 \u3637 \u3623 \u3636 \u3605 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 <br>\u3586 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3650 \u3629 \u3585 \u3634 \u3626 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 <br>\u3588 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 <br>\u3591 . \u3607 \u3640 \u3585 \u3604 \u3657 \u3634 \u3609 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3610 \u3609 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3594 \u3637 \u3623 \u3636 \u3605 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3610 \u3609 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3594 \u3637 \u3623 \u3636 \u3605 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617  \u3652 \u3604 \u3657 \u3609 \u3657 \u3629 \u3617 \u3609 \u3635 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609  (SDGs) \u3617 \u3634 \u3648 \u3611 \u3655 \u3609 \u3585 \u3619 \u3629 \u3610 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3627 \u3621 \u3633 \u3585 </div></div>\
\
    <div class="qb"><div class="q">88. \uc0\u3585 \u3634 \u3619 \u3629 \u3609 \u3640 \u3619 \u3633 \u3585 \u3625 \u3660 \u3649 \u3621 \u3632 \u3615 \u3657 \u3639 \u3609 \u3615 \u3641  \'93\u3588 \u3623 \u3634 \u3617 \u3627 \u3621 \u3634 \u3585 \u3627 \u3621 \u3634 \u3618 \u3607 \u3634 \u3591 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614 \'94 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3611 \u3655 \u3609 \u3600 \u3634 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3607 \u3637 \u3656 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3649 \u3621 \u3632 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3656 \u3636 \u3617 \u3607 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3652 \u3604 \u3657 <br>\u3586 . \u3594 \u3656 \u3623 \u3618 \u3604 \u3638 \u3591 \u3604 \u3641 \u3604 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3648 \u3594 \u3636 \u3591 \u3609 \u3636 \u3648 \u3623 \u3624 <br>\u3588 . \u3607 \u3635 \u3651 \u3627 \u3657 \u3619 \u3632 \u3610 \u3610 \u3609 \u3636 \u3648 \u3623 \u3624 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3617 \u3604 \u3640 \u3621 <br>\u3591 . \u3648 \u3611 \u3655 \u3609 \u3649 \u3627 \u3621 \u3656 \u3591 \u3629 \u3634 \u3627 \u3634 \u3619 \u3649 \u3621 \u3632 \u3618 \u3634 \u3619 \u3633 \u3585 \u3625 \u3634 \u3650 \u3619 \u3588 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3648 \u3611 \u3655 \u3609 \u3600 \u3634 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3607 \u3637 \u3656 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3649 \u3621 \u3632 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3656 \u3636 \u3617 \u3607 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3652 \u3604 \u3657 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3588 \u3623 \u3634 \u3617 \u3627 \u3621 \u3634 \u3585 \u3627 \u3621 \u3634 \u3618 \u3607 \u3634 \u3591 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614 \u3648 \u3611 \u3655 \u3609 \u3600 \u3634 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3607 \u3637 \u3656 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3609 \u3635 \u3617 \u3634 \u3605 \u3656 \u3629 \u3618 \u3629 \u3604 \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3656 \u3636 \u3617 \u3607 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3652 \u3604 \u3657  \u3648 \u3594 \u3656 \u3609  \u3651 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3618 \u3634 \u3649 \u3621 \u3632 \u3648 \u3623 \u3594 \u3626 \u3635 \u3629 \u3634 \u3591 </div></div>\
\
    <div class="qb"><div class="q">89. \uc0\u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634  "\u3619 \u3632 \u3610 \u3610 \u3650 \u3588 \u3619 \u3591 \u3586 \u3656 \u3634 \u3618 \u3652 \u3615 \u3615 \u3657 \u3634 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 " (Smart Grid) \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3611 \u3619 \u3632 \u3648 \u3616 \u3607 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3607 \u3604 \u3649 \u3607 \u3609 \u3649 \u3621 \u3632 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3607 \u3634 \u3591 \u3648 \u3621 \u3639 \u3629 \u3585 <br>\u3586 . \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3615 \u3629 \u3626 \u3595 \u3636 \u3621 <br>\u3588 . \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3609 \u3636 \u3623 \u3648 \u3588 \u3621 \u3637 \u3618 \u3619 \u3660 <br>\u3591 . \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3619 \u3657 \u3629 \u3609 \u3651 \u3605 \u3657 \u3614 \u3636 \u3616 \u3614 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3607 \u3604 \u3649 \u3607 \u3609 \u3649 \u3621 \u3632 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3607 \u3634 \u3591 \u3648 \u3621 \u3639 \u3629 \u3585 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : Smart Grid \u3648 \u3611 \u3655 \u3609 \u3619 \u3632 \u3610 \u3610 \u3607 \u3637 \u3656 \u3594 \u3656 \u3623 \u3618 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3649 \u3621 \u3632 \u3592 \u3656 \u3634 \u3618 \u3652 \u3615 \u3615 \u3657 \u3634 \u3651 \u3627 \u3657 \u3617 \u3637 \u3648 \u3626 \u3606 \u3637 \u3618 \u3619 \u3616 \u3634 \u3614  \u3595 \u3638 \u3656 \u3591 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3636 \u3656 \u3591 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3619 \u3629 \u3591 \u3619 \u3633 \u3610 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3607 \u3604 \u3649 \u3607 \u3609 \u3607 \u3637 \u3656 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3612 \u3633 \u3609 \u3612 \u3623 \u3609  \u3648 \u3594 \u3656 \u3609  \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3649 \u3626 \u3591 \u3629 \u3634 \u3607 \u3636 \u3605 \u3618 \u3660 \u3649 \u3621 \u3632 \u3621 \u3617 </div></div>\
\
    <div class="qb"><div class="q">90. \uc0\u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3607 \u3637 \u3656 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3618 \u3591 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609  \u3609 \u3635 \u3652 \u3611 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3611 \u3619 \u3632 \u3648 \u3616 \u3607 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656  (Big Data)<br>\u3586 . \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3626 \u3656 \u3623 \u3609 \u3610 \u3640 \u3588 \u3588 \u3621 <br>\u3588 . \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3626 \u3606 \u3636 \u3605 \u3636 <br>\u3591 . \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3648 \u3611 \u3636 \u3604 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656  (Big Data)</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3618 \u3591 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3592 \u3634 \u3585 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3605 \u3656 \u3634 \u3591 \u3654  \u3607 \u3635 \u3651 \u3627 \u3657 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3592 \u3635 \u3609 \u3623 \u3609 \u3617 \u3627 \u3634 \u3624 \u3634 \u3621  \u3595 \u3638 \u3656 \u3591 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3609 \u3635 \u3652 \u3611 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3648 \u3611 \u3655 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656  (Big Data) \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3585 \u3635 \u3627 \u3609 \u3604 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 </div></div>\
\
    <div class="qb"><div class="q">91. \uc0\u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637  "\u3592 \u3636 \u3605 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 " \u3627 \u3617 \u3634 \u3618 \u3606 \u3638 \u3591 \u3586 \u3657 \u3629 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3617 \u3640 \u3656 \u3591 \u3617 \u3633 \u3656 \u3609 \u3651 \u3609 \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3605 \u3655 \u3617 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 <br>\u3586 . \u3607 \u3635 \u3591 \u3634 \u3609 \u3605 \u3634 \u3617 \u3588 \u3635 \u3626 \u3633 \u3656 \u3591 \u3586 \u3629 \u3591 \u3612 \u3641 \u3657 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3610 \u3633 \u3597 \u3594 \u3634 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3588 \u3619 \u3656 \u3591 \u3588 \u3619 \u3633 \u3604 <br>\u3588 . \u3651 \u3627 \u3657 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3648 \u3593 \u3614 \u3634 \u3632 \u3612 \u3641 \u3657 \u3607 \u3637 \u3656 \u3617 \u3634 \u3605 \u3636 \u3604 \u3605 \u3656 \u3629 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3648 \u3607 \u3656 \u3634 \u3609 \u3633 \u3657 \u3609 <br>\u3591 . \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3619 \u3641 \u3657 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3619 \u3633 \u3610 \u3612 \u3636 \u3604 \u3594 \u3629 \u3610 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3617 \u3640 \u3656 \u3591 \u3617 \u3633 \u3656 \u3609 \u3651 \u3609 \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3605 \u3655 \u3617 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3592 \u3636 \u3605 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619  (Service Mind) \u3588 \u3639 \u3629  \u3607 \u3633 \u3624 \u3609 \u3588 \u3605 \u3636 \u3649 \u3621 \u3632 \u3614 \u3620 \u3605 \u3636 \u3585 \u3619 \u3619 \u3617 \u3607 \u3637 \u3656 \u3617 \u3640 \u3656 \u3591 \u3617 \u3633 \u3656 \u3609 \u3651 \u3609 \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3605 \u3655 \u3617 \u3651 \u3592 \u3649 \u3621 \u3632 \u3648 \u3605 \u3655 \u3617 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606  \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3588 \u3623 \u3634 \u3617 \u3614 \u3638 \u3591 \u3614 \u3629 \u3651 \u3592 \u3626 \u3641 \u3591 \u3626 \u3640 \u3604 </div></div>\
\
    <div class="qb"><div class="q">92. \uc0\u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3605 \u3657 \u3629 \u3591 \u3617 \u3637 \u3585 \u3634 \u3619  "\u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3607 \u3637 \u3656 \u3629 \u3634 \u3592 \u3648 \u3585 \u3636 \u3604 \u3586 \u3638 \u3657 \u3609 " (Regulatory Impact Assessment: RIA) \u3585 \u3656 \u3629 \u3609 \u3585 \u3634 \u3619 \u3605 \u3619 \u3634 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618  \u3617 \u3637 \u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3648 \u3614 \u3656 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3585 \u3634 \u3619 \u3629 \u3629 \u3585 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3648 \u3611 \u3655 \u3609 \u3652 \u3611 \u3629 \u3618 \u3656 \u3634 \u3591 \u3619 \u3629 \u3610 \u3588 \u3629 \u3610 \u3649 \u3621 \u3632 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 <br>\u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3594 \u3632 \u3621 \u3629 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3629 \u3629 \u3585 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3652 \u3617 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 <br>\u3588 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3619 \u3633 \u3610 \u3615 \u3633 \u3591 \u3588 \u3623 \u3634 \u3617 \u3588 \u3636 \u3604 \u3648 \u3627 \u3655 \u3609 \u3592 \u3634 \u3585 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3604 \u3657 \u3623 \u3618 \u3585 \u3633 \u3609 <br>\u3591 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3607 \u3637 \u3656 \u3605 \u3657 \u3629 \u3591 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3651 \u3594 \u3657 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3585 \u3634 \u3619 \u3629 \u3629 \u3585 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3648 \u3611 \u3655 \u3609 \u3652 \u3611 \u3629 \u3618 \u3656 \u3634 \u3591 \u3619 \u3629 \u3610 \u3588 \u3629 \u3610 \u3649 \u3621 \u3632 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610  (RIA) \u3648 \u3611 \u3655 \u3609 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3612 \u3621 \u3604 \u3637 \u3612 \u3621 \u3648 \u3626 \u3637 \u3618 \u3586 \u3629 \u3591 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3629 \u3618 \u3656 \u3634 \u3591 \u3619 \u3629 \u3610 \u3604 \u3657 \u3634 \u3609 \u3585 \u3656 \u3629 \u3609 \u3607 \u3637 \u3656 \u3592 \u3632 \u3611 \u3619 \u3632 \u3585 \u3634 \u3624 \u3651 \u3594 \u3657  \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3609 \u3633 \u3657 \u3609 \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3649 \u3621 \u3632 \u3652 \u3617 \u3656 \u3626 \u3619 \u3657 \u3634 \u3591 \u3616 \u3634 \u3619 \u3632 \u3648 \u3585 \u3636 \u3609 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 </div></div>\
\
    <div class="qb"><div class="q">93. \uc0\u3619 \u3632 \u3610 \u3610 \u3618 \u3640 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 \u3607 \u3634 \u3591 \u3648 \u3621 \u3639 \u3629 \u3585  \u3648 \u3594 \u3656 \u3609  \u3585 \u3634 \u3619 \u3652 \u3585 \u3621 \u3656 \u3648 \u3585 \u3621 \u3637 \u3656 \u3618 \u3586 \u3657 \u3629 \u3614 \u3636 \u3614 \u3634 \u3607  \u3617 \u3637 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3621 \u3604 \u3611 \u3619 \u3636 \u3617 \u3634 \u3603 \u3588 \u3604 \u3637 \u3586 \u3638 \u3657 \u3609 \u3626 \u3641 \u3656 \u3624 \u3634 \u3621 \u3649 \u3621 \u3632 \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3586 \u3633 \u3604 \u3649 \u3618 \u3657 \u3591 \u3651 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 <br>\u3586 . \u3607 \u3635 \u3651 \u3627 \u3657 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3618 \u3640 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623 \u3618 \u3636 \u3656 \u3591 \u3586 \u3638 \u3657 \u3609 <br>\u3588 . \u3611 \u3619 \u3632 \u3627 \u3618 \u3633 \u3604 \u3588 \u3656 \u3634 \u3651 \u3594 \u3657 \u3592 \u3656 \u3634 \u3618 \u3586 \u3629 \u3591 \u3619 \u3633 \u3600 \u3651 \u3609 \u3585 \u3634 \u3619 \u3604 \u3635 \u3648 \u3609 \u3636 \u3609 \u3588 \u3604 \u3637 <br>\u3591 . \u3648 \u3614 \u3656 \u3636 \u3617 \u3607 \u3634 \u3591 \u3648 \u3621 \u3639 \u3629 \u3585 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3651 \u3609 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3585 \u3619 \u3657 \u3629 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3621 \u3604 \u3611 \u3619 \u3636 \u3617 \u3634 \u3603 \u3588 \u3604 \u3637 \u3586 \u3638 \u3657 \u3609 \u3626 \u3641 \u3656 \u3624 \u3634 \u3621 \u3649 \u3621 \u3632 \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3586 \u3633 \u3604 \u3649 \u3618 \u3657 \u3591 \u3651 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3619 \u3632 \u3610 \u3610 \u3618 \u3640 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 \u3607 \u3634 \u3591 \u3648 \u3621 \u3639 \u3629 \u3585  \u3648 \u3594 \u3656 \u3609  \u3585 \u3634 \u3619 \u3652 \u3585 \u3621 \u3656 \u3648 \u3585 \u3621 \u3637 \u3656 \u3618  \u3594 \u3656 \u3623 \u3618 \u3651 \u3627 \u3657 \u3588 \u3641 \u3656 \u3586 \u3633 \u3604 \u3649 \u3618 \u3657 \u3591 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3605 \u3585 \u3621 \u3591 \u3585 \u3633 \u3609 \u3652 \u3604 \u3657 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3605 \u3657 \u3629 \u3591 \u3612 \u3656 \u3634 \u3609 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3586 \u3629 \u3591 \u3624 \u3634 \u3621  \u3595 \u3638 \u3656 \u3591 \u3594 \u3656 \u3623 \u3618 \u3621 \u3604 \u3611 \u3619 \u3636 \u3617 \u3634 \u3603 \u3588 \u3604 \u3637 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3586 \u3633 \u3604 \u3649 \u3618 \u3657 \u3591 \u3651 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 \u3652 \u3604 \u3657 </div></div>\
\
    <div class="qb"><div class="q">94. \uc0\u3605 \u3634 \u3617 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636  \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3588 \u3634 \u3604 \u3623 \u3656 \u3634 \u3592 \u3632 \u3648 \u3586 \u3657 \u3634 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3648 \u3611 \u3655 \u3609  \'93\u3626 \u3633 \u3591 \u3588 \u3617 \u3626 \u3641 \u3591 \u3623 \u3633 \u3618 \u3619 \u3632 \u3604 \u3633 \u3610 \u3626 \u3640 \u3604 \u3618 \u3629 \u3604 \'94 \u3651 \u3609 \u3611 \u3637 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3614 .\u3624 . 2574<br>\u3586 . \u3614 .\u3624 . 2565<br>\u3588 . \u3614 .\u3624 . 2580<br>\u3591 . \u3614 .\u3624 . 2570</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3614 .\u3624 . 2574</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3588 \u3634 \u3604 \u3585 \u3634 \u3619 \u3603 \u3660 \u3623 \u3656 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3592 \u3632 \u3648 \u3586 \u3657 \u3634 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3648 \u3611 \u3655 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 \u3626 \u3641 \u3591 \u3623 \u3633 \u3618 \u3619 \u3632 \u3604 \u3633 \u3610 \u3626 \u3640 \u3604 \u3618 \u3629 \u3604  (Super-aged society) \u3651 \u3609 \u3611 \u3637  \u3614 .\u3624 . 2574</div></div>\
\
    <div class="qb"><div class="q">95. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3588 \u3623 \u3634 \u3617 \u3607 \u3657 \u3634 \u3607 \u3634 \u3618 \u3626 \u3635 \u3588 \u3633 \u3597 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3607 \u3656 \u3637 \u3585 \u3621 \u3656 \u3634 \u3623 \u3606 \u3638 \u3591 \u3651 \u3609 \u3610 \u3607 \u3609 \u3635 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3585 \u3619 \u3626 \u3641 \u3656 \u3626 \u3633 \u3591 \u3588 \u3617 \u3626 \u3641 \u3591 \u3623 \u3633 \u3618 <br>\u3586 . \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3607 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3585 \u3633 \u3610 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3648 \u3614 \u3656 \u3639 \u3629 \u3609 \u3610 \u3657 \u3634 \u3609 <br>\u3588 . \u3588 \u3623 \u3634 \u3617 \u3586 \u3633 \u3604 \u3649 \u3618 \u3657 \u3591 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3617 \u3639 \u3629 \u3591 \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3591 . \u3616 \u3633 \u3618 \u3614 \u3636 \u3610 \u3633 \u3605 \u3636 \u3607 \u3634 \u3591 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636 \u3607 \u3637 \u3656 \u3619 \u3640 \u3609 \u3649 \u3619 \u3591 \u3586 \u3638 \u3657 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3585 \u3619 \u3626 \u3641 \u3656 \u3626 \u3633 \u3591 \u3588 \u3617 \u3626 \u3641 \u3591 \u3623 \u3633 \u3618 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3585 \u3619 \u3607 \u3637 \u3656 \u3617 \u3637 \u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 \u3648 \u3614 \u3636 \u3656 \u3617 \u3586 \u3638 \u3657 \u3609 \u3649 \u3621 \u3632 \u3623 \u3633 \u3618 \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 \u3621 \u3604 \u3621 \u3591  \u3606 \u3639 \u3629 \u3648 \u3611 \u3655 \u3609 \u3588 \u3623 \u3634 \u3617 \u3607 \u3657 \u3634 \u3607 \u3634 \u3618 \u3626 \u3635 \u3588 \u3633 \u3597 \u3607 \u3656 \u3637 \u3592 \u3632 \u3626 \u3656 \u3591 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3651 \u3609 \u3607 \u3640 \u3585 \u3617 \u3636 \u3605 \u3636 </div></div>\
\
    <div class="qb"><div class="q">96. "\uc0\u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618  4.0" \u3606 \u3641 \u3585 \u3585 \u3621 \u3656 \u3634 \u3623 \u3606 \u3638 \u3591 \u3651 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3651 \u3609 \u3600 \u3634 \u3609 \u3632 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609 \u3651 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3648 \u3611 \u3655 \u3609 \u3648 \u3592 \u3657 \u3634 \u3586 \u3629 \u3591 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 <br>\u3586 . \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 <br>\u3588 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 <br>\u3591 . \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3619 \u3632 \u3610 \u3610 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3634 \u3619 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3648 \u3611 \u3655 \u3609 \u3648 \u3592 \u3657 \u3634 \u3586 \u3629 \u3591 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3652 \u3607 \u3618 \u3649 \u3621 \u3609 \u3604 \u3660  4.0 \u3648 \u3611 \u3655 \u3609 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609 \u3651 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637  \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3648 \u3611 \u3655 \u3609 \u3612 \u3641 \u3657 \u3651 \u3594 \u3657 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3652 \u3611 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3648 \u3611 \u3655 \u3609 \u3648 \u3592 \u3657 \u3634 \u3586 \u3629 \u3591 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 </div></div>\
\
    <div class="qb"><div class="q">97. \uc0\u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3617 \u3639 \u3629 \u3591 \u3651 \u3609 \u3619 \u3632 \u3610 \u3629 \u3610 \u3611 \u3619 \u3632 \u3594 \u3634 \u3608 \u3636 \u3611 \u3652 \u3605 \u3618 \u3629 \u3633 \u3609 \u3617 \u3637 \u3614 \u3619 \u3632 \u3617 \u3627 \u3634 \u3585 \u3625 \u3633 \u3605 \u3619 \u3636 \u3618 \u3660 \u3607 \u3619 \u3591 \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3617 \u3640 \u3586 \u3607 \u3637  \u3656 \u3617 \u3637 \u3648 \u3626 \u3606 \u3637 \u3618 \u3619 \u3616 \u3634 \u3614 \u3649 \u3621 \u3632 \u3617 \u3637 \u3608 \u3619 \u3619 \u3617 \u3634 \u3616 \u3636 \u3610 \u3634 \u3621  \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3651 \u3609 \u3604 \u3657 \u3634 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 <br>\u3586 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3626 \u3617 \u3604 \u3640 \u3621 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 <br>\u3588 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3650 \u3629 \u3585 \u3634 \u3626 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 <br>\u3591 . \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3619 \u3657 \u3634 \u3591 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3648 \u3617 \u3639 \u3629 \u3591 \u3607 \u3637 \u3656 \u3617 \u3637 \u3648 \u3626 \u3606 \u3637 \u3618 \u3619 \u3616 \u3634 \u3614 \u3649 \u3621 \u3632 \u3608 \u3619 \u3619 \u3617 \u3634 \u3616 \u3636 \u3610 \u3634 \u3621 \u3648 \u3611 \u3655 \u3609 \u3611 \u3633 \u3592 \u3592 \u3633 \u3618 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609 \u3607 \u3637 \u3656 \u3626 \u3635 \u3588 \u3633 \u3597 \u3605 \u3656 \u3629 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3592 \u3638 \u3591 \u3592 \u3633 \u3604 \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 </div></div>\
\
    <div class="qb"><div class="q">98. \uc0\u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3651 \u3627 \u3657 \u3617 \u3637  "\u3626 \u3617 \u3619 \u3619 \u3606 \u3609 \u3632 \u3651 \u3627 \u3617 \u3656 \u3654 " \u3648 \u3614 \u3656 \u3639 \u3629 \u3619 \u3629 \u3591 \u3619 \u3633 \u3610 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591  \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3607 \u3635 \u3651 \u3627 \u3657 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3591 \u3634 \u3609 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 \u3649 \u3621 \u3632 \u3607 \u3633 \u3609 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 <br>\u3586 . \u3607 \u3635 \u3651 \u3627 \u3657 \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3585 \u3657 \u3634 \u3623 \u3627 \u3609 \u3657 \u3634 \u3651 \u3609 \u3626 \u3634 \u3618 \u3629 \u3634 \u3594 \u3637 \u3614 <br>\u3588 . \u3607 \u3635 \u3651 \u3627 \u3657 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3621 \u3604 \u3592 \u3635 \u3609 \u3623 \u3609 \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 \u3621 \u3591 \u3652 \u3604 \u3657 <br>\u3591 . \u3607 \u3635 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3614 \u3638 \u3591 \u3614 \u3629 \u3651 \u3592 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3586 \u3629 \u3591 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3634 \u3585 \u3586 \u3657 \u3638 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3607 \u3635 \u3651 \u3627 \u3657 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3591 \u3634 \u3609 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 \u3649 \u3621 \u3632 \u3607 \u3633 \u3609 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3650 \u3621 \u3585 \u3607 \u3637 \u3656 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3629 \u3618 \u3656 \u3634 \u3591 \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623 \u3607 \u3635 \u3651 \u3627 \u3657 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3605 \u3657 \u3629 \u3591 \u3611 \u3619 \u3633 \u3610 \u3605 \u3633 \u3623  \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3592 \u3638 \u3591 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3605 \u3657 \u3629 \u3591 \u3617 \u3637 \u3626 \u3617 \u3619 \u3619 \u3606 \u3609 \u3632 \u3651 \u3627 \u3617 \u3656 \u3654  \u3607 \u3637 \u3656 \u3626 \u3629 \u3604 \u3588 \u3621 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3610 \u3619 \u3636 \u3610 \u3607 \u3607 \u3637 \u3656 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3652 \u3611  \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3591 \u3634 \u3609 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 </div></div>\
\
    <div class="qb"><div class="q">99. \uc0\u3585 \u3634 \u3619 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3651 \u3594 \u3657 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3588 \u3619 \u3656 \u3591 \u3588 \u3619 \u3633 \u3604  \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617  \u3649 \u3621 \u3632 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588  \u3648 \u3611 \u3655 \u3609 \u3629 \u3591 \u3588 \u3660 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3618 \u3640 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 \u3648 \u3588 \u3634 \u3619 \u3614 \u3626 \u3636 \u3607 \u3608 \u3636 \u3617 \u3609 \u3640 \u3625 \u3618 \u3594 \u3609 \u3649 \u3621 \u3632 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3605 \u3656 \u3629 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3650 \u3604 \u3618 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588 <br>\u3586 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626  \u3611 \u3621 \u3629 \u3604 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3614 \u3620 \u3605 \u3636 \u3617 \u3636 \u3594 \u3629 \u3610 <br>\u3588 . \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3629 \u3604 \u3588 \u3621 \u3657 \u3629 \u3591 \u3648 \u3627 \u3617 \u3634 \u3632 \u3626 \u3617 \u3585 \u3633 \u3610 \u3610 \u3619 \u3636 \u3610 \u3607 \u3605 \u3656 \u3634 \u3591 \u3654 <br>\u3591 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3637 \u3656 \u3618 \u3638 \u3604 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3618 \u3640 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 \u3648 \u3588 \u3634 \u3619 \u3614 \u3626 \u3636 \u3607 \u3608 \u3636 \u3617 \u3609 \u3640 \u3625 \u3618 \u3594 \u3609 \u3649 \u3621 \u3632 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3605 \u3656 \u3629 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3650 \u3604 \u3618 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3651 \u3594 \u3657 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3626 \u3617 \u3629 \u3616 \u3634 \u3588 \u3648 \u3611 \u3655 \u3609 \u3627 \u3633 \u3623 \u3651 \u3592 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3618 \u3640 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 \u3607 \u3637 \u3656 \u3648 \u3588 \u3634 \u3619 \u3614 \u3626 \u3636 \u3607 \u3608 \u3636 \u3617 \u3609 \u3640 \u3625 \u3618 \u3594 \u3609  \u3649 \u3621 \u3632 \u3607 \u3635 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3633 \u3656 \u3609 \u3651 \u3609 \u3588 \u3623 \u3634 \u3617 \u3618 \u3640 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 </div></div>\
\
    <div class="qb" style="border-bottom:none;"><div class="q">100. \uc0\u3585 \u3634 \u3619 \u3610 \u3619 \u3619 \u3621 \u3640 \u3623 \u3636 \u3626 \u3633 \u3618 \u3607 \u3633 \u3624 \u3609 \u3660  \'93\u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591  \u3617 \u3633 \u3656 \u3591 \u3588 \u3656 \u3633 \u3591  \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \'94 \u3592 \u3632 \u3626 \u3656 \u3591 \u3612 \u3621 \u3604 \u3637 \u3605 \u3656 \u3629 \u3651 \u3588 \u3619 \u3617 \u3634 \u3585 \u3607 \u3656 \u3637 \u3626 \u3640 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3588 \u3609 \u3652 \u3607 \u3618 \u3607 \u3640 \u3585 \u3588 \u3609 <br>\u3586 . \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3649 \u3621 \u3632 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 <br>\u3588 . \u3616 \u3634 \u3588 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3609 \u3633 \u3585 \u3621 \u3591 \u3607 \u3640 \u3609 <br>\u3591 . \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3649 \u3621 \u3632 \u3612 \u3641 \u3657 \u3651 \u3594 \u3657 \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3588 \u3609 \u3652 \u3607 \u3618 \u3607 \u3640 \u3585 \u3588 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3641 \u3591 \u3626 \u3640 \u3604 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3588 \u3639 \u3629 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3651 \u3609 \u3607 \u3640 \u3585 \u3617 \u3636 \u3605 \u3636  \u3648 \u3614 \u3639 \u3656 \u3629 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3626 \u3640 \u3586 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3612 \u3634 \u3626 \u3640 \u3585 \u3586 \u3629 \u3591 \u3588 \u3609 \u3652 \u3607 \u3618 \u3607 \u3640 \u3585 \u3588 \u3609 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div></div>\
