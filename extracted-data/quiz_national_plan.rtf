    <h1>\uc0\u3649 \u3609 \u3623 \u3586 \u3657 \u3629 \u3626 \u3629 \u3610 : \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621  \u3609 \u3634 \u3618 \u3629 \u3609 \u3640 \u3607 \u3636 \u3609  \u3594 \u3634 \u3597 \u3623 \u3637 \u3619 \u3585 \u3641 \u3621  \u3609 \u3634 \u3618 \u3585 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637  (50 \u3586 \u3657 \u3629 )</h1>\
\
    <div class="qb"><div class="q">1. \uc0\u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3626 \u3635 \u3588 \u3633 \u3597  3 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3651 \u3594 \u3657 \u3648 \u3611 \u3655 \u3609 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609 \u3651 \u3609 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3612 \u3656 \u3609 \u3604 \u3636 \u3609 \u3588 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3626 \u3633 \u3609 \u3605 \u3636 \u3616 \u3634 \u3614  \u3648 \u3626 \u3606 \u3637 \u3618 \u3619 \u3616 \u3634 \u3614  \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3591 \u3588 \u3656 \u3633 \u3591 <br>\u3586 . \u3585 \u3634 \u3619 \u3614 \u3636 \u3607 \u3633 \u3585 \u3625 \u3660 \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3631 , \u3618 \u3638 \u3604 \u3617 \u3633 \u3656 \u3609 \u3611 \u3619 \u3632 \u3594 \u3634 \u3608 \u3636 \u3611 \u3652 \u3605 \u3618  \u3649 \u3621 \u3632 \u3627 \u3621 \u3633 \u3585 \u3609 \u3636 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 <br>\u3588 . \u3588 \u3623 \u3634 \u3617 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626  \u3588 \u3623 \u3634 \u3617 \u3588 \u3640 \u3657 \u3617 \u3588 \u3656 \u3634  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3617 \u3637 \u3626 \u3656 \u3623 \u3609 \u3619 \u3656 \u3623 \u3617 <br>\u3591 . \u3588 \u3623 \u3634 \u3617 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618  \u3588 \u3623 \u3634 \u3617 \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3621 \u3604 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3614 \u3636 \u3607 \u3633 \u3585 \u3625 \u3660 \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3631 , \u3618 \u3638 \u3604 \u3617 \u3633 \u3656 \u3609 \u3611 \u3619 \u3632 \u3594 \u3634 \u3608 \u3636 \u3611 \u3652 \u3605 \u3618  \u3649 \u3621 \u3632 \u3627 \u3621 \u3633 \u3585 \u3609 \u3636 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3619 \u3632 \u3610 \u3640 \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3626 \u3635 \u3588 \u3633 \u3597  3 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619 \u3588 \u3639 \u3629  1. \u3614 \u3636 \u3607 \u3633 \u3585 \u3625 \u3660 \u3619 \u3633 \u3585 \u3625 \u3634 \u3652 \u3623 \u3657 \u3595 \u3638 \u3656 \u3591 \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3594 \u3634 \u3605 \u3636  \u3624 \u3634 \u3626 \u3609 \u3634  \u3649 \u3621 \u3632 \u3614 \u3619 \u3632 \u3617 \u3627 \u3634 \u3585 \u3625 \u3633 \u3605 \u3619 \u3636 \u3618 \u3660  2. \u3618 \u3638 \u3604 \u3617 \u3633 \u3656 \u3609 \u3585 \u3634 \u3619 \u3611 \u3585 \u3588 \u3619 \u3629 \u3591 \u3651 \u3609 \u3619 \u3632 \u3610 \u3629 \u3610 \u3611 \u3619 \u3632 \u3594 \u3634 \u3608 \u3636 \u3611 \u3652 \u3605 \u3618 \u3629 \u3633 \u3609 \u3617 \u3637 \u3614 \u3619 \u3632 \u3617 \u3627 \u3634 \u3585 \u3625 \u3633 \u3605 \u3619 \u3636 \u3618 \u3660 \u3607 \u3619 \u3591 \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3617 \u3640 \u3586  \u3649 \u3621 \u3632  3. \u3618 \u3638 \u3604 \u3617 \u3633 \u3656 \u3609 \u3651 \u3609 \u3627 \u3621 \u3633 \u3585 \u3609 \u3636 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617  \u3585 \u3634 \u3619 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3651 \u3594 \u3657 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3612 \u3656 \u3609 \u3604 \u3636 \u3609 \u3610 \u3609 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609 \u3586 \u3629 \u3591 \u3608 \u3619 \u3619 \u3617 \u3634 \u3616 \u3636 \u3610 \u3634 \u3621  \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3611 \u3655 \u3609 \u3585 \u3619 \u3629 \u3610 \u3609 \u3635 \u3607 \u3634 \u3591 \u3651 \u3609 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3588 \u3623 \u3634 \u3617 \u3626 \u3591 \u3610 \u3626 \u3640 \u3586 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3649 \u3585 \u3656 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 </div></div>\
\
    <div class="qb"><div class="q">2. \uc0\u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3649 \u3610 \u3610  "Cluster" \u3617 \u3637 \u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3627 \u3621 \u3633 \u3585 \u3648 \u3614 \u3656 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3614 \u3656 \u3636 \u3617 \u3592 \u3635 \u3609 \u3623 \u3609 \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 \u3651 \u3609 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597 <br>\u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3648 \u3594 \u3636 \u3591 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3610 \u3609 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3649 \u3621 \u3632 \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3648 \u3604 \u3637 \u3618 \u3623 \u3585 \u3633 \u3609 <br>\u3588 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3649 \u3618 \u3585 \u3626 \u3656 \u3623 \u3609 \u3591 \u3634 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3629 \u3636 \u3626 \u3619 \u3632 \u3605 \u3656 \u3629 \u3585 \u3633 \u3609 \u3617 \u3634 \u3585 \u3586 \u3657 \u3638 \u3609 <br>\u3591 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3621 \u3604 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3619 \u3634 \u3618 \u3592 \u3656 \u3634 \u3618 \u3651 \u3609 \u3616 \u3634 \u3614 \u3619 \u3623 \u3617 \u3586 \u3629 \u3591 \u3649 \u3605 \u3656 \u3621 \u3632 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3648 \u3594 \u3636 \u3591 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3610 \u3609 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3649 \u3621 \u3632 \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3648 \u3604 \u3637 \u3618 \u3623 \u3585 \u3633 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3649 \u3610 \u3610  Cluster \u3627 \u3619 \u3639 \u3629 \u3585 \u3621 \u3640 \u3656 \u3617 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660  \u3648 \u3611 \u3655 \u3609 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3637 \u3656 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3607 \u3621 \u3634 \u3618 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3649 \u3610 \u3610 \u3649 \u3618 \u3585 \u3626 \u3656 \u3623 \u3609  (Silos) \u3650 \u3604 \u3618 \u3585 \u3635 \u3627 \u3609 \u3604 \u3651 \u3627 \u3657 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3617 \u3637 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591 \u3585 \u3633 \u3609 \u3617 \u3634 \u3607 \u3635 \u3591 \u3634 \u3609 \u3619 \u3656 \u3623 \u3617 \u3585 \u3633 \u3609 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3649 \u3621 \u3632 \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3648 \u3604 \u3637 \u3618 \u3623 \u3585 \u3633 \u3609  \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 \u3626 \u3641 \u3591 \u3626 \u3640 \u3604 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3611 \u3633 \u3597 \u3627 \u3634 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3595 \u3657 \u3635 \u3595 \u3657 \u3629 \u3609 \u3586 \u3629 \u3591 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603  \u3649 \u3621 \u3632 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3605 \u3629 \u3610 \u3626 \u3609 \u3629 \u3591 \u3588 \u3623 \u3634 \u3617 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3588 \u3619 \u3629 \u3610 \u3588 \u3621 \u3640 \u3617 \u3607 \u3640 \u3585 \u3617 \u3636 \u3605 \u3636 </div></div>\
\
    <div class="qb"><div class="q">3. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3612 \u3656 \u3634 \u3609 \u3626 \u3641 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621  (Government Digital Transformation)</div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3618 \u3585 \u3648 \u3621 \u3636 \u3585 \u3585 \u3634 \u3619 \u3592 \u3657 \u3634 \u3591 \u3591 \u3634 \u3609 \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 \u3651 \u3609 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 <br>\u3586 . \u3585 \u3634 \u3619 \u3648 \u3614 \u3656 \u3636 \u3617 \u3588 \u3623 \u3634 \u3617 \u3649 \u3617 \u3656 \u3609 \u3618 \u3635  \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623  \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626  \u3649 \u3621 \u3632 \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3652 \u3604 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 <br>\u3588 . \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3595 \u3639 \u3657 \u3629 \u3629 \u3640 \u3611 \u3585 \u3619 \u3603 \u3660 \u3588 \u3629 \u3617 \u3614 \u3636 \u3623 \u3648 \u3605 \u3629 \u3619 \u3660 \u3619 \u3634 \u3588 \u3634 \u3649 \u3614 \u3591 \u3651 \u3627 \u3657 \u3588 \u3619 \u3610 \u3607 \u3640 \u3585 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 <br>\u3591 . \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3652 \u3615 \u3621 \u3660 \u3616 \u3634 \u3614 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3648 \u3614 \u3656 \u3636 \u3617 \u3588 \u3623 \u3634 \u3617 \u3649 \u3617 \u3656 \u3609 \u3618 \u3635  \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623  \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626  \u3649 \u3621 \u3632 \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3652 \u3604 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3612 \u3656 \u3634 \u3609 \u3626 \u3641 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621  \u3588 \u3639 \u3629 \u3585 \u3634 \u3619 \u3609 \u3635 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3626 \u3634 \u3619 \u3626 \u3609 \u3648 \u3607 \u3624 \u3617 \u3634 \u3611 \u3619 \u3633 \u3610 \u3611 \u3619 \u3640 \u3591 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3651 \u3627 \u3657 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618  \u3650 \u3604 \u3618 \u3648 \u3609 \u3657 \u3609 \u3588 \u3623 \u3634 \u3617 \u3649 \u3617 \u3656 \u3609 \u3618 \u3635 \u3651 \u3609 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621  \u3588 \u3623 \u3634 \u3617 \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623 \u3651 \u3609 \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609  \u3588 \u3623 \u3634 \u3617 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626 \u3651 \u3609 \u3607 \u3640 \u3585 \u3586 \u3657 \u3633 \u3609 \u3605 \u3629 \u3609  \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3652 \u3604 \u3657  \u3648 \u3614 \u3639 \u3656 \u3629 \u3621 \u3604 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 \u3649 \u3621 \u3632 \u3648 \u3614 \u3656 \u3636 \u3617 \u3588 \u3623 \u3634 \u3617 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3633 \u3656 \u3609 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3607 \u3637 \u3656 \u3617 \u3637 \u3605 \u3656 \u3629 \u3619 \u3632 \u3610 \u3610 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </div></div>\
\
    <div class="qb"><div class="q">4. \uc0\u3619 \u3632 \u3610 \u3610  "Super License" \u3607 \u3637 \u3656 \u3619 \u3632 \u3610 \u3640 \u3651 \u3609 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3588 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3651 \u3610 \u3629 \u3609 \u3640 \u3597 \u3634 \u3605 \u3586 \u3633 \u3610 \u3586 \u3656 \u3637 \u3619 \u3606 \u3618 \u3609 \u3605 \u3660 \u3652 \u3615 \u3615 \u3657 \u3634 \u3649 \u3610 \u3610 \u3614 \u3636 \u3648 \u3624 \u3625 <br>\u3586 . \u3619 \u3632 \u3610 \u3610 \u3627 \u3621 \u3633 \u3585 \u3651 \u3609 \u3585 \u3634 \u3619 \u3629 \u3635 \u3609 \u3623 \u3618 \u3588 \u3623 \u3634 \u3617 \u3626 \u3632 \u3604 \u3623 \u3585 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3626 \u3634 \u3608 \u3634 \u3619 \u3603 \u3632 \u3649 \u3585 \u3656 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 <br>\u3588 . \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3626 \u3636 \u3607 \u3608 \u3636 \u3614 \u3636 \u3648 \u3624 \u3625 \u3649 \u3585 \u3656 \u3610 \u3619 \u3636 \u3625 \u3633 \u3607 \u3586 \u3657 \u3634 \u3617 \u3594 \u3634 \u3605 \u3636 \u3651 \u3609 \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 <br>\u3591 . \u3619 \u3632 \u3610 \u3610 \u3619 \u3633 \u3585 \u3625 \u3634 \u3588 \u3623 \u3634 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 \u3607 \u3634 \u3591 \u3652 \u3595 \u3648 \u3610 \u3629 \u3619 \u3660 \u3586 \u3633 \u3657 \u3609 \u3626 \u3641 \u3591 \u3586 \u3629 \u3591 \u3585 \u3629 \u3591 \u3607 \u3633 \u3614 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3619 \u3632 \u3610 \u3610 \u3627 \u3621 \u3633 \u3585 \u3651 \u3609 \u3585 \u3634 \u3619 \u3629 \u3635 \u3609 \u3623 \u3618 \u3588 \u3623 \u3634 \u3617 \u3626 \u3632 \u3604 \u3623 \u3585 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3626 \u3634 \u3608 \u3634 \u3619 \u3603 \u3632 \u3649 \u3585 \u3656 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3619 \u3632 \u3610 \u3610  Super License \u3627 \u3619 \u3639 \u3629 \u3619 \u3656 \u3634 \u3591 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3623 \u3656 \u3634 \u3604 \u3657 \u3623 \u3618 \u3585 \u3634 \u3619 \u3629 \u3635 \u3609 \u3623 \u3618 \u3588 \u3623 \u3634 \u3617 \u3626 \u3632 \u3604 \u3623 \u3585 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3626 \u3634 \u3608 \u3634 \u3619 \u3603 \u3632 \u3649 \u3585 \u3656 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609  \u3606 \u3641 \u3585 \u3585 \u3635 \u3627 \u3609 \u3604 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3619 \u3632 \u3610 \u3610 \u3627 \u3621 \u3633 \u3585 \u3607 \u3637 \u3656 \u3592 \u3632 \u3594 \u3656 \u3623 \u3618 \u3621 \u3604 \u3616 \u3634 \u3619 \u3632 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3585 \u3634 \u3619 \u3586 \u3629 \u3629 \u3609 \u3640 \u3597 \u3634 \u3605 \u3605 \u3656 \u3634 \u3591 \u3654  \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3649 \u3621 \u3632 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619  \u3650 \u3604 \u3618 \u3619 \u3623 \u3610 \u3619 \u3623 \u3617 \u3651 \u3610 \u3629 \u3609 \u3640 \u3597 \u3634 \u3605 \u3607 \u3637 \u3656 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3586 \u3657 \u3629 \u3591 \u3648 \u3586 \u3657 \u3634 \u3652 \u3623 \u3657 \u3651 \u3609 \u3619 \u3632 \u3610 \u3610 \u3648 \u3604 \u3637 \u3618 \u3623  \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3649 \u3621 \u3632 \u3621 \u3604 \u3605 \u3657 \u3609 \u3607 \u3640 \u3609 \u3649 \u3613 \u3591 \u3607 \u3637 \u3656 \u3648 \u3585 \u3636 \u3604 \u3592 \u3634 \u3585 \u3588 \u3623 \u3634 \u3617 \u3621 \u3656 \u3634 \u3594 \u3657 \u3634 \u3651 \u3609 \u3619 \u3632 \u3610 \u3610 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </div></div>\
\
    <div class="qb"><div class="q">5. \uc0\u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3605 \u3633 \u3657 \u3591 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3610 \u3619 \u3619 \u3621 \u3640 \u3585 \u3634 \u3619 \u3611 \u3621 \u3656 \u3629 \u3618 \u3585 \u3658 \u3634 \u3595 \u3648 \u3619 \u3639 \u3629 \u3609 \u3585 \u3619 \u3632 \u3592 \u3585 \u3626 \u3640 \u3607 \u3608 \u3636 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660  (Net Zero) \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637 \u3588 \u3619 \u3636 \u3626 \u3605 \u3660 \u3624 \u3633 \u3585 \u3619 \u3634 \u3594 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . 2030<br>\u3586 . 2040<br>\u3588 . 2050<br>\u3591 . 2070</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . 2050</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3652 \u3604 \u3657 \u3611 \u3619 \u3632 \u3585 \u3634 \u3624 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3585 \u3634 \u3619 \u3611 \u3621 \u3656 \u3629 \u3618 \u3585 \u3658 \u3634 \u3595 \u3648 \u3619 \u3639 \u3629 \u3609 \u3585 \u3619 \u3632 \u3592 \u3585 \u3626 \u3640 \u3607 \u3608 \u3636 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660  (Net Zero) \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637  \u3614 .\u3624 . 2593 \u3627 \u3619 \u3639 \u3629  \u3588 .\u3624 . 2050 \u3648 \u3614 \u3656 \u3639 \u3629 \u3619 \u3633 \u3610 \u3617 \u3639 \u3629 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3626 \u3616 \u3634 \u3614 \u3616 \u3641 \u3617 \u3636 \u3629 \u3634 \u3585 \u3634 \u3624 \u3649 \u3621 \u3632 \u3586 \u3657 \u3629 \u3585 \u3635 \u3627 \u3609 \u3604 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3607 \u3637 \u3656 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 </div></div>\
\
    <div class="qb"><div class="q">6. \uc0\u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3651 \u3604 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3609 \u3635 \u3617 \u3634 \u3651 \u3594 \u3657 \u3648 \u3614 \u3656 \u3639 \u3629 \u3648 \u3614 \u3656 \u3636 \u3617 \u3588 \u3623 \u3634 \u3617 \u3649 \u3617 \u3656 \u3609 \u3618 \u3635 \u3651 \u3609 \u3585 \u3634 \u3619 \u3614 \u3618 \u3634 \u3585 \u3619 \u3603 \u3660 \u3629 \u3634 \u3585 \u3634 \u3624 \u3619 \u3632 \u3604 \u3633 \u3610 \u3605 \u3635 \u3610 \u3621 </div>\
    <div class="c">\uc0\u3585 . \u3619 \u3632 \u3610 \u3610 \u3604 \u3634 \u3623 \u3648 \u3607 \u3637 \u3618 \u3617 \u3626 \u3639 \u3656 \u3629 \u3626 \u3634 \u3619 \u3619 \u3640 \u3656 \u3609 \u3648 \u3585 \u3656 \u3634 <br>\u3586 . \u3585 \u3634 \u3619 \u3651 \u3594 \u3657  Big Data \u3649 \u3621 \u3632  AI \u3651 \u3609 \u3585 \u3634 \u3619 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 <br>\u3588 . \u3585 \u3634 \u3619 \u3605 \u3636 \u3604 \u3605 \u3633 \u3657 \u3591 \u3626 \u3606 \u3634 \u3609 \u3637 \u3623 \u3633 \u3604 \u3609 \u3657 \u3635 \u3613 \u3609 \u3651 \u3609 \u3607 \u3640 \u3585 \u3627 \u3617 \u3641 \u3656 \u3610 \u3657 \u3634 \u3609 <br>\u3591 . \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3619 \u3632 \u3610 \u3610 \u3623 \u3636 \u3607 \u3618 \u3640 \u3626 \u3639 \u3656 \u3629 \u3626 \u3634 \u3619 \u3607 \u3634 \u3591 \u3652 \u3585 \u3621 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3651 \u3594 \u3657  Big Data \u3649 \u3621 \u3632  AI \u3651 \u3609 \u3585 \u3634 \u3619 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3604 \u3657 \u3634 \u3609 \u3616 \u3633 \u3618 \u3614 \u3636 \u3610 \u3633 \u3605 \u3636 \u3649 \u3621 \u3632 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 \u3619 \u3632 \u3610 \u3640 \u3651 \u3627 \u3657 \u3617 \u3637 \u3585 \u3634 \u3619 \u3648 \u3619 \u3656 \u3591 \u3614 \u3633 \u3602 \u3609 \u3634  Big Data \u3649 \u3621 \u3632 \u3651 \u3594 \u3657  AI \u3617 \u3634 \u3648 \u3611 \u3655 \u3609 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3627 \u3621 \u3633 \u3585 \u3651 \u3609 \u3585 \u3634 \u3619 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3649 \u3621 \u3632 \u3614 \u3618 \u3634 \u3585 \u3619 \u3603 \u3660 \u3629 \u3634 \u3585 \u3634 \u3624  \u3619 \u3623 \u3617 \u3606 \u3638 \u3591 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3609 \u3657 \u3635 \u3607 \u3633 \u3657 \u3591 \u3619 \u3632 \u3610 \u3610  \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3649 \u3617 \u3656 \u3609 \u3618 \u3635 \u3621 \u3638 \u3585 \u3652 \u3611 \u3606 \u3638 \u3591 \u3619 \u3632 \u3604 \u3633 \u3610 \u3605 \u3635 \u3610 \u3621 </div></div>\
\
    <div class="qb"><div class="q">7. "Skill Bridge" \uc0\u3648 \u3611 \u3655 \u3609 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3607 \u3637 \u3656 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3586 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3604 \u3657 \u3634 \u3609 \u3651 \u3604 \u3617 \u3634 \u3585 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3585 \u3656 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3632 \u3614 \u3634 \u3609 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3618 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3594 \u3634 \u3618 \u3649 \u3604 \u3609 <br>\u3586 . \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3627 \u3621 \u3633 \u3585 \u3626 \u3641 \u3605 \u3619 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3588 \u3609 \u3652 \u3607 \u3618 \u3648 \u3586 \u3657 \u3634 \u3626 \u3641 \u3656 \u3605 \u3621 \u3634 \u3604 \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 \u3652 \u3604 \u3657 \u3607 \u3633 \u3609 \u3607 \u3637 <br>\u3588 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3648 \u3588 \u3619 \u3639 \u3629 \u3586 \u3656 \u3634 \u3618 \u3629 \u3636 \u3609 \u3648 \u3607 \u3629 \u3619 \u3660 \u3648 \u3609 \u3655 \u3605 \u3588 \u3623 \u3634 \u3617 \u3648 \u3619 \u3655 \u3623 \u3626 \u3641 \u3591 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604 <br>\u3591 . \u3585 \u3634 \u3619 \u3650 \u3629 \u3609 \u3618 \u3657 \u3634 \u3618 \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3627 \u3621 \u3633 \u3585 \u3626 \u3641 \u3605 \u3619 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3588 \u3609 \u3652 \u3607 \u3618 \u3648 \u3586 \u3657 \u3634 \u3626 \u3641 \u3656 \u3605 \u3621 \u3634 \u3604 \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 \u3652 \u3604 \u3657 \u3607 \u3633 \u3609 \u3607 \u3637 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : Skill Bridge \u3588 \u3639 \u3629 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3611 \u3619 \u3640 \u3591 \u3627 \u3621 \u3633 \u3585 \u3626 \u3641 \u3605 \u3619 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 \u3649 \u3621 \u3632 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3651 \u3627 \u3657 \u3626 \u3629 \u3604 \u3619 \u3633 \u3610 \u3585 \u3633 \u3610 \u3649 \u3609 \u3623 \u3650 \u3609 \u3657 \u3617 \u3586 \u3629 \u3591 \u3605 \u3621 \u3634 \u3604 \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 \u3651 \u3609 \u3629 \u3609 \u3634 \u3588 \u3605  \u3650 \u3604 \u3618 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3613 \u3638 \u3585 \u3607 \u3633 \u3585 \u3625 \u3632 \u3607 \u3637 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3612 \u3641 \u3657 \u3626 \u3635 \u3648 \u3619 \u3655 \u3592 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3648 \u3586 \u3657 \u3634 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3592 \u3657 \u3634 \u3591 \u3591 \u3634 \u3609 \u3652 \u3604 \u3657 \u3607 \u3633 \u3609 \u3607 \u3637 </div></div>\
\
    <div class="qb"><div class="q">8. \uc0\u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3656 \u3618 \u3591 \u3604 \u3657 \u3634 \u3609 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3586 \u3629 \u3591 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3651 \u3609 \u3626 \u3606 \u3634 \u3609 \u3585 \u3634 \u3619 \u3603 \u3660 \u3588 \u3623 \u3634 \u3617 \u3586 \u3633 \u3604 \u3649 \u3618 \u3657 \u3591 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3648 \u3609 \u3657 \u3609 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3585 \u3633 \u3585 \u3648 \u3585 \u3655 \u3610 \u3609 \u3657 \u3635 \u3617 \u3633 \u3609 \u3652 \u3623 \u3657 \u3651 \u3594 \u3657 \u3648 \u3614 \u3637 \u3618 \u3591 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3604 \u3637 \u3618 \u3623 <br>\u3586 . \u3585 \u3634 \u3619 \u3648 \u3614 \u3656 \u3636 \u3617 \u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3648 \u3594 \u3639 \u3657 \u3629 \u3648 \u3614 \u3621 \u3636 \u3591 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3626 \u3632 \u3629 \u3634 \u3604 <br>\u3588 . \u3585 \u3634 \u3619 \u3586 \u3657 \u3638 \u3609 \u3616 \u3634 \u3625 \u3637 \u3609 \u3657 \u3635 \u3617 \u3633 \u3609 \u3648 \u3614 \u3656 \u3639 \u3629 \u3621 \u3604 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3591 . \u3585 \u3634 \u3619 \u3618 \u3585 \u3648 \u3621 \u3636 \u3585 \u3585 \u3634 \u3619 \u3609 \u3635 \u3648 \u3586 \u3657 \u3634 \u3609 \u3657 \u3635 \u3617 \u3633 \u3609 \u3592 \u3634 \u3585 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3607 \u3657 \u3633 \u3591 \u3627 \u3617 \u3604 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3648 \u3614 \u3656 \u3636 \u3617 \u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3648 \u3594 \u3639 \u3657 \u3629 \u3648 \u3614 \u3621 \u3636 \u3591 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3626 \u3632 \u3629 \u3634 \u3604 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3626 \u3606 \u3634 \u3609 \u3585 \u3634 \u3619 \u3603 \u3660 \u3588 \u3623 \u3634 \u3617 \u3612 \u3633 \u3609 \u3612 \u3623 \u3609 \u3586 \u3629 \u3591 \u3619 \u3634 \u3588 \u3634 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3650 \u3621 \u3585  \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3617 \u3637 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3656 \u3618 \u3591 \u3650 \u3604 \u3618 \u3585 \u3634 \u3619 \u3621 \u3604 \u3585 \u3634 \u3619 \u3614 \u3638 \u3656 \u3591 \u3614 \u3634 \u3609 \u3657 \u3635 \u3617 \u3633 \u3609 \u3648 \u3594 \u3639 \u3657 \u3629 \u3648 \u3614 \u3621 \u3636 \u3591 \u3592 \u3634 \u3585 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3612 \u3656 \u3634 \u3609 \u3585 \u3634 \u3619 \u3648 \u3614 \u3636 \u3656 \u3617 \u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3648 \u3594 \u3639 \u3657 \u3629 \u3648 \u3614 \u3621 \u3636 \u3591 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3626 \u3632 \u3629 \u3634 \u3604  \u3619 \u3623 \u3617 \u3606 \u3638 \u3591 \u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3619 \u3634 \u3585 \u3600 \u3634 \u3609 \u3605 \u3621 \u3634 \u3604 \u3652 \u3615 \u3615 \u3657 \u3634 \u3648 \u3626 \u3619 \u3637 </div></div>\
\
    <div class="qb"><div class="q">9. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3651 \u3609 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3627 \u3609 \u3637 \u3657 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 \u3649 \u3610 \u3610  "\u3618 \u3638 \u3604 \u3621 \u3641 \u3585 \u3627 \u3609 \u3637 \u3657 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 "</div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3618 \u3585 \u3618 \u3629 \u3604 \u3627 \u3609 \u3637 \u3657 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 \u3651 \u3627 \u3657 \u3585 \u3633 \u3610 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3607 \u3637 \u3656 \u3617 \u3637 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3609 \u3657 \u3629 \u3618 <br>\u3586 . \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3600 \u3634 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3607 \u3637 \u3656 \u3588 \u3619 \u3629 \u3610 \u3588 \u3621 \u3640 \u3617 \u3649 \u3621 \u3632 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3618 \u3591 \u3607 \u3640 \u3585 \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609 \u3648 \u3614 \u3656 \u3639 \u3629 \u3649 \u3585 \u3657 \u3652 \u3586 \u3627 \u3609 \u3637 \u3657 \u3648 \u3610 \u3655 \u3604 \u3648 \u3626 \u3619 \u3655 \u3592 <br>\u3588 . \u3585 \u3634 \u3619 \u3627 \u3657 \u3634 \u3617 \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609 \u3615 \u3657 \u3629 \u3591 \u3619 \u3657 \u3629 \u3591 \u3621 \u3641 \u3585 \u3627 \u3609 \u3637 \u3657 \u3607 \u3640 \u3585 \u3585 \u3619 \u3603 \u3637 <br>\u3591 . \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3585 \u3641 \u3657 \u3618 \u3639 \u3617 \u3648 \u3591 \u3636 \u3609 \u3651 \u3627 \u3617 \u3656 \u3648 \u3614 \u3656 \u3639 \u3629 \u3652 \u3611 \u3651 \u3594 \u3657 \u3627 \u3609 \u3637 \u3657 \u3648 \u3585 \u3656 \u3634 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3617 \u3637 \u3648 \u3591 \u3639 \u3656 \u3629 \u3609 \u3652 \u3586 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3600 \u3634 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3607 \u3637 \u3656 \u3588 \u3619 \u3629 \u3610 \u3588 \u3621 \u3640 \u3617 \u3649 \u3621 \u3632 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3618 \u3591 \u3607 \u3640 \u3585 \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609 \u3648 \u3614 \u3656 \u3639 \u3629 \u3649 \u3585 \u3657 \u3652 \u3586 \u3627 \u3609 \u3637 \u3657 \u3648 \u3610 \u3655 \u3604 \u3648 \u3626 \u3619 \u3655 \u3592 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3627 \u3609 \u3637 \u3657 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 \u3649 \u3610 \u3610  "\u3618 \u3638 \u3604 \u3621 \u3641 \u3585 \u3627 \u3609 \u3637 \u3657 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 " \u3588 \u3639 \u3629 \u3585 \u3634 \u3619 \u3594 \u3656 \u3623 \u3618 \u3648 \u3627 \u3621 \u3639 \u3629 \u3629 \u3618 \u3656 \u3634 \u3591 \u3588 \u3619 \u3610 \u3623 \u3591 \u3592 \u3619  \u3650 \u3604 \u3618 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3592 \u3632 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3600 \u3634 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3619 \u3634 \u3618 \u3610 \u3640 \u3588 \u3588 \u3621 \u3607 \u3637 \u3656 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3618 \u3591 \u3585 \u3633 \u3610 \u3607 \u3640 \u3585 \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3625 \u3633 \u3607 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3626 \u3636 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3660  \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3648 \u3627 \u3655 \u3609 \u3616 \u3634 \u3614 \u3619 \u3623 \u3617 \u3586 \u3629 \u3591 \u3627 \u3609 \u3637 \u3657 \u3649 \u3621 \u3632 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3629 \u3629 \u3585 \u3649 \u3610 \u3610 \u3623 \u3636 \u3608 \u3637 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3627 \u3609 \u3637 \u3657 \u3607 \u3637 \u3656 \u3648 \u3627 \u3617 \u3634 \u3632 \u3626 \u3617 </div></div>\
\
    <div class="qb"><div class="q">10. \uc0\u3585 \u3634 \u3619 \u3604 \u3638 \u3591 \u3604 \u3641 \u3604 \u3609 \u3633 \u3585 \u3621 \u3591 \u3607 \u3640 \u3609 \u3605 \u3656 \u3634 \u3591 \u3594 \u3634 \u3605 \u3636 \u3650 \u3604 \u3618 \u3648 \u3609 \u3657 \u3609  "\u3610 \u3619 \u3636 \u3625 \u3633 \u3607 \u3619 \u3656 \u3623 \u3617 \u3607 \u3640 \u3609 \u3585 \u3633 \u3610 \u3610 \u3619 \u3636 \u3625 \u3633 \u3607 \u3652 \u3607 \u3618 " \u3617 \u3637 \u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3648 \u3594 \u3636 \u3591 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3610 \u3619 \u3636 \u3625 \u3633 \u3607 \u3652 \u3607 \u3618 \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 <br>\u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3649 \u3610 \u3656 \u3591 \u3616 \u3634 \u3619 \u3632 \u3616 \u3634 \u3625 \u3637 \u3651 \u3627 \u3657 \u3585 \u3633 \u3610 \u3610 \u3619 \u3636 \u3625 \u3633 \u3607 \u3605 \u3656 \u3634 \u3591 \u3594 \u3634 \u3605 \u3636 <br>\u3588 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3588 \u3623 \u3610 \u3588 \u3640 \u3617 \u3610 \u3619 \u3636 \u3625 \u3633 \u3607 \u3605 \u3656 \u3634 \u3591 \u3594 \u3634 \u3605 \u3636 \u3652 \u3604 \u3657 \u3591 \u3656 \u3634 \u3618 \u3586 \u3657 \u3638 \u3609 <br>\u3591 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3621 \u3604 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3610 \u3619 \u3636 \u3625 \u3633 \u3607 \u3652 \u3607 \u3618 \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3585 \u3634 \u3619 \u3604 \u3638 \u3591 \u3604 \u3641 \u3604 \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3592 \u3634 \u3585 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3650 \u3604 \u3618 \u3651 \u3627 \u3657 \u3617 \u3637 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3605 \u3633 \u3657 \u3591 \u3610 \u3619 \u3636 \u3625 \u3633 \u3607 \u3619 \u3656 \u3623 \u3617 \u3607 \u3640 \u3609 \u3585 \u3633 \u3610 \u3610 \u3619 \u3636 \u3625 \u3633 \u3607 \u3652 \u3607 \u3618  \u3617 \u3640 \u3656 \u3591 \u3627 \u3623 \u3633 \u3591 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3585 \u3634 \u3619 \u3606 \u3656 \u3634 \u3618 \u3607 \u3629 \u3604 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3586 \u3633  \u3657 \u3609 \u3626 \u3641 \u3591 \u3649 \u3621 \u3632 \u3629 \u3591 \u3588 \u3660 \u3588 \u3623 \u3634 \u3617 \u3619 \u3641 \u3657 \u3619 \u3632 \u3604 \u3633 \u3610 \u3626 \u3634 \u3585 \u3621 \u3617 \u3634 \u3618 \u3633 \u3591 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3648 \u3611 \u3655 \u3609 \u3585 \u3634 \u3619 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3586 \u3637 \u3604 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 </div></div>\
\
    <div class="qb"><div class="q">11. \uc0\u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3617 \u3637 \u3649 \u3612 \u3609 \u3592 \u3632 \u3648 \u3586 \u3657 \u3634 \u3648 \u3611 \u3655 \u3609 \u3626 \u3617 \u3634 \u3594 \u3636 \u3585 \u3629 \u3591 \u3588 \u3660 \u3585 \u3634 \u3619 \u3651 \u3604 \u3648 \u3614 \u3656 \u3639 \u3629 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3617 \u3634 \u3605 \u3619 \u3600 \u3634 \u3609 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3626 \u3641 \u3656 \u3619 \u3632 \u3604 \u3633 \u3610 \u3626 \u3634 \u3585 \u3621 </div>\
    <div class="c">\uc0\u3585 . BRICS<br>\u3586 . OECD<br>\u3588 . OPEC<br>\u3591 . NATO</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . OECD</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : OECD \u3588 \u3639 \u3629 \u3629 \u3591 \u3588 \u3660 \u3585 \u3634 \u3619 \u3648 \u3614 \u3656 \u3639 \u3629 \u3588 \u3623 \u3634 \u3617 \u3619 \u3656 \u3623 \u3617 \u3617 \u3639 \u3629 \u3607 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3605 \u3633 \u3657 \u3591 \u3648 \u3611 \u3657 \u3634 \u3592 \u3632 \u3648 \u3586 \u3657 \u3634 \u3648 \u3611 \u3655 \u3609 \u3626 \u3617 \u3634 \u3594 \u3636 \u3585 \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637  \u3614 .\u3624 . 2571 \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3594 \u3657 \u3648 \u3611 \u3655 \u3609 \u3585 \u3621 \u3652 \u3585 \u3651 \u3609 \u3585 \u3634 \u3619 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3617 \u3634 \u3605 \u3619 \u3600 \u3634 \u3609 \u3607 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592  \u3585 \u3598 \u3627 \u3617 \u3634 \u3618  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3586 \u3629 \u3591 \u3652 \u3607 \u3618 \u3651 \u3627 \u3657 \u3648 \u3607 \u3637 \u3618 \u3610 \u3648 \u3607 \u3656 \u3634 \u3619 \u3632 \u3604 \u3633 \u3610 \u3626 \u3634 \u3585 \u3621 </div></div>\
\
    <div class="qb"><div class="q">12. \uc0\u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619  "\u3607 \u3627 \u3634 \u3619 \u3629 \u3634 \u3626 \u3634  100,000 \u3629 \u3633 \u3605 \u3619 \u3634 " \u3617 \u3637 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3648 \u3594 \u3636 \u3591 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3605 \u3619 \u3637 \u3618 \u3617 \u3588 \u3623 \u3634 \u3617 \u3614 \u3619 \u3657 \u3629 \u3617 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3626 \u3591 \u3588 \u3619 \u3634 \u3617 \u3648 \u3605 \u3655 \u3617 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 <br>\u3586 . \u3648 \u3611 \u3655 \u3609 \u3600 \u3634 \u3609 \u3619 \u3629 \u3591 \u3619 \u3633 \u3610 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3619 \u3632 \u3610 \u3610 \u3648 \u3585 \u3603 \u3601 \u3660 \u3607 \u3627 \u3634 \u3619 \u3652 \u3611 \u3626 \u3641 \u3656 \u3619 \u3632 \u3610 \u3610 \u3626 \u3617 \u3633 \u3588 \u3619 \u3651 \u3592 \u3651 \u3609 \u3619 \u3632 \u3618 \u3632 \u3618 \u3634 \u3623 <br>\u3588 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3621 \u3604 \u3592 \u3635 \u3609 \u3623 \u3609 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3614 \u3621 \u3648 \u3619 \u3639 \u3629 \u3609 <br>\u3591 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3607 \u3627 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3604 \u3657 \u3634 \u3609 \u3608 \u3640 \u3619 \u3585 \u3634 \u3619 \u3649 \u3607 \u3609 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3607 \u3633 \u3656 \u3623 \u3652 \u3611 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3648 \u3611 \u3655 \u3609 \u3600 \u3634 \u3609 \u3619 \u3629 \u3591 \u3619 \u3633 \u3610 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3619 \u3632 \u3610 \u3610 \u3648 \u3585 \u3603 \u3601 \u3660 \u3607 \u3627 \u3634 \u3619 \u3652 \u3611 \u3626 \u3641 \u3656 \u3619 \u3632 \u3610 \u3610 \u3626 \u3617 \u3633 \u3588 \u3619 \u3651 \u3592 \u3651 \u3609 \u3619 \u3632 \u3618 \u3632 \u3618 \u3634 \u3623 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 \u3607 \u3627 \u3634 \u3619 \u3629 \u3634 \u3626 \u3634  100,000 \u3629 \u3633 \u3605 \u3619 \u3634  \u3648 \u3611 \u3655 \u3609 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3619 \u3632 \u3610 \u3610 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3607 \u3637 \u3656 \u3648 \u3609 \u3657 \u3609 \u3588 \u3623 \u3634 \u3617 \u3626 \u3617 \u3633 \u3588 \u3619 \u3651 \u3592  \u3650 \u3604 \u3618 \u3648 \u3611 \u3636 \u3604 \u3619 \u3633 \u3610 \u3626 \u3617 \u3633 \u3588 \u3619 \u3594 \u3634 \u3618 \u3652 \u3607 \u3618 \u3648 \u3586 \u3657 \u3634 \u3648 \u3611 \u3655 \u3609 \u3607 \u3627 \u3634 \u3619 \u3604 \u3657 \u3623 \u3618 \u3619 \u3632 \u3610 \u3610 \u3626 \u3633 \u3597 \u3597 \u3634 \u3592 \u3657 \u3634 \u3591  4 \u3611 \u3637  \u3617 \u3637 \u3588 \u3656 \u3634 \u3605 \u3629 \u3610 \u3649 \u3607 \u3609 \u3649 \u3621 \u3632 \u3626 \u3623 \u3633 \u3626 \u3604 \u3636 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3648 \u3627 \u3617 \u3634 \u3632 \u3626 \u3617  \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3594 \u3657 \u3648 \u3611 \u3655 \u3609 \u3600 \u3634 \u3609 \u3651 \u3609 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3612 \u3656 \u3634 \u3609 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3648 \u3585 \u3603 \u3601 \u3660 \u3607 \u3627 \u3634 \u3619 \u3649 \u3610 \u3610 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3652 \u3611 \u3626 \u3641 \u3656 \u3619 \u3632 \u3610 \u3610 \u3629 \u3634 \u3626 \u3634 \u3626 \u3617 \u3633 \u3588 \u3619 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3605 \u3655 \u3617 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 </div></div>\
\
    <div class="qb"><div class="q">13. \uc0\u3619 \u3632 \u3610 \u3610  "PromptBiz" \u3606 \u3641 \u3585 \u3619 \u3632 \u3610 \u3640 \u3651 \u3609 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3648 \u3614 \u3639 \u3656 \u3629 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3651 \u3609 \u3604 \u3657 \u3634 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3592 \u3629 \u3591 \u3605 \u3633 \u3659 \u3623 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3610 \u3636 \u3609 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 <br>\u3586 . \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3594 \u3656 \u3623 \u3618 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3621 \u3604 \u3605 \u3657 \u3609 \u3607 \u3640 \u3609 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610  SMEs<br>\u3588 . \u3585 \u3634 \u3619 \u3649 \u3592 \u3657 \u3591 \u3648 \u3605 \u3639 \u3629 \u3609 \u3616 \u3633 \u3618 \u3614 \u3636 \u3610 \u3633 \u3605 \u3636 \u3607 \u3634 \u3591 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636 <br>\u3591 . \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3632 \u3648 \u3610 \u3637 \u3618 \u3609 \u3626 \u3623 \u3633 \u3626 \u3604 \u3636 \u3585 \u3634 \u3619 \u3649 \u3627 \u3656 \u3591 \u3619 \u3633 \u3600 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3594 \u3656 \u3623 \u3618 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3621 \u3604 \u3605 \u3657 \u3609 \u3607 \u3640 \u3609 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610  SMEs</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : PromptBiz \u3648 \u3611 \u3655 \u3609 \u3649 \u3614 \u3621 \u3605 \u3615 \u3629 \u3619 \u3660 \u3617 \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3607 \u3634 \u3591 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3609 \u3635 \u3617 \u3634 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3612 \u3641  \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619  \u3650 \u3604 \u3618 \u3648 \u3593 \u3614 \u3634 \u3632  SMEs \u3651 \u3594 \u3657 \u3648 \u3611 \u3655 \u3609 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3651 \u3609 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3608 \u3640 \u3619 \u3585 \u3619 \u3619 \u3617 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634  \u3648 \u3594 \u3656 \u3609  \u3585 \u3634 \u3619 \u3607 \u3635 \u3651 \u3610 \u3585 \u3635 \u3585 \u3633 \u3610 \u3616 \u3634 \u3625 \u3637 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3594 \u3635 \u3619 \u3632 \u3648 \u3591 \u3636 \u3609 \u3607 \u3637  \u3656 \u3626 \u3632 \u3604 \u3623 \u3585 \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623 </div></div>\
\
    <div class="qb"><div class="q">14. \uc0\u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3609 \u3657 \u3635 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3611 \u3655 \u3609 \u3619 \u3632 \u3610 \u3610 \u3648 \u3614 \u3639 \u3656 \u3629 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3616 \u3633 \u3618 \u3614 \u3636 \u3610 \u3633 \u3605 \u3636 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3649 \u3610 \u3610 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3605 \u3656 \u3634 \u3591 \u3588 \u3609 \u3605 \u3656 \u3634 \u3591 \u3607 \u3635 \u3605 \u3634 \u3617 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3586 \u3629 \u3591 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3605 \u3609 \u3648 \u3629 \u3591 <br>\u3586 . \u3585 \u3634 \u3619 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3649 \u3621 \u3632 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3619 \u3633 \u3610 \u3612 \u3636 \u3604 \u3594 \u3629 \u3610 \u3594 \u3633 \u3604 \u3648 \u3592 \u3609 <br>\u3588 . \u3585 \u3634 \u3619 \u3619 \u3629 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3616 \u3633 \u3618 \u3614 \u3636 \u3610 \u3633 \u3605 \u3636 \u3585 \u3656 \u3629 \u3609 \u3649 \u3621 \u3657 \u3623 \u3588 \u3656 \u3629 \u3618 \u3623 \u3634 \u3591 \u3649 \u3612 \u3609 \u3649 \u3585 \u3657 \u3652 \u3586 <br>\u3591 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3648 \u3586 \u3639 \u3656 \u3629 \u3609 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656 \u3651 \u3609 \u3607 \u3640 \u3585 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604 \u3607 \u3637 \u3656 \u3617 \u3637 \u3649 \u3617 \u3656 \u3609 \u3657 \u3635 \u3612 \u3656 \u3634 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3649 \u3621 \u3632 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3619 \u3633 \u3610 \u3612 \u3636 \u3604 \u3594 \u3629 \u3610 \u3594 \u3633 \u3604 \u3648 \u3592 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3609 \u3657 \u3635 \u3649 \u3609 \u3623 \u3651 \u3627 \u3617 \u3656 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3649 \u3610 \u3610 \u3649 \u3618 \u3585 \u3626 \u3656 \u3623 \u3609 \u3617 \u3634 \u3648 \u3611 \u3655 \u3609 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3649 \u3610 \u3610 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619  \u3650 \u3604 \u3618 \u3617 \u3637 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3619 \u3633 \u3610 \u3612 \u3636 \u3604 \u3594 \u3629 \u3610 \u3627 \u3621 \u3633 \u3585 \u3607 \u3637 \u3656 \u3594 \u3633 \u3604 \u3648 \u3592 \u3609 \u3651 \u3609 \u3649 \u3605 \u3656 \u3621 \u3632 \u3585 \u3621 \u3640 \u3656 \u3617 \u3621 \u3640 \u3656 \u3617 \u3609 \u3657 \u3635  \u3649 \u3621 \u3632 \u3651 \u3594 \u3657 \u3600 \u3634 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3648 \u3604 \u3637 \u3618 \u3623 \u3585 \u3633 \u3609 \u3651 \u3609 \u3585 \u3634 \u3619 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3626 \u3606 \u3634 \u3609 \u3585 \u3634 \u3619 \u3603 \u3660 \u3609 \u3657 \u3635 </div></div>\
\
    <div class="qb"><div class="q">15. "Cultural Diplomacy" \uc0\u3627 \u3619 \u3639 \u3629 \u3585 \u3634 \u3619 \u3607 \u3641 \u3605 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617  \u3606 \u3641 \u3585 \u3609 \u3635 \u3617 \u3634 \u3651 \u3594 \u3657 \u3648 \u3611 \u3655 \u3609 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3651 \u3609 \u3604 \u3657 \u3634 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3648 \u3612 \u3618 \u3649 \u3614 \u3619 \u3656 \u3624 \u3634 \u3626 \u3609 \u3634 \u3651 \u3609 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3586 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3586 \u3657 \u3634 \u3651 \u3592 \u3629 \u3633 \u3609 \u3604 \u3637 \u3649 \u3621 \u3632 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3616 \u3634 \u3614 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3649 \u3621 \u3632 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 <br>\u3588 . \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3652 \u3611 \u3624 \u3638 \u3585 \u3625 \u3634 \u3604 \u3641 \u3591 \u3634 \u3609 \u3604 \u3657 \u3634 \u3609 \u3624 \u3636 \u3621 \u3611 \u3632 <br>\u3591 . \u3585 \u3634 \u3619 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3651 \u3627 \u3657 \u3588 \u3609 \u3605 \u3656 \u3634 \u3591 \u3594 \u3634 \u3605 \u3636 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3605 \u3634 \u3617 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617 \u3652 \u3607 \u3618 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3586 \u3657 \u3634 \u3651 \u3592 \u3629 \u3633 \u3609 \u3604 \u3637 \u3649 \u3621 \u3632 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3616 \u3634 \u3614 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3649 \u3621 \u3632 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3607 \u3641 \u3605 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617  \u3648 \u3611 \u3655 \u3609 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3648 \u3594 \u3636 \u3591 \u3619 \u3640 \u3585 \u3651 \u3609 \u3585 \u3634 \u3619 \u3609 \u3635  "Soft Power" \u3586 \u3629 \u3591 \u3652 \u3607 \u3618  \u3648 \u3594 \u3656 \u3609  \u3629 \u3634 \u3627 \u3634 \u3619  \u3624 \u3636 \u3621 \u3611 \u3632  \u3611 \u3619 \u3632 \u3648 \u3614 \u3603 \u3637  \u3649 \u3621 \u3632 \u3629 \u3633 \u3605 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609  \u3617 \u3634 \u3626 \u3619 \u3657 \u3634 \u3591 \u3616 \u3634 \u3614 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3607 \u3637 \u3656 \u3604 \u3637 \u3651 \u3609 \u3648 \u3623 \u3607 \u3637 \u3650 \u3621 \u3585  \u3648 \u3614 \u3639 \u3656 \u3629 \u3604 \u3638 \u3591 \u3604 \u3641 \u3604 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623  \u3649 \u3621 \u3632 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3636 \u3656 \u3617 \u3651 \u3627 \u3657 \u3585 \u3633 \u3610 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3586 \u3629 \u3591 \u3652 \u3607 \u3618 </div></div>\
\
    <div class="qb"><div class="q">16. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3656 \u3618 \u3591 \u3648 \u3594 \u3636 \u3591 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3651 \u3627 \u3657 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3652 \u3586 \u3604 \u3657 \u3623 \u3618 \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3607 \u3634 \u3591 \u3592 \u3619 \u3636 \u3618 \u3608 \u3619 \u3619 \u3617 </div>\
    <div class="c">\uc0\u3585 . \u3611 \u3633 \u3597 \u3627 \u3634 \u3609 \u3657 \u3635 \u3607 \u3656 \u3623 \u3617 \u3595 \u3657 \u3635 \u3595 \u3634 \u3585 <br>\u3586 . \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 \u3588 \u3629 \u3619 \u3660 \u3619 \u3633 \u3611 \u3594 \u3633 \u3609 \u3649 \u3621 \u3632 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3629 \u3609 \u3640 \u3617 \u3633 \u3605 \u3636 \u3607 \u3656 \u3637 \u3621 \u3656 \u3634 \u3594 \u3657 \u3634 <br>\u3588 . \u3585 \u3634 \u3619 \u3586 \u3634 \u3604 \u3649 \u3588 \u3621 \u3609 \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 \u3651 \u3609 \u3616 \u3634 \u3588 \u3648 \u3585 \u3625 \u3605 \u3619 <br>\u3591 . \u3585 \u3634 \u3619 \u3648 \u3626 \u3639 \u3656 \u3629 \u3617 \u3626 \u3616 \u3634 \u3614 \u3586 \u3629 \u3591 \u3606 \u3609 \u3609 \u3627 \u3621 \u3623 \u3591 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 \u3588 \u3629 \u3619 \u3660 \u3619 \u3633 \u3611 \u3594 \u3633 \u3609 \u3649 \u3621 \u3632 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3629 \u3609 \u3640 \u3617 \u3633 \u3605 \u3636 \u3607 \u3656 \u3637 \u3621 \u3656 \u3634 \u3594 \u3657 \u3634 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3623 \u3656 \u3634 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 \u3588 \u3629 \u3619 \u3660 \u3619 \u3633 \u3611 \u3594 \u3633 \u3609 \u3648 \u3594 \u3636 \u3591 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3633 \u3585 \u3648 \u3585 \u3636 \u3604 \u3592 \u3634 \u3585 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3629 \u3609 \u3640 \u3617 \u3633 \u3605 \u3636 \u3629 \u3609 \u3640 \u3597 \u3634 \u3605 \u3607 \u3637 \u3656 \u3651 \u3594 \u3657 \u3604 \u3640 \u3621 \u3614 \u3636 \u3609 \u3636 \u3592 \u3586 \u3629 \u3591 \u3648 \u3592 \u3657 \u3634 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3617 \u3634 \u3585 \u3648 \u3585 \u3636 \u3609 \u3652 \u3611 \u3649 \u3621 \u3632 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3621 \u3656 \u3634 \u3594 \u3657 \u3634  \u3592 \u3638 \u3591 \u3585 \u3635 \u3627 \u3609 \u3604 \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3607 \u3634 \u3591 \u3592 \u3619 \u3636 \u3618 \u3608 \u3619 \u3619 \u3617 \u3588 \u3623 \u3610 \u3588 \u3641 \u3656 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3619 \u3632 \u3610 \u3610 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3617 \u3634 \u3621 \u3604 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3649 \u3621 \u3632 \u3604 \u3640 \u3621 \u3614 \u3636 \u3609 \u3636 \u3592 </div></div>\
\
    <div class="qb"><div class="q">17. \uc0\u3585 \u3634 \u3619 \u3651 \u3594 \u3657  AI \u3651 \u3609 \u3585 \u3634 \u3619 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3605 \u3634 \u3617 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3605 \u3657 \u3629 \u3591 \u3629 \u3618 \u3641 \u3656 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3648 \u3591 \u3639 \u3656 \u3629 \u3609 \u3652 \u3586 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3626 \u3609 \u3651 \u3592 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610 <br>\u3586 . \u3585 \u3634 \u3619 \u3619 \u3633 \u3585 \u3625 \u3634 \u3588 \u3623 \u3634 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 \u3586 \u3629 \u3591 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3607 \u3637 \u3656 \u3648 \u3588 \u3619 \u3656 \u3591 \u3588 \u3619 \u3633 \u3604 <br>\u3588 . \u3585 \u3634 \u3619 \u3648 \u3611 \u3636 \u3604 \u3648 \u3612 \u3618 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3626 \u3656 \u3623 \u3609 \u3610 \u3640 \u3588 \u3588 \u3621 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3605 \u3656 \u3629 \u3626 \u3634 \u3608 \u3634 \u3619 \u3603 \u3632 <br>\u3591 . \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3648 \u3593 \u3614 \u3634 \u3632 \u3651 \u3609 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591 \u3648 \u3607 \u3656 \u3634 \u3609 \u3633 \u3657 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3619 \u3633 \u3585 \u3625 \u3634 \u3588 \u3623 \u3634 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 \u3586 \u3629 \u3591 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3607 \u3637 \u3656 \u3648 \u3588 \u3619 \u3656 \u3591 \u3588 \u3619 \u3633 \u3604 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3591 \u3639 \u3656 \u3629 \u3609 \u3652 \u3586 \u3626 \u3635 \u3588 \u3633 \u3597 \u3607 \u3637 \u3656 \u3605 \u3657 \u3629 \u3591 \u3618 \u3638 \u3604 \u3606 \u3639 \u3629 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3588 \u3619 \u3656 \u3591 \u3588 \u3619 \u3633 \u3604 \u3588 \u3639 \u3629  "\u3585 \u3634 \u3619 \u3619 \u3633 \u3585 \u3625 \u3634 \u3588 \u3623 \u3634 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 \u3586 \u3629 \u3591 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 " \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3588 \u3640 \u3657 \u3617 \u3588 \u3619 \u3629 \u3591 \u3586 \u3657 \u3629 \u3617 \u3621 \u3641 \u3626 \u3656 \u3623 \u3609 \u3610 \u3640 \u3588 \u3588 \u3621 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609  \u3648 \u3614 \u3656 \u3639 \u3629 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3585 \u3634 \u3619 \u3609 \u3635 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3652 \u3611 \u3651 \u3594 \u3657 \u3651 \u3609 \u3607 \u3634 \u3591 \u3607 \u3637 \u3656 \u3612 \u3636 \u3604 \u3627 \u3619 \u3639 \u3629 \u3585 \u3634 \u3619 \u3650 \u3592 \u3617 \u3605 \u3637 \u3607 \u3634 \u3591 \u3652 \u3595 \u3648 \u3610 \u3629 \u3619 \u3660 </div></div>\
\
    <div class="qb"><div class="q">18. \uc0\u3609 \u3650 \u3618 \u3610 \u3634 \u3618  "365 \u3623 \u3633 \u3609  (Destination Thailand)" \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3616 \u3634 \u3588 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3619 \u3634 \u3588 \u3634 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3651 \u3627 \u3657 \u3606 \u3641 \u3585 \u3607 \u3656 \u3637 \u3626 \u3640 \u3604 \u3651 \u3609 \u3650 \u3621 \u3585 <br>\u3586 . \u3585 \u3634 \u3619 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3592 \u3634 \u3585 \u3648 \u3609 \u3657 \u3609 \u3611 \u3619 \u3636 \u3617 \u3634 \u3603 \u3652 \u3611 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3626 \u3641 \u3591 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3627 \u3621 \u3634 \u3585 \u3627 \u3621 \u3634 \u3618 <br>\u3588 . \u3585 \u3634 \u3619 \u3629 \u3609 \u3640 \u3597 \u3634 \u3605 \u3651 \u3627 \u3657 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3629 \u3618 \u3641 \u3656 \u3652 \u3604 \u3657 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3605 \u3657 \u3629 \u3591 \u3617 \u3637 \u3623 \u3637 \u3595 \u3656 \u3634 \u3605 \u3621 \u3629 \u3604 \u3611 \u3637 <br>\u3591 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3623 \u3609 \u3626 \u3609 \u3640 \u3585 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656 \u3651 \u3609 \u3607 \u3640 \u3585 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3592 \u3634 \u3585 \u3648 \u3609 \u3657 \u3609 \u3611 \u3619 \u3636 \u3617 \u3634 \u3603 \u3652 \u3611 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3626 \u3641 \u3591 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3627 \u3621 \u3634 \u3585 \u3627 \u3621 \u3634 \u3618 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3609 \u3650 \u3618 \u3610 \u3634 \u3618  "Destination Thailand 365 \u3623 \u3633 \u3609 " \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3605 \u3621 \u3629 \u3604 \u3607 \u3633 \u3657 \u3591 \u3611 \u3637  \u3650 \u3604 \u3618 \u3585 \u3634 \u3619 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3616 \u3634 \u3588 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3648 \u3609 \u3657 \u3609 \u3592 \u3635 \u3609 \u3623 \u3609 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623  (Quantity) \u3652 \u3611 \u3626  \u3641  \u3656 \u3585 \u3634 \u3619 \u3626 \u3619  \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3626  \u3641 \u3591  (Value-added) \u3604 \u3657 \u3623 \u3618 \u3585 \u3634 \u3619 \u3609 \u3635 \u3648 \u3626 \u3609 \u3629 \u3611 \u3619 \u3632 \u3626 \u3610 \u3585 \u3634 \u3619 \u3603 \u3660 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637  \u3656 \u3618 \u3623 \u3648 \u3594  \u3636 \u3591 \u3626  \u3640 \u3586 \u3616 \u3634 \u3614  \u3624 \u3636 \u3621 \u3611 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617  \u3649 \u3621 \u3632 \u3585 \u3636 \u3592 \u3585 \u3619 \u3619 \u3617 \u3626 \u3633 \u3609 \u3607 \u3609 \u3634 \u3585 \u3634 \u3619 \u3619 \u3632 \u3604 \u3633 \u3610 \u3650 \u3621 \u3585 </div></div>\
\
    <div class="qb"><div class="q">19. \uc0\u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3652 \u3586 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3651 \u3609 \u3621 \u3633 \u3585 \u3625 \u3603 \u3632  "Omnibus Law" \u3617 \u3637 \u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3648 \u3614 \u3656 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3648 \u3614 \u3636 \u3656 \u3617 \u3650 \u3607 \u3625 \u3607 \u3634 \u3591 \u3629 \u3634 \u3597 \u3634 \u3651 \u3627 \u3657 \u3619 \u3640 \u3609 \u3649 \u3619 \u3591 \u3586 \u3638 \u3657 \u3609 <br>\u3586 . \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3652 \u3586 \u3594 \u3640 \u3604 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3621 \u3657 \u3634 \u3626 \u3617 \u3633 \u3618 \u3648 \u3614 \u3639 \u3656 \u3629 \u3649 \u3585 \u3657 \u3611 \u3633 \u3597 \u3627 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3651 \u3609 \u3588 \u3619 \u3634 \u3623 \u3648 \u3604 \u3637 \u3618 \u3623 <br>\u3588 . \u3585 \u3634 \u3619 \u3629 \u3629 \u3585 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3651 \u3627 \u3617 \u3656 \u3648 \u3614 \u3656 \u3639 \u3629 \u3592 \u3633 \u3604 \u3648 \u3585 \u3655 \u3610 \u3616 \u3634 \u3625 \u3637 \u3648 \u3614 \u3656 \u3636 \u3617 \u3648 \u3605 \u3636 \u3617 <br>\u3591 . \u3585 \u3634 \u3619 \u3618 \u3585 \u3648 \u3621 \u3636 \u3585 \u3629 \u3635 \u3609 \u3634 \u3592 \u3586 \u3629 \u3591 \u3613 \u3656 \u3634 \u3618 \u3609 \u3636 \u3605 \u3636 \u3610 \u3633 \u3597 \u3597 \u3633 \u3605 \u3636 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3652 \u3586 \u3594 \u3640 \u3604 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3621 \u3657 \u3634 \u3626 \u3617 \u3633 \u3618 \u3648 \u3614 \u3639 \u3656 \u3629 \u3649 \u3585 \u3657 \u3611 \u3633 \u3597 \u3627 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3651 \u3609 \u3588 \u3619 \u3634 \u3623 \u3648 \u3604 \u3637 \u3618 \u3623 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : Omnibus Law \u3627 \u3619 \u3639 \u3629  "\u3619 \u3656 \u3634 \u3591 \u3594 \u3640 \u3604 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 " \u3648 \u3611 \u3655 \u3609 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3607 \u3634 \u3591 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3609 \u3635 \u3617 \u3634 \u3651 \u3594 \u3657 \u3648 \u3614 \u3639 \u3656 \u3629 \u3649 \u3585 \u3657 \u3652 \u3586 \u3627 \u3619 \u3639 \u3629 \u3618 \u3585 \u3648 \u3621 \u3636 \u3585 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3627 \u3621 \u3634 \u3618 \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656 \u3621 \u3657 \u3634 \u3626 \u3617 \u3633 \u3618 \u3649 \u3621 \u3632 \u3648 \u3611 \u3655 \u3609 \u3629 \u3640 \u3611 \u3626 \u3619 \u3619 \u3588 \u3605 \u3656 \u3629 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3651 \u3609 \u3588 \u3619 \u3634 \u3623 \u3648 \u3604 \u3637 \u3618 \u3623  \u3649 \u3607 \u3609 \u3607 \u3637 \u3656 \u3592 \u3632 \u3649 \u3585 \u3657 \u3652 \u3586 \u3607 \u3637 \u3621 \u3632 \u3593 \u3610 \u3633 \u3610 \u3595 \u3638 \u3656 \u3591 \u3651 \u3594 \u3657 \u3648 \u3623 \u3621 \u3634 \u3609 \u3634 \u3609 </div></div>\
\
    <div class="qb"><div class="q">20. \uc0\u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3612 \u3621 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3586 \u3629 \u3591 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3605 \u3634 \u3617 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3651 \u3627 \u3617 \u3656 \u3592 \u3632 \u3648 \u3609 \u3657 \u3609 \u3626 \u3636 \u3656 \u3591 \u3651 \u3604 \u3648 \u3611 \u3655 \u3609 \u3627 \u3621 \u3633 \u3585 </div>\
    <div class="c">\uc0\u3585 . \u3592 \u3635 \u3609 \u3623 \u3609 \u3611 \u3637 \u3607 \u3637 \u3656 \u3619 \u3633 \u3610 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 <br>\u3586 . \u3612 \u3621 \u3621 \u3633 \u3614 \u3608 \u3660 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3607 \u3637 \u3656 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3592 \u3632 \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 <br>\u3588 . \u3588 \u3623 \u3634 \u3617 \u3626 \u3633 \u3617 \u3614 \u3633 \u3609 \u3608 \u3660 \u3626 \u3656 \u3623 \u3609 \u3605 \u3633 \u3623 \u3585 \u3633 \u3610 \u3612 \u3641 \u3657 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3610 \u3633 \u3597 \u3594 \u3634 <br>\u3591 . \u3585 \u3634 \u3619 \u3617 \u3634 \u3607 \u3635 \u3591 \u3634 \u3609 \u3605 \u3619 \u3591 \u3648 \u3623 \u3621 \u3634 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3612 \u3621 \u3621 \u3633 \u3614 \u3608 \u3660 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3607 \u3637 \u3656 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3592 \u3632 \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3619 \u3632 \u3610 \u3610 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3619 \u3632 \u3610 \u3610 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3612 \u3621 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3648 \u3609 \u3657 \u3609 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3627 \u3619 \u3639 \u3629 \u3588 \u3623 \u3634 \u3617 \u3614 \u3618 \u3634 \u3618 \u3634 \u3617  (Input/Process) \u3617 \u3634 \u3648 \u3611 \u3655 \u3609 \u3585 \u3634 \u3619 \u3648 \u3609 \u3657 \u3609 \u3607 \u3637 \u3656  "\u3612 \u3621 \u3621 \u3633 \u3614 \u3608 \u3660 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3607 \u3637 \u3656 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3592 \u3632 \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 " (Outcome/Benefit) \u3648 \u3611 \u3655 \u3609 \u3627 \u3621 \u3633 \u3585 </div></div>\
\
    <div class="qb"><div class="q">21. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3592 \u3632 \u3609 \u3635 \u3617 \u3634 \u3651 \u3594 \u3657 \u3651 \u3609 \u3619 \u3632 \u3610 \u3610  "Smart Grid"</div>\
    <div class="c">\uc0\u3585 . \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3652 \u3615 \u3615 \u3657 \u3634 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 \u3648 \u3614 \u3656 \u3639 \u3629 \u3619 \u3629 \u3591 \u3619 \u3633 \u3610 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3626 \u3632 \u3629 \u3634 \u3604 <br>\u3586 . \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3626 \u3639 \u3656 \u3629 \u3626 \u3634 \u3619 \u3612 \u3656 \u3634 \u3609 \u3604 \u3634 \u3623 \u3648 \u3607 \u3637 \u3618 \u3617 \u3588 \u3623 \u3634 \u3617 \u3648 \u3619 \u3655 \u3623 \u3626 \u3641 \u3591 <br>\u3588 . \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3592 \u3619 \u3634 \u3592 \u3619 \u3604 \u3657 \u3623 \u3618 \u3650 \u3604 \u3619 \u3609 <br>\u3591 . \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3651 \u3609 \u3626 \u3635 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3652 \u3615 \u3615 \u3657 \u3634 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 \u3648 \u3614 \u3656 \u3639 \u3629 \u3619 \u3629 \u3591 \u3619 \u3633 \u3610 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3626 \u3632 \u3629 \u3634 \u3604 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : Smart Grid \u3627 \u3619 \u3639 \u3629 \u3619 \u3632 \u3610 \u3610 \u3650 \u3588 \u3619 \u3591 \u3586 \u3656 \u3634 \u3618 \u3652 \u3615 \u3615 \u3657 \u3634 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632  \u3648 \u3611 \u3655 \u3609 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3626 \u3635 \u3588 \u3633 \u3597 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3592 \u3632 \u3609 \u3635 \u3617 \u3634 \u3651 \u3594 \u3657 \u3611 \u3619 \u3633 \u3610 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3605 \u3621 \u3634 \u3604 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609  \u3648 \u3614 \u3639 \u3656 \u3629 \u3619 \u3629 \u3591 \u3619 \u3633 \u3610 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3649 \u3621 \u3632 \u3651 \u3594 \u3657 \u3652 \u3615 \u3615 \u3657 \u3634 \u3592 \u3634 \u3585 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3626 \u3632 \u3629 \u3634 \u3604  (\u3648 \u3594 \u3656 \u3609  \u3649 \u3626 \u3591 \u3629 \u3634 \u3607 \u3636 \u3605 \u3618 \u3660 ) \u3650 \u3604 \u3618 \u3619 \u3632 \u3610 \u3610 \u3609 \u3637 \u3657 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3585 \u3634 \u3619 \u3652 \u3627 \u3621 \u3586 \u3629 \u3591 \u3652 \u3615 \u3615 \u3657 \u3634 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 </div></div>\
\
    <div class="qb"><div class="q">22. "Digital Literacy" \uc0\u3606 \u3641 \u3585 \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634 \u3648 \u3611 \u3655 \u3609 \u3607 \u3633 \u3585 \u3625 \u3632 \u3607 \u3637 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3651 \u3588 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3593 \u3614 \u3634 \u3632 \u3648 \u3604 \u3655 \u3585 \u3649 \u3621 \u3632 \u3648 \u3618 \u3634 \u3623 \u3594 \u3609 \u3648 \u3607 \u3656 \u3634 \u3609 \u3633 \u3657 \u3609 <br>\u3586 . \u3588 \u3609 \u3652 \u3607 \u3618 \u3607 \u3640 \u3585 \u3585 \u3621 \u3640 \u3656 \u3617 \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3648 \u3607 \u3656 \u3634 \u3607 \u3633 \u3609 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3627 \u3656 \u3591 \u3629 \u3609 \u3634 \u3588 \u3605 <br>\u3588 . \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3619 \u3632 \u3604 \u3633 \u3610 \u3626 \u3641 \u3591 \u3648 \u3607 \u3656 \u3634 \u3609 \u3633 \u3657 \u3609 <br>\u3591 . \u3648 \u3593 \u3614 \u3634 \u3632 \u3612 \u3641 \u3657 \u3607 \u3637 \u3656 \u3607 \u3635 \u3591 \u3634 \u3609 \u3651 \u3609 \u3610 \u3619 \u3636 \u3625 \u3633 \u3607 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3588 \u3609 \u3652 \u3607 \u3618 \u3607 \u3640 \u3585 \u3585 \u3621 \u3640 \u3656 \u3617 \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3648 \u3607 \u3656 \u3634 \u3607 \u3633 \u3609 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3627 \u3656 \u3591 \u3629 \u3609 \u3634 \u3588 \u3605 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : Digital Literacy \u3627 \u3619 \u3639 \u3629 \u3588 \u3623 \u3634 \u3617 \u3619 \u3641 \u3657 \u3588 \u3623 \u3634 \u3617 \u3648 \u3586 \u3657 \u3634 \u3651 \u3592 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621  \u3648 \u3611 \u3655 \u3609 \u3607 \u3633 \u3585 \u3625 \u3632 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3588 \u3609 \u3652 \u3607 \u3618 \u3607 \u3640 \u3585 \u3585 \u3621 \u3640 \u3656 \u3617 \u3649 \u3621 \u3632 \u3607 \u3640 \u3585 \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3617 \u3637 \u3605 \u3636 \u3604 \u3605 \u3633 \u3623  \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3594 \u3657 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3592 \u3634 \u3585 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591  \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618  \u3649 \u3621 \u3632 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3619 \u3619 \u3588 \u3660 </div></div>\
\
    <div class="qb"><div class="q">23. \uc0\u3651 \u3609 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3595 \u3639 \u3657 \u3629 \u3592 \u3633 \u3604 \u3592 \u3657 \u3634 \u3591 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600  \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3651 \u3627 \u3617 \u3656 \u3651 \u3627 \u3657 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597 \u3585 \u3633 \u3610 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3651 \u3604 \u3617 \u3634 \u3585 \u3585 \u3623 \u3656 \u3634  "\u3619 \u3634 \u3588 \u3634 \u3605 \u3656 \u3635 \u3626 \u3640 \u3604 "</div>\
    <div class="c">\uc0\u3585 . \u3588 \u3623 \u3634 \u3617 \u3626 \u3633 \u3617 \u3614 \u3633 \u3609 \u3608 \u3660 \u3585 \u3633 \u3610 \u3612 \u3641 \u3657 \u3586 \u3634 \u3618 <br>\u3586 . \u3588 \u3623 \u3634 \u3617 \u3588 \u3640 \u3657 \u3617 \u3588 \u3656 \u3634  \u3626 \u3617 \u3648 \u3627 \u3605 \u3640 \u3626 \u3617 \u3612 \u3621  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3588 . \u3585 \u3634 \u3619 \u3648 \u3621 \u3639 \u3629 \u3585 \u3610 \u3619 \u3636 \u3625 \u3633 \u3607 \u3607 \u3637 \u3656 \u3617 \u3637 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 <br>\u3591 . \u3585 \u3634 \u3619 \u3609 \u3635 \u3648 \u3586 \u3657 \u3634 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3592 \u3634 \u3585 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3648 \u3614 \u3656 \u3639 \u3629 \u3588 \u3623 \u3634 \u3617 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3588 \u3623 \u3634 \u3617 \u3588 \u3640 \u3657 \u3617 \u3588 \u3656 \u3634  \u3626 \u3617 \u3648 \u3627 \u3605 \u3640 \u3626 \u3617 \u3612 \u3621  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3595 \u3639 \u3657 \u3629 \u3592 \u3633 \u3604 \u3592 \u3657 \u3634 \u3591 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3618 \u3640 \u3588 \u3651 \u3627 \u3617 \u3656 \u3592 \u3632 \u3606 \u3641 \u3585 \u3611 \u3619 \u3633 \u3610 \u3611 \u3619 \u3640 \u3591 \u3652 \u3617 \u3656 \u3651 \u3627 \u3657 \u3588 \u3635 \u3609 \u3638 \u3591 \u3606 \u3638 \u3591  "\u3619 \u3634 \u3588 \u3634 \u3605 \u3656 \u3635 \u3626 \u3640 \u3604 " \u3648 \u3614 \u3637 \u3618 \u3591 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3604 \u3637 \u3618 \u3623  \u3649 \u3605 \u3656 \u3592 \u3632 \u3648 \u3609 \u3657 \u3609 \u3607 \u3637 \u3656 \u3588 \u3623 \u3634 \u3617 \u3588 \u3640 \u3657 \u3617 \u3588 \u3656 \u3634  \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  (Made in Thailand First) \u3619 \u3623 \u3617 \u3606 \u3638 \u3591 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 </div></div>\
\
    <div class="qb"><div class="q">24. \uc0\u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3611 \u3633 \u3597 \u3627 \u3634  "\u3609 \u3629 \u3617 \u3636 \u3609 \u3637 " \u3651 \u3609 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 \u3617 \u3637 \u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3648 \u3614 \u3656 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3614 \u3656 \u3636 \u3617 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3588 \u3656 \u3634 \u3611 \u3619 \u3633 \u3610 <br>\u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3621 \u3604 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3605 \u3656 \u3629 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3652 \u3607 \u3618 \u3649 \u3621 \u3632 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3594 \u3640 \u3617 \u3594 \u3609 <br>\u3588 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3637 \u3604 \u3585 \u3633 \u3609 \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3592 \u3634 \u3585 \u3605 \u3656 \u3634 \u3591 \u3594 \u3634 \u3605 \u3636 \u3607 \u3640 \u3585 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 <br>\u3591 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3648 \u3586 \u3657 \u3634 \u3652 \u3611 \u3648 \u3611 \u3655 \u3609 \u3648 \u3592 \u3657 \u3634 \u3586 \u3629 \u3591 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3648 \u3629 \u3585 \u3594 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3621 \u3604 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3605 \u3656 \u3629 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3652 \u3607 \u3618 \u3649 \u3621 \u3632 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3594 \u3640 \u3617 \u3594 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3611 \u3633 \u3597 \u3627 \u3634 \u3609 \u3629 \u3617 \u3636 \u3609 \u3637  (Nominee) \u3627 \u3619 \u3639 \u3629 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3605 \u3633 \u3657 \u3591 \u3609 \u3629 \u3617 \u3636 \u3609 \u3637 \u3648 \u3614 \u3656 \u3639 \u3629 \u3607 \u3635 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3605 \u3619 \u3591 \u3652 \u3611 \u3605 \u3619 \u3591 \u3617 \u3634  \u3626 \u3656 \u3591 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3629 \u3618 \u3656 \u3634 \u3591 \u3619 \u3640 \u3609 \u3649 \u3619 \u3591 \u3605 \u3656 \u3629 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3652 \u3607 \u3618  \u3650 \u3604 \u3618 \u3648 \u3593 \u3614 \u3634 \u3632  SMEs \u3649 \u3621 \u3632 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3594 \u3640 \u3617 \u3594 \u3609 \u3607 \u3637 \u3656 \u3652 \u3617 \u3656 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617  \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3592 \u3638 \u3591 \u3605 \u3657 \u3629 \u3591 \u3617 \u3637 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3609 \u3637 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3592 \u3619 \u3636 \u3591 \u3592 \u3633 \u3591 \u3648 \u3614 \u3639 \u3656 \u3629 \u3611 \u3585 \u3611 \u3657 \u3629 \u3591 \u3626 \u3636 \u3607 \u3608 \u3636 \u3586 \u3629 \u3591 \u3588 \u3609 \u3652 \u3607 \u3618 </div></div>\
\
    <div class="qb"><div class="q">25. \uc0\u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3626 \u3619 \u3619 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3651 \u3609 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3648 \u3609 \u3657 \u3609 \u3588 \u3623 \u3634 \u3617 \u3588 \u3640 \u3657 \u3617 \u3588 \u3656 \u3634 \u3612 \u3656 \u3634 \u3609 \u3585 \u3621 \u3652 \u3585 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3585 \u3641 \u3657 \u3648 \u3591 \u3636 \u3609 \u3651 \u3627 \u3657 \u3617 \u3634 \u3585 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 \u3648 \u3614 \u3639 \u3656 \u3629 \u3585 \u3619 \u3632 \u3605 \u3640 \u3657 \u3609 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 <br>\u3586 . \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3626 \u3636 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3660 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3651 \u3627 \u3657 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626 \u3649 \u3621 \u3632 \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3652 \u3604 \u3657 <br>\u3588 . \u3585 \u3634 \u3619 \u3605 \u3633 \u3604 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3604 \u3657 \u3634 \u3609 \u3626 \u3623 \u3633 \u3626 \u3604 \u3636 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 <br>\u3591 . \u3585 \u3634 \u3619 \u3619 \u3629 \u3651 \u3627 \u3657 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3648 \u3627 \u3621 \u3639 \u3629 \u3592 \u3656 \u3634 \u3618 \u3649 \u3621 \u3657 \u3623 \u3588 \u3656 \u3629 \u3618 \u3609 \u3635 \u3617 \u3634 \u3651 \u3594 \u3657 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3626 \u3636 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3660 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3651 \u3627 \u3657 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626 \u3649 \u3621 \u3632 \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3652 \u3604 \u3657 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3626 \u3619 \u3619 \u3649 \u3621 \u3632 \u3651 \u3594 \u3657 \u3592 \u3656 \u3634 \u3618 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3609 \u3637 \u3657  \u3592 \u3632 \u3618 \u3638 \u3604 \u3627 \u3621 \u3633 \u3585 \u3623 \u3636 \u3609 \u3633 \u3618 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609 \u3585 \u3634 \u3619 \u3588 \u3621 \u3633 \u3591 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3588 \u3619 \u3656 \u3591 \u3588 \u3619 \u3633 \u3604  \u3650 \u3604 \u3618 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3626 \u3636 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3660 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3651 \u3627 \u3657 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3588 \u3640 \u3657 \u3617 \u3588 \u3656 \u3634 \u3626 \u3641 \u3591 \u3626 \u3640 \u3604  \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626  \u3649 \u3621 \u3632 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3652 \u3604 \u3657 \u3651 \u3609 \u3607 \u3640 \u3585 \u3586 \u3633  \u3657 \u3609 \u3605 \u3629 \u3609 </div></div>\
\
    <div class="qb"><div class="q">26. \uc0\u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3617 \u3637 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 \u3651 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591  "\u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3607 \u3634 \u3591 \u3629 \u3634 \u3627 \u3634 \u3619 \u3586 \u3629 \u3591 \u3650 \u3621 \u3585 "</div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3627 \u3657 \u3634 \u3617 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3648 \u3585 \u3625 \u3605 \u3619 \u3607 \u3640 \u3585 \u3594 \u3609 \u3636 \u3604 <br>\u3586 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3656 \u3636 \u3617 \u3605 \u3621 \u3629 \u3604 \u3627 \u3656 \u3623 \u3591 \u3650 \u3595 \u3656 \u3629 \u3640 \u3611 \u3607 \u3634 \u3609 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3648 \u3592 \u3619 \u3592 \u3634 \u3648 \u3614 \u3656 \u3636 \u3617 \u3605 \u3621 \u3634 \u3604 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 <br>\u3588 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3592 \u3635 \u3609 \u3623 \u3609 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3621 \u3591 \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3614 \u3656 \u3636 \u3617 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3609 \u3636 \u3588 \u3617 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 <br>\u3591 . \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3626 \u3634 \u3619 \u3648 \u3588 \u3617 \u3637 \u3651 \u3609 \u3616 \u3634 \u3588 \u3648 \u3585 \u3625 \u3605 \u3619 \u3648 \u3614 \u3656 \u3639 \u3629 \u3648 \u3614 \u3656 \u3636 \u3617 \u3612 \u3621 \u3612 \u3621 \u3636 \u3605 \u3629 \u3618 \u3656 \u3634 \u3591 \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3656 \u3636 \u3617 \u3605 \u3621 \u3629 \u3604 \u3627 \u3656 \u3623 \u3591 \u3650 \u3595 \u3656 \u3629 \u3640 \u3611 \u3607 \u3634 \u3609 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3648 \u3592 \u3619 \u3592 \u3634 \u3648 \u3614 \u3656 \u3636 \u3617 \u3605 \u3621 \u3634 \u3604 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3648 \u3611 \u3655 \u3609  "\u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3607 \u3634 \u3591 \u3629 \u3634 \u3627 \u3634 \u3619 \u3586 \u3629 \u3591 \u3650 \u3621 \u3585 " \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3648 \u3609 \u3657 \u3609 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3592 \u3634 \u3585 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3619 \u3617 \u3649 \u3610 \u3610 \u3604 \u3633 \u3657 \u3591 \u3648 \u3604 \u3636 \u3617 \u3652 \u3611 \u3626 \u3641 \u3656 \u3648 \u3585 \u3625 \u3605 \u3619 \u3649 \u3617 \u3656 \u3609 \u3618 \u3635 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3649 \u3611 \u3619 \u3619 \u3641 \u3611 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3648 \u3585 \u3625 \u3605 \u3619 \u3648 \u3614 \u3639 \u3656 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3636 \u3656 \u3617  (High Value) \u3588 \u3623 \u3610 \u3588 \u3641 \u3656 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3607 \u3637 \u3617 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3651 \u3609 \u3585 \u3634 \u3619 \u3648 \u3592 \u3619 \u3592 \u3634 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 \u3648 \u3594 \u3636 \u3591 \u3619 \u3640 \u3585 \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3611 \u3636 \u3604 \u3605 \u3621 \u3634 \u3604 \u3651 \u3627 \u3617 \u3656 \u3654  \u3651 \u3609 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div></div>\
\
    <div class="qb"><div class="q">27. \uc0\u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634  "Deep Tech" \u3627 \u3619 \u3639 \u3629 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3648 \u3594 \u3636 \u3591 \u3621 \u3638 \u3585 \u3651 \u3609 \u3619 \u3632 \u3618 \u3632 \u3649 \u3619 \u3585 \u3648 \u3609 \u3657 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3615 \u3594 \u3633 \u3656 \u3609 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3629 \u3629 \u3585 \u3649 \u3610 \u3610 <br>\u3586 . \u3648 \u3585 \u3625 \u3605 \u3619  \u3629 \u3634 \u3627 \u3634 \u3619  \u3618 \u3634  \u3649 \u3621 \u3632 \u3648 \u3595 \u3617 \u3636 \u3588 \u3629 \u3609 \u3604 \u3633 \u3585 \u3648 \u3605 \u3629 \u3619 \u3660 <br>\u3588 . \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3648 \u3615 \u3629 \u3619 \u3660 \u3609 \u3636 \u3648 \u3592 \u3629 \u3619 \u3660 \u3652 \u3617 \u3657 <br>\u3591 . \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3648 \u3621 \u3637 \u3657 \u3618 \u3591 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3650 \u3619 \u3591 \u3649 \u3619 \u3617 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3648 \u3585 \u3625 \u3605 \u3619  \u3629 \u3634 \u3627 \u3634 \u3619  \u3618 \u3634  \u3649 \u3621 \u3632 \u3648 \u3595 \u3617 \u3636 \u3588 \u3629 \u3609 \u3604 \u3633 \u3585 \u3648 \u3605 \u3629 \u3619 \u3660 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : Deep Tech \u3627 \u3619 \u3639 \u3629 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3648 \u3594 \u3636 \u3591 \u3621 \u3638 \u3585 \u3648 \u3611 \u3655 \u3609 \u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3619 \u3634 \u3585 \u3600 \u3634 \u3609 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3651 \u3627 \u3617 \u3656 \u3651 \u3609 \u3619 \u3632 \u3618 \u3632 \u3618 \u3634 \u3623  \u3595 \u3638 \u3656 \u3591 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3585 \u3635 \u3627 \u3609 \u3604 \u3651 \u3627 \u3657 \u3648 \u3619 \u3636 \u3656 \u3617 \u3605 \u3657 \u3609 \u3592 \u3634 \u3585 \u3626 \u3634 \u3586 \u3634 \u3607 \u3637 \u3656 \u3652 \u3607 \u3618 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3652 \u3604 \u3657 \u3648 \u3611 \u3619 \u3637 \u3618 \u3610 \u3649 \u3621 \u3632 \u3617 \u3637 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3614 \u3657 \u3639 \u3609 \u3600 \u3634 \u3609 \u3629 \u3618 \u3641 \u3656 \u3649 \u3621 \u3657 \u3623  \u3652 \u3604 \u3657 \u3649 \u3585 \u3656  \u3648 \u3585 \u3625 \u3605 \u3619  \u3629 \u3634 \u3627 \u3634 \u3619  \u3618 \u3634  \u3649 \u3621 \u3632 \u3648 \u3623 \u3594 \u3616 \u3633 \u3603 \u3601 \u3660 \u3592 \u3634 \u3585 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636  \u3619 \u3623 \u3617 \u3606 \u3638 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3607 \u3637 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3605 \u3656 \u3629 \u3629 \u3609 \u3634 \u3588 \u3605 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3595 \u3617 \u3636 \u3588 \u3629 \u3609 \u3604 \u3633 \u3585 \u3648 \u3605 \u3629 \u3619 \u3660 </div></div>\
\
    <div class="qb"><div class="q">28. \uc0\u3609 \u3650 \u3618 \u3610 \u3634 \u3618  "\u3648 \u3619 \u3637 \u3618 \u3609 \u3615 \u3619 \u3637 \u3617 \u3637 \u3591 \u3634 \u3609 \u3607 \u3635 " \u3651 \u3594 \u3657 \u3649 \u3614 \u3621 \u3605 \u3615 \u3629 \u3619 \u3660 \u3617 \u3651 \u3604 \u3648 \u3611 \u3655 \u3609 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3626 \u3635 \u3588 \u3633 \u3597 </div>\
    <div class="c">\uc0\u3585 . \u3649 \u3614 \u3621 \u3605 \u3615 \u3629 \u3619 \u3660 \u3617 \u3650 \u3595 \u3648 \u3594 \u3637 \u3618 \u3621 \u3617 \u3637 \u3648 \u3604 \u3637 \u3618 \u3607 \u3633 \u3656 \u3623 \u3652 \u3611 <br>\u3586 . \u3649 \u3614 \u3621 \u3605 \u3615 \u3629 \u3619 \u3660 \u3617 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660 \u3615 \u3619 \u3637 \u3607 \u3637 \u3656 \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591 \u3652 \u3604 \u3657 \u3607 \u3640 \u3585 \u3607 \u3637 \u3656 \u3607 \u3640 \u3585 \u3648 \u3623 \u3621 \u3634 <br>\u3588 . \u3585 \u3634 \u3619 \u3649 \u3592 \u3585 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3648 \u3619 \u3637 \u3618 \u3609 \u3648 \u3611 \u3655 \u3609 \u3648 \u3621 \u3656 \u3617 \u3651 \u3627 \u3657 \u3617 \u3634 \u3585 \u3586 \u3657 \u3638 \u3609 <br>\u3591 . \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3609 \u3633 \u3585 \u3648 \u3619 \u3637 \u3618 \u3609 \u3652 \u3611 \u3613 \u3638 \u3585 \u3591 \u3634 \u3609 \u3651 \u3609 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3607 \u3640 \u3585 \u3588 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3649 \u3614 \u3621 \u3605 \u3615 \u3629 \u3619 \u3660 \u3617 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660 \u3615 \u3619 \u3637 \u3607 \u3637 \u3656 \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591 \u3652 \u3604 \u3657 \u3607 \u3640 \u3585 \u3607 \u3637 \u3656 \u3607 \u3640 \u3585 \u3648 \u3623 \u3621 \u3634 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3614 \u3639 \u3656 \u3629 \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3627 \u3621 \u3639 \u3656 \u3629 \u3617 \u3621 \u3657 \u3635 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634  \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3652 \u3604 \u3657 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3614 \u3621 \u3605 \u3615 \u3629 \u3619 \u3660 \u3617 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660 \u3615 \u3619 \u3637 \u3607 \u3637 \u3656 \u3652 \u3617 \u3656 \u3617 \u3637 \u3588 \u3656 \u3634 \u3651 \u3594 \u3657 \u3592 \u3656 \u3634 \u3618 \u3651 \u3609 \u3585 \u3634 \u3619 \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591  (\u3619 \u3623 \u3617 \u3606 \u3638 \u3591 \u3585 \u3634 \u3619 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3605 \u3656 \u3629 \u3629 \u3636 \u3609 \u3648 \u3607 \u3629 \u3619 \u3660 \u3648 \u3609 \u3655 \u3605 ) \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3607 \u3640 \u3585 \u3585 \u3621 \u3640 \u3656 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3607 \u3633 \u3585 \u3625 \u3632 \u3651 \u3627 \u3617 \u3656 \u3654  \u3652 \u3604 \u3657 \u3604 \u3657 \u3623 \u3618 \u3605 \u3609 \u3648 \u3629 \u3591 \u3605 \u3621 \u3629 \u3604 \u3648 \u3623 \u3621 \u3634 </div></div>\
\
    <div class="qb"><div class="q">29. \uc0\u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3616 \u3633 \u3618 \u3588 \u3640 \u3585 \u3588 \u3634 \u3617 \u3607 \u3634 \u3591 \u3652 \u3595 \u3648 \u3610 \u3629 \u3619 \u3660 \u3651 \u3609 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3619 \u3623 \u3617 \u3606 \u3638 \u3591 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3651 \u3604 \u3610 \u3657 \u3634 \u3591 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3593 \u3614 \u3634 \u3632 \u3585 \u3634 \u3619 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3652 \u3623 \u3619 \u3633 \u3626 \u3588 \u3629 \u3617 \u3614 \u3636 \u3623 \u3648 \u3605 \u3629 \u3619 \u3660 \u3651 \u3609 \u3626 \u3635 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 <br>\u3586 . \u3626 \u3649 \u3585 \u3617 \u3648 \u3617 \u3629 \u3619 \u3660  \u3585 \u3634 \u3619 \u3627 \u3621 \u3629 \u3585 \u3621 \u3623 \u3591 \u3607 \u3634 \u3591 \u3652 \u3595 \u3648 \u3610 \u3629 \u3619 \u3660  \u3649 \u3621 \u3632 \u3629 \u3634 \u3594 \u3597 \u3634 \u3585 \u3619 \u3586 \u3657 \u3634 \u3617 \u3594 \u3634 \u3605 \u3636 <br>\u3588 . \u3585 \u3634 \u3619 \u3611 \u3636 \u3604 \u3585 \u3657 \u3633 \u3609 \u3626 \u3639 \u3656 \u3629 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660 \u3607 \u3637 \u3656 \u3623 \u3636 \u3614 \u3634 \u3585 \u3625 \u3660 \u3623 \u3636 \u3592 \u3634 \u3619 \u3603 \u3660 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 <br>\u3591 . \u3585 \u3634 \u3619 \u3618 \u3585 \u3648 \u3621 \u3636 \u3585 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3626 \u3617 \u3634 \u3619 \u3660 \u3607 \u3650 \u3615 \u3609 \u3651 \u3609 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3626 \u3649 \u3585 \u3617 \u3648 \u3617 \u3629 \u3619 \u3660  \u3585 \u3634 \u3619 \u3627 \u3621 \u3629 \u3585 \u3621 \u3623 \u3591 \u3607 \u3634 \u3591 \u3652 \u3595 \u3648 \u3610 \u3629 \u3619 \u3660  \u3649 \u3621 \u3632 \u3629 \u3634 \u3594 \u3597 \u3634 \u3585 \u3619 \u3586 \u3657 \u3634 \u3617 \u3594 \u3634 \u3605 \u3636 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3616 \u3633 \u3618 \u3588 \u3640 \u3585 \u3588 \u3634 \u3617 \u3607 \u3634 \u3591 \u3652 \u3595 \u3648 \u3610 \u3629 \u3619 \u3660 \u3651 \u3609 \u3617 \u3640 \u3617 \u3617 \u3629 \u3591 \u3586 \u3629 \u3591 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3611 \u3633 \u3592 \u3592 \u3640 \u3610 \u3633 \u3609 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3595 \u3633 \u3610 \u3595 \u3657 \u3629 \u3609 \u3649 \u3621 \u3632 \u3585 \u3619 \u3632 \u3607 \u3610 \u3605 \u3656 \u3629 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3650 \u3604 \u3618 \u3605 \u3619 \u3591  \u3652 \u3604 \u3657 \u3649 \u3585 \u3656  \u3648 \u3588 \u3619 \u3639 \u3629 \u3586 \u3656 \u3634 \u3618 \u3626 \u3649 \u3585 \u3617 \u3648 \u3617 \u3629 \u3619 \u3660  \u3585 \u3634 \u3619 \u3593 \u3657 \u3629 \u3650 \u3585 \u3591 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660  \u3585 \u3634 \u3619 \u3615 \u3629 \u3585 \u3648 \u3591 \u3636 \u3609  \u3649 \u3621 \u3632 \u3629 \u3634 \u3594 \u3597 \u3634 \u3585 \u3619 \u3619 \u3617 \u3586 \u3657 \u3634 \u3617 \u3594 \u3634 \u3605 \u3636  \u3595 \u3638 \u3656 \u3591 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3605 \u3657 \u3629 \u3591 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3585 \u3634 \u3619 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3651 \u3594 \u3657 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3649 \u3621 \u3632 \u3651 \u3594 \u3657 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3626 \u3634 \u3619 \u3626 \u3609 \u3648 \u3607 \u3624 \u3607 \u3637 \u3656 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618 \u3617 \u3634 \u3605 \u3619 \u3623 \u3592 \u3592 \u3633 \u3610  \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609  \u3649 \u3621 \u3632 \u3605 \u3633 \u3604 \u3594 \u3656 \u3629 \u3591 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609 \u3586 \u3629 \u3591 \u3629 \u3634 \u3594 \u3597 \u3634 \u3585 \u3619 \u3648 \u3627 \u3621 \u3656 \u3634 \u3609 \u3637 \u3657 </div></div>\
\
    <div class="qb"><div class="q">30. "Silver Economy" \uc0\u3627 \u3617 \u3634 \u3618 \u3606 \u3638 \u3591 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3607 \u3637 \u3656 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3621 \u3640 \u3656 \u3617 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3621 \u3640 \u3656 \u3617 \u3612 \u3641 \u3657 \u3612 \u3621 \u3636 \u3605 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3611 \u3619 \u3632 \u3604 \u3633 \u3610 \u3648 \u3591 \u3636 \u3609 <br>\u3586 . \u3585 \u3621 \u3640 \u3656 \u3617 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 \u3648 \u3614 \u3639 \u3656 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3649 \u3621 \u3632 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3594 \u3637 \u3623 \u3636 \u3605 \u3607 \u3637 \u3656 \u3604 \u3637 <br>\u3588 . \u3585 \u3621 \u3640 \u3656 \u3617 \u3609 \u3633 \u3585 \u3621 \u3591 \u3607 \u3640 \u3609 \u3651 \u3609 \u3605 \u3621 \u3634 \u3604 \u3627 \u3621 \u3633 \u3585 \u3607 \u3619 \u3633 \u3614 \u3618 \u3660 <br>\u3591 . \u3585 \u3621 \u3640 \u3656 \u3617 \u3648 \u3618 \u3634 \u3623 \u3594 \u3609 \u3619 \u3640 \u3656 \u3609 \u3651 \u3627 \u3617 \u3656 \u3607 \u3637 \u3656 \u3617 \u3637 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3626 \u3641 \u3591 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3621 \u3640 \u3656 \u3617 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 \u3648 \u3614 \u3639 \u3656 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3649 \u3621 \u3632 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3594 \u3637 \u3623 \u3636 \u3605 \u3607 \u3637 \u3656 \u3604 \u3637 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : Silver Economy \u3627 \u3619 \u3639 \u3629 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3641 \u3591 \u3623 \u3633 \u3618  \u3648 \u3611 \u3655 \u3609 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3648 \u3614 \u3639  \u3656 \u3629 \u3619 \u3629 \u3591 \u3619 \u3633 \u3610 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3585 \u3619 \u3652 \u3607 \u3618 \u3648 \u3586 \u3657 \u3634 \u3626 \u3641 \u3656 \u3626 \u3633 \u3591 \u3588 \u3617 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640  \u3650 \u3604 \u3618 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3605 \u3629 \u3610 \u3650 \u3592 \u3607 \u3618 \u3660 \u3588 \u3623 \u3634 \u3617 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3586 \u3629 \u3591 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640  \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3592 \u3657 \u3634 \u3591 \u3591 \u3634 \u3609 \u3612 \u3641  \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 \u3607 \u3637  \u3656 \u3617 \u3637 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3607 \u3637 \u3656 \u3594 \u3656 \u3623 \u3618 \u3629 \u3635 \u3609 \u3623 \u3618 \u3588 \u3623 \u3634 \u3617 \u3626 \u3632 \u3604 \u3623 \u3585 \u3651 \u3609 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3594 \u3637 \u3623 \u3636 \u3605 </div></div>\
\
    <div class="qb"><div class="q">31. \uc0\u3585 \u3634 \u3619 \u3605 \u3636 \u3604 \u3605 \u3634 \u3617 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3612 \u3621 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3592 \u3632 \u3651 \u3594 \u3657 \u3604 \u3633 \u3594 \u3609 \u3637 \u3651 \u3604 \u3648 \u3611 \u3655 \u3609 \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3648 \u3619 \u3655 \u3592 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3634 \u3610 \u3611 \u3619 \u3634 \u3617 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 </div>\
    <div class="c">\uc0\u3585 . \u3592 \u3635 \u3609 \u3623 \u3609 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3621 \u3591 \u3650 \u3607 \u3625 <br>\u3586 . \u3619 \u3632 \u3604 \u3633 \u3610 \u3604 \u3633 \u3594 \u3609 \u3637 \u3585 \u3634 \u3619 \u3619 \u3633 \u3610 \u3619 \u3641 \u3657 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605  (CPI) \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3607 \u3637 \u3656 \u3611 \u3619 \u3633 \u3610 \u3605 \u3633 \u3623 \u3604 \u3637 \u3586 \u3638 \u3657 \u3609 <br>\u3588 . \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3607 \u3656 \u3637 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3650 \u3590 \u3625 \u3603 \u3634 \u3605 \u3656 \u3629 \u3605 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 <br>\u3591 . \u3592 \u3635 \u3609 \u3623 \u3609 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3605 \u3633 \u3657 \u3591 \u3586 \u3638 \u3657 \u3609 \u3651 \u3627 \u3617 \u3656 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3619 \u3632 \u3604 \u3633 \u3610 \u3604 \u3633 \u3594 \u3609 \u3637 \u3585 \u3634 \u3619 \u3619 \u3633 \u3610 \u3619 \u3641 \u3657 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605  (CPI) \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3607 \u3637 \u3656 \u3611 \u3619 \u3633 \u3610 \u3605 \u3633 \u3623 \u3604 \u3637 \u3586 \u3638 \u3657 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3648 \u3619 \u3655 \u3592 \u3607 \u3637 \u3656 \u3594 \u3633 \u3604 \u3648 \u3592 \u3609 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3605 \u3656 \u3629 \u3605 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3588 \u3639 \u3629  "\u3619 \u3632 \u3604 \u3633 \u3610 \u3604 \u3633 \u3594 \u3609 \u3637 \u3585 \u3634 \u3619 \u3619 \u3633 \u3610 \u3619 \u3641 \u3657 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605  (Corruption Perceptions Index: CPI)" \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3592 \u3632 \u3605 \u3657 \u3629 \u3591 \u3611 \u3619 \u3633 \u3610 \u3605 \u3633 \u3623 \u3604 \u3637 \u3586 \u3638 \u3657 \u3609  \u3595 \u3638 \u3656 \u3591 \u3604 \u3633 \u3594 \u3609 \u3637 \u3609 \u3637 \u3657 \u3648 \u3611 \u3655 \u3609 \u3617 \u3634 \u3605 \u3619 \u3600 \u3634 \u3609 \u3626 \u3634 \u3585 \u3621 \u3607 \u3637 \u3656 \u3609 \u3633 \u3585 \u3621 \u3591 \u3607 \u3640 \u3609 \u3607 \u3633 \u3656 \u3623 \u3650 \u3621 \u3585 \u3651 \u3594 \u3657 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3588 \u3623 \u3634 \u3617 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div></div>\
\
    <div class="qb"><div class="q">32. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3610 \u3607 \u3610 \u3634 \u3607 \u3651 \u3627 \u3617 \u3656 \u3586 \u3629 \u3591 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3617 \u3640 \u3656 \u3591 \u3627 \u3623 \u3633 \u3591 \u3592 \u3632 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3592 \u3634 \u3585  "\u3612 \u3641 \u3657 \u3588 \u3623 \u3610 \u3588 \u3640 \u3617 "</div>\
    <div class="c">\uc0\u3585 . \u3612 \u3641 \u3657 \u3626 \u3633 \u3656 \u3591 \u3585 \u3634 \u3619  (Commander)<br>\u3586 . \u3612 \u3641 \u3657 \u3629 \u3635 \u3609 \u3623 \u3618 \u3588 \u3623 \u3634 \u3617 \u3626 \u3632 \u3604 \u3623 \u3585  (Facilitator)<br>\u3588 . \u3612 \u3641 \u3657 \u3586 \u3633 \u3604 \u3586 \u3623 \u3634 \u3591  (Interrupter)<br>\u3591 . \u3612 \u3641 \u3657 \u3607 \u3635 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3649 \u3586 \u3656 \u3591 \u3585 \u3633 \u3610 \u3648 \u3629 \u3585 \u3594 \u3609  (Competitor)</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3612 \u3641 \u3657 \u3629 \u3635 \u3609 \u3623 \u3618 \u3588 \u3623 \u3634 \u3617 \u3626 \u3632 \u3604 \u3623 \u3585  (Facilitator)</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3619 \u3632 \u3610 \u3610 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3588 \u3639 \u3629 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3610 \u3607 \u3610 \u3634 \u3607  (Role Model) \u3586 \u3629 \u3591 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600  \u3592 \u3634 \u3585 \u3648 \u3604 \u3636 \u3617 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609  "\u3612 \u3641 \u3657 \u3626 \u3633 \u3656 \u3591 \u3585 \u3634 \u3619 " \u3627 \u3619 \u3639 \u3629  "\u3612 \u3641 \u3657 \u3588 \u3623 \u3610 \u3588 \u3640 \u3617 " (Controller) \u3607 \u3637 \u3656 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3649 \u3605 \u3656 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610 \u3585 \u3598 \u3648 \u3585 \u3603 \u3601 \u3660  \u3617 \u3634 \u3648 \u3611 \u3655 \u3609  "\u3612 \u3641 \u3657 \u3629 \u3635 \u3609 \u3623 \u3618 \u3588 \u3623 \u3634 \u3617 \u3626 \u3632 \u3604 \u3623 \u3585 " (Facilitator) \u3607 \u3637 \u3656 \u3617 \u3640 \u3656 \u3591 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3616 \u3634 \u3588 \u3648 \u3629 \u3585 \u3594 \u3609 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3651 \u3627 \u3657 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3604 \u3635 \u3619 \u3591 \u3594 \u3637 \u3623 \u3636 \u3605 \u3649 \u3621 \u3632 \u3607 \u3635 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3652 \u3604 \u3657 \u3591 \u3656 \u3634 \u3618 \u3586 \u3638 \u3657 \u3609 </div></div>\
\
    <div class="qb"><div class="q">33. \uc0\u3585 \u3634 \u3619 \u3621 \u3604 \u3619 \u3634 \u3618 \u3592 \u3656 \u3634 \u3618 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3637 \u3656 \u3652 \u3617 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3606 \u3641 \u3585 \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634 \u3588 \u3623 \u3619 \u3648 \u3619 \u3636 \u3656 \u3617 \u3605 \u3657 \u3609 \u3592 \u3634 \u3585 \u3626 \u3656 \u3623 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3648 \u3591 \u3636 \u3609 \u3648 \u3604 \u3639 \u3629 \u3609 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3594 \u3633 \u3657 \u3609 \u3612 \u3641 \u3657 \u3609 \u3657 \u3629 \u3618 <br>\u3586 . \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3651 \u3609 \u3626 \u3636 \u3656 \u3591 \u3611 \u3621 \u3641 \u3585 \u3626 \u3619 \u3657 \u3634 \u3591 \u3607 \u3637 \u3656 \u3652 \u3617 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 \u3604 \u3641 \u3591 \u3634 \u3609 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3588 . \u3585 \u3634 \u3619 \u3618 \u3585 \u3648 \u3621 \u3636 \u3585 \u3585 \u3634 \u3619 \u3619 \u3633 \u3585 \u3625 \u3634 \u3614 \u3618 \u3634 \u3610 \u3634 \u3621 \u3615 \u3619 \u3637 <br>\u3591 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3629 \u3634 \u3627 \u3634 \u3619 \u3585 \u3621 \u3634 \u3591 \u3623 \u3633 \u3609 \u3609 \u3633 \u3585 \u3648 \u3619 \u3637 \u3618 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3651 \u3609 \u3626 \u3636 \u3656 \u3591 \u3611 \u3621 \u3641 \u3585 \u3626 \u3619 \u3657 \u3634 \u3591 \u3607 \u3637 \u3656 \u3652 \u3617 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 \u3604 \u3641 \u3591 \u3634 \u3609 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3617 \u3637 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3611 \u3619 \u3633 \u3610 \u3621 \u3604 \u3619 \u3634 \u3618 \u3592 \u3656 \u3634 \u3618 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3637 \u3656 \u3595 \u3657 \u3635 \u3595 \u3657 \u3629 \u3609 \u3649 \u3621 \u3632 \u3652 \u3617 \u3656 \u3585 \u3656 \u3629 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3650 \u3604 \u3618 \u3605 \u3619 \u3591 \u3605 \u3656 \u3629 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609  \u3650 \u3604 \u3618 \u3648 \u3593 \u3614 \u3634 \u3632 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3651 \u3609 \u3626 \u3636  \u3656 \u3591 \u3611 \u3621 \u3641 \u3585 \u3626 \u3619 \u3657 \u3634 \u3591 \u3607 \u3637  \u3656 \u3618 \u3633 \u3591 \u3652 \u3617 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3627 \u3619 \u3639 \u3629 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3624 \u3638 \u3585 \u3625 \u3634 \u3604 \u3641 \u3591 \u3634 \u3609 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3648 \u3614 \u3639 \u3656 \u3629 \u3609 \u3635 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3648 \u3627 \u3621 \u3656 \u3634 \u3609 \u3633 \u3657 \u3609 \u3652 \u3611 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3648 \u3619 \u3656 \u3591 \u3604 \u3656 \u3623 \u3609 </div></div>\
\
    <div class="qb"><div class="q">34. \uc0\u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3651 \u3604 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3609 \u3635 \u3617 \u3634 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3619 \u3632 \u3610 \u3610 \u3611 \u3619 \u3632 \u3585 \u3633 \u3609 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614  (\u3619 \u3633 \u3585 \u3625 \u3634 \u3607 \u3640 \u3585 \u3607 \u3656 \u3637 \u3652 \u3604 \u3657 \u3607 \u3633 \u3609 \u3607 \u3637 )</div>\
    <div class="c">\uc0\u3585 . \u3619 \u3632 \u3610 \u3610 \u3610 \u3633 \u3605 \u3619 \u3588 \u3636 \u3623 \u3649 \u3610 \u3610 \u3585 \u3619 \u3632 \u3604 \u3634 <br>\u3586 . \u3619 \u3632 \u3610 \u3610 \u3600 \u3634 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614 \u3626 \u3656 \u3623 \u3609 \u3610 \u3640 \u3588 \u3588 \u3621 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \u3607 \u3634 \u3591 \u3652 \u3585 \u3621  (Telemedicine)<br>\u3588 . \u3585 \u3634 \u3619 \u3648 \u3614 \u3656 \u3636 \u3617 \u3592 \u3635 \u3609 \u3623 \u3609 \u3614 \u3618 \u3634 \u3610 \u3634 \u3621 \u3651 \u3609 \u3607 \u3640 \u3585 \u3627 \u3617 \u3641 \u3656 \u3610 \u3657 \u3634 \u3609 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3651 \u3594 \u3657 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 <br>\u3591 . \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3614 \u3636 \u3617 \u3614 \u3660 \u3604 \u3637 \u3604 \u3651 \u3609 \u3585 \u3634 \u3619 \u3610 \u3633 \u3609 \u3607 \u3638 \u3585 \u3611 \u3619 \u3632 \u3623 \u3633 \u3605 \u3636 \u3588 \u3609 \u3652 \u3586 \u3657 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3619 \u3632 \u3610 \u3610 \u3600 \u3634 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614 \u3626 \u3656 \u3623 \u3609 \u3610 \u3640 \u3588 \u3588 \u3621 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \u3607 \u3634 \u3591 \u3652 \u3585 \u3621  (Telemedicine)</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3614 \u3639 \u3656 \u3629 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614 \u3651 \u3627 \u3657 \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623 \u3649 \u3621 \u3632 \u3648 \u3607 \u3656 \u3634 \u3648 \u3607 \u3637 \u3618 \u3617  \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621  \u3648 \u3594 \u3656 \u3609  \u3619 \u3632 \u3610 \u3610 \u3600 \u3634 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614 \u3626 \u3656 \u3623 \u3609 \u3610 \u3640 \u3588 \u3588 \u3621 \u3607 \u3637  \u3656 \u3648 \u3594  \u3639  \u3656 \u3629 \u3617 \u3650 \u3618 \u3591 \u3606 \u3638 \u3591 \u3585 \u3633 \u3609  (Personal Health Record) \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \u3607 \u3634 \u3591 \u3652 \u3585 \u3621  (Telemedicine) \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3623 \u3636 \u3609 \u3636 \u3592 \u3593 \u3633 \u3618 \u3649 \u3621 \u3632 \u3619 \u3633 \u3585 \u3625 \u3634 \u3648 \u3610 \u3639 \u3657 \u3629 \u3591 \u3605 \u3657 \u3609 \u3652 \u3604 \u3657 \u3607 \u3633 \u3609 \u3607 \u3637 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3605 \u3657 \u3629 \u3591 \u3648 \u3604 \u3636 \u3609 \u3607 \u3634 \u3591 \u3652 \u3611 \u3650 \u3619 \u3591 \u3614 \u3618 \u3634 \u3610 \u3634 \u3621 \u3651 \u3627 \u3597 \u3656 </div></div>\
\
    <div class="qb"><div class="q">35. \uc0\u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3605 \u3633 \u3657 \u3591  "\u3605 \u3621 \u3634 \u3604 \u3595 \u3639 \u3657 \u3629 \u3586 \u3634 \u3618 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 \u3648 \u3588 \u3619 \u3604 \u3636 \u3605 " \u3617 \u3637 \u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3648 \u3614 \u3656 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3586 \u3634 \u3618 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3611 \u3656 \u3634 \u3652 \u3617 \u3657 \u3651 \u3627 \u3657 \u3585 \u3633 \u3610 \u3605 \u3656 \u3634 \u3591 \u3594 \u3634 \u3605 \u3636 <br>\u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3650 \u3629 \u3585 \u3634 \u3626 \u3651 \u3609 \u3585 \u3634 \u3619 \u3627 \u3634 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3649 \u3621 \u3632 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 \u3605 \u3656 \u3635 <br>\u3588 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3648 \u3585 \u3655 \u3610 \u3616 \u3634 \u3625 \u3637 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 \u3592 \u3634 \u3585 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3650 \u3604 \u3618 \u3605 \u3619 \u3591 <br>\u3591 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3618 \u3585 \u3648 \u3621 \u3636 \u3585 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3618 \u3609 \u3605 \u3660 \u3626 \u3633 \u3609 \u3604 \u3634 \u3611 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 \u3607 \u3633 \u3609 \u3607 \u3637 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3650 \u3629 \u3585 \u3634 \u3626 \u3651 \u3609 \u3585 \u3634 \u3619 \u3627 \u3634 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3649 \u3621 \u3632 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 \u3605 \u3656 \u3635 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3605 \u3633 \u3657 \u3591 \u3605 \u3621 \u3634 \u3604 \u3595 \u3639 \u3657 \u3629 \u3586 \u3634 \u3618 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 \u3648 \u3588 \u3619 \u3604 \u3636 \u3605 \u3648 \u3611 \u3655 \u3609 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3607 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3607 \u3637 \u3656 \u3594 \u3656 \u3623 \u3618 \u3651 \u3627 \u3657 \u3594 \u3640 \u3617 \u3594 \u3609 \u3649 \u3621 \u3632 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3652 \u3607 \u3618 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3585 \u3634 \u3619 \u3604 \u3641 \u3649 \u3621 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657  \u3650 \u3604 \u3618 \u3648 \u3593 \u3614 \u3634 \u3632 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3607 \u3637 \u3656 \u3611 \u3619 \u3633 \u3610 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3617 \u3634 \u3607 \u3635 \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3605 \u3619 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3586 \u3634 \u3618 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 \u3648 \u3588 \u3619 \u3604 \u3636 \u3605 \u3651 \u3627 \u3657 \u3585 \u3633 \u3610 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3607 \u3637 \u3656 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3621 \u3604 \u3585 \u3634 \u3619 \u3611 \u3621 \u3656 \u3629 \u3618 \u3585 \u3658 \u3634 \u3595 \u3648 \u3619 \u3639 \u3629 \u3609 \u3585 \u3619 \u3632 \u3592 \u3585  \u3648 \u3611 \u3655 \u3609 \u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3605 \u3640 \u3657 \u3609 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3626 \u3633 \u3591 \u3588 \u3617 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 \u3605 \u3656 \u3635 \u3588 \u3623 \u3610 \u3588 \u3641 \u3656 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3650 \u3629 \u3585 \u3634 \u3626 \u3607 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3651 \u3627 \u3617 \u3656 </div></div>\
\
    <div class="qb"><div class="q">36. \uc0\u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3617 \u3637 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609  SMEs \u3651 \u3627 \u3657 \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591 \u3649 \u3627 \u3621 \u3656 \u3591 \u3607 \u3640 \u3609 \u3612 \u3656 \u3634 \u3609 \u3585 \u3621 \u3652 \u3585 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3618 \u3639 \u3617 \u3648 \u3591 \u3636 \u3609 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3605 \u3657 \u3629 \u3591 \u3607 \u3635 \u3626 \u3633 \u3597 \u3597 \u3634 <br>\u3586 . \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3611 \u3619 \u3640 \u3591 \u3619 \u3632 \u3610 \u3610 \u3610 \u3633 \u3597 \u3594 \u3637 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660 \u3615 \u3619 \u3637 \u3649 \u3621 \u3632 \u3619 \u3632 \u3610 \u3610 \u3651 \u3610 \u3585 \u3635 \u3585 \u3633 \u3610 \u3616 \u3634 \u3625 \u3637 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660 <br>\u3588 . \u3585 \u3634 \u3619 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3651 \u3627 \u3657 \u3608 \u3609 \u3634 \u3588 \u3634 \u3619 \u3648 \u3629 \u3585 \u3594 \u3609 \u3611 \u3621 \u3656 \u3629 \u3618 \u3585 \u3641 \u3657 \u3607 \u3640 \u3585 \u3585 \u3619 \u3603 \u3637 <br>\u3591 . \u3585 \u3634 \u3619 \u3649 \u3592 \u3585 \u3648 \u3591 \u3636 \u3609 \u3626 \u3604 \u3651 \u3627 \u3657 \u3585 \u3633 \u3610 \u3648 \u3592 \u3657 \u3634 \u3586 \u3629 \u3591 \u3585 \u3636 \u3592 \u3585 \u3634 \u3619 \u3650 \u3604 \u3618 \u3605 \u3619 \u3591 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3611 \u3619 \u3640 \u3591 \u3619 \u3632 \u3610 \u3610 \u3610 \u3633 \u3597 \u3594 \u3637 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660 \u3615 \u3619 \u3637 \u3649 \u3621 \u3632 \u3619 \u3632 \u3610 \u3610 \u3651 \u3610 \u3585 \u3635 \u3585 \u3633 \u3610 \u3616 \u3634 \u3625 \u3637 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3594 \u3656 \u3623 \u3618 \u3621 \u3604 \u3586 \u3657 \u3629 \u3592 \u3635 \u3585 \u3633 \u3604 \u3586 \u3629 \u3591  SMEs \u3651 \u3609 \u3585 \u3634 \u3619 \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591 \u3649 \u3627 \u3621 \u3656 \u3591 \u3607 \u3640 \u3609 \u3604 \u3657 \u3623 \u3618 \u3585 \u3634 \u3619 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621  \u3648 \u3594 \u3656 \u3609  \u3619 \u3632 \u3610 \u3610 \u3610 \u3633 \u3597 \u3594 \u3637 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660 \u3615 \u3619 \u3637  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3618 \u3591 \u3619 \u3632 \u3610 \u3610  e-Tax Invoice \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3619 \u3634 \u3618 \u3618 \u3656 \u3629 \u3618 \u3617 \u3637 \u3600 \u3634 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609 \u3607 \u3637 \u3656 \u3652 \u3604 \u3657 \u3617 \u3634 \u3605 \u3619 \u3600 \u3634 \u3609 \u3649 \u3621 \u3632 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626  \u3595 \u3638 \u3656 \u3591 \u3592 \u3632 \u3594 \u3656 \u3623 \u3618 \u3648 \u3614 \u3636 \u3656 \u3617 \u3588 \u3623 \u3634 \u3617 \u3609 \u3656 \u3634 \u3648 \u3594 \u3639 \u3656 \u3629 \u3606 \u3639 \u3629 \u3648 \u3617 \u3639 \u3656 \u3629 \u3652 \u3611 \u3618 \u3639 \u3656 \u3609 \u3586 \u3629 \u3626 \u3636 \u3609 \u3648 \u3594 \u3639 \u3656 \u3629 \u3592 \u3634 \u3585 \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609 </div></div>\
\
    <div class="qb"><div class="q">37. "Government Digital Transformation" \uc0\u3592 \u3632 \u3626 \u3617 \u3610 \u3641 \u3619 \u3603 \u3660 \u3652 \u3604 \u3657 \u3605 \u3657 \u3629 \u3591 \u3629 \u3634 \u3624 \u3633 \u3618 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3651 \u3609 \u3604 \u3657 \u3634 \u3609 \u3651 \u3604 \u3648 \u3611 \u3655 \u3609 \u3627 \u3621 \u3633 \u3585 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3588 \u3629 \u3617 \u3614 \u3636 \u3623 \u3648 \u3605 \u3629 \u3619 \u3660 \u3651 \u3627 \u3617 \u3656 \u3607 \u3640 \u3585 \u3611 \u3637 <br>\u3586 . \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3649 \u3621 \u3632 \u3651 \u3627 \u3657 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3626 \u3641 \u3656 \u3619 \u3632 \u3610 \u3610 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 <br>\u3588 . \u3585 \u3634 \u3619 \u3651 \u3594 \u3629 \u3637 \u3648 \u3617 \u3621 \u3651 \u3609 \u3585 \u3634 \u3619 \u3626 \u3639 \u3656 \u3629 \u3626 \u3634 \u3619 \u3616 \u3634 \u3618 \u3651 \u3609 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3648 \u3607 \u3656 \u3634 \u3609 \u3633 \u3657 \u3609 <br>\u3591 . \u3585 \u3634 \u3619 \u3592 \u3657 \u3634 \u3591 \u3610 \u3619 \u3636 \u3625 \u3633 \u3607 \u3648 \u3629 \u3585 \u3594 \u3609 \u3617 \u3634 \u3607 \u3635 \u3591 \u3634 \u3609 \u3649 \u3607 \u3609 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3649 \u3621 \u3632 \u3651 \u3627 \u3657 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3626 \u3641 \u3656 \u3619 \u3632 \u3610 \u3610 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3612 \u3656 \u3634 \u3609 \u3626 \u3641 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621  (Government Digital Transformation) \u3607 \u3637 \u3656 \u3649 \u3607 \u3657 \u3592 \u3619 \u3636 \u3591 \u3652 \u3617 \u3656 \u3651 \u3594 \u3656 \u3649 \u3588 \u3656 \u3585 \u3634 \u3619 \u3595 \u3639 \u3657 \u3629 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3588 \u3629 \u3617 \u3614 \u3636 \u3623 \u3648 \u3605 \u3629 \u3619 \u3660  \u3649 \u3605 \u3656 \u3588 \u3639 \u3629 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3619 \u3639 \u3657 \u3629 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609  (Process Redesign) \u3586 \u3629 \u3591 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 \u3651 \u3627 \u3657 \u3585 \u3621 \u3634 \u3618 \u3648 \u3611 \u3655 \u3609 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3605 \u3633 \u3657 \u3591 \u3649 \u3605 \u3656 \u3605 \u3657 \u3609 \u3592 \u3609 \u3592 \u3610  \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3649 \u3617 \u3656 \u3609 \u3618 \u3635  \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626  \u3649 \u3621 \u3632 \u3621 \u3604 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3604 \u3640 \u3621 \u3614 \u3636 \u3609 \u3636 \u3592 \u3586 \u3629 \u3591 \u3648 \u3592 \u3657 \u3634 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 </div></div>\
\
    <div class="qb"><div class="q">38. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3648 \u3594 \u3636 \u3591 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3586 \u3629 \u3591 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618  "\u3607 \u3641 \u3605 \u3623 \u3636 \u3607 \u3618 \u3634 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660  \u3623 \u3636 \u3592 \u3633 \u3618  \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 "</div>\
    <div class="c">\uc0\u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3626 \u3656 \u3591 \u3609 \u3633 \u3585 \u3623 \u3636 \u3607 \u3618 \u3634 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3652 \u3607 \u3618 \u3652 \u3611 \u3607 \u3635 \u3591 \u3634 \u3609 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3633 \u3656 \u3609 \u3649 \u3621 \u3632 \u3612 \u3621 \u3633 \u3585 \u3604 \u3633 \u3609 \u3652 \u3607 \u3618 \u3626 \u3641 \u3656 \u3627 \u3656 \u3623 \u3591 \u3650 \u3595 \u3656 \u3629 \u3640 \u3611 \u3607 \u3634 \u3609 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3650 \u3621 \u3585 <br>\u3588 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3611 \u3619 \u3632 \u3585 \u3623 \u3604 \u3619 \u3634 \u3591 \u3623 \u3633 \u3621 \u3607 \u3634 \u3591 \u3623 \u3636 \u3607 \u3618 \u3634 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3619 \u3632 \u3604 \u3633 \u3610 \u3650 \u3621 \u3585 <br>\u3591 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3609 \u3636 \u3618 \u3634 \u3618 \u3623 \u3636 \u3607 \u3618 \u3634 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3652 \u3607 \u3618 \u3651 \u3627 \u3657 \u3650 \u3604 \u3656 \u3591 \u3604 \u3633 \u3591 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3633 \u3656 \u3609 \u3649 \u3621 \u3632 \u3612 \u3621 \u3633 \u3585 \u3604 \u3633 \u3609 \u3652 \u3607 \u3618 \u3626 \u3641 \u3656 \u3627 \u3656 \u3623 \u3591 \u3650 \u3595 \u3656 \u3629 \u3640 \u3611 \u3607 \u3634 \u3609 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3650 \u3621 \u3585 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3607 \u3641 \u3605 \u3623 \u3636 \u3607 \u3618 \u3634 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660  \u3623 \u3636 \u3592 \u3633 \u3618  \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617  \u3648 \u3611 \u3655 \u3609 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3651 \u3627 \u3617 \u3656 \u3651 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3633 \u3617 \u3614 \u3633 \u3609 \u3608 \u3660 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3650 \u3604 \u3618 \u3648 \u3609 \u3657 \u3609 \u3588 \u3623 \u3634 \u3617 \u3619 \u3656 \u3623 \u3617 \u3617 \u3639 \u3629 \u3604 \u3657 \u3634 \u3609 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3594 \u3633 \u3657 \u3609 \u3626 \u3641 \u3591  \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3633 \u3656 \u3609 \u3651 \u3627 \u3657 \u3609 \u3633 \u3585 \u3621 \u3591 \u3607 \u3640 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3650 \u3621 \u3585 \u3649 \u3621 \u3632 \u3612 \u3621 \u3633 \u3585 \u3604 \u3633 \u3609 \u3651 \u3627 \u3657 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3586 \u3629 \u3591 \u3652 \u3607 \u3618 \u3648 \u3586 \u3657 \u3634 \u3652 \u3611 \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3627 \u3656 \u3623 \u3591 \u3650 \u3595 \u3656 \u3629 \u3640 \u3611 \u3607 \u3634 \u3609  (Supply Chain) \u3607 \u3637 \u3656 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3650 \u3621 \u3585  \u3648 \u3594 \u3656 \u3609  \u3648 \u3595 \u3617 \u3636 \u3588 \u3629 \u3609 \u3604 \u3633 \u3585 \u3648 \u3605 \u3629 \u3619 \u3660  \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3626 \u3632 \u3629 \u3634 \u3604  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 </div></div>\
\
    <div class="qb"><div class="q">39. \uc0\u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3656 \u3618 \u3591 \u3604 \u3657 \u3634 \u3609  "\u3616 \u3641 \u3617 \u3636 \u3619 \u3633 \u3600 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 " (Geopolitics) \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3604 \u3635 \u3648 \u3609 \u3636 \u3609 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3649 \u3610 \u3610 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3648 \u3621 \u3639 \u3629 \u3585 \u3586 \u3657 \u3634 \u3591 \u3617 \u3627 \u3634 \u3629 \u3635 \u3609 \u3634 \u3592 \u3648 \u3614 \u3637 \u3618 \u3591 \u3613 \u3656 \u3634 \u3618 \u3648 \u3604 \u3637 \u3618 \u3623 <br>\u3586 . \u3585 \u3634 \u3619 \u3619 \u3633 \u3585 \u3625 \u3634 \u3611 \u3599 \u3636 \u3626 \u3633 \u3617 \u3614 \u3633 \u3609 \u3608 \u3660 \u3607 \u3637 \u3656 \u3604 \u3637 \u3585 \u3633 \u3610 \u3607 \u3640 \u3585 \u3586 \u3633 \u3657 \u3623 \u3629 \u3635 \u3609 \u3634 \u3592 \u3649 \u3621 \u3632 \u3618 \u3638 \u3604 \u3612 \u3621 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3586 \u3629 \u3591 \u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3607 \u3637 \u3656 \u3605 \u3633 \u3657 \u3591 <br>\u3588 . \u3585 \u3634 \u3619 \u3611 \u3636 \u3604 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3648 \u3614 \u3656 \u3639 \u3629 \u3627 \u3621 \u3637 \u3585 \u3648 \u3621 \u3637 \u3656 \u3618 \u3591 \u3588 \u3623 \u3634 \u3617 \u3586 \u3633 \u3604 \u3649 \u3618 \u3657 \u3591 <br>\u3591 . \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3585 \u3634 \u3624 \u3626 \u3591 \u3588 \u3619 \u3634 \u3617 \u3585 \u3633 \u3610 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3588 \u3641 \u3656 \u3586 \u3633 \u3604 \u3649 \u3618 \u3657 \u3591 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3619 \u3633 \u3585 \u3625 \u3634 \u3611 \u3599 \u3636 \u3626 \u3633 \u3617 \u3614 \u3633 \u3609 \u3608 \u3660 \u3607 \u3637 \u3656 \u3604 \u3637 \u3585 \u3633 \u3610 \u3607 \u3640 \u3585 \u3586 \u3633 \u3657 \u3623 \u3629 \u3635 \u3609 \u3634 \u3592 \u3649 \u3621 \u3632 \u3618 \u3638 \u3604 \u3612 \u3621 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3586 \u3629 \u3591 \u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3607 \u3637 \u3656 \u3605 \u3633 \u3657 \u3591 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3610 \u3619 \u3636 \u3610 \u3607 \u3650 \u3621 \u3585 \u3627 \u3621 \u3634 \u3618 \u3586 \u3633 \u3657 \u3623 \u3607 \u3637 \u3656 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3586 \u3633 \u3604 \u3649 \u3618 \u3657 \u3591 \u3626 \u3641 \u3591  \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3604 \u3635 \u3648 \u3609 \u3636 \u3609 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3648 \u3594 \u3636 \u3591 \u3619 \u3640 \u3585 \u3607 \u3637 \u3656 \u3618 \u3639 \u3604 \u3627 \u3618 \u3640 \u3656 \u3609 \u3649 \u3621 \u3632 \u3606 \u3656 \u3623 \u3591 \u3604 \u3640 \u3621 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3586 \u3633 \u3657 \u3623 \u3629 \u3635 \u3609 \u3634 \u3592 \u3617 \u3627 \u3634 \u3629 \u3635 \u3609 \u3634 \u3592  \u3650 \u3604 \u3618 \u3618 \u3638 \u3604 \u3606 \u3639 \u3629 \u3612 \u3621 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3648 \u3611 \u3655 \u3609 \u3605 \u3633 \u3623 \u3605 \u3633 \u3657 \u3591 \u3626 \u3635 \u3588 \u3633 \u3597  \u3614 \u3619 \u3657 \u3629 \u3617 \u3607 \u3633 \u3657 \u3591 \u3619 \u3633 \u3585 \u3625 \u3634 \u3588 \u3623 \u3634 \u3617 \u3626 \u3633 \u3617 \u3614 \u3633 \u3609 \u3608 \u3660 \u3607 \u3637 \u3656 \u3604 \u3637 \u3585 \u3633 \u3610 \u3607 \u3640 \u3585 \u3613 \u3656 \u3634 \u3618 \u3648 \u3614 \u3639 \u3656 \u3629 \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3656 \u3618 \u3591 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3649 \u3621 \u3632 \u3586 \u3618 \u3634 \u3618 \u3650 \u3629 \u3585 \u3634 \u3626 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3651 \u3609 \u3607 \u3640 \u3585 \u3617 \u3636 \u3605  \u3636 </div></div>\
\
    <div class="qb"><div class="q">40. \uc0\u3619 \u3632 \u3610 \u3610  "Zoning by Agri-Map" \u3606 \u3641 \u3585 \u3609 \u3635 \u3617 \u3634 \u3651 \u3594 \u3657 \u3648 \u3614 \u3656 \u3639 \u3629 \u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3651 \u3604 \u3651 \u3609 \u3616 \u3634 \u3588 \u3648 \u3585 \u3625 \u3605 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3618 \u3638 \u3604 \u3607 \u3637 \u3656 \u3604 \u3636 \u3609 \u3607 \u3635 \u3585 \u3636 \u3609 \u3586 \u3629 \u3591 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3588 \u3639 \u3609 <br>\u3586 . \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3605 \u3619 \u3607 \u3637 \u3656 \u3626 \u3629 \u3604 \u3588 \u3621 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3586 \u3629 \u3591 \u3604 \u3636 \u3609 \u3649 \u3621 \u3632 \u3649 \u3627 \u3621 \u3656 \u3591 \u3609 \u3657 \u3635 <br>\u3588 . \u3585 \u3634 \u3619 \u3649 \u3610 \u3656 \u3591 \u3648 \u3586 \u3605 \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3634 \u3619 \u3648 \u3621 \u3639 \u3629 \u3585 \u3605 \u3633 \u3657 \u3591 <br>\u3591 . \u3585 \u3634 \u3619 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3586 \u3605 \u3627 \u3657 \u3634 \u3617 \u3648 \u3586 \u3657 \u3634 \u3651 \u3609 \u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656 \u3611 \u3656 \u3634 \u3652 \u3617 \u3657 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3605 \u3619 \u3607 \u3637 \u3656 \u3626 \u3629 \u3604 \u3588 \u3621 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3586 \u3629 \u3591 \u3604 \u3636 \u3609 \u3649 \u3621 \u3632 \u3649 \u3627 \u3621 \u3656 \u3591 \u3609 \u3657 \u3635 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : Zoning by Agri-Map \u3648 \u3611 \u3655 \u3609 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3651 \u3609 \u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3649 \u3612 \u3609 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3619 \u3617 \u3648 \u3594 \u3636 \u3591 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660  \u3650 \u3604 \u3618 \u3609 \u3635 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3586 \u3629 \u3591 \u3604 \u3636 \u3609  \u3649 \u3627 \u3621 \u3656 \u3591 \u3609 \u3657 \u3635  \u3649 \u3621 \u3632 \u3626 \u3616 \u3634 \u3614 \u3629 \u3634 \u3585 \u3634 \u3624 \u3617 \u3634 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660  \u3648 \u3614 \u3639 \u3656 \u3629 \u3649 \u3609 \u3632 \u3609 \u3635 \u3651 \u3627 \u3657 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3611 \u3621 \u3641 \u3585 \u3614 \u3639 \u3594 \u3607 \u3637 \u3656 \u3648 \u3627 \u3617 \u3634 \u3632 \u3626 \u3617 \u3585 \u3633 \u3610 \u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656 \u3586 \u3629 \u3591 \u3605 \u3609 \u3648 \u3629 \u3591 \u3617 \u3634 \u3585 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604  \u3595 \u3638 \u3656 \u3591 \u3592 \u3632 \u3594 \u3656 \u3623 \u3618 \u3621 \u3604 \u3605 \u3657 \u3609 \u3607 \u3640 \u3609 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605  \u3648 \u3614 \u3656 \u3636 \u3617 \u3611 \u3619 \u3636 \u3617 \u3634 \u3603 \u3612 \u3621 \u3612 \u3621 \u3636 \u3605  \u3649 \u3621 \u3632 \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3656 \u3618 \u3591 \u3592 \u3634 \u3585 \u3616 \u3633 \u3618 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636 </div></div>\
\
    <div class="qb"><div class="q">41. \uc0\u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3585 \u3656 \u3629 \u3609 \u3585 \u3634 \u3619 \u3605 \u3619 \u3634 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3651 \u3627 \u3617 \u3656  (Regulatory Impact Assessment) \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3588 \u3623 \u3634 \u3617 \u3626 \u3623 \u3618 \u3591 \u3634 \u3617 \u3586 \u3629 \u3591 \u3605 \u3633 \u3623 \u3610 \u3607 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 <br>\u3586 . \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3605 \u3657 \u3629 \u3591 \u3648 \u3614 \u3656 \u3636 \u3617 \u3586 \u3637 \u3604 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3649 \u3621 \u3632 \u3607 \u3635 \u3651 \u3627 \u3657 \u3594 \u3637 \u3623 \u3636 \u3605 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3604 \u3637 \u3586 \u3638 \u3657 \u3609 <br>\u3588 . \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3605 \u3657 \u3629 \u3591 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3618 \u3634 \u3623 \u3649 \u3621 \u3632 \u3621 \u3632 \u3648 \u3629 \u3637 \u3618 \u3604 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 <br>\u3591 . \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3605 \u3657 \u3629 \u3591 \u3606 \u3641 \u3585 \u3651 \u3592 \u3609 \u3633 \u3585 \u3585 \u3634 \u3619 \u3648 \u3617 \u3639 \u3629 \u3591 \u3617 \u3634 \u3585 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3605 \u3657 \u3629 \u3591 \u3648 \u3614 \u3656 \u3636 \u3617 \u3586 \u3637 \u3604 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3649 \u3621 \u3632 \u3607 \u3635 \u3651 \u3627 \u3657 \u3594 \u3637 \u3623 \u3636 \u3605 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3604 \u3637 \u3586 \u3638 \u3657 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618  (Regulatory Impact Assessment) \u3648 \u3611 \u3655 \u3609 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3626 \u3635 \u3588 \u3633 \u3597 \u3585 \u3656 \u3629 \u3609 \u3585 \u3634 \u3619 \u3629 \u3629 \u3585 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3651 \u3627 \u3617 \u3656  \u3648 \u3614 \u3656 \u3639 \u3629 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3629 \u3618 \u3656 \u3634 \u3591 \u3619 \u3629 \u3610 \u3604 \u3657 \u3634 \u3609 \u3623 \u3656 \u3634 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3609 \u3633 \u3657 \u3609 \u3592 \u3632 \u3626 \u3656 \u3591 \u3612 \u3621 \u3604 \u3637 \u3605 \u3656 \u3629 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619  \u3650 \u3604 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3648 \u3609 \u3657 \u3609 \u3623 \u3656 \u3634 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3651 \u3627 \u3617 \u3656 \u3605 \u3657 \u3629 \u3591 \u3652 \u3617 \u3656 \u3626 \u3619 \u3657 \u3634 \u3591 \u3616 \u3634 \u3619 \u3632 \u3648 \u3585 \u3636 \u3609 \u3626 \u3617 \u3588 \u3623 \u3619  \u3605 \u3657 \u3629 \u3591 \u3592 \u3635 \u3585 \u3633 \u3604 \u3626 \u3636 \u3607 \u3608 \u3636 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3648 \u3607 \u3656 \u3634 \u3607 \u3637 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609  \u3649 \u3621 \u3632 \u3605 \u3657 \u3629 \u3591 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3651 \u3627 \u3657 \u3604 \u3637 \u3618 \u3636 \u3656 \u3591 \u3586 \u3638 \u3657 \u3609 </div></div>\
\
    <div class="qb"><div class="q">42. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3648 \u3614 \u3639 \u3656 \u3629 \u3621 \u3604 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 \u3588 \u3629 \u3619 \u3660 \u3619 \u3633 \u3611 \u3594 \u3633 \u3609 \u3651 \u3609 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3629 \u3609 \u3640 \u3617 \u3633 \u3605 \u3636 \u3629 \u3609 \u3640 \u3597 \u3634 \u3605 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3648 \u3614 \u3636 \u3656 \u3617 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3585 \u3634 \u3619 \u3629 \u3609 \u3640 \u3617 \u3633 \u3605 \u3636 \u3651 \u3627 \u3657 \u3617 \u3634 \u3585 \u3586 \u3638 \u3657 \u3609 <br>\u3586 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3604 \u3640 \u3621 \u3614 \u3636 \u3609 \u3636 \u3592 \u3586 \u3629 \u3591 \u3648 \u3592 \u3657 \u3634 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3649 \u3621 \u3632 \u3651 \u3594 \u3657 \u3619 \u3632 \u3610 \u3610 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3607 \u3637 \u3656 \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3652 \u3604 \u3657 <br>\u3588 . \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3609 \u3635 \u3648 \u3591 \u3636 \u3609 \u3617 \u3634 \u3592 \u3656 \u3634 \u3618 \u3612 \u3656 \u3634 \u3609 \u3594 \u3656 \u3629 \u3591 \u3607 \u3634 \u3591 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3605 \u3657 \u3629 \u3591 \u3617 \u3637 \u3651 \u3610 \u3648 \u3626 \u3619 \u3655 \u3592 <br>\u3591 . \u3585 \u3634 \u3619 \u3618 \u3585 \u3648 \u3621 \u3636 \u3585 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3629 \u3609 \u3640 \u3617 \u3633 \u3605 \u3636 \u3629 \u3609 \u3640 \u3597 \u3634 \u3605 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3604 \u3640 \u3621 \u3614 \u3636 \u3609 \u3636 \u3592 \u3586 \u3629 \u3591 \u3648 \u3592 \u3657 \u3634 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3649 \u3621 \u3632 \u3651 \u3594 \u3657 \u3619 \u3632 \u3610 \u3610 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3607 \u3637 \u3656 \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3652 \u3604 \u3657 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3627 \u3621 \u3633 \u3585 \u3651 \u3609 \u3585 \u3634 \u3619 \u3621 \u3604 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 \u3588 \u3639 \u3629 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3629 \u3609 \u3640 \u3617 \u3633 \u3605 \u3636 \u3629 \u3609 \u3640 \u3597 \u3634 \u3605 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3619 \u3632 \u3610 \u3610 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632  (Smart License) \u3595 \u3638 \u3656 \u3591 \u3594 \u3656 \u3623 \u3618 \u3621 \u3604 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3604 \u3640 \u3621 \u3614 \u3636 \u3609 \u3636 \u3592 \u3586 \u3629 \u3591 \u3648 \u3592 \u3657 \u3634 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656  (Discretion) \u3649 \u3621 \u3632 \u3607 \u3635 \u3651 \u3627 \u3657 \u3607 \u3640 \u3585 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626  \u3611 \u3619 \u3632 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3605 \u3636 \u3604 \u3605 \u3634 \u3617 \u3626 \u3606 \u3634 \u3609 \u3632 \u3588 \u3635 \u3586 \u3629 \u3652 \u3604 \u3657 \u3649 \u3610 \u3610 \u3648 \u3619 \u3637 \u3618 \u3621 \u3652 \u3607 \u3617 \u3660  \u3595 \u3638 \u3656 \u3591 \u3648 \u3611 \u3655 \u3609 \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3611 \u3633 \u3597 \u3627 \u3634 \u3607 \u3637 \u3656 \u3605 \u3657 \u3609 \u3648 \u3627 \u3605 \u3640 \u3649 \u3621 \u3632 \u3607 \u3635 \u3651 \u3627 \u3657 \u3585 \u3634 \u3619 \u3605 \u3636 \u3604 \u3605 \u3656 \u3629 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3632 \u3604 \u3623 \u3585 \u3649 \u3621 \u3632 \u3618 \u3640 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3607 \u3640 \u3585 \u3588 \u3609 </div></div>\
\
    <div class="qb"><div class="q">43. \uc0\u3609 \u3650 \u3618 \u3610 \u3634 \u3618  "\u3604 \u3629 \u3585 \u3648 \u3610 \u3637 \u3657 \u3618 \u3588 \u3609 \u3621 \u3632 \u3588 \u3619 \u3638 \u3656 \u3591 " \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3621 \u3640 \u3656 \u3617 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3609 \u3633 \u3585 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3629 \u3626 \u3633 \u3591 \u3627 \u3634 \u3619 \u3636 \u3617 \u3607 \u3619 \u3633 \u3614 \u3618 \u3660 <br>\u3586 . \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3607 \u3637 \u3656 \u3648 \u3586 \u3657 \u3634 \u3619 \u3656 \u3623 \u3617 \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3633 \u3585 \u3625 \u3632 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3611 \u3633 \u3592 \u3592 \u3633 \u3618 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 <br>\u3588 . \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3619 \u3632 \u3604 \u3633 \u3610 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 <br>\u3591 . \u3609 \u3633 \u3585 \u3648 \u3619 \u3637 \u3618 \u3609 \u3607 \u3637 \u3656 \u3585 \u3641 \u3657 \u3618 \u3639 \u3617 \u3648 \u3591 \u3636 \u3609 \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3607 \u3637 \u3656 \u3648 \u3586 \u3657 \u3634 \u3619 \u3656 \u3623 \u3617 \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3633 \u3585 \u3625 \u3632 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3611 \u3633 \u3592 \u3592 \u3633 \u3618 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 \u3604 \u3629 \u3585 \u3648 \u3610 \u3637 \u3657 \u3618 \u3588 \u3609 \u3621 \u3632 \u3588 \u3619 \u3638 \u3656 \u3591 \u3606 \u3641 \u3585 \u3629 \u3629 \u3585 \u3649 \u3610 \u3610 \u3617 \u3634 \u3648 \u3614 \u3656 \u3639 \u3629 \u3592 \u3641 \u3591 \u3651 \u3592 \u3651 \u3627 \u3657 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3611 \u3619 \u3633 \u3610 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3623 \u3636 \u3606 \u3637 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3617 \u3634 \u3626 \u3641 \u3656 \u3648 \u3585 \u3625 \u3605 \u3619 \u3626 \u3617 \u3633 \u3618 \u3651 \u3627 \u3617 \u3656 \u3607 \u3637 \u3656 \u3651 \u3594 \u3657 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3611 \u3633 \u3592 \u3592 \u3633 \u3618 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591  \u3650 \u3604 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3592 \u3632 \u3594 \u3656 \u3623 \u3618 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3616 \u3634 \u3619 \u3632 \u3604 \u3629 \u3585 \u3648 \u3610 \u3637 \u3657 \u3618 \u3648 \u3591 \u3636 \u3609 \u3585 \u3641 \u3657 \u3592 \u3634 \u3585 \u3608 \u3609 \u3634 \u3588 \u3634 \u3619 \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3605 \u3619 \u3649 \u3621 \u3632 \u3626 \u3627 \u3585 \u3619 \u3603 \u3660 \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3605 \u3619  (\u3608 .\u3585 .\u3626 .) \u3651 \u3627 \u3657 \u3585 \u3638 \u3656 \u3591 \u3627 \u3609 \u3638 \u3656 \u3591  \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3607 \u3637 \u3656 \u3648 \u3586 \u3657 \u3634 \u3619 \u3656 \u3623 \u3617 \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3633 \u3585 \u3625 \u3632 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3649 \u3617 \u3656 \u3611 \u3640 \u3659 \u3618 \u3649 \u3621 \u3632 \u3648 \u3617 \u3621 \u3655 \u3604 \u3614 \u3633 \u3609 \u3608 \u3640 \u3660 \u3607 \u3637 \u3656 \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 </div></div>\
\
    <div class="qb"><div class="q">44. \uc0\u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3619 \u3632 \u3610 \u3610 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3617 \u3637  "\u3586 \u3609 \u3634 \u3604 \u3648 \u3621 \u3655 \u3585 \u3621 \u3591 " \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3617 \u3637 \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3652 \u3621 \u3656 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3629 \u3629 \u3585 \u3607 \u3633 \u3609 \u3607  \u3637 <br>\u3586 . \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3637 \u3618 \u3603 \u3629 \u3634 \u3618 \u3640 \u3585 \u3656 \u3629 \u3609 \u3585 \u3635 \u3627 \u3609 \u3604 \u3649 \u3621 \u3632 \u3621 \u3604 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 \u3607 \u3637 \u3656 \u3595 \u3657 \u3635 \u3595 \u3657 \u3629 \u3609 <br>\u3588 . \u3585 \u3634 \u3619 \u3618 \u3640 \u3610 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 \u3651 \u3627 \u3657 \u3648 \u3627 \u3621 \u3639 \u3629 \u3648 \u3614 \u3637 \u3618 \u3591 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3648 \u3604 \u3637 \u3618 \u3623 <br>\u3591 . \u3585 \u3634 \u3619 \u3627 \u3657 \u3634 \u3617 \u3619 \u3633 \u3610 \u3626 \u3617 \u3633 \u3588 \u3619 \u3614 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 \u3651 \u3627 \u3617 \u3656 \u3648 \u3611 \u3655 \u3609 \u3648 \u3623 \u3621 \u3634  10 \u3611 \u3637 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3637 \u3618 \u3603 \u3629 \u3634 \u3618 \u3640 \u3585 \u3656 \u3629 \u3609 \u3585 \u3635 \u3627 \u3609 \u3604 \u3649 \u3621 \u3632 \u3621 \u3604 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 \u3607 \u3637 \u3656 \u3595 \u3657 \u3635 \u3595 \u3657 \u3629 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3607 \u3635 \u3651 \u3627 \u3657 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3617 \u3637 \u3586 \u3609 \u3634 \u3604 \u3648 \u3621 \u3655 \u3585 \u3621 \u3591 \u3649 \u3605 \u3656 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 \u3626 \u3641 \u3591  (Small but Beautiful) \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3651 \u3594 \u3657 \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3607 \u3634 \u3591 \u3648 \u3621 \u3639 \u3629 \u3585 \u3649 \u3607 \u3609 \u3585 \u3634 \u3619 \u3621 \u3604 \u3614 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 \u3649 \u3610 \u3610 \u3611 \u3633 \u3592 \u3592 \u3640 \u3610 \u3633 \u3609 \u3607 \u3633 \u3609 \u3604 \u3656 \u3623 \u3609  \u3648 \u3594 \u3656 \u3609  \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3637 \u3618 \u3603 \u3629 \u3634 \u3618 \u3640 \u3585 \u3656 \u3629 \u3609 \u3585 \u3635 \u3627 \u3609 \u3604 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3626 \u3617 \u3633 \u3588 \u3619 \u3651 \u3592  \u3585 \u3634 \u3619 \u3621 \u3604 \u3585 \u3634 \u3619 \u3619 \u3633 \u3610 \u3610 \u3619 \u3619 \u3592 \u3640 \u3651 \u3627 \u3617 \u3656 \u3651 \u3609 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3607 \u3637 \u3656 \u3652 \u3617 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3609 \u3635 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3617 \u3634 \u3607 \u3635 \u3591 \u3634 \u3609 \u3649 \u3607 \u3609 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3608 \u3640 \u3619 \u3585 \u3634 \u3619 \u3607 \u3633 \u3656 \u3623 \u3652 \u3611  \u3648 \u3614 \u3656 \u3639 \u3629 \u3621 \u3604 \u3592 \u3635 \u3609 \u3623 \u3609 \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 \u3651 \u3609 \u3619 \u3632 \u3618 \u3632 \u3618 \u3634 \u3623 </div></div>\
\
    <div class="qb"><div class="q">45. \uc0\u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3588 \u3629 \u3617 \u3614 \u3636 \u3623 \u3648 \u3605 \u3629 \u3619 \u3660 \u3649 \u3621 \u3632 \u3629 \u3640 \u3611 \u3585 \u3619 \u3603 \u3660 \u3626 \u3635 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 \u3651 \u3609 \u3618 \u3640 \u3588 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3605 \u3657 \u3629 \u3591 \u3619 \u3629 \u3591 \u3619 \u3633 \u3610 \u3588 \u3640 \u3603 \u3626 \u3617 \u3610 \u3633 \u3605 \u3636 \u3651 \u3604 \u3605 \u3634 \u3617 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 </div>\
    <div class="c">\uc0\u3585 . \u3605 \u3657 \u3629 \u3591 \u3648 \u3611 \u3655 \u3609 \u3629 \u3640 \u3611 \u3585 \u3619 \u3603 \u3660 \u3607 \u3656 \u3637 \u3607 \u3635 \u3591 \u3634 \u3609 \u3649 \u3618 \u3585 \u3626 \u3656 \u3623 \u3609 \u3585 \u3633 \u3609  (Standalone)<br>\u3586 . \u3605 \u3657 \u3629 \u3591 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3618 \u3591 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3649 \u3621 \u3632 \u3629 \u3656 \u3634 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3652 \u3604 \u3657 \u3604 \u3657 \u3623 \u3618 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3588 \u3629 \u3617 \u3614 \u3636 \u3623 \u3648 \u3605 \u3629 \u3619 \u3660  (Machine Readable)<br>\u3588 . \u3605 \u3657 \u3629 \u3591 \u3648 \u3611 \u3655 \u3609 \u3629 \u3640 \u3611 \u3585 \u3619 \u3603 \u3660 \u3619 \u3634 \u3588 \u3634 \u3606 \u3641 \u3585 \u3607 \u3656 \u3637 \u3626 \u3640 \u3604 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3626 \u3609 \u3651 \u3592 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 <br>\u3591 . \u3605 \u3657 \u3629 \u3591 \u3612 \u3621 \u3636 \u3605 \u3616 \u3634 \u3618 \u3651 \u3609 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3648 \u3607 \u3656 \u3634 \u3609 \u3633 \u3657 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3605 \u3657 \u3629 \u3591 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3618 \u3591 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3649 \u3621 \u3632 \u3629 \u3656 \u3634 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3652 \u3604 \u3657 \u3604 \u3657 \u3623 \u3618 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3588 \u3629 \u3617 \u3614 \u3636 \u3623 \u3648 \u3605 \u3629 \u3619 \u3660  (Machine Readable)</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3618 \u3640 \u3588 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621  \u3629 \u3640 \u3611 \u3585 \u3619 \u3603 \u3660 \u3649 \u3621 \u3632 \u3619 \u3632 \u3610 \u3610 \u3588 \u3629 \u3617 \u3614 \u3636 \u3623 \u3648 \u3605 \u3629 \u3619 \u3660 \u3651 \u3609 \u3626 \u3635 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 \u3605 \u3657 \u3629 \u3591 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3651 \u3627 \u3657 \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3607 \u3637 \u3656 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3588 \u3629 \u3617 \u3614 \u3636 \u3623 \u3648 \u3605 \u3629 \u3619 \u3660 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3629 \u3656 \u3634 \u3609 \u3649 \u3621 \u3632 \u3609 \u3635 \u3652 \u3611 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3605 \u3656 \u3629 \u3652 \u3604 \u3657 \u3607 \u3633 \u3609 \u3607 \u3637  (Machine Readable) \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3594 \u3657  AI \u3617 \u3634 \u3594 \u3656 \u3623 \u3618 \u3651 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3617 \u3623 \u3621 \u3612 \u3621 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656 \u3649 \u3621 \u3632 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3585 \u3634 \u3619 \u3605 \u3633 \u3604 \u3626 \u3636 \u3609 \u3651 \u3592 \u3586 \u3629 \u3591 \u3612 \u3641 \u3657 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591 \u3649 \u3617 \u3656 \u3609 \u3618 \u3635 </div></div>\
\
    <div class="qb"><div class="q">46. \uc0\u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591  "\u3607 \u3637 \u3617 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 " (Team Thailand) \u3651 \u3609 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3617 \u3637 \u3652 \u3623 \u3657 \u3648 \u3614 \u3656 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3652 \u3611 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3614 \u3633 \u3585 \u3612 \u3656 \u3629 \u3609 \u3586 \u3629 \u3591 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 <br>\u3586 . \u3585 \u3634 \u3619 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3648 \u3614 \u3656 \u3639 \u3629 \u3612 \u3621 \u3633 \u3585 \u3604 \u3633 \u3609 \u3585 \u3634 \u3619 \u3607 \u3641 \u3605 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3612 \u3621 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3594 \u3634 \u3605 \u3636 <br>\u3588 . \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3585 \u3637 \u3628 \u3634 \u3651 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3609 \u3634 \u3609 \u3634 \u3594 \u3634 \u3605 \u3636 <br>\u3591 . \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3605 \u3633 \u3657 \u3591 \u3614 \u3619 \u3619 \u3588 \u3585 \u3634 \u3619 \u3648 \u3617 \u3639 \u3629 \u3591 \u3651 \u3609 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3648 \u3614 \u3656 \u3639 \u3629 \u3612 \u3621 \u3633 \u3585 \u3604 \u3633 \u3609 \u3585 \u3634 \u3619 \u3607 \u3641 \u3605 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3612 \u3621 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3594 \u3634 \u3605 \u3636 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3607 \u3637 \u3617 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618  (Team Thailand) \u3588 \u3639 \u3629 \u3585 \u3634 \u3619 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3586 \u3629 \u3591 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3652 \u3607 \u3618 \u3651 \u3609 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3592 \u3634 \u3585 \u3607 \u3640 \u3585 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591  (\u3648 \u3594 \u3656 \u3609  \u3585 \u3634 \u3619 \u3607 \u3641 \u3605  \u3614 \u3634 \u3603 \u3636 \u3594 \u3618 \u3660  \u3648 \u3585 \u3625 \u3605 \u3619  \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 ) \u3651 \u3627 \u3657 \u3607 \u3635 \u3591 \u3634 \u3609 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3648 \u3604 \u3637 \u3618 \u3623 \u3585 \u3633 \u3609  \u3648 \u3614 \u3656 \u3639 \u3629 \u3612 \u3621 \u3633 \u3585 \u3604 \u3633 \u3609 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3585 \u3634 \u3619 \u3607 \u3641 \u3605 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3648 \u3594 \u3636 \u3591 \u3619 \u3640 \u3585  \u3594 \u3656 \u3623 \u3618 \u3648 \u3627 \u3621 \u3639 \u3629 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3652 \u3607 \u3618 \u3651 \u3609 \u3585 \u3634 \u3619 \u3586 \u3618 \u3634 \u3618 \u3605 \u3621 \u3634 \u3604  \u3649 \u3621 \u3632 \u3604 \u3638 \u3591 \u3604 \u3641 \u3604 \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3609 \u3640 \u3607 \u3637 \u3656 \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3592 \u3634 \u3585 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3585 \u3621 \u3633 \u3610 \u3617 \u3634 \u3618 \u3633 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3611 \u3655 \u3609 \u3648 \u3629 \u3585 \u3616 \u3634 \u3614 </div></div>\
\
    <div class="qb"><div class="q">47. "Prosumer" \uc0\u3651 \u3609 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3604 \u3657 \u3634 \u3609 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3627 \u3617 \u3634 \u3618 \u3606 \u3638 \u3591 \u3626 \u3636 \u3656 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3612 \u3641 \u3657 \u3610 \u3619 \u3636 \u3650 \u3616 \u3588 \u3607 \u3656 \u3637 \u3588 \u3629 \u3618 \u3605 \u3635 \u3627 \u3609 \u3636 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3586 \u3629 \u3591 \u3619 \u3633 \u3600 <br>\u3586 . \u3612 \u3641 \u3657 \u3651 \u3594 \u3657 \u3652 \u3615 \u3615 \u3657 \u3634 \u3607 \u3637 \u3656 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3612 \u3621 \u3636 \u3605 \u3652 \u3615 \u3615 \u3657 \u3634 \u3651 \u3594 \u3657 \u3648 \u3629 \u3591 \u3649 \u3621 \u3632 \u3586 \u3634 \u3618 \u3648 \u3586 \u3657 \u3634 \u3619 \u3632 \u3610 \u3610 \u3652 \u3604 \u3657 <br>\u3588 . \u3629 \u3640 \u3611 \u3585 \u3619 \u3603 \u3660 \u3623 \u3633 \u3604 \u3617 \u3636 \u3648 \u3605 \u3629 \u3619 \u3660 \u3652 \u3615 \u3615 \u3657 \u3634 \u3649 \u3610 \u3610 \u3648 \u3585 \u3656 \u3634 <br>\u3591 . \u3610 \u3619 \u3636 \u3625 \u3633 \u3607 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3648 \u3592 \u3657 \u3634 \u3586 \u3629 \u3591 \u3626 \u3633 \u3617 \u3611 \u3607 \u3634 \u3609 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3612 \u3641 \u3657 \u3651 \u3594 \u3657 \u3652 \u3615 \u3615 \u3657 \u3634 \u3607 \u3637 \u3656 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3612 \u3621 \u3636 \u3605 \u3652 \u3615 \u3615 \u3657 \u3634 \u3651 \u3594 \u3657 \u3648 \u3629 \u3591 \u3649 \u3621 \u3632 \u3586 \u3634 \u3618 \u3648 \u3586 \u3657 \u3634 \u3619 \u3632 \u3610 \u3610 \u3652 \u3604 \u3657 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : Prosumer (\u3617 \u3634 \u3592 \u3634 \u3585  Producer + Consumer) \u3588 \u3639 \u3629 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3651 \u3627 \u3617 \u3656 \u3651 \u3609 \u3605 \u3621 \u3634 \u3604 \u3652 \u3615 \u3615 \u3657 \u3634 \u3648 \u3626 \u3619 \u3637 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609  \u3650 \u3604 \u3618 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3627 \u3619 \u3639 \u3629 \u3594 \u3640 \u3617 \u3594 \u3609 \u3652 \u3617 \u3656 \u3652 \u3604 \u3657 \u3648 \u3611 \u3655 \u3609 \u3648 \u3614 \u3637 \u3618 \u3591 \u3612 \u3641 \u3657 \u3595 \u3639 \u3657 \u3629 \u3652 \u3615 \u3615 \u3657 \u3634 \u3617 \u3634 \u3651 \u3594 \u3657 \u3648 \u3607 \u3656 \u3634 \u3609 \u3633 \u3657 \u3609  \u3649 \u3605 \u3656 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3605 \u3636 \u3604 \u3605 \u3633 \u3657 \u3591 \u3619 \u3632 \u3610 \u3610 \u3612 \u3621 \u3636 \u3605 \u3652 \u3615 \u3615 \u3657 \u3634 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3626 \u3632 \u3629 \u3634 \u3604  (\u3648 \u3594 \u3656 \u3609  \u3650 \u3595 \u3621 \u3634 \u3619 \u3660 \u3648 \u3595 \u3621 \u3621 \u3660 ) \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3594 \u3657 \u3648 \u3629 \u3591 \u3651 \u3609 \u3610 \u3657 \u3634 \u3609 \u3649 \u3621 \u3632 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3586 \u3634 \u3618 \u3652 \u3615 \u3615 \u3657 \u3634 \u3626 \u3656 \u3623 \u3609 \u3648 \u3585 \u3636 \u3609 \u3648 \u3586 \u3657 \u3634 \u3619 \u3632 \u3610 \u3610 \u3652 \u3604 \u3657  \u3595 \u3638 \u3656 \u3591 \u3592 \u3632 \u3594 \u3656 \u3623 \u3618 \u3621 \u3604 \u3616 \u3634 \u3619 \u3632 \u3588 \u3656 \u3634 \u3652 \u3615 \u3615 \u3657 \u3634 \u3649 \u3621 \u3632 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3607 \u3634 \u3591 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3651 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 </div></div>\
\
    <div class="qb"><div class="q">48. \uc0\u3585 \u3634 \u3619 \u3626 \u3639 \u3656 \u3629 \u3626 \u3634 \u3619 \u3648 \u3594 \u3636 \u3591 \u3619 \u3640 \u3585 \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3633 \u3656 \u3609 \u3651 \u3627 \u3657 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3586 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3611 \u3585 \u3611 \u3636 \u3604 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3586 \u3656 \u3634 \u3623 \u3626 \u3634 \u3619 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3604 \u3657 \u3634 \u3609 \u3621 \u3610 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 <br>\u3586 . \u3585 \u3634 \u3619 \u3626 \u3639 \u3656 \u3629 \u3626 \u3634 \u3619 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591  \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623  \u3649 \u3621 \u3632 \u3648 \u3609 \u3657 \u3609 \u3588 \u3623 \u3634 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 <br>\u3588 . \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3604 \u3634 \u3619 \u3634 \u3605 \u3656 \u3634 \u3591 \u3594 \u3634 \u3605 \u3636 \u3617 \u3634 \u3650 \u3590 \u3625 \u3603 \u3634 \u3648 \u3614 \u3637 \u3618 \u3591 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3604 \u3637 \u3618 \u3623 <br>\u3591 . \u3585 \u3634 \u3619 \u3649 \u3592 \u3585 \u3651 \u3610 \u3611 \u3621 \u3636 \u3623 \u3605 \u3634 \u3617 \u3626 \u3606 \u3634 \u3609 \u3607 \u3637 \u3656 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3605 \u3656 \u3634 \u3591 \u3654 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3626 \u3639 \u3656 \u3629 \u3626 \u3634 \u3619 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591  \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623  \u3649 \u3621 \u3632 \u3648 \u3609 \u3657 \u3609 \u3588 \u3623 \u3634 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3585 \u3634 \u3619 \u3626 \u3639 \u3656 \u3629 \u3626 \u3634 \u3619 \u3648 \u3594 \u3636 \u3591 \u3619 \u3640 \u3585 \u3651 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3605 \u3634 \u3617 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621  \u3588 \u3639 \u3629 \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591  \u3588 \u3619 \u3610 \u3606 \u3657 \u3623 \u3609  \u3649 \u3621 \u3632 \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623  \u3650 \u3604 \u3618 \u3648 \u3593 \u3614 \u3634 \u3632 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3626 \u3634 \u3608 \u3634 \u3619 \u3603 \u3626 \u3640 \u3586  \u3648 \u3614 \u3639  \u3656 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3594 \u3639  \u3656 \u3629 \u3617 \u3633  \u3656 \u3609 \u3651 \u3627 \u3657 \u3585 \u3633 \u3610 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3607 \u3633 \u3656 \u3623 \u3650 \u3621 \u3585  \u3648 \u3611 \u3655 \u3609 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3651 \u3609 \u3585 \u3634 \u3619 \u3626 \u3639 \u3656 \u3629 \u3626 \u3634 \u3619 \u3650 \u3604 \u3618 \u3605 \u3619 \u3591 \u3585 \u3633 \u3610 \u3609 \u3633  \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3648 \u3614 \u3639 \u3656 \u3629 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3607 \u3637 \u3656 \u3588 \u3621 \u3634 \u3604 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3649 \u3621 \u3632 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3616 \u3634 \u3614 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3607 \u3637 \u3656 \u3604 \u3637 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3651 \u3609 \u3600 \u3634 \u3609 \u3632 \u3610 \u3657 \u3634 \u3609 \u3627 \u3621 \u3633 \u3591 \u3607 \u3637 \u3656 \u3626 \u3629 \u3591 \u3586 \u3629 \u3591 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 </div></div>\
\
    <div class="qb"><div class="q">49. \uc0\u3585 \u3634 \u3619 \u3651 \u3594 \u3657  AI \u3651 \u3609 \u3585 \u3634 \u3619 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660  "Big Data" \u3604 \u3657 \u3634 \u3609 \u3609 \u3657 \u3635 \u3617 \u3637 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 \u3605 \u3656 \u3629 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3594 \u3656 \u3623 \u3618 \u3651 \u3627 \u3657 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3652 \u3617 \u3656 \u3605 \u3657 \u3629 \u3591 \u3607 \u3635 \u3591 \u3634 \u3609 \u3627 \u3609 \u3633 \u3585 <br>\u3586 . \u3594 \u3656 \u3623 \u3618 \u3648 \u3614 \u3636 \u3656 \u3617 \u3588 \u3623 \u3634 \u3617 \u3649 \u3617 \u3656 \u3609 \u3618 \u3635 \u3651 \u3609 \u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3649 \u3612 \u3609 \u3648 \u3614 \u3634 \u3632 \u3611 \u3621 \u3641 \u3585 \u3649 \u3621 \u3632 \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3618 \u3627 \u3634 \u3618 \u3592 \u3634 \u3585 \u3616 \u3633 \u3618 \u3649 \u3621 \u3657 \u3591 /\u3609 \u3657 \u3635 \u3607 \u3656 \u3623 \u3617 <br>\u3588 . \u3594 \u3656 \u3623 \u3618 \u3651 \u3627 \u3657 \u3619 \u3634 \u3588 \u3634 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3648 \u3585 \u3625 \u3605 \u3619 \u3626 \u3641 \u3591 \u3586 \u3638 \u3657 \u3609 \u3650 \u3604 \u3618 \u3629 \u3633 \u3605 \u3650 \u3609 \u3617 \u3633 \u3605 \u3636 <br>\u3591 . \u3594 \u3656 \u3623 \u3618 \u3627 \u3634 \u3609 \u3657 \u3635 \u3610 \u3634 \u3604 \u3634 \u3621 \u3617 \u3634 \u3651 \u3627 \u3657 \u3651 \u3609 \u3607 \u3640 \u3585 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3605 \u3657 \u3629 \u3591 \u3586 \u3640 \u3604 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3594 \u3656 \u3623 \u3618 \u3648 \u3614 \u3636 \u3656 \u3617 \u3588 \u3623 \u3634 \u3617 \u3649 \u3617 \u3656 \u3609 \u3618 \u3635 \u3651 \u3609 \u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3649 \u3612 \u3609 \u3648 \u3614 \u3634 \u3632 \u3611 \u3621 \u3641 \u3585 \u3649 \u3621 \u3632 \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3618 \u3627 \u3634 \u3618 \u3592 \u3634 \u3585 \u3616 \u3633 \u3618 \u3649 \u3621 \u3657 \u3591 /\u3609 \u3657 \u3635 \u3607 \u3656 \u3623 \u3617 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3626 \u3641 \u3591 \u3626 \u3640 \u3604 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657  Big Data \u3649 \u3621 \u3632  AI \u3651 \u3609 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3609 \u3657 \u3635 \u3588 \u3639 \u3629  "\u3585 \u3634 \u3619 \u3648 \u3614 \u3636 \u3656 \u3617 \u3588 \u3623 \u3634 \u3617 \u3649 \u3617 \u3656 \u3609 \u3618 \u3635 \u3651 \u3609 \u3585 \u3634 \u3619 \u3605 \u3633 \u3604 \u3626 \u3636 \u3609 \u3651 \u3592 " \u3595 \u3638 \u3656 \u3591 \u3594 \u3656 \u3623 \u3618 \u3651 \u3627 \u3657 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3649 \u3621 \u3632 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3588 \u3634 \u3604 \u3585 \u3634 \u3619 \u3603 \u3660 \u3611 \u3619 \u3636 \u3617 \u3634 \u3603 \u3609 \u3657 \u3635 \u3651 \u3609 \u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656 \u3605 \u3609 \u3648 \u3629 \u3591 \u3621 \u3656 \u3623 \u3591 \u3627 \u3609 \u3657 \u3634 \u3652 \u3604 \u3657  \u3607 \u3635 \u3651 \u3627 \u3657 \u3623 \u3634 \u3591 \u3649 \u3612 \u3609 \u3585 \u3634 \u3619 \u3648 \u3614 \u3634 \u3632 \u3611 \u3621 \u3641 \u3585 \u3652 \u3604 \u3657 \u3606 \u3641 \u3585 \u3594 \u3656 \u3623 \u3591 \u3648 \u3623 \u3621 \u3634  \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3656 \u3618 \u3591 \u3651 \u3609 \u3585 \u3634 \u3619 \u3586 \u3634 \u3604 \u3649 \u3588 \u3621 \u3609 \u3609 \u3657 \u3635 \u3627 \u3619 \u3639 \u3629 \u3609 \u3657 \u3635 \u3607 \u3656 \u3623 \u3617 \u3586 \u3633 \u3591  \u3649 \u3621 \u3632 \u3594 \u3656 \u3623 \u3618 \u3648 \u3614 \u3636 \u3656 \u3617 \u3612 \u3621 \u3612 \u3621 \u3636 \u3605 \u3605 \u3656 \u3629 \u3652 \u3619 \u3656 \u3651 \u3627 \u3657 \u3626 \u3641 \u3591 \u3586 \u3638 \u3657 \u3609 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3609 \u3657 \u3635 \u3607 \u3637 \u3656 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 </div></div>\
\
    <div class="qb" style="border-bottom:none;"><div class="q">50. \uc0\u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3626 \u3619 \u3640 \u3611 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3640 \u3604 \u3607 \u3657 \u3634 \u3618 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3612 \u3656 \u3609 \u3604 \u3636 \u3609 \u3652 \u3623 \u3657 \u3623 \u3656 \u3634 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3648 \u3592 \u3657 \u3634 \u3650 \u3621 \u3585 <br>\u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3609 \u3635 \u3588 \u3623 \u3634 \u3617 \u3585 \u3636 \u3609 \u3604 \u3637 \u3629 \u3618 \u3641 \u3656 \u3604 \u3637 \u3649 \u3621 \u3632 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3591 \u3610 \u3626 \u3640 \u3586 \u3651 \u3627 \u3657 \u3588 \u3609 \u3652 \u3607 \u3618 \u3607 \u3640 \u3585 \u3588 \u3609 <br>\u3588 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3640 \u3586 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 <br>\u3591 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3617 \u3637 \u3585 \u3634 \u3619 \u3648 \u3621 \u3639 \u3629 \u3585 \u3605 \u3633 \u3657 \u3591 \u3610 \u3656 \u3629 \u3618 \u3607 \u3656 \u3637 \u3626 \u3640 \u3604 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3609 \u3635 \u3588 \u3623 \u3634 \u3617 \u3585 \u3636 \u3609 \u3604 \u3637 \u3629 \u3618 \u3641 \u3656 \u3604 \u3637 \u3649 \u3621 \u3632 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3591 \u3610 \u3626 \u3640 \u3586 \u3651 \u3627 \u3657 \u3588 \u3609 \u3652 \u3607 \u3618 \u3607 \u3640 \u3585 \u3588 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3640 \u3604 \u3607 \u3657 \u3634 \u3618 \u3607 \u3637 \u3656 \u3619 \u3632 \u3610 \u3640 \u3652 \u3623 \u3657 \u3651 \u3609 \u3588 \u3635 \u3649 \u3606 \u3621 \u3591 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3586 \u3629 \u3591 \u3609 \u3634 \u3618 \u3585 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 \u3588 \u3639 \u3629  \u3585 \u3634 \u3619 \u3617 \u3640 \u3656 \u3591 \u3617 \u3633 \u3656 \u3609 \u3648 \u3605 \u3636 \u3617 \u3648 \u3605 \u3655 \u3617 \u3649 \u3621 \u3632 \u3607 \u3640 \u3656 \u3617 \u3648 \u3607 \u3626 \u3619 \u3619 \u3614 \u3585 \u3635 \u3621 \u3633 \u3591 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3605 \u3655 \u3617 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3648 \u3614 \u3639 \u3656 \u3629 \u3649 \u3585 \u3657 \u3611 \u3633 \u3597 \u3627 \u3634 \u3611 \u3634 \u3585 \u3607 \u3657 \u3629 \u3591 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609  \u3649 \u3621 \u3632 \u3609 \u3635 \u3614 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3585 \u3657 \u3634 \u3623 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3609 \u3635 \u3588 \u3623 \u3634 \u3617 \u3585 \u3636 \u3609 \u3604 \u3637 \u3629 \u3618 \u3641 \u3656 \u3604 \u3637 \u3649 \u3621 \u3632 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3591 \u3610 \u3626 \u3640 \u3586 \u3651 \u3627 \u3657 \u3588 \u3609 \u3652 \u3607 \u3618 \u3607 \u3640 \u3585 \u3588 \u3609 </div></div>\
\
</div>\
