    <div class="qb"><div class="q">19. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  3 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3652 \u3615 \u3615 \u3657 \u3634  (\u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3607 \u3637 \u3656 \u3611 \u3621 \u3656 \u3629 \u3618 \u3617 \u3621 \u3614 \u3636 \u3625 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 ) \u3651 \u3609 \u3611 \u3637  2570 \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3607 \u3637 \u3656 \u3592 \u3635 \u3609 \u3623 \u3609 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . 282,240 \u3588 \u3633 \u3609 <br>\u3586 . 380,250 \u3588 \u3633 \u3609 <br>\u3588 . 440,000 \u3588 \u3633 \u3609 <br>\u3591 . 725,000 \u3588 \u3633 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . 380,250 \u3588 \u3633 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  3 (\u3627 \u3609 \u3657 \u3634  52) \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3607 \u3637 \u3656  1.2 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618  "\u3611 \u3619 \u3636 \u3617 \u3634 \u3603 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3652 \u3615 \u3615 \u3657 \u3634  (\u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3607 \u3637 \u3656 \u3611 \u3621 \u3656 \u3629 \u3618 \u3617 \u3621 \u3614 \u3636 \u3625 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 ) \u3592 \u3635 \u3609 \u3623 \u3609  380,250 \u3588 \u3633 \u3609 " \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637  2570 (\u3588 \u3636 \u3604 \u3648 \u3611 \u3655 \u3609 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  17 \u3586 \u3629 \u3591 \u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 )</div></div>\
\
    <div class="qb"><div class="q">20. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  3 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3592 \u3635 \u3609 \u3623 \u3609 \u3626 \u3606 \u3634 \u3609 \u3637 \u3629 \u3633 \u3604 \u3611 \u3619 \u3632 \u3592 \u3640 \u3652 \u3615 \u3615 \u3657 \u3634 \u3626 \u3634 \u3608 \u3634 \u3619 \u3603 \u3632  (\u3627 \u3633 \u3623 \u3592 \u3656 \u3634 \u3618 \u3594 \u3634 \u3619 \u3660 \u3592 \u3648 \u3619 \u3655 \u3623 ) \u3607 \u3637 \u3656 \u3592 \u3632 \u3648 \u3614 \u3656 \u3636 \u3617 \u3586 \u3638 \u3657 \u3609 \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637  2570 \u3588 \u3639 \u3629 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . 3,000 \u3627 \u3633 \u3623 \u3592 \u3656 \u3634 \u3618 <br>\u3586 . 4,000 \u3627 \u3633 \u3623 \u3592 \u3656 \u3634 \u3618 <br>\u3588 . 5,000 \u3627 \u3633 \u3623 \u3592 \u3656 \u3634 \u3618 <br>\u3591 . 10,000 \u3627 \u3633 \u3623 \u3592 \u3656 \u3634 \u3618 </div>\
