    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  3 (\u3627 \u3609 \u3657 \u3634  28) \u3649 \u3621 \u3632  \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 (\u3627 \u3609 \u3657 \u3634  42) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2 \u3588 \u3639 \u3629  "\u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3592 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3607 \u3637 \u3656 \u3648 \u3609 \u3657 \u3609 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 "</div></div>\
