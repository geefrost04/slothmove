<div class="container">\
    <h1>\uc0\u3649 \u3609 \u3623 \u3586 \u3657 \u3629 \u3626 \u3629 \u3610 : \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3626 \u3633 \u3591 \u3588 \u3617 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13 (\u3614 .\u3624 . 2566 - 2570) (100 \u3586 \u3657 \u3629 )</h1>\
\
    <div class="qb"><div class="q">1. \uc0\u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3626 \u3633 \u3591 \u3588 \u3617 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13 \u3617 \u3637 \u3585 \u3619 \u3629 \u3610 \u3619 \u3632 \u3618 \u3632 \u3648 \u3623 \u3621 \u3634 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3651 \u3594 \u3657 \u3605 \u3634 \u3617 \u3586 \u3657 \u3629 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . 1 \u3617 \u3585 \u3619 \u3634 \u3588 \u3617  2566 - 31 \u3608 \u3633 \u3609 \u3623 \u3634 \u3588 \u3617  2570<br>\u3586 . 1 \u3605 \u3640 \u3621 \u3634 \u3588 \u3617  2565 - 30 \u3585 \u3633 \u3609 \u3618 \u3634 \u3618 \u3609  2570<br>\u3588 . 1 \u3617 \u3585 \u3619 \u3634 \u3588 \u3617  2565 - 31 \u3608 \u3633 \u3609 \u3623 \u3634 \u3588 \u3617  2569<br>\u3591 . 1 \u3605 \u3640 \u3621 \u3634 \u3588 \u3617  2566 - 30 \u3585 \u3633 \u3609 \u3618 \u3634 \u3618 \u3609  2571</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . 1 \u3605 \u3640 \u3621 \u3634 \u3588 \u3617  2565 - 30 \u3585 \u3633 \u3609 \u3618 \u3634 \u3618 \u3609  2570</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3605 \u3634 \u3617 \u3611 \u3619 \u3632 \u3585 \u3634 \u3624 \u3651 \u3609 \u3619 \u3634 \u3594 \u3585 \u3636 \u3592 \u3592 \u3634 \u3609 \u3640 \u3648 \u3610 \u3585 \u3625 \u3634  \u3649 \u3621 \u3632 \u3648 \u3609 \u3639 \u3657 \u3629 \u3627 \u3634 \u3651 \u3609 \u3611 \u3600 \u3617 \u3610 \u3607  (\u3627 \u3609 \u3657 \u3634  3) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634 \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13 \u3617 \u3637 \u3612 \u3621 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3651 \u3594 \u3657 \u3605 \u3633 \u3657 \u3591 \u3649 \u3605 \u3656 \u3623 \u3633 \u3609 \u3607 \u3637 \u3656  1 \u3605 \u3640 \u3621 \u3634 \u3588 \u3617  2565 \u3592 \u3609 \u3606 \u3638 \u3591 \u3623 \u3633 \u3609 \u3607 \u3637 \u3656  30 \u3585 \u3633 \u3609 \u3618 \u3634 \u3618 \u3609  2570 \u3595 \u3638 \u3656 \u3591 \u3588 \u3619 \u3629 \u3610 \u3588 \u3621 \u3640 \u3617 \u3611 \u3637 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603  \u3614 .\u3624 . 2566 \'96 2570</div></div>\
\
    <div class="qb"><div class="q">2. \uc0\u3605 \u3634 \u3617 \u3611 \u3619 \u3632 \u3585 \u3634 \u3624 \u3651 \u3609 \u3619 \u3634 \u3594 \u3585 \u3636 \u3592 \u3592 \u3634 \u3609 \u3640 \u3648 \u3610 \u3585 \u3625 \u3634  \u3612 \u3641 \u3657 \u3651 \u3604 \u3648 \u3611 \u3655 \u3609 \u3612 \u3641 \u3657 \u3619 \u3633 \u3610 \u3626 \u3609 \u3629 \u3591 \u3614 \u3619 \u3632 \u3610 \u3619 \u3617 \u3619 \u3634 \u3594 \u3650 \u3629 \u3591 \u3585 \u3634 \u3619 \u3651 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3585 \u3634 \u3624 \u3651 \u3594 \u3657 \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13</div>\
    <div class="c">\uc0\u3585 . \u3609 \u3634 \u3618 \u3585 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 <br>\u3586 . \u3611 \u3619 \u3632 \u3608 \u3634 \u3609 \u3619 \u3633 \u3600 \u3626 \u3616 \u3634 <br>\u3588 . \u3611 \u3619 \u3632 \u3608 \u3634 \u3609 \u3624 \u3634 \u3621 \u3598 \u3637 \u3585 \u3634 <br>\u3591 . \u3648 \u3621 \u3586 \u3634 \u3608 \u3636 \u3585 \u3634 \u3619 \u3626 \u3616 \u3634 \u3614 \u3633 \u3602 \u3609 \u3634 \u3585 \u3634 \u3619 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3626 \u3633 \u3591 \u3588 \u3617 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3609 \u3634 \u3618 \u3585 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3609 \u3657 \u3634 \u3611 \u3619 \u3632 \u3585 \u3634 \u3624  (\u3627 \u3609 \u3657 \u3634  1) \u3619 \u3632 \u3610 \u3640 \u3594 \u3639 \u3656 \u3629  \u3614 \u3621 \u3648 \u3629 \u3585  \u3611 \u3619 \u3632 \u3618 \u3640 \u3607 \u3608 \u3660  \u3592 \u3633 \u3609 \u3607 \u3619 \u3660 \u3650 \u3629 \u3594 \u3634  \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591  \u3609 \u3634 \u3618 \u3585 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637  \u3648 \u3611 \u3655 \u3609 \u3612 \u3641 \u3657 \u3619 \u3633 \u3610 \u3626 \u3609 \u3629 \u3591 \u3614 \u3619 \u3632 \u3610 \u3619 \u3617 \u3619 \u3634 \u3594 \u3650 \u3629 \u3591 \u3585 \u3634 \u3619 </div></div>\
\
    <div class="qb"><div class="q">3. \uc0\u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13 \u3606 \u3639 \u3629 \u3648 \u3611 \u3655 \u3609 \u3649 \u3612 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3651 \u3604 \u3605 \u3634 \u3617 \u3585 \u3621 \u3652 \u3585 \u3585 \u3634 \u3619 \u3649 \u3611 \u3621 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3652 \u3611 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 </div>\
    <div class="c">\uc0\u3585 . \u3649 \u3612 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  1<br>\u3586 . \u3649 \u3612 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  2<br>\u3588 . \u3649 \u3612 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  3<br>\u3591 . \u3649 \u3612 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  4</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3649 \u3612 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  2</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3611 \u3600 \u3617 \u3610 \u3607  (\u3627 \u3609 \u3657 \u3634  3) \u3649 \u3621 \u3632  \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  1 (\u3627 \u3609 \u3657 \u3634  8-9) \u3619 \u3632 \u3610 \u3640 \u3594 \u3633 \u3604 \u3648 \u3592 \u3609 \u3623 \u3656 \u3634  \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3626 \u3633 \u3591 \u3588 \u3617 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636  \u3617 \u3637 \u3626 \u3606 \u3634 \u3609 \u3632 \u3648 \u3611 \u3655 \u3609  "\u3649 \u3612 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  2" \u3595 \u3638 \u3656 \u3591 \u3607 \u3635 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3649 \u3611 \u3621 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636  (\u3649 \u3612 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3656 \u3637  1) \u3652 \u3611 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 </div></div>\
\
    <div class="qb"><div class="q">4. \uc0\u3586 \u3657 \u3629 \u3651 \u3604  \u3652 \u3617 \u3656 \u3651 \u3594 \u3656  1 \u3651 \u3609  4 \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3649 \u3621 \u3632 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3626 \u3635 \u3588 \u3633 \u3597 \u3607 \u3637 \u3656 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3585 \u3635 \u3627 \u3609 \u3604 \u3607 \u3636 \u3624 \u3607 \u3634 \u3591 \u3586 \u3629 \u3591 \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13</div>\
    <div class="c">\uc0\u3585 . \u3627 \u3621 \u3633 \u3585 \u3611 \u3619 \u3633 \u3594 \u3597 \u3634 \u3586 \u3629 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3629 \u3648 \u3614 \u3637 \u3618 \u3591 <br>\u3586 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3627 \u3617 \u3640 \u3609 \u3648 \u3623 \u3637 \u3618 \u3609  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3637 \u3648 \u3586 \u3637 \u3618 \u3623  (BCG)<br>\u3588 . \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3586 \u3629 \u3591 \u3626 \u3627 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3634 \u3605 \u3636  (SDGs)<br>\u3591 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3627 \u3609 \u3633 \u3585 \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585  (Heavy Industry Focus)</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3591 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3627 \u3609 \u3633 \u3585 \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585  (Heavy Industry Focus)</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3611 \u3600 \u3617 \u3610 \u3607  (\u3627 \u3609 \u3657 \u3634  3-4) \u3619 \u3632 \u3610 \u3640 \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3649 \u3621 \u3632 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604  4 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619 \u3652 \u3623 \u3657 \u3594 \u3633 \u3604 \u3648 \u3592 \u3609  \u3652 \u3604 \u3657 \u3649 \u3585 \u3656  1) \u3627 \u3621 \u3633 \u3585 \u3611 \u3619 \u3633 \u3594 \u3597 \u3634 \u3586 \u3629 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3629 \u3648 \u3614 \u3637 \u3618 \u3591  2) \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619  \'93\u3621 \u3657 \u3617 \u3649 \u3621 \u3657 \u3623  \u3621 \u3640 \u3585 \u3652 \u3623 \'94 (Resilience) 3) \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609  (SDGs) \u3649 \u3621 \u3632  4) \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3627 \u3617 \u3640 \u3609 \u3648 \u3623 \u3637 \u3618 \u3609  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3637 \u3648 \u3586 \u3637 \u3618 \u3623  (BCG)</div></div>\
\
    <div class="qb"><div class="q">5. \uc0\u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619  "\u3621 \u3657 \u3617 \u3649 \u3621 \u3657 \u3623  \u3621 \u3640 \u3585 \u3652 \u3623 " (Resilience) \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3604 \u3657 \u3623 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3651 \u3609  3 \u3619 \u3632 \u3604 \u3633 \u3610  \u3618 \u3585 \u3648 \u3623 \u3657 \u3609 \u3586 \u3657 \u3629 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3619 \u3632 \u3604 \u3633 \u3610  "\u3629 \u3618 \u3641 \u3656 \u3619 \u3629 \u3604 " (\u3585 \u3634 \u3619 \u3614 \u3619 \u3657 \u3629 \u3617 \u3619 \u3633 \u3610 )<br>\u3586 . \u3619 \u3632 \u3604 \u3633 \u3610  "\u3614 \u3629 \u3648 \u3614 \u3637 \u3618 \u3591 " (\u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3605 \u3633 \u3623 )<br>\u3588 . \u3619 \u3632 \u3604 \u3633 \u3610  "\u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 " (\u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 )<br>\u3591 . \u3619 \u3632 \u3604 \u3633 \u3610  "\u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 " (\u3585 \u3634 \u3619 \u3594 \u3636 \u3591 \u3588 \u3623 \u3634 \u3617 \u3652 \u3604 \u3657 \u3648 \u3611 \u3619 \u3637 \u3618 \u3610 )</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3591 . \u3619 \u3632 \u3604 \u3633 \u3610  "\u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 " (\u3585 \u3634 \u3619 \u3594 \u3636 \u3591 \u3588 \u3623 \u3634 \u3617 \u3652 \u3604 \u3657 \u3648 \u3611 \u3619 \u3637 \u3618 \u3610 )</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3611 \u3600 \u3617 \u3610 \u3607  (\u3627 \u3609 \u3657 \u3634  4) \u3649 \u3609 \u3623 \u3588 \u3636 \u3604  "\u3621 \u3657 \u3617 \u3649 \u3621 \u3657 \u3623  \u3621 \u3640 \u3585 \u3652 \u3623 " (Resilience) \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3651 \u3609  3 \u3619 \u3632 \u3604 \u3633 \u3610  \u3652 \u3604 \u3657 \u3649 \u3585 \u3656  1) \u3619 \u3632 \u3604 \u3633 \u3610  "\u3629 \u3618 \u3641 \u3656 \u3619 \u3629 \u3604 " (\u3585 \u3634 \u3619 \u3614 \u3619 \u3657 \u3629 \u3617 \u3619 \u3633 \u3610 ) 2) \u3619 \u3632 \u3604 \u3633 \u3610  "\u3614 \u3629 \u3648 \u3614 \u3637 \u3618 \u3591 " (\u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3605 \u3633 \u3623 ) \u3649 \u3621 \u3632  3) \u3619 \u3632 \u3604 \u3633 \u3610  "\u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 " (\u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3648 \u3614 \u3639 \u3656 \u3629 \u3614 \u3619 \u3657 \u3629 \u3617 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 )</div></div>\
\
    <div class="qb"><div class="q">6. \uc0\u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13 \u3606 \u3639 \u3629 \u3648 \u3611 \u3655 \u3609 \u3649 \u3612 \u3609  5 \u3611 \u3637 \u3607 \u3637 \u3656 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636  (\u3614 .\u3624 . 2561 - 2580)</div>\
    <div class="c">\uc0\u3585 . 5 \u3611 \u3637 \u3649 \u3619 \u3585 <br>\u3586 . 5 \u3611 \u3637 \u3607 \u3637 \u3656 \u3626 \u3629 \u3591 <br>\u3588 . 5 \u3611 \u3637 \u3607 \u3637 \u3656 \u3626 \u3634 \u3617 <br>\u3591 . 5 \u3611 \u3637 \u3607 \u3637 \u3656 \u3626 \u3637 \u3656 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . 5 \u3611 \u3637 \u3607 \u3637 \u3656 \u3626 \u3629 \u3591 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3611 \u3600 \u3617 \u3610 \u3607  (\u3627 \u3609 \u3657 \u3634  3) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  \u3585 \u3619 \u3629 \u3610 \u3619 \u3632 \u3618 \u3632 \u3648 \u3623 \u3621 \u3634 \u3586 \u3629 \u3591 \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13 (\u3614 .\u3624 . 2566 \'96 2570) \u3648 \u3611 \u3655 \u3609  "\u3619 \u3632 \u3618 \u3632  5 \u3611 \u3637 \u3607 \u3637 \u3656 \u3626 \u3629 \u3591 " \u3586 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 </div></div>\
\
    <div class="qb"><div class="q">7. \uc0\u3626 \u3606 \u3634 \u3609 \u3585 \u3634 \u3619 \u3603 \u3660 \u3626 \u3635 \u3588 \u3633 \u3597 \u3651 \u3604 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634 \u3626 \u3656 \u3591 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3629 \u3618 \u3656 \u3634 \u3591 \u3619 \u3640 \u3609 \u3649 \u3619 \u3591 \u3605 \u3656 \u3629 \u3607 \u3633 \u3656 \u3623 \u3650 \u3621 \u3585 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3651 \u3609 \u3594 \u3656 \u3623 \u3591 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3607 \u3635 \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13</div>\
    <div class="c">\uc0\u3585 . \u3623 \u3636 \u3585 \u3620 \u3605 \u3585 \u3634 \u3619 \u3603 \u3660 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609 \u3651 \u3609 \u3648 \u3629 \u3648 \u3594 \u3637 \u3618 <br>\u3586 . \u3585 \u3634 \u3619 \u3649 \u3614 \u3619 \u3656 \u3619 \u3632 \u3610 \u3634 \u3604 \u3586 \u3629 \u3591 \u3650 \u3588 \u3623 \u3636 \u3604 -19<br>\u3588 . \u3588 \u3623 \u3634 \u3617 \u3586 \u3633 \u3604 \u3649 \u3618 \u3657 \u3591 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 \u3651 \u3609 \u3605 \u3632 \u3623 \u3633 \u3609 \u3629 \u3629 \u3585 \u3585 \u3621 \u3634 \u3591 <br>\u3591 . \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3607 \u3634 \u3591 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637  5G</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3649 \u3614 \u3619 \u3656 \u3619 \u3632 \u3610 \u3634 \u3604 \u3586 \u3629 \u3591 \u3650 \u3588 \u3623 \u3636 \u3604 -19</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3611 \u3600 \u3617 \u3610 \u3607  (\u3627 \u3609 \u3657 \u3634  3) \u3649 \u3621 \u3632 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  2 (\u3627 \u3609 \u3657 \u3634  11, 13) \u3617 \u3637 \u3585 \u3634 \u3619 \u3585 \u3621 \u3656 \u3634 \u3623 \u3606 \u3638 \u3591 \u3626 \u3606 \u3634 \u3609 \u3585 \u3634 \u3619 \u3603 \u3660 \u3585 \u3634 \u3619 \u3649 \u3614 \u3619 \u3656 \u3619 \u3632 \u3610 \u3634 \u3604 \u3586 \u3629 \u3591 \u3650 \u3588 \u3623 \u3636 \u3604 -19 \u3623 \u3656 \u3634 \u3648 \u3611 \u3655 \u3609 \u3586 \u3657 \u3629 \u3592 \u3635 \u3585 \u3633 \u3604 \u3649 \u3621 \u3632 \u3611 \u3633 \u3592 \u3592 \u3633 \u3618 \u3626 \u3635 \u3588 \u3633 \u3597 \u3607 \u3637 \u3656 \u3626 \u3656 \u3591 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3605 \u3656 \u3629 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3604 \u3635 \u3648 \u3609 \u3636 \u3609 \u3594 \u3637 \u3623 \u3636 \u3605  \u3595 \u3638 \u3656 \u3591 \u3605 \u3657 \u3629 \u3591 \u3609 \u3635 \u3617 \u3634 \u3614 \u3636 \u3592 \u3634 \u3619 \u3603 \u3634 \u3651 \u3609 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3607 \u3635 \u3649 \u3612 \u3609 </div></div>\
\
    <div class="qb"><div class="q">8. \uc0\u3649 \u3612 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  1 \u3595 \u3638 \u3656 \u3591 \u3648 \u3611 \u3655 \u3609 \u3585 \u3619 \u3629 \u3610 \u3607 \u3636 \u3624 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3651 \u3609 \u3616 \u3634 \u3614 \u3619 \u3623 \u3617  \u3588 \u3639 \u3629 \u3649 \u3612 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3626 \u3633 \u3591 \u3588 \u3617 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636 <br>\u3586 . \u3649 \u3612 \u3609 \u3649 \u3617 \u3656 \u3610 \u3607 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 <br>\u3588 . \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 <br>\u3591 . \u3649 \u3612 \u3609 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  1 (\u3627 \u3609 \u3657 \u3634  8) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 " \u3648 \u3611 \u3655 \u3609  "\u3649 \u3612 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  1" \u3607 \u3635 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3585 \u3619 \u3629 \u3610 \u3607 \u3636 \u3624 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3651 \u3609 \u3616 \u3634 \u3614 \u3619 \u3623 \u3617 </div></div>\
\
    <div class="qb"><div class="q">9. \uc0\u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3627 \u3621 \u3633 \u3585 \u3586 \u3629 \u3591 \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13 \u3588 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3614 \u3621 \u3636 \u3585 \u3650 \u3593 \u3617 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3626 \u3641 \u3656  \'93\u3626 \u3633 \u3591 \u3588 \u3617 \u3585 \u3657 \u3634 \u3623 \u3627 \u3609 \u3657 \u3634  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634  \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \'94<br>\u3586 . \u3609 \u3635 \u3614 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3651 \u3627 \u3657 \u3614 \u3657 \u3609 \u3592 \u3634 \u3585 \u3585 \u3633 \u3610 \u3604 \u3633 \u3585 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3611 \u3634 \u3609 \u3585 \u3621 \u3634 \u3591 <br>\u3588 . \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591  \u3617 \u3633 \u3656 \u3591 \u3588 \u3633 \u3656 \u3591  \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609  \u3651 \u3627 \u3657 \u3610 \u3619 \u3619 \u3621 \u3640 \u3612 \u3621 \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637  2570<br>\u3591 . \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3619 \u3632 \u3610 \u3610 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3614 \u3621 \u3636 \u3585 \u3650 \u3593 \u3617 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3626 \u3641 \u3656  \'93\u3626 \u3633 \u3591 \u3588 \u3617 \u3585 \u3657 \u3634 \u3623 \u3627 \u3609 \u3657 \u3634  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634  \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \'94</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  3 (\u3627 \u3609 \u3657 \u3634  26) \u3619 \u3632 \u3610 \u3640 \u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3586 \u3629 \u3591 \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13 \u3652 \u3623 \u3657 \u3623 \u3656 \u3634  \'93\u3648 \u3614 \u3639 \u3656 \u3629  \u3614 \u3621 \u3636 \u3585 \u3650 \u3593 \u3617 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3626 \u3641 \u3656  \'93\u3626 \u3633 \u3591 \u3588 \u3617 \u3585 \u3657 \u3634 \u3623 \u3627 \u3609 \u3657 \u3634  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634  \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \'94\'94</div></div>\
\
    <div class="qb"><div class="q">10. \uc0\u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3627 \u3621 \u3633 \u3585 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3652 \u3623 \u3657 \u3585 \u3637 \u3656 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619 </div>\
    <div class="c">\uc0\u3585 . 3 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619 <br>\u3586 . 5 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619 <br>\u3588 . 7 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619 <br>\u3591 . 13 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . 5 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  3 (\u3627 \u3609 \u3657 \u3634  26) \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13 \u3652 \u3604 \u3657 \u3585 \u3635 \u3627 \u3609 \u3604  "\u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3627 \u3621 \u3633 \u3585 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 " \u3652 \u3623 \u3657 \u3592 \u3635 \u3609 \u3623 \u3609  5 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619 </div></div>\
\
    <div class="qb"><div class="q">11. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604  "\u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3634 \u3605 \u3636 \u3605 \u3656 \u3629 \u3627 \u3633 \u3623 " \u3607 \u3637 \u3656 \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3651 \u3609 \u3611 \u3637  2570</div>\
    <div class="c">\uc0\u3585 . 7,097 \u3648 \u3627 \u3619 \u3637 \u3618 \u3597 \u3626 \u3627 \u3619 \u3633 \u3600 \u3605 \u3656 \u3629 \u3611 \u3637 <br>\u3586 . 8,500 \u3648 \u3627 \u3619 \u3637 \u3618 \u3597 \u3626 \u3627 \u3619 \u3633 \u3600 \u3605 \u3656 \u3629 \u3611 \u3637 <br>\u3588 . 9,300 \u3648 \u3627 \u3619 \u3637 \u3618 \u3597 \u3626 \u3627 \u3619 \u3633 \u3600 \u3605 \u3656 \u3629 \u3611 \u3637 <br>\u3591 . 12,000 \u3648 \u3627 \u3619 \u3637 \u3618 \u3597 \u3626 \u3627 \u3619 \u3633 \u3600 \u3605 \u3656 \u3629 \u3611 \u3637 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . 9,300 \u3648 \u3627 \u3619 \u3637 \u3618 \u3597 \u3626 \u3627 \u3619 \u3633 \u3600 \u3605 \u3656 \u3629 \u3611 \u3637 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3605 \u3634 \u3619 \u3634 \u3591 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3627 \u3621 \u3633 \u3585  (\u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  3 \u3627 \u3609 \u3657 \u3634  27) \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  1 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3631  \u3617 \u3637 \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604  "\u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3634 \u3605 \u3636 \u3605 \u3656 \u3629 \u3627 \u3633 \u3623 " \u3650 \u3604 \u3618 \u3585 \u3635 \u3627 \u3609 \u3604 \u3588 \u3656 \u3634 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637  2570 \u3652 \u3623 \u3657 \u3607 \u3637 \u3656  9,300 \u3648 \u3627 \u3619 \u3637 \u3618 \u3597 \u3626 \u3627 \u3619 \u3633 \u3600 \u3605 \u3656 \u3629 \u3611 \u3637  (300,000 \u3610 \u3634 \u3607 )</div></div>\
\
    <div class="qb"><div class="q">12. \uc0\u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13 \u3652 \u3604 \u3657 \u3585 \u3635 \u3627 \u3609 \u3604  "\u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 " \u3652 \u3623 \u3657 \u3607 \u3657 \u3633 \u3591 \u3626 \u3636 \u3657 \u3609 \u3585 \u3637 \u3656 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 </div>\
    <div class="c">\uc0\u3585 . 5 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 <br>\u3586 . 9 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 <br>\u3588 . 13 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 <br>\u3591 . 20 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . 13 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  3 (\u3627 \u3609 \u3657 \u3634  28) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13 \u3592 \u3638 \u3591 \u3652 \u3604 \u3657 \u3585 \u3635 \u3627 \u3609 \u3604 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634  \u3592 \u3635 \u3609 \u3623 \u3609  13 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 "</div></div>\
\
    <div class="qb"><div class="q">13. "\uc0\u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3594 \u3633 \u3657 \u3609 \u3609 \u3635 \u3604 \u3657 \u3634 \u3609 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3648 \u3585 \u3625 \u3605 \u3619 \u3649 \u3621 \u3632 \u3648 \u3585 \u3625 \u3605 \u3619 \u3649 \u3611 \u3619 \u3619 \u3641 \u3611 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3626 \u3641 \u3591 " \u3626 \u3629 \u3604 \u3588 \u3621 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  1<br>\u3586 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2<br>\u3588 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  3<br>\u3591 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  4</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  1</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  3 (\u3627 \u3609 \u3657 \u3634  28) \u3649 \u3621 \u3632  \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 (\u3627 \u3609 \u3657 \u3634  32) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  1 \u3588 \u3639 \u3629  "\u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3594 \u3633 \u3657 \u3609 \u3609 \u3635 \u3604 \u3657 \u3634 \u3609 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3648 \u3585 \u3625 \u3605 \u3619 \u3649 \u3621 \u3632 \u3648 \u3585 \u3625 \u3605 \u3619 \u3649 \u3611 \u3619 \u3619 \u3641 \u3611 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3626 \u3641 \u3591 "</div></div>\
\
    <div class="qb"><div class="q">14. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  1 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3604 \u3657 \u3634 \u3609 \u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656 \u3648 \u3585 \u3625 \u3605 \u3619 \u3629 \u3636 \u3609 \u3607 \u3619 \u3637 \u3618 \u3660 \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 \u3648 \u3617 \u3639 \u3656 \u3629 \u3626 \u3636 \u3657 \u3609 \u3626 \u3640 \u3604 \u3649 \u3612 \u3609 </div>\
    <div class="c">\uc0\u3585 . 1.0 \u3621 \u3657 \u3634 \u3609 \u3652 \u3619 \u3656 <br>\u3586 . 1.5 \u3621 \u3657 \u3634 \u3609 \u3652 \u3619 \u3656 <br>\u3588 . 2.0 \u3621 \u3657 \u3634 \u3609 \u3652 \u3619 \u3656 <br>\u3591 . 2.5 \u3621 \u3657 \u3634 \u3609 \u3652 \u3619 \u3656 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . 2.0 \u3621 \u3657 \u3634 \u3609 \u3652 \u3619 \u3656 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  1 (\u3627 \u3609 \u3657 \u3634  34) \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3607 \u3637 \u3656  1.3 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618  "\u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656 \u3648 \u3585 \u3625 \u3605 \u3619 \u3629 \u3636 \u3609 \u3607 \u3619 \u3637 \u3618 \u3660  \u3648 \u3614 \u3656 \u3636 \u3617 \u3586 \u3657 \u3638 \u3609 \u3648 \u3611 \u3655 \u3609  2.0 \u3621 \u3657 \u3634 \u3609 \u3652 \u3619 \u3656 " \u3648 \u3617 \u3639 \u3656 \u3629 \u3626 \u3636 \u3657 \u3609 \u3626 \u3640 \u3604 \u3649 \u3612 \u3609 </div></div>\
\
    <div class="qb"><div class="q">15. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  1 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604  "\u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3626 \u3640 \u3607 \u3608 \u3636 \u3605 \u3656 \u3629 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 " \u3648 \u3617 \u3639 \u3656 \u3629 \u3626 \u3636 \u3657 \u3609 \u3626 \u3640 \u3604 \u3649 \u3612 \u3609 \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3607 \u3637 \u3656 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . 350,000 \u3610 \u3634 \u3607 \u3605 \u3656 \u3629 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 <br>\u3586 . 485,000 \u3610 \u3634 \u3607 \u3605 \u3656 \u3629 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 <br>\u3588 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634  537,000 \u3610 \u3634 \u3607 \u3605 \u3656 \u3629 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 <br>\u3591 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634  600,000 \u3610 \u3634 \u3607 \u3605 \u3656 \u3629 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 </div>\
