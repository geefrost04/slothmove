    <div class="qb"><div class="q">21. "\uc0\u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \u3649 \u3621 \u3632 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3626 \u3641 \u3591 " \u3588 \u3639 \u3629 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2<br>\u3586 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  4<br>\u3588 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  6<br>\u3591 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  4</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  3 (\u3627 \u3609 \u3657 \u3634  28) \u3649 \u3621 \u3632  \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 (\u3627 \u3609 \u3657 \u3634  60) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  4 \u3588 \u3639 \u3629  "\u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \u3649 \u3621 \u3632 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3626 \u3641 \u3591 "</div></div>\
\
    <div class="qb"><div class="q">22. \uc0\u3651 \u3609 \u3611 \u3637  2562 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634 \u3617 \u3637 \u3594 \u3634 \u3623 \u3605 \u3656 \u3634 \u3591 \u3594 \u3634 \u3605 \u3636 \u3617 \u3634 \u3651 \u3594 \u3657 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \u3651 \u3609 \u3652 \u3607 \u3618 \u3592 \u3635 \u3609 \u3623 \u3609 \u3585 \u3637 \u3656 \u3621 \u3657 \u3634 \u3609 \u3588 \u3609 \u3588 \u3619 \u3633 \u3657 \u3591 </div>\
    <div class="c">\uc0\u3585 . 1.2 \u3621 \u3657 \u3634 \u3609 \u3588 \u3609 \u3588 \u3619 \u3633 \u3657 \u3591 <br>\u3586 . 2.5 \u3621 \u3657 \u3634 \u3609 \u3588 \u3609 \u3588 \u3619 \u3633 \u3657 \u3591 <br>\u3588 . 3.6 \u3621 \u3657 \u3634 \u3609 \u3588 \u3609 \u3588 \u3619 \u3633 \u3657 \u3591 <br>\u3591 . 5.0 \u3621 \u3657 \u3634 \u3609 \u3588 \u3609 \u3588 \u3619 \u3633 \u3657 \u3591 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . 3.6 \u3621 \u3657 \u3634 \u3609 \u3588 \u3609 \u3588 \u3619 \u3633 \u3657 \u3591 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  4 (\u3627 \u3609 \u3657 \u3634  60) \u3626 \u3606 \u3634 \u3609 \u3585 \u3634 \u3619 \u3603 \u3660 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3612 \u3656 \u3634 \u3609 \u3617 \u3634  \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3611 \u3637  2562 \u3617 \u3637 \u3594 \u3634 \u3623 \u3605 \u3656 \u3634 \u3591 \u3594 \u3634 \u3605 \u3636 \u3617 \u3634 \u3651 \u3594 \u3657 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660  3.6 \u3621 \u3657 \u3634 \u3609 \u3588 \u3609 \u3588 \u3619 \u3633 \u3657 \u3591 "</div></div>\
\
    <div class="qb"><div class="q">23. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  4 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3636 \u3656 \u3617 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614 \u3605 \u3656 \u3629 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3617 \u3623 \u3621 \u3619 \u3623 \u3617 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  (GDP) \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3607 \u3637 \u3656 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  1.7<br>\u3586 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  2.0<br>\u3588 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  3.5<br>\u3591 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  5.0</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  1.7</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  4 (\u3627 \u3609 \u3657 \u3634  62) \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3607 \u3637 \u3656  1.1 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618  "\u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3656 \u3636 \u3617 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614 \u3605 \u3656 \u3629 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3617 \u3623 \u3621 \u3619 \u3623 \u3617 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3629 \u3618 \u3641 \u3656 \u3607 \u3637 \u3656 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  1.7"</div></div>\
\
    <div class="qb"><div class="q">24. "\uc0\u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3605 \u3641 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3649 \u3621 \u3632 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3607 \u3634 \u3591 \u3650 \u3621 \u3592 \u3636 \u3626 \u3605 \u3636 \u3585 \u3626 \u3660 \u3607 \u3637 \u3656 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 " \u3588 \u3639 \u3629 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  3<br>\u3586 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  5<br>\u3588 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  7<br>\u3591 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  8</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  5</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  3 (\u3627 \u3609 \u3657 \u3634  28) \u3649 \u3621 \u3632  \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 (\u3627 \u3609 \u3657 \u3634  70) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  5 \u3588 \u3639 \u3629  "\u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3605 \u3641 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3649 \u3621 \u3632 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3607 \u3634 \u3591 \u3650 \u3621 \u3592 \u3636 \u3626 \u3605 \u3636 \u3585 \u3626 \u3660 \u3607 \u3637 \u3656 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 "</div></div>\
\
    <div class="qb"><div class="q">25. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  5 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3604 \u3633 \u3594 \u3609 \u3637 \u3623 \u3633 \u3604 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 \u3604 \u3657 \u3634 \u3609 \u3650 \u3621 \u3592 \u3636 \u3626 \u3605 \u3636 \u3585 \u3626 \u3660 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  (LPI) \u3586 \u3629 \u3591 \u3652 \u3607 \u3618  \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  25<br>\u3586 . \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  30<br>\u3588 . \u3617 \u3637 \u3588 \u3632 \u3649 \u3609 \u3609 \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634  4.00<br>\u3591 . \u3617 \u3637 \u3588 \u3632 \u3649 \u3609 \u3609 \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634  4.50</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  25</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  5 (\u3627 \u3609 \u3657 \u3634  73) \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3607 \u3637 \u3656  3.1 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618  "\u3604 \u3633 \u3594 \u3609 \u3637 \u3623 \u3633 \u3604 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 \u3604 \u3657 \u3634 \u3609 \u3650 \u3621 \u3592 \u3636 \u3626 \u3605 \u3636 \u3585 \u3626 \u3660 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  25 \u3627 \u3619 \u3639 \u3629 \u3588 \u3632 \u3649 \u3609 \u3609 \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634  3.60"</div></div>\
\
    <div class="qb"><div class="q">26. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  5 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3605 \u3657 \u3609 \u3607 \u3640 \u3609 \u3650 \u3621 \u3592 \u3636 \u3626 \u3605 \u3636 \u3585 \u3626 \u3660 \u3586 \u3629 \u3591 \u3652 \u3607 \u3618 \u3605 \u3656 \u3629 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3617 \u3623 \u3621 \u3619 \u3623 \u3617 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  (GDP) \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3609 \u3657 \u3629 \u3618 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  15<br>\u3586 . \u3609 \u3657 \u3629 \u3618 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  13<br>\u3588 . \u3609 \u3657 \u3629 \u3618 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  11<br>\u3591 . \u3609 \u3657 \u3629 \u3618 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  9</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3609 \u3657 \u3629 \u3618 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  11</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  5 (\u3627 \u3609 \u3657 \u3634  73) \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3607 \u3637 \u3656  3.2 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618  "\u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3605 \u3657 \u3609 \u3607 \u3640 \u3609 \u3650 \u3621 \u3592 \u3636 \u3626 \u3605 \u3636 \u3585 \u3626 \u3660 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3605 \u3656 \u3629 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3617 \u3623 \u3621 \u3619 \u3623 \u3617 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3609 \u3657 \u3629 \u3618 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  11"</div></div>\
\
    <div class="qb"><div class="q">27. "\uc0\u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 \u3649 \u3621 \u3632 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3586 \u3629 \u3591 \u3629 \u3634 \u3648 \u3595 \u3637 \u3618 \u3609 " \u3588 \u3639 \u3629 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  4<br>\u3586 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  6<br>\u3588 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  8<br>\u3591 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  10</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  6</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  3 (\u3627 \u3609 \u3657 \u3634  28) \u3649 \u3621 \u3632  \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 (\u3627 \u3609 \u3657 \u3634  78) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  6 \u3588 \u3639 \u3629  "\u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 \u3649 \u3621 \u3632 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3586 \u3629 \u3591 \u3629 \u3634 \u3648 \u3595 \u3637 \u3618 \u3609 "</div></div>\
\
    <div class="qb"><div class="q">28. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  6 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3636 \u3656 \u3617 \u3586 \u3629 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3605 \u3656 \u3629  GDP \u3651 \u3609 \u3611 \u3637  2570 \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3607 \u3637 \u3656 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  20<br>\u3586 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  25<br>\u3588 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  30<br>\u3591 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  35</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  30</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  6 (\u3627 \u3609 \u3657 \u3634  79) \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3607 \u3637 \u3656  1.1 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618  "\u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3636 \u3656 \u3617 \u3586 \u3629 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3605 \u3656 \u3629 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3617 \u3623 \u3621 \u3619 \u3623 \u3617 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3648 \u3614 \u3656 \u3636 \u3617 \u3586 \u3657 \u3638 \u3609 \u3648 \u3611 \u3655 \u3609 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  30 \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637  2570"</div></div>\
\
    <div class="qb"><div class="q">29. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  6 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 \u3651 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637  2570 \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3588 \u3636 \u3604 \u3648 \u3611 \u3655 \u3609 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  40 \u3586 \u3629 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3652 \u3615 \u3615 \u3657 \u3634 \u3649 \u3621 \u3632 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 <br>\u3586 . \u3588 \u3636 \u3604 \u3648 \u3611 \u3655 \u3609 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  50 \u3586 \u3629 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3652 \u3615 \u3615 \u3657 \u3634 \u3649 \u3621 \u3632 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 <br>\u3588 . \u3588 \u3636 \u3604 \u3648 \u3611 \u3655 \u3609 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  60 \u3586 \u3629 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3652 \u3615 \u3615 \u3657 \u3634 \u3649 \u3621 \u3632 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 <br>\u3591 . \u3588 \u3636 \u3604 \u3648 \u3611 \u3655 \u3609 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  70 \u3586 \u3629 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3652 \u3615 \u3615 \u3657 \u3634 \u3649 \u3621 \u3632 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3588 \u3636 \u3604 \u3648 \u3611 \u3655 \u3609 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  60 \u3586 \u3629 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3652 \u3615 \u3615 \u3657 \u3634 \u3649 \u3621 \u3632 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  6 (\u3627 \u3609 \u3657 \u3634  80) \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3607 \u3637 \u3656  2.1 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618  "\u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 \u3651 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3588 \u3636 \u3604 \u3648 \u3611 \u3655 \u3609 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  60 \u3586 \u3629 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3652 \u3615 \u3615 \u3657 \u3634 \u3649 \u3621 \u3632 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637  2570"</div></div>\
\
    <div class="qb"><div class="q">30. "\uc0\u3652 \u3607 \u3618 \u3617 \u3637 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3586 \u3609 \u3634 \u3604 \u3585 \u3621 \u3634 \u3591 \u3649 \u3621 \u3632 \u3586 \u3609 \u3634 \u3604 \u3618 \u3656 \u3629 \u3617 \u3607 \u3637 \u3656 \u3648 \u3586 \u3657 \u3617 \u3649 \u3586 \u3655 \u3591  \u3617 \u3637 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3626 \u3641 \u3591  \u3649 \u3621 \u3632 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3652 \u3604 \u3657 " \u3588 \u3639 \u3629 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  5<br>\u3586 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  7<br>\u3588 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9<br>\u3591 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  11</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  7</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  3 (\u3627 \u3609 \u3657 \u3634  28) \u3649 \u3621 \u3632  \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 (\u3627 \u3609 \u3657 \u3634  86) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  7 \u3588 \u3639 \u3629  "\u3652 \u3607 \u3618 \u3617 \u3637 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3586 \u3609 \u3634 \u3604 \u3585 \u3621 \u3634 \u3591 \u3649 \u3621 \u3632 \u3586 \u3609 \u3634 \u3604 \u3618 \u3656 \u3629 \u3617 \u3607 \u3637 \u3656 \u3648 \u3586 \u3657 \u3617 \u3649 \u3586 \u3655 \u3591  \u3617 \u3637 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3626 \u3641 \u3591  \u3649 \u3621 \u3632 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3652 \u3604 \u3657 "</div></div>\
\
    <div class="qb"><div class="q">31. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  7 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3617 \u3623 \u3621 \u3619 \u3623 \u3617 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3586 \u3629 \u3591 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3586 \u3609 \u3634 \u3604 \u3585 \u3621 \u3634 \u3591 \u3649 \u3621 \u3632 \u3586 \u3609 \u3634 \u3604 \u3618 \u3656 \u3629 \u3617  (SMEs) \u3605 \u3656 \u3629  GDP \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637  2570 \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3607 \u3637 \u3656 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  35<br>\u3586 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  40<br>\u3588 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  45<br>\u3591 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  50</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  40</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  7 (\u3627 \u3609 \u3657 \u3634  88) \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3607 \u3637 \u3656  2.1 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618  "\u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3617 \u3623 \u3621 \u3619 \u3623 \u3617 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3586 \u3629 \u3591 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3586 \u3609 \u3634 \u3604 \u3585 \u3621 \u3634 \u3591 \u3649 \u3621 \u3632 \u3586 \u3609 \u3634 \u3604 \u3618 \u3656 \u3629 \u3617  \u3605 \u3656 \u3629 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3617 \u3623 \u3621 \u3619 \u3623 \u3617 \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3648 \u3614 \u3636 \u3656 \u3617 \u3586 \u3638 \u3657 \u3609 \u3648 \u3611 \u3655 \u3609 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  40"</div></div>\
\
    <div class="qb"><div class="q">32. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  7 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 \u3586 \u3629 \u3591  SMEs \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 \u3607 \u3633 \u3657 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637  2570 \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3607 \u3637 \u3656 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  15<br>\u3586 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  20<br>\u3588 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  25<br>\u3591 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  30</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  20</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  7 (\u3627 \u3609 \u3657 \u3634  88) \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3607 \u3637 \u3656  2.1 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618  "\u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 \u3586 \u3629 \u3591 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3586 \u3609 \u3634 \u3604 \u3585 \u3621 \u3634 \u3591 \u3649 \u3621 \u3632 \u3586 \u3609 \u3634 \u3604 \u3618 \u3656 \u3629 \u3617  \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 \u3607 \u3657 \u3633 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3648 \u3614 \u3656 \u3636 \u3617 \u3586 \u3657 \u3638 \u3609 \u3648 \u3611 \u3655 \u3609 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  20 \u3651 \u3609 \u3611 \u3637  2570"</div></div>\
\
    <div class="qb"><div class="q">33. "\uc0\u3652 \u3607 \u3618 \u3617 \u3637 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3649 \u3621 \u3632 \u3648 \u3617 \u3639 \u3629 \u3591 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 \u3607 \u3637 \u3656 \u3609 \u3656 \u3634 \u3629 \u3618 \u3641 \u3656  \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618  \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 " \u3588 \u3639 \u3629 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  6<br>\u3586 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  8<br>\u3588 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  10<br>\u3591 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  11</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  8</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  3 (\u3627 \u3609 \u3657 \u3634  28) \u3649 \u3621 \u3632  \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 (\u3627 \u3609 \u3657 \u3634  95) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  8 \u3588 \u3639 \u3629  "\u3652 \u3607 \u3618 \u3617 \u3637 \u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656 \u3649 \u3621 \u3632 \u3648 \u3617 \u3639 \u3629 \u3591 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 \u3607 \u3637 \u3656 \u3609 \u3656 \u3634 \u3629 \u3618 \u3641 \u3656  \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618  \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 "</div></div>\
\
    <div class="qb"><div class="q">34. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  8 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3592 \u3635 \u3609 \u3623 \u3609  "\u3648 \u3617 \u3639 \u3629 \u3591 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 " \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637  2570 \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3592 \u3635 \u3609 \u3623 \u3609 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . 55 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 <br>\u3586 . 75 \u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656 <br>\u3588 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634  105 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 <br>\u3591 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634  125 \u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634  105 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  8 (\u3627 \u3609 \u3657 \u3634  97) \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3607 \u3637 \u3656  3.1 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618  "\u3648 \u3617 \u3639 \u3629 \u3591 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 \u3617 \u3637 \u3592 \u3635 \u3609 \u3623 \u3609 \u3619 \u3623 \u3617 \u3607 \u3633 \u3657 \u3591 \u3626 \u3636 \u3657 \u3609 \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634  105 \u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656  \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637  2570"</div></div>\
\
    <div class="qb"><div class="q">35. \uc0\u3605 \u3634 \u3617 \u3610 \u3619 \u3636 \u3610 \u3607 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  8 \u3616 \u3634 \u3588 \u3651 \u3604 \u3617 \u3637 \u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3605 \u3656 \u3629 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3617 \u3623 \u3621 \u3619 \u3623 \u3617 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3626 \u3641 \u3591 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 \u3651 \u3609 \u3611 \u3637  2562</div>\
    <div class="c">\uc0\u3585 . \u3616 \u3634 \u3588 \u3605 \u3632 \u3623 \u3633 \u3609 \u3629 \u3629 \u3585 <br>\u3586 . \u3616 \u3634 \u3588 \u3648 \u3627 \u3609 \u3639 \u3629 <br>\u3588 . \u3616 \u3634 \u3588 \u3605 \u3632 \u3623 \u3633 \u3609 \u3629 \u3629 \u3585 \u3648 \u3593 \u3637 \u3618 \u3591 \u3648 \u3627 \u3609 \u3639 \u3629 <br>\u3591 . \u3585 \u3619 \u3640 \u3591 \u3648 \u3607 \u3614 \u3617 \u3627 \u3634 \u3609 \u3588 \u3619 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3591 . \u3585 \u3619 \u3640 \u3591 \u3648 \u3607 \u3614 \u3617 \u3627 \u3634 \u3609 \u3588 \u3619 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  8 (\u3627 \u3609 \u3657 \u3634  95) \u3626 \u3606 \u3634 \u3609 \u3585 \u3634 \u3619 \u3603 \u3660 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3612 \u3656 \u3634 \u3609 \u3617 \u3634  \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3585 \u3619 \u3640 \u3591 \u3648 \u3607 \u3614 \u3631  \u3617 \u3637 \u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604 \u3605 \u3656 \u3629 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3617 \u3623 \u3621 \u3619 \u3623 \u3617 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3626 \u3641 \u3591 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 ... \u3592 \u3634 \u3585 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  32.7 \u3651 \u3609 \u3611 \u3637  2560 \u3648 \u3611 \u3655 \u3609 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  33.8 \u3651 \u3609 \u3611 \u3637  2562"</div></div>\
\
    <div class="qb"><div class="q">36. "\uc0\u3652 \u3607 \u3618 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3618 \u3634 \u3585 \u3592 \u3609 \u3586 \u3657 \u3634 \u3617 \u3619 \u3640 \u3656 \u3609 \u3621 \u3604 \u3621 \u3591  \u3649 \u3621 \u3632 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3588 \u3640 \u3657 \u3617 \u3588 \u3619 \u3629 \u3591 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 \u3607 \u3637 \u3656 \u3648 \u3614 \u3637 \u3618 \u3591 \u3614 \u3629  \u3648 \u3627 \u3617 \u3634 \u3632 \u3626 \u3617 " \u3588 \u3639 \u3629 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  7<br>\u3586 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  8<br>\u3588 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9<br>\u3591 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  12</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  3 (\u3627 \u3609 \u3657 \u3634  29) \u3649 \u3621 \u3632  \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 (\u3627 \u3609 \u3657 \u3634  103) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9 \u3588 \u3639 \u3629  "\u3652 \u3607 \u3618 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3618 \u3634 \u3585 \u3592 \u3609 \u3586 \u3657 \u3634 \u3617 \u3619 \u3640 \u3656 \u3609 \u3621 \u3604 \u3621 \u3591  \u3649 \u3621 \u3632 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3588 \u3640 \u3657 \u3617 \u3588 \u3619 \u3629 \u3591 \u3607 \u3634 \u3591 \u3626 \u3633 \u3591 \u3588 \u3617 \u3607 \u3656 \u3637 \u3648 \u3614 \u3637 \u3618 \u3591 \u3614 \u3629  \u3648 \u3627 \u3617 \u3634 \u3632 \u3626 \u3617 "</div></div>\
\
    <div class="qb"><div class="q">37. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9 \u3611 \u3633 \u3592 \u3592 \u3633 \u3618 \u3626 \u3635 \u3588 \u3633 \u3597 \u3607 \u3656 \u3637 \u3626 \u3640 \u3604 \u3607 \u3637 \u3656 \u3607 \u3635 \u3651 \u3627 \u3657 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 \u3648 \u3586 \u3657 \u3634 \u3586 \u3656 \u3634 \u3618 \u3648 \u3611 \u3655 \u3609  "\u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 \u3618 \u3634 \u3585 \u3592 \u3609 \u3586 \u3657 \u3634 \u3617 \u3619 \u3640 \u3656 \u3609 " \u3588 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3586 \u3634 \u3604 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591 \u3592 \u3634 \u3585 \u3652 \u3617 \u3656 \u3617 \u3637 \u3648 \u3591 \u3636 \u3609 \u3629 \u3629 \u3617 <br>\u3586 . \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3648 \u3604 \u3655 \u3585 \u3652 \u3617 \u3656 \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 \u3616 \u3634 \u3588 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 <br>\u3588 . \u3585 \u3634 \u3619 \u3617 \u3637 \u3629 \u3633 \u3605 \u3619 \u3634 \u3626 \u3656 \u3623 \u3609 \u3585 \u3634 \u3619 \u3614 \u3656 \u3638 \u3591 \u3614 \u3636 \u3591 \u3586 \u3629 \u3591 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 \u3626 \u3641 \u3591 <br>\u3591 . \u3627 \u3633 \u3623 \u3627 \u3609 \u3657 \u3634 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3629 \u3634 \u3594 \u3637 \u3614 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3619 \u3617 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3634 \u3619 \u3586 \u3634 \u3604 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591 \u3592 \u3634 \u3585 \u3652 \u3617 \u3656 \u3617 \u3637 \u3648 \u3591 \u3636 \u3609 \u3629 \u3629 \u3617 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9 (\u3627 \u3609 \u3657 \u3634  103) \u3626 \u3606 \u3634 \u3609 \u3585 \u3634 \u3619 \u3603 \u3660 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3612 \u3656 \u3634 \u3609 \u3617 \u3634  \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3611 \u3633 \u3592 \u3592 \u3633 \u3618 \u3607 \u3637 \u3656 \u3626 \u3635 \u3588 \u3633 \u3597 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 \u3607 \u3637 \u3656 \u3607 \u3635 \u3651 \u3627 \u3657 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 \u3648 \u3586 \u3657 \u3634 \u3586 \u3656 \u3634 \u3618 \u3648 \u3611 \u3655 \u3609 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 \u3618 \u3634 \u3585 \u3592 \u3609 \u3586 \u3657 \u3634 \u3617 \u3619 \u3640 \u3656 \u3609  \u3588 \u3639 \u3629  \u3585 \u3634 \u3619 \u3586 \u3634 \u3604 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591 \u3592 \u3634 \u3585 \u3652 \u3617 \u3656 \u3617 \u3637 \u3648 \u3591 \u3636 \u3609 \u3629 \u3629 \u3617  (\u3619 \u3657 \u3629 \u3618 \u3621 \u3632  73.4)"</div></div>\
\
    <div class="qb"><div class="q">38. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3629 \u3633 \u3605 \u3619 \u3634 \u3585 \u3634 \u3619 \u3648 \u3586 \u3657 \u3634 \u3648 \u3619 \u3637 \u3618 \u3609 \u3626 \u3640 \u3607 \u3608 \u3636 \u3649 \u3610 \u3610 \u3611 \u3619 \u3633 \u3610 \u3586 \u3629 \u3591 \u3648 \u3604 \u3655 \u3585 \u3592 \u3634 \u3585 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 \u3618 \u3634 \u3585 \u3592 \u3609 \u3586 \u3657 \u3634 \u3617 \u3619 \u3640 \u3656 \u3609 \u3651 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3617 \u3633 \u3608 \u3618 \u3617 \u3624 \u3638 \u3585 \u3625 \u3634 \u3605 \u3629 \u3609 \u3611 \u3621 \u3634 \u3618 \u3627 \u3619 \u3639 \u3629 \u3648 \u3607 \u3637 \u3618 \u3610 \u3648 \u3607 \u3656 \u3634  \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  50<br>\u3586 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  60<br>\u3588 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  70<br>\u3591 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  80</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  70</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9 (\u3627 \u3609 \u3657 \u3634  105) \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3607 \u3637 \u3656  1.2 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618  "\u3629 \u3633 \u3605 \u3619 \u3634 \u3585 \u3634 \u3619 \u3648 \u3586 \u3657 \u3634 \u3648 \u3619 \u3637 \u3618 \u3609 \u3626 \u3640 \u3607 \u3608 \u3636 \u3649 \u3610 \u3610 \u3611 \u3619 \u3633 \u3610 \u3586 \u3629 \u3591 \u3648 \u3604 \u3655 \u3585 \u3592 \u3634 \u3585 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 \u3618 \u3634 \u3585 \u3592 \u3609 \u3586 \u3657 \u3634 \u3617 \u3619 \u3640 \u3656 \u3609 ...\u3619 \u3632 \u3604 \u3633 \u3610 \u3617 \u3633 \u3608 \u3618 \u3617 \u3624 \u3638 \u3585 \u3625 \u3634 \u3605 \u3629 \u3609 \u3611 \u3621 \u3634 \u3618 \u3627 \u3619 \u3639 \u3629 \u3648 \u3607 \u3637 \u3618 \u3610 \u3648 \u3607 \u3656 \u3634  \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  70"</div></div>\
\
    <div class="qb"><div class="q">39. "\uc0\u3652 \u3607 \u3618 \u3617 \u3637 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3627 \u3617 \u3640 \u3609 \u3648 \u3623 \u3637 \u3618 \u3609 \u3649 \u3621 \u3632 \u3626 \u3633 \u3591 \u3588 \u3617 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 \u3605 \u3656 \u3635 " \u3588 \u3639 \u3629 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  8<br>\u3586 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9<br>\u3588 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  10<br>\u3591 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  11</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  10</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  3 (\u3627 \u3609 \u3657 \u3634  29) \u3649 \u3621 \u3632  \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 (\u3627 \u3609 \u3657 \u3634  111) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  10 \u3588 \u3639 \u3629  "\u3652 \u3607 \u3618 \u3617 \u3637 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3627 \u3617 \u3640 \u3609 \u3648 \u3623 \u3637 \u3618 \u3609 \u3649 \u3621 \u3632 \u3626 \u3633 \u3591 \u3588 \u3617 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 \u3605 \u3656 \u3635 "</div></div>\
\
    <div class="qb"><div class="q">40. \uc0\u3605 \u3634 \u3617 \u3610 \u3619 \u3636 \u3610 \u3607 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  10 \u3616 \u3634 \u3588 \u3626 \u3656 \u3623 \u3609 \u3651 \u3604 \u3611 \u3621 \u3656 \u3629 \u3618 \u3585 \u3658 \u3634 \u3595 \u3648 \u3619 \u3639 \u3629 \u3609 \u3585 \u3619 \u3632 \u3592 \u3585 \u3617 \u3634 \u3585 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604  (\u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3611 \u3637  2559)</div>\
    <div class="c">\uc0\u3585 . \u3616 \u3634 \u3588 \u3648 \u3585 \u3625 \u3605 \u3619 <br>\u3586 . \u3616 \u3634 \u3588 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 <br>\u3588 . \u3616 \u3634 \u3588 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3649 \u3621 \u3632 \u3586 \u3609 \u3626 \u3656 \u3591 <br>\u3591 . \u3616 \u3634 \u3588 \u3586 \u3629 \u3591 \u3648 \u3626 \u3637 \u3618 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3616 \u3634 \u3588 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3649 \u3621 \u3632 \u3586 \u3609 \u3626 \u3656 \u3591 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  10 (\u3627 \u3609 \u3657 \u3634  112) \u3626 \u3606 \u3634 \u3609 \u3585 \u3634 \u3619 \u3603 \u3660 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3612 \u3656 \u3634 \u3609 \u3617 \u3634  \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  (\u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3611 \u3637  2559) "\u3616 \u3634 \u3588 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3649 \u3621 \u3632 \u3586 \u3609 \u3626 \u3656 \u3591  \u3611 \u3621 \u3656 \u3629 \u3618 \u3585 \u3658 \u3634 \u3595 \u3648 \u3619 \u3639 \u3629 \u3609 \u3585 \u3619 \u3632 \u3592 \u3585 \u3617 \u3634 \u3585 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604  253.89 \u3621 \u3657 \u3634 \u3609 \u3605 \u3633 \u3609 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 \u3652 \u3604 \u3629 \u3629 \u3585 \u3652 \u3595 \u3604 \u3660 \u3648 \u3607 \u3637 \u3618 \u3610 \u3648 \u3607 \u3656 \u3634  (\u3619 \u3657 \u3629 \u3618 \u3621 \u3632  71.65)"</div></div>\
\
    <div class="qb"><div class="q">41. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  10 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3607 \u3604 \u3649 \u3607 \u3609 \u3605 \u3656 \u3629 \u3611 \u3619 \u3636 \u3617 \u3634 \u3603 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3586 \u3633 \u3657 \u3609 \u3626 \u3640 \u3604 \u3607 \u3657 \u3634 \u3618  \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637  2570 \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  20<br>\u3586 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  24<br>\u3588 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  28<br>\u3591 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  30</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  24</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  10 (\u3627 \u3609 \u3657 \u3634  113) \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3607 \u3637 \u3656  3.1 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618  "\u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3607 \u3604 \u3649 \u3607 \u3609 \u3605 \u3656 \u3629 \u3611 \u3619 \u3636 \u3617 \u3634 \u3603 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3586 \u3633 \u3657 \u3609 \u3626 \u3640 \u3604 \u3607 \u3657 \u3634 \u3618 \u3648 \u3614 \u3656 \u3636 \u3617 \u3586 \u3657 \u3638 \u3609  \u3617 \u3637 \u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3652 \u3617 \u3656 \u3609 \u3657 \u3629 \u3618 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  24 \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637  2570"</div></div>\
\
    <div class="qb"><div class="q">42. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  10 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3629 \u3633 \u3605 \u3619 \u3634 \u3585 \u3634 \u3619 \u3609 \u3635 \u3586 \u3618 \u3632 \u3585 \u3621 \u3633 \u3610 \u3617 \u3634 \u3651 \u3594 \u3657 \u3651 \u3627 \u3617 \u3656 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637  2570 \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  30<br>\u3586 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  35<br>\u3588 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  40<br>\u3591 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  50</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  40</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  10 (\u3627 \u3609 \u3657 \u3634  113) \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3607 \u3637 \u3656  3.2 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618  "\u3629 \u3633 \u3605 \u3619 \u3634 \u3585 \u3634 \u3619 \u3609 \u3635 \u3586 \u3618 \u3632 \u3585 \u3621 \u3633 \u3610 \u3617 \u3634 \u3651 \u3594 \u3657 \u3651 \u3627 \u3617 \u3656 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  40 \u3586 \u3629 \u3591 \u3611 \u3619 \u3636 \u3617 \u3634 \u3603 \u3586 \u3618 \u3632 \u3607 \u3656 \u3637 \u3609 \u3635 \u3585 \u3621 \u3633 \u3610 \u3617 \u3634 \u3651 \u3594 \u3657 \u3651 \u3627 \u3617 \u3656 \u3652 \u3604 \u3657 \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637  2570</div></div>\
\
    <div class="qb"><div class="q">43. "\uc0\u3652 \u3607 \u3618 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3656 \u3618 \u3591 \u3649 \u3621 \u3632 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3592 \u3634 \u3585 \u3616 \u3633 \u3618 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3626 \u3616 \u3634 \u3614 \u3616 \u3641 \u3617 \u3636 \u3629 \u3634 \u3585 \u3634 \u3624 " \u3588 \u3639 \u3629 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9<br>\u3586 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  10<br>\u3588 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  11<br>\u3591 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  12</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  11</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  3 (\u3627 \u3609 \u3657 \u3634  29) \u3649 \u3621 \u3632  \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 (\u3627 \u3609 \u3657 \u3634  119) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  11 \u3588 \u3639 \u3629  "\u3652 \u3607 \u3618 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3656 \u3618 \u3591 \u3649 \u3621 \u3632 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3592 \u3634 \u3585 \u3616 \u3633 \u3618 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3626 \u3616 \u3634 \u3614 \u3616 \u3641 \u3617 \u3636 \u3629 \u3634 \u3585 \u3634 \u3624 "</div></div>\
\
    <div class="qb"><div class="q">44. \uc0\u3605 \u3634 \u3617 \u3610 \u3619 \u3636 \u3610 \u3607 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  11 \u3619 \u3634 \u3618 \u3591 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3656 \u3618 \u3591 \u3604 \u3657 \u3634 \u3609 \u3616 \u3641 \u3617 \u3636 \u3629 \u3634 \u3585 \u3634 \u3624 \u3650 \u3621 \u3585  \u3611 \u3637  \u3588 .\u3624 . 2020 \u3592 \u3633 \u3604 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3651 \u3604 \u3607 \u3656 \u3637 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3656 \u3618 \u3591 \u3626 \u3641 \u3591 \u3605 \u3656 \u3629 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 </div>\
    <div class="c">\uc0\u3585 . \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  5<br>\u3586 . \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  8<br>\u3588 . \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  10<br>\u3591 . \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  12</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  8</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  11 (\u3627 \u3609 \u3657 \u3634  119) \u3626 \u3606 \u3634 \u3609 \u3585 \u3634 \u3619 \u3603 \u3660 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3612 \u3656 \u3634 \u3609 \u3617 \u3634  \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3592 \u3634 \u3585 \u3619 \u3634 \u3618 \u3591 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3656 \u3618 \u3591 \u3604 \u3657 \u3634 \u3609 \u3616 \u3641 \u3617 \u3636 \u3629 \u3634 \u3585 \u3634 \u3624 \u3650 \u3621 \u3585  \u3611 \u3637  \u3588 .\u3624 . 2020 \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618  \u3592 \u3633 \u3604 \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3585 \u3621 \u3640 \u3656 \u3617 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3607 \u3637 \u3656 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3656 \u3618 \u3591 \u3626 \u3641 \u3591 \u3605 \u3656 \u3629 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3626 \u3616 \u3634 \u3614 \u3616 \u3641 \u3617 \u3636 \u3629 \u3634 \u3585 \u3634 \u3624 \u3648 \u3611 \u3655 \u3609 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610  8"</div></div>\
\
    <div class="qb"><div class="q">45. "\uc0\u3652 \u3607 \u3618 \u3617 \u3637 \u3585 \u3635 \u3621 \u3633 \u3591 \u3588 \u3609 \u3626 \u3617 \u3619 \u3619 \u3606 \u3609 \u3632 \u3626 \u3641 \u3591  \u3617 \u3640 \u3656 \u3591 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3605 \u3656 \u3629 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591  \u3605 \u3629 \u3610 \u3650 \u3592 \u3607 \u3618 \u3660 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3627 \u3656 \u3591 \u3629 \u3609 \u3634 \u3588 \u3605 " \u3588 \u3639 \u3629 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9<br>\u3586 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  10<br>\u3588 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  11<br>\u3591 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  12</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3591 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  12</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  3 (\u3627 \u3609 \u3657 \u3634  29) \u3649 \u3621 \u3632  \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 (\u3627 \u3609 \u3657 \u3634  127) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  12 \u3588 \u3639 \u3629  "\u3652 \u3607 \u3618 \u3617 \u3637 \u3585 \u3635 \u3621 \u3633 \u3591 \u3588 \u3609 \u3626 \u3617 \u3619 \u3619 \u3606 \u3609 \u3632 \u3626 \u3641 \u3591  \u3617 \u3640 \u3656 \u3591 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3605 \u3656 \u3629 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591  \u3605 \u3629 \u3610 \u3650 \u3592 \u3607 \u3618 \u3660 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3627 \u3656 \u3591 \u3629 \u3609 \u3634 \u3588 \u3605 "</div></div>\
\
    <div class="qb"><div class="q">46. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  12 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3585 \u3634 \u3619 \u3648 \u3614 \u3656 \u3636 \u3617 \u3586 \u3657 \u3638 \u3609 \u3586 \u3629 \u3591 \u3612 \u3621 \u3636 \u3605 \u3616 \u3634 \u3614 \u3649 \u3619 \u3591 \u3591 \u3634 \u3609  \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3607 \u3637 \u3656 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3614 \u3656 \u3636 \u3617 \u3586 \u3657 \u3638 \u3609 \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  2 \u3605 \u3656 \u3629 \u3611 \u3637 <br>\u3586 . \u3648 \u3614 \u3636 \u3656 \u3617 \u3586 \u3657 \u3638 \u3609 \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  3 \u3605 \u3656 \u3629 \u3611 \u3637 <br>\u3588 . \u3648 \u3614 \u3636 \u3656 \u3617 \u3586 \u3657 \u3638 \u3609 \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  4 \u3605 \u3656 \u3629 \u3611 \u3637 <br>\u3591 . \u3648 \u3614 \u3636 \u3656 \u3617 \u3586 \u3657 \u3638 \u3609 \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  5 \u3605 \u3656 \u3629 \u3611 \u3637 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3648 \u3614 \u3656 \u3636 \u3617 \u3586 \u3657 \u3638 \u3609 \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  4 \u3605 \u3656 \u3629 \u3611 \u3637 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  12 (\u3627 \u3609 \u3657 \u3634  129) \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3607 \u3637 \u3656  1.5 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618  "\u3612 \u3621 \u3636 \u3605 \u3616 \u3634 \u3614 \u3649 \u3619 \u3591 \u3591 \u3634 \u3609  \u3648 \u3614 \u3656 \u3636 \u3617 \u3586 \u3657 \u3638 \u3609 \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  4 \u3605 \u3656 \u3629 \u3611 \u3637 "</div></div>\
\
    <div class="qb"><div class="q">47. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  12 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3585 \u3621 \u3640 \u3656 \u3617 \u3611 \u3619 \u3632 \u3594 \u3634 \u3585 \u3619 \u3629 \u3634 \u3618 \u3640  15-24 \u3611 \u3637  \u3607 \u3637 \u3656 \u3652 \u3617 \u3656 \u3652 \u3604 \u3657 \u3648 \u3619 \u3637 \u3618 \u3609  \u3652 \u3617 \u3656 \u3652 \u3604 \u3657 \u3607 \u3635 \u3591 \u3634 \u3609  \u3627 \u3619 \u3639 \u3629 \u3652 \u3617 \u3656 \u3652 \u3604 \u3657 \u3613 \u3638 \u3585 \u3629 \u3610 \u3619 \u3617  (NEET) \u3648 \u3617 \u3639 \u3656 \u3629 \u3626 \u3636 \u3657 \u3609 \u3626 \u3640 \u3604 \u3649 \u3612 \u3609  \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3652 \u3617 \u3656 \u3648 \u3585 \u3636 \u3609 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  5<br>\u3586 . \u3652 \u3617 \u3656 \u3648 \u3585 \u3636 \u3609 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  8<br>\u3588 . \u3652 \u3617 \u3656 \u3648 \u3585 \u3636 \u3609 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  10<br>\u3591 . \u3652 \u3617 \u3656 \u3648 \u3585 \u3636 \u3609 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  12</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3652 \u3617 \u3656 \u3648 \u3585 \u3636 \u3609 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  5</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  12 (\u3627 \u3609 \u3657 \u3634  130) \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3607 \u3637 \u3656  3.2 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618  "\u3585 \u3621 \u3640 \u3656 \u3617 \u3611 \u3619 \u3632 \u3594 \u3634 \u3585 \u3619 \u3629 \u3634 \u3618 \u3640  15-24 \u3611 \u3637  \u3607 \u3637 \u3656 \u3652 \u3617 \u3656 \u3652 \u3604 \u3657 \u3648 \u3619 \u3637 \u3618 \u3609  \u3652 \u3617 \u3656 \u3652 \u3604 \u3657 \u3607 \u3635 \u3591 \u3634 \u3609  \u3627 \u3619 \u3639 \u3629 \u3652 \u3617 \u3656 \u3652 \u3604 \u3657 \u3613 \u3638 \u3585 \u3629 \u3610 \u3619 \u3617  \u3652 \u3617 \u3656 \u3648 \u3585 \u3636 \u3609 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  5 \u3648 \u3617 \u3639 \u3656 \u3629 \u3626 \u3636 \u3657 \u3609 \u3626 \u3640 \u3604 \u3649 \u3612 \u3609 "</div></div>\
\
    <div class="qb"><div class="q">48. "\uc0\u3652 \u3607 \u3618 \u3617 \u3637 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3637 \u3656 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618  \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614  \u3649 \u3621 \u3632 \u3605 \u3629 \u3610 \u3650 \u3592 \u3607 \u3618 \u3660 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 " \u3588 \u3639 \u3629 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  10<br>\u3586 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  11<br>\u3588 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  12<br>\u3591 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  13</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3591 . \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  13</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  3 (\u3627 \u3609 \u3657 \u3634  29) \u3649 \u3621 \u3632  \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 (\u3627 \u3609 \u3657 \u3634  138) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  13 \u3588 \u3639 \u3629  "\u3652 \u3607 \u3618 \u3617 \u3637 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3637 \u3656 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618  \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614  \u3649 \u3621 \u3632 \u3605 \u3629 \u3610 \u3650 \u3592 \u3607 \u3618 \u3660 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 "</div></div>\
\
    <div class="qb"><div class="q">49. \uc0\u3605 \u3634 \u3617 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  13 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3612 \u3621 \u3585 \u3634 \u3619 \u3626 \u3635 \u3619 \u3623 \u3592 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660  (e-Government Development Index) \u3586 \u3629 \u3591 \u3652 \u3607 \u3618  \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3652 \u3617 \u3656 \u3648 \u3585 \u3636 \u3609 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  30 \u3586 \u3629 \u3591 \u3650 \u3621 \u3585 <br>\u3586 . \u3652 \u3617 \u3656 \u3648 \u3585 \u3636 \u3609 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  40 \u3586 \u3629 \u3591 \u3650 \u3621 \u3585 <br>\u3588 . \u3652 \u3617 \u3656 \u3648 \u3585 \u3636 \u3609 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  50 \u3586 \u3629 \u3591 \u3650 \u3621 \u3585 <br>\u3591 . \u3652 \u3617 \u3656 \u3648 \u3585 \u3636 \u3609 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  57 \u3586 \u3629 \u3591 \u3650 \u3621 \u3585 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3652 \u3617 \u3656 \u3648 \u3585 \u3636 \u3609 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  40 \u3586 \u3629 \u3591 \u3650 \u3621 \u3585 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  4 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  13 (\u3627 \u3609 \u3657 \u3634  140) \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3607 \u3637 \u3656  2.1 \u3585 \u3635 \u3627 \u3609 \u3604 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618  "\u3612 \u3621 \u3585 \u3634 \u3619 \u3626 \u3635 \u3619 \u3623 \u3592 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660 ... \u3652 \u3617 \u3656 \u3648 \u3585 \u3636 \u3609 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  40 \u3586 \u3629 \u3591 \u3650 \u3621 \u3585  \u3649 \u3621 \u3632 \u3617 \u3637 \u3588 \u3632 \u3649 \u3609 \u3609 \u3652 \u3617 \u3656 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634  0.82"</div></div>\
\
    <div class="qb"><div class="q">50. \uc0\u3585 \u3634 \u3619 \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636  \u3652 \u3604 \u3657 \u3585 \u3635 \u3627 \u3609 \u3604 \u3651 \u3627 \u3657 \u3651 \u3594 \u3657 \u3623 \u3591 \u3592 \u3619 \u3651 \u3604 \u3648 \u3611 \u3655 \u3609 \u3585 \u3619 \u3629 \u3610 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3619 \u3632 \u3610 \u3610 \u3649 \u3621 \u3632 \u3617 \u3637 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3619 \u3633 \u3610 \u3611 \u3619 \u3640 \u3591 \u3629 \u3618 \u3656 \u3634 \u3591 \u3605 \u3656 \u3629 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591 </div>\
    <div class="c">\uc0\u3585 . \u3623 \u3591 \u3592 \u3619 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3591 \u3634 \u3609 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614  (PDCA)<br>\u3586 . \u3585 \u3621 \u3652 \u3585 \u3585 \u3634 \u3619 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3649 \u3610 \u3610 \u3617 \u3640 \u3656 \u3591 \u3612 \u3621 \u3626 \u3633 \u3617 \u3620 \u3607 \u3608 \u3636 \u3660  (RBA)<br>\u3588 . \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609  (SDGs)<br>\u3591 . \u3627 \u3621 \u3633 \u3585 \u3608 \u3619 \u3619 \u3617 \u3634 \u3616 \u3636 \u3610 \u3634 \u3621  (Good Governance)</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3623 \u3591 \u3592 \u3619 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3591 \u3634 \u3609 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614  (PDCA)</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  5 \u3585 \u3634 \u3619 \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3649 \u3612 \u3609 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636  (\u3627 \u3609 \u3657 \u3634  146) \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3633 \u3623 \u3586 \u3657 \u3629  5.1 \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3631  \u3586 \u3657 \u3629  5.1.1 \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3623 \u3591 \u3592 \u3619 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3591 \u3634 \u3609 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3648 \u3611 \u3655 \u3609 \u3585 \u3619 \u3629 \u3610 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 " \u3595 \u3638 \u3656 \u3591 \u3623 \u3591 \u3592 \u3619 \u3604 \u3633 \u3591 \u3585 \u3621 \u3656 \u3634 \u3623 \u3588 \u3639 \u3629  PDCA (\u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3649 \u3612 \u3609 , \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3605 \u3634 \u3617 \u3649 \u3612 \u3609 , \u3585 \u3634 \u3619 \u3605 \u3636 \u3604 \u3605 \u3634 \u3617  \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 , \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3611 \u3619 \u3640 \u3591 \u3649 \u3585 \u3657 \u3652 \u3586 )</div></div>\
\
    <div class="qb"><div class="q">51. \uc0\u3651 \u3609 \u3610 \u3619 \u3636 \u3610 \u3607 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3604 \u3657 \u3634 \u3609 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592  (\u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  2) \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3606 \u3641 \u3585 \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634 \u3605 \u3636 \u3604 \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3585 \u3633 \u3610 \u3604 \u3633 \u3585 \u3651 \u3604 \u3617 \u3634 \u3648 \u3611 \u3655 \u3609 \u3648 \u3623 \u3621 \u3634 \u3609 \u3634 \u3609 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3633 \u3610 \u3604 \u3633 \u3585 \u3626 \u3616 \u3634 \u3614 \u3588 \u3621 \u3656 \u3629 \u3591 <br>\u3586 . \u3585 \u3633 \u3610 \u3604 \u3633 \u3585 \u3627 \u3609 \u3637 \u3657 \u3626 \u3634 \u3608 \u3634 \u3619 \u3603 \u3632 <br>\u3588 . \u3585 \u3633 \u3610 \u3604 \u3633 \u3585 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3611 \u3634 \u3609 \u3585 \u3621 \u3634 \u3591 <br>\u3591 . \u3585 \u3633 \u3610 \u3604 \u3633 \u3585 \u3585 \u3634 \u3619 \u3614 \u3638 \u3656 \u3591 \u3614 \u3634 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3585 \u3633 \u3610 \u3604 \u3633 \u3585 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3611 \u3634 \u3609 \u3585 \u3621 \u3634 \u3591 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  2 \u3610 \u3619 \u3636 \u3610 \u3607 \u3604 \u3657 \u3634 \u3609 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592  (\u3627 \u3609 \u3657 \u3634  12) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3605 \u3636 \u3604 \u3585 \u3633 \u3610 \u3604 \u3633 \u3585 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3611 \u3634 \u3609 \u3585 \u3621 \u3634 \u3591 \u3617 \u3634 \u3648 \u3611 \u3655 \u3609 \u3648 \u3623 \u3621 \u3634 \u3609 \u3634 \u3609 " \u3648 \u3609 \u3639 \u3656 \u3629 \u3591 \u3592 \u3634 \u3585 \u3611 \u3633 \u3597 \u3627 \u3634 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 \u3586 \u3629 \u3591 \u3605 \u3621 \u3634 \u3604 </div></div>\
\
    <div class="qb"><div class="q">52. \uc0\u3592 \u3634 \u3585 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3586 \u3629 \u3591 \u3650 \u3588 \u3623 \u3636 \u3604 -19 \u3651 \u3609 \u3611 \u3637  2563 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3652 \u3607 \u3618 \u3627 \u3604 \u3605 \u3633 \u3623 \u3621 \u3591 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  3.5<br>\u3586 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  4.9<br>\u3588 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  6.1<br>\u3591 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  7.4</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  6.1</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  2 \u3610 \u3619 \u3636 \u3610 \u3607 \u3604 \u3657 \u3634 \u3609 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592  (\u3627 \u3609 \u3657 \u3634  13) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3651 \u3609 \u3611 \u3637  2563 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3652 \u3607 \u3618 \u3627 \u3604 \u3605 \u3633 \u3623 \u3621 \u3591 \u3606 \u3638 \u3591 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  6.1" \u3595 \u3638 \u3656 \u3591 \u3648 \u3611 \u3655 \u3609 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3592 \u3634 \u3585 \u3626 \u3606 \u3634 \u3609 \u3585 \u3634 \u3619 \u3603 \u3660 \u3650 \u3588 \u3623 \u3636 \u3604 -19</div></div>\
\
    <div class="qb"><div class="q">53. \uc0\u3651 \u3609 \u3611 \u3637  2563 \u3616 \u3634 \u3588 \u3626 \u3656 \u3623 \u3609 \u3651 \u3604 \u3586 \u3629 \u3591 \u3652 \u3607 \u3618 \u3607 \u3637 \u3656 \u3609 \u3629 \u3585 \u3648 \u3627 \u3609 \u3639 \u3629 \u3592 \u3634 \u3585 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600  \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3592 \u3634 \u3585 \u3650 \u3588 \u3623 \u3636 \u3604 -19 \u3617 \u3634 \u3585 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604  \u3650 \u3604 \u3618 \u3627 \u3604 \u3605 \u3633 \u3623 \u3621 \u3591 \u3606 \u3638 \u3591 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  7.4</div>\
    <div class="c">\uc0\u3585 . \u3616 \u3634 \u3588 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3619 \u3617 <br>\u3586 . \u3616 \u3634 \u3588 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 <br>\u3588 . \u3616 \u3634 \u3588 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 <br>\u3591 . \u3616 \u3634 \u3588 \u3585 \u3634 \u3619 \u3585 \u3656 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3616 \u3634 \u3588 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  2 \u3610 \u3619 \u3636 \u3610 \u3607 \u3604 \u3657 \u3634 \u3609 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592  (\u3627 \u3609 \u3657 \u3634  13) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3616 \u3634 \u3588 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3586 \u3629 \u3591 \u3652 \u3607 \u3618 \u3607 \u3637 \u3656 \u3609 \u3629 \u3585 \u3648 \u3627 \u3609 \u3639 \u3629 \u3592 \u3634 \u3585 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600  \u3648 \u3611 \u3655 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656 \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3617 \u3634 \u3585 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604  \u3650 \u3604 \u3618 \u3627 \u3604 \u3605 \u3633 \u3623 \u3621 \u3591 \u3606 \u3638 \u3591 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  7.4"</div></div>\
\
    <div class="qb"><div class="q">54. \uc0\u3651 \u3609 \u3610 \u3619 \u3636 \u3610 \u3607 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3604 \u3657 \u3634 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617  (\u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  2) \u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3588 \u3609 \u3592 \u3609 \u3586 \u3629 \u3591 \u3652 \u3607 \u3618 \u3651 \u3609 \u3611 \u3637  2563 \u3629 \u3618 \u3641 \u3656 \u3607 \u3637 \u3656 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  6.84<br>\u3586 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  8.6<br>\u3588 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  9.2<br>\u3591 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  10.5</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  6.84</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  2 \u3610 \u3619 \u3636 \u3610 \u3607 \u3604 \u3657 \u3634 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617  (\u3627 \u3609 \u3657 \u3634  15) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3621 \u3604 \u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3588 \u3609 \u3592 \u3609 \u3621 \u3591 \u3592 \u3634 \u3585 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  8.6 \u3651 \u3609 \u3611 \u3637  2559 \u3648 \u3627 \u3621 \u3639 \u3629 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  6.84 \u3651 \u3609 \u3611 \u3637  2563"</div></div>\
\
    <div class="qb"><div class="q">55. \uc0\u3610 \u3619 \u3636 \u3610 \u3607 \u3604 \u3657 \u3634 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617  (\u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  2) \u3619 \u3632 \u3610 \u3640 \u3606 \u3638 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3627 \u3621 \u3639 \u3656 \u3629 \u3617 \u3621 \u3657 \u3635 \u3604 \u3657 \u3634 \u3609 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3623 \u3656 \u3634  \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3648 \u3593 \u3621 \u3637 \u3656 \u3618 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3585 \u3621 \u3640 \u3656 \u3617 \u3588 \u3609 \u3607 \u3637 \u3656 \u3592 \u3609 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 \u3585 \u3633 \u3610 \u3585 \u3621 \u3640 \u3656 \u3617 \u3607 \u3656 \u3637 \u3617 \u3637 \u3600 \u3634 \u3609 \u3632 \u3604 \u3637 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3649 \u3605 \u3585 \u3605 \u3656 \u3634 \u3591 \u3585 \u3633 \u3609 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3585 \u3637 \u3656 \u3648 \u3607 \u3656 \u3634 </div>\
    <div class="c">\uc0\u3585 . 8 \u3648 \u3607 \u3656 \u3634 <br>\u3586 . 12 \u3648 \u3607 \u3656 \u3634 <br>\u3588 . \u3648 \u3585 \u3639 \u3629 \u3610  16 \u3648 \u3607 \u3656 \u3634 <br>\u3591 . \u3648 \u3585 \u3639 \u3629 \u3610  20 \u3648 \u3607 \u3656 \u3634 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3648 \u3585 \u3639 \u3629 \u3610  16 \u3648 \u3607 \u3656 \u3634 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  2 \u3610 \u3619 \u3636 \u3610 \u3607 \u3604 \u3657 \u3634 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617  (\u3627 \u3609 \u3657 \u3634  16) \u3619 \u3632 \u3610 \u3640 \u3606 \u3638 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3627 \u3621 \u3639 \u3656 \u3629 \u3617 \u3621 \u3657 \u3635 \u3604 \u3657 \u3634 \u3609 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3623 \u3656 \u3634  "\u3614 \u3610 \u3623 \u3656 \u3634 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3648 \u3593 \u3621 \u3637 \u3656 \u3618 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3585 \u3621 \u3640 \u3656 \u3617 \u3588 \u3609 \u3607 \u3637 \u3656 \u3592 \u3609 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 \u3585 \u3633 \u3610 \u3585 \u3621 \u3640 \u3656 \u3617 \u3607 \u3637 \u3656 \u3617 \u3637 \u3600 \u3634 \u3609 \u3632 \u3604 \u3637 \u3607 \u3656 \u3637 \u3626 \u3640 \u3604 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3649 \u3605 \u3585 \u3605 \u3656 \u3634 \u3591 \u3585 \u3633 \u3609 \u3648 \u3585 \u3639 \u3629 \u3610  16 \u3648 \u3607 \u3656 \u3634 "</div></div>\
\
    <div class="qb"><div class="q">56. \uc0\u3651 \u3609 \u3611 \u3637  2563 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3586 \u3609 \u3634 \u3604 \u3585 \u3621 \u3634 \u3591 \u3649 \u3621 \u3632 \u3586 \u3609 \u3634 \u3604 \u3618 \u3656 \u3629 \u3617  (MSMEs) \u3617 \u3637 \u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3605 \u3656 \u3629 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3617 \u3623 \u3621 \u3619 \u3623 \u3617 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  (GDP) \u3629 \u3618 \u3641 \u3656 \u3607 \u3637 \u3656 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  34.2<br>\u3586 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  45.5<br>\u3588 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  50.0<br>\u3591 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  70.1</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  34.2</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  2 \u3610 \u3619 \u3636 \u3610 \u3607 \u3604 \u3657 \u3634 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617  (\u3627 \u3609 \u3657 \u3634  16) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3586 \u3609 \u3634 \u3604 \u3585 \u3621 \u3634 \u3591 \u3649 \u3621 \u3632 \u3586 \u3609 \u3634 \u3604 \u3618 \u3656 \u3629 \u3617 ...\u3585 \u3621 \u3633 \u3610 \u3617 \u3637 \u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3605 \u3656 \u3629 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3617 \u3623 \u3621 \u3619 \u3623 \u3617 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3648 \u3614 \u3637 \u3618 \u3591 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  34.2 \u3651 \u3609 \u3611 \u3637  2563"</div></div>\
\
    <div class="qb"><div class="q">57. \uc0\u3610 \u3619 \u3636 \u3610 \u3607 \u3604 \u3657 \u3634 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617  (\u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  2) \u3588 \u3634 \u3604 \u3585 \u3634 \u3619 \u3603 \u3660 \u3623 \u3656 \u3634 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3592 \u3632 \u3585 \u3621 \u3634 \u3618 \u3648 \u3611 \u3655 \u3609  "\u3626 \u3633 \u3591 \u3588 \u3617 \u3626 \u3641 \u3591 \u3623 \u3633 \u3618 \u3629 \u3618 \u3656 \u3634 \u3591 \u3626 \u3617 \u3610 \u3641 \u3619 \u3603 \u3660 " (\u3611 \u3619 \u3632 \u3594 \u3634 \u3585 \u3619 \u3629 \u3634 \u3618 \u3640  60 \u3611 \u3637 \u3586 \u3638 \u3657 \u3609 \u3652 \u3611  \u3626 \u3641 \u3591 \u3606 \u3638 \u3591 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  20) \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3611 \u3637  2565<br>\u3586 . \u3611 \u3637  2566<br>\u3588 . \u3611 \u3637  2568<br>\u3591 . \u3611 \u3637  2570</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3611 \u3637  2566</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  2 \u3610 \u3619 \u3636 \u3610 \u3607 \u3604 \u3657 \u3634 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617  (\u3627 \u3609 \u3657 \u3634  17) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3588 \u3634 \u3604 \u3623 \u3656 \u3634 \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3637  2566 \u3595 \u3638 \u3656 \u3591 \u3648 \u3611 \u3655 \u3609 \u3611 \u3637 \u3648 \u3619 \u3636 \u3656 \u3617 \u3605 \u3657 \u3609 \u3586 \u3629 \u3591 \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13 \u3652 \u3607 \u3618 \u3592 \u3632 \u3585 \u3621 \u3634 \u3618 \u3648 \u3611 \u3655 \u3609  \u3626 \u3633 \u3591 \u3588 \u3617 \u3626 \u3641 \u3591 \u3623 \u3633 \u3618 \u3629 \u3618 \u3656 \u3634 \u3591 \u3626 \u3617 \u3610 \u3641 \u3619 \u3603 \u3660 "</div></div>\
\
    <div class="qb"><div class="q">58. \uc0\u3610 \u3619 \u3636 \u3610 \u3607 \u3604 \u3657 \u3634 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636  (\u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  2) \u3619 \u3632 \u3610 \u3640 \u3606 \u3638 \u3591 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3611 \u3656 \u3634 \u3652 \u3617 \u3657 \u3605 \u3634 \u3617 \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  12 \u3595 \u3638 \u3656 \u3591 \u3618 \u3633 \u3591 \u3588 \u3591 \u3648 \u3611 \u3655 \u3609 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3605 \u3656 \u3629 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591  \u3623 \u3656 \u3634 \u3588 \u3623 \u3619 \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3607 \u3637 \u3656 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 \u3586 \u3629 \u3591 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
    <div class="c">\uc0\u3585 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  30<br>\u3586 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  35<br>\u3588 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  40<br>\u3591 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  50</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  40</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  2 \u3610 \u3619 \u3636 \u3610 \u3607 \u3604 \u3657 \u3634 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636  (\u3627 \u3609 \u3657 \u3634  19) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3618 \u3633 \u3591 \u3605 \u3656 \u3635 \u3585 \u3623 \u3656 \u3634 \u3588 \u3656 \u3634 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3605 \u3634 \u3617 \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  12 \u3607 \u3637 \u3656 \u3585 \u3635 \u3627 \u3609 \u3604 \u3651 \u3627 \u3657 \u3648 \u3614 \u3636 \u3656 \u3617 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3611 \u3656 \u3634 \u3652 \u3617 \u3657 \u3648 \u3611 \u3655 \u3609 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  40 \u3586 \u3629 \u3591 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 "</div></div>\
\
    <div class="qb"><div class="q">59. \uc0\u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3651 \u3609 \u3610 \u3619 \u3636 \u3610 \u3607 \u3604 \u3657 \u3634 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636  (\u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  2) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634 \u3649 \u3627 \u3621 \u3656 \u3591 \u3607 \u3637 \u3656 \u3617 \u3634 \u3651 \u3609 \u3585 \u3634 \u3619 \u3611 \u3621 \u3656 \u3629 \u3618 \u3585 \u3658 \u3634 \u3595 \u3648 \u3619 \u3639 \u3629 \u3609 \u3585 \u3619 \u3632 \u3592 \u3585 \u3607 \u3637 \u3656 \u3617 \u3634 \u3585 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604  (\u3619 \u3657 \u3629 \u3618 \u3621 \u3632  74) \u3617 \u3634 \u3592 \u3634 \u3585 \u3616 \u3634 \u3588 \u3626 \u3656 \u3623 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3605 \u3619 <br>\u3586 . \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 <br>\u3588 . \u3616 \u3634 \u3588 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 <br>\u3591 . \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3586 \u3629 \u3591 \u3648 \u3626 \u3637 \u3618 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  2 \u3610 \u3619 \u3636 \u3610 \u3607 \u3604 \u3657 \u3634 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636  (\u3627 \u3609 \u3657 \u3634  20) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3626 \u3633 \u3604 \u3626 \u3656 \u3623 \u3609 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3611 \u3621 \u3656 \u3629 \u3618 \u3585 \u3658 \u3634 \u3595 \u3648 \u3619 \u3639 \u3629 \u3609 \u3585 \u3619 \u3632 \u3592 \u3585 \u3607 \u3637 \u3656 \u3617 \u3634 \u3585 \u3607 \u3656 \u3637 \u3626 \u3640 \u3604 \u3606 \u3638 \u3591 \u3619 \u3657 \u3629 \u3618 \u3621 \u3632  74 \u3617 \u3634 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 "</div></div>\
\
    <div class="qb"><div class="q">60. \uc0\u3651 \u3609 \u3611 \u3637  2563 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3604 \u3633 \u3594 \u3609 \u3637 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660  (e-Government Development Index) \u3651 \u3627 \u3657 \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656 \u3648 \u3607 \u3656 \u3634 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  45<br>\u3586 . \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  57<br>\u3588 . \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  66<br>\u3591 . \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  77</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  57</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  2 \u3610 \u3619 \u3636 \u3610 \u3607 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600  (\u3627 \u3609 \u3657 \u3634  22) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3651 \u3609 \u3611 \u3637  2563 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3604 \u3633 \u3594 \u3609 \u3637 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660 ... \u3651 \u3627 \u3657 \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3629 \u3633 \u3609 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  57 \u3592 \u3634 \u3585 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604  193 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 "</div></div>\
\
    <div class="qb"><div class="q">61. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.1 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  1 (\u3648 \u3585 \u3625 \u3605 \u3619 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3626 \u3641 \u3591 ) \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3585 \u3634 \u3619 \u3623 \u3636 \u3592 \u3633 \u3618 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3650 \u3604 \u3618 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3617 \u3637 \u3626 \u3656 \u3623 \u3609 \u3619 \u3656 \u3623 \u3617 \u3586 \u3629 \u3591 \u3616 \u3634 \u3588 \u3626 \u3656 \u3623 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3616 \u3634 \u3588 \u3611 \u3619 \u3632 \u3594 \u3634 \u3626 \u3633 \u3591 \u3588 \u3617 <br>\u3586 . \u3616 \u3634 \u3588 \u3648 \u3629 \u3585 \u3594 \u3609 <br>\u3588 . \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 <br>\u3591 . \u3629 \u3591 \u3588 \u3660 \u3585 \u3619 \u3611 \u3585 \u3588 \u3619 \u3629 \u3591 \u3626 \u3656 \u3623 \u3609 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3616 \u3634 \u3588 \u3648 \u3629 \u3585 \u3594 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  1 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.1 (\u3627 \u3609 \u3657 \u3634  37) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3585 \u3634 \u3619 \u3623 \u3636 \u3592 \u3633 \u3618 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3649 \u3621 \u3632 \u3649 \u3611 \u3619 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3617 \u3640 \u3656 \u3591 \u3648 \u3611 \u3657 \u3634  \u3650 \u3604 \u3618 \u3585 \u3634 \u3619 \u3617 \u3637 \u3626 \u3656 \u3623 \u3609 \u3619 \u3656 \u3623 \u3617 \u3586 \u3629 \u3591 \u3616 \u3634 \u3588 \u3648 \u3629 \u3585 \u3594 \u3609 "</div></div>\
\
    <div class="qb"><div class="q">62. \uc0\u3586 \u3657 \u3629 \u3651 \u3604  \u3652 \u3617 \u3656 \u3651 \u3594 \u3656  \u3605 \u3633 \u3623 \u3629 \u3618 \u3656 \u3634 \u3591 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3648 \u3585 \u3625 \u3605 \u3619 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3585 \u3633 \u3610 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 \u3649 \u3621 \u3632 \u3617 \u3637 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3656 \u3636 \u3617 \u3626 \u3641 \u3591  \u3607 \u3637 \u3656 \u3619 \u3632 \u3610 \u3640 \u3652 \u3623 \u3657 \u3651 \u3609 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3607 \u3637 \u3656  3 \u3586 \u3629 \u3591 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  1</div>\
    <div class="c">\uc0\u3585 . \u3648 \u3585 \u3625 \u3605 \u3619 \u3605 \u3634 \u3617 \u3650 \u3617 \u3648 \u3604 \u3621 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592  BCG<br>\u3586 . \u3623 \u3609 \u3648 \u3585 \u3625 \u3605 \u3619  \u3649 \u3621 \u3632 \u3648 \u3585 \u3625 \u3605 \u3619 \u3629 \u3636 \u3609 \u3607 \u3619 \u3637 \u3618 \u3660 <br>\u3588 . \u3585 \u3634 \u3619 \u3607 \u3635 \u3611 \u3619 \u3632 \u3617 \u3591 \u3606 \u3641 \u3585 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 <br>\u3591 . \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3605 \u3619 \u3649 \u3610 \u3610 \u3651 \u3594 \u3657 \u3626 \u3634 \u3619 \u3648 \u3588 \u3617 \u3637 \u3648 \u3586 \u3657 \u3617 \u3586 \u3657 \u3609 \u3648 \u3614 \u3656 \u3639 \u3629 \u3612 \u3621 \u3612 \u3621 \u3636 \u3605 \u3626 \u3641 \u3591 \u3626 \u3640 \u3604 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3591 . \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3605 \u3619 \u3649 \u3610 \u3610 \u3651 \u3594 \u3657 \u3626 \u3634 \u3619 \u3648 \u3588 \u3617 \u3637 \u3648 \u3586 \u3657 \u3617 \u3586 \u3657 \u3609 \u3648 \u3614 \u3656 \u3639 \u3629 \u3612 \u3621 \u3612 \u3621 \u3636 \u3605 \u3626 \u3641 \u3591 \u3626 \u3640 \u3604 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  1 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3607 \u3637 \u3656  3 (\u3627 \u3609 \u3657 \u3634  38) \u3619 \u3632 \u3610 \u3640 \u3605 \u3633 \u3623 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3585 \u3625 \u3605 \u3619 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3652 \u3623 \u3657 \u3627 \u3621 \u3634 \u3618 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610  \u3648 \u3594 \u3656 \u3609  \u3648 \u3585 \u3625 \u3605 \u3619  BCG, \u3648 \u3585 \u3625 \u3605 \u3619 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 , \u3623 \u3609 \u3648 \u3585 \u3625 \u3605 \u3619 , \u3648 \u3585 \u3625 \u3605 \u3619 \u3629 \u3636 \u3609 \u3607 \u3619 \u3637 \u3618 ,\u3660  \u3611 \u3619 \u3632 \u3617 \u3591 \u3614 \u3657 \u3639 \u3609 \u3610 \u3657 \u3634 \u3609  \u3649 \u3605 \u3656 \u3652 \u3617 \u3656 \u3652 \u3604 \u3657 \u3619 \u3623 \u3617 \u3606 \u3638 \u3591 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3626 \u3634 \u3619 \u3648 \u3588 \u3617 \u3637 \u3648 \u3586 \u3657 \u3617 \u3586 \u3657 \u3609 </div></div>\
\
    <div class="qb"><div class="q">63. \uc0\u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  1 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3651 \u3604 \u3607 \u3637 \u3656 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3609 \u3657 \u3635 \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3605 \u3619 \u3651 \u3627 \u3657 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3617 \u3604 \u3640 \u3621 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3629 \u3640 \u3611 \u3626 \u3591 \u3588 \u3660 \u3649 \u3621 \u3632 \u3629 \u3640 \u3611 \u3607 \u3634 \u3609  \u3619 \u3623 \u3617 \u3606 \u3638 \u3591 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3609 \u3657 \u3635 \u3595 \u3657 \u3635 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3607 \u3637 \u3656  2<br>\u3586 . \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3607 \u3637 \u3656  4<br>\u3588 . \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3607 \u3637 \u3656  6<br>\u3591 . \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3607 \u3637 \u3656  7</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3607 \u3637 \u3656  4</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  1 (\u3627 \u3609 \u3657 \u3634  38) \u3594 \u3639 \u3656 \u3629 \u3586 \u3629 \u3591 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3607 \u3637 \u3656  4 \u3588 \u3639 \u3629  "\u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3609 \u3657 \u3635 \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3605 \u3619 \u3651 \u3627 \u3657 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3617 \u3604 \u3640 \u3621 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3629 \u3640 \u3611 \u3626 \u3591 \u3588 \u3660 \u3649 \u3621 \u3632 \u3629 \u3640 \u3611 \u3607 \u3634 \u3609  \u3619 \u3623 \u3617 \u3607 \u3633 \u3657 \u3591 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3609 \u3657 \u3635 \u3595 \u3657 \u3635 "</div></div>\
\
    <div class="qb"><div class="q">64. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3607 \u3637 \u3656  9 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  1 (\u3648 \u3585 \u3625 \u3605 \u3619 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3626 \u3641 \u3591 ) \u3617 \u3637 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3651 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3600 \u3634 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3649 \u3621 \u3632 \u3588 \u3621 \u3633 \u3591 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3605 \u3619 \u3651 \u3627 \u3657 \u3617 \u3637 \u3621 \u3633 \u3585 \u3625 \u3603 \u3632 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3611 \u3655 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3621 \u3633 \u3610 \u3648 \u3593 \u3614 \u3634 \u3632 \u3586 \u3629 \u3591 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3619 \u3633 \u3600 <br>\u3586 . \u3651 \u3627 \u3657 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3618 \u3591 \u3585 \u3633 \u3609  \u3649 \u3621 \u3632 \u3648 \u3611 \u3655 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3648 \u3611 \u3636 \u3604  (Open Data)<br>\u3588 . \u3648 \u3609 \u3657 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591 \u3648 \u3611 \u3655 \u3609 \u3627 \u3621 \u3633 \u3585 <br>\u3591 . \u3592 \u3633 \u3604 \u3648 \u3585 \u3655 \u3610 \u3651 \u3609 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3648 \u3614 \u3639 \u3656 \u3629 \u3588 \u3623 \u3634 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3651 \u3627 \u3657 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3618 \u3591 \u3585 \u3633 \u3609  \u3649 \u3621 \u3632 \u3648 \u3611 \u3655 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3648 \u3611 \u3636 \u3604  (Open Data)</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  1 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  9.1 (\u3627 \u3609 \u3657 \u3634  40) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3588 \u3621 \u3633 \u3591 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3604 \u3657 \u3634 \u3609 \u3648 \u3585 \u3625 \u3605 \u3619 \u3651 \u3627 \u3657 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3650 \u3618 \u3591 \u3585 \u3633 \u3609  \u3649 \u3621 \u3632 \u3648 \u3611 \u3655 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3648 \u3611 \u3636 \u3604 " \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3609 \u3635 \u3652 \u3611 \u3651 \u3594 \u3657 \u3591 \u3634 \u3609 \u3605 \u3656 \u3629 \u3618 \u3629 \u3604 \u3652 \u3604 \u3657 </div></div>\
\
    <div class="qb"><div class="q">65. \uc0\u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2 (\u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 ) \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.1 \u3617 \u3640 \u3656 \u3591 \u3614 \u3633 \u3602 \u3609 \u3634 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3605 \u3634 \u3617 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3650 \u3617 \u3648 \u3604 \u3621 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3619 \u3619 \u3588 \u3660 <br>\u3586 . \u3650 \u3617 \u3648 \u3604 \u3621 \u3629 \u3634 \u3619 \u3617 \u3603 \u3660 \u3604 \u3637 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3640 \u3586 <br>\u3588 . \u3650 \u3617 \u3648 \u3604 \u3621 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3648 \u3594 \u3636 \u3591 \u3611 \u3619 \u3636 \u3617 \u3634 \u3603 <br>\u3591 . \u3650 \u3617 \u3648 \u3604 \u3621 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3649 \u3610 \u3610 \u3627 \u3619 \u3641 \u3627 \u3619 \u3634 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3650 \u3617 \u3648 \u3604 \u3621 \u3629 \u3634 \u3619 \u3617 \u3603 \u3660 \u3604 \u3637 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3640 \u3586 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3656 \u3637  1.1 (\u3627 \u3609 \u3657 \u3634  46) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3614 \u3633 \u3602 \u3609 \u3634 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3605 \u3634 \u3617 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3650 \u3617 \u3648 \u3604 \u3621 \u3629 \u3634 \u3619 \u3617 \u3603 \u3660 \u3604 \u3637 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3640 \u3586  \u3651 \u3609 \u3649 \u3612 \u3609 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3604 \u3657 \u3634 \u3609 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 "</div></div>\
\
    <div class="qb"><div class="q">66. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  2.1 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3651 \u3627 \u3657 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3649 \u3621 \u3632 \u3626 \u3605 \u3634 \u3619 \u3660 \u3607 \u3629 \u3633 \u3614 \u3611 \u3619 \u3632 \u3618 \u3640 \u3585 \u3605 \u3660 \u3651 \u3594 \u3657 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3651 \u3604 \u3651 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3656 \u3636 \u3617 \u3651 \u3627 \u3657 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3619 \u3619 \u3588 \u3660  \u3648 \u3629 \u3585 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3607 \u3634 \u3591 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617  \u3649 \u3621 \u3632 \u3595 \u3629 \u3615 \u3605 \u3660 \u3614 \u3634 \u3623 \u3648 \u3623 \u3629 \u3619 \u3660 <br>\u3586 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3605 \u3657 \u3609 \u3607 \u3640 \u3609 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3604 \u3657 \u3634 \u3609 \u3619 \u3634 \u3588 \u3634 <br>\u3588 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3649 \u3627 \u3621 \u3656 \u3591 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656 <br>\u3591 . \u3585 \u3634 \u3619 \u3614 \u3638 \u3656 \u3591 \u3614 \u3634 \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3592 \u3634 \u3585 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3619 \u3619 \u3588 \u3660  \u3648 \u3629 \u3585 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3607 \u3634 \u3591 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617  \u3649 \u3621 \u3632 \u3595 \u3629 \u3615 \u3605 \u3660 \u3614 \u3634 \u3623 \u3648 \u3623 \u3629 \u3619 \u3660 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  2.1 (\u3627 \u3609 \u3657 \u3634  46) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3651 \u3627 \u3657 \u3612 \u3641  \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619  \u3649 \u3621 \u3632 \u3626 \u3605 \u3634 \u3619 \u3660 \u3607 \u3629 \u3633 \u3614  \u3611 \u3619 \u3632 \u3618 \u3640 \u3585 \u3605 \u3660 \u3651 \u3594 \u3657 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3619 \u3619 \u3588 \u3660  \u3648 \u3629 \u3585 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3607 \u3634 \u3591 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617  \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637  \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 ... \u3619 \u3623 \u3617 \u3607 \u3633 \u3657 \u3591 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3595 \u3629 \u3615 \u3605 \u3660 \u3614 \u3634 \u3623 \u3648 \u3623 \u3629 \u3619 \u3660 \u3648 \u3611 \u3655 \u3609 \u3605 \u3633 \u3623 \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 "</div></div>\
\
    <div class="qb"><div class="q">67. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  3.3 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2 \u3648 \u3626 \u3609 \u3629 \u3651 \u3627 \u3657 \u3617 \u3637 \u3585 \u3634 \u3619 \u3648 \u3585 \u3655 \u3610 \u3588 \u3656 \u3634 \u3608 \u3619 \u3619 \u3617 \u3648 \u3609 \u3637 \u3618 \u3617 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3648 \u3586 \u3657 \u3634 \u3585 \u3629 \u3591 \u3607 \u3640 \u3609 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3629 \u3591 \u3607 \u3640 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3585 \u3637 \u3628 \u3634 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636 <br>\u3586 . \u3585 \u3629 \u3591 \u3607 \u3640 \u3609 \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3652 \u3607 \u3618 <br>\u3588 . \u3585 \u3629 \u3591 \u3607 \u3640 \u3609 \u3629 \u3609 \u3640 \u3619 \u3633 \u3585 \u3625 \u3660 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 <br>\u3591 . \u3585 \u3629 \u3591 \u3607 \u3640 \u3609 \u3615 \u3657 \u3639 \u3609 \u3615 \u3641 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3629 \u3591 \u3607 \u3640 \u3609 \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3652 \u3607 \u3618 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  3.3 (\u3627 \u3609 \u3657 \u3634  47) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3651 \u3627 \u3657 \u3617 \u3637 \u3585 \u3634 \u3619 \u3648 \u3585 \u3655 \u3610 \u3588 \u3656 \u3634 \u3608 \u3619 \u3619 \u3617 \u3648 \u3609 \u3637 \u3618 \u3617 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3648 \u3586 \u3657 \u3634  \'93\u3585 \u3629 \u3591 \u3607 \u3640 \u3609 \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3652 \u3607 \u3618 \'94"</div></div>\
\
    <div class="qb"><div class="q">68. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  5.2 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3611 \u3619 \u3640 \u3591 \u3586 \u3657 \u3629 \u3592 \u3635 \u3585 \u3633 \u3604 \u3586 \u3629 \u3591 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3649 \u3621 \u3632 \u3621 \u3604 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3629 \u3640 \u3611 \u3626 \u3619 \u3619 \u3588 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3607 \u3635 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592  \u3650 \u3604 \u3618 \u3648 \u3593 \u3614 \u3634 \u3632 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3611 \u3619 \u3632 \u3648 \u3616 \u3607 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3609 \u3635 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3649 \u3621 \u3632 \u3617 \u3633 \u3588 \u3588 \u3640 \u3648 \u3607 \u3624 \u3585 \u3660 <br>\u3586 . \u3607 \u3637 \u3656 \u3614 \u3633 \u3585 \u3649 \u3619 \u3617  \u3649 \u3621 \u3632 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3629 \u3656 \u3639 \u3609 \u3607 \u3637 \u3656 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3586 \u3657 \u3629 \u3591 <br>\u3588 . \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3619 \u3657 \u3634 \u3609 \u3629 \u3634 \u3627 \u3634 \u3619 \u3649 \u3621 \u3632 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3604 \u3639 \u3656 \u3617 <br>\u3591 . \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3585 \u3634 \u3619 \u3610 \u3636 \u3609 \u3649 \u3621 \u3632 \u3586 \u3609 \u3626 \u3656 \u3591 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3607 \u3637 \u3656 \u3614 \u3633 \u3585 \u3649 \u3619 \u3617  \u3649 \u3621 \u3632 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3629 \u3656 \u3639 \u3609 \u3607 \u3637 \u3656 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3586 \u3657 \u3629 \u3591 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  5.2 (\u3627 \u3609 \u3657 \u3634  48) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3611 \u3619 \u3633 \u3610 \u3611 \u3619 \u3640 \u3591 \u3586 \u3657 \u3629 \u3592 \u3635 \u3585 \u3633 \u3604 \u3586 \u3629 \u3591 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618  \u3621 \u3604 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3607 \u3637 \u3656 \u3621 \u3657 \u3634 \u3626 \u3617 \u3633 \u3618 \u3649 \u3621 \u3632 \u3648 \u3611 \u3655 \u3609 \u3629 \u3640 \u3611 \u3626 \u3619 \u3619 \u3588 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3607 \u3635 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 ... \u3650 \u3604 \u3618 \u3648 \u3593 \u3614 \u3634 \u3632 \u3607 \u3637 \u3656 \u3614 \u3633 \u3585 \u3649 \u3619 \u3617  \u3649 \u3621 \u3632 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3629 \u3639 \u3656 \u3609 \u3607 \u3637 \u3656 \u3648 \u3585 \u3656 \u3637 \u3618 \u3623 \u3586 \u3657 \u3629 \u3591 "</div></div>\
\
    <div class="qb"><div class="q">69. \uc0\u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  3 (\u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3652 \u3615 \u3615 \u3657 \u3634 ) \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.1 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3592 \u3641 \u3591 \u3651 \u3592 \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3652 \u3615 \u3615 \u3657 \u3634  \u3586 \u3657 \u3629 \u3651 \u3604  \u3652 \u3617 \u3656 \u3651 \u3594 \u3656  \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3619 \u3632 \u3610 \u3640 \u3652 \u3623 \u3657 </div>\
    <div class="c">\uc0\u3585 . \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3607 \u3634 \u3591 \u3604 \u3657 \u3634 \u3609 \u3616 \u3634 \u3625 \u3637  (\u3648 \u3594 \u3656 \u3609  \u3616 \u3634 \u3625 \u3637 \u3626 \u3619 \u3619 \u3614 \u3626 \u3634 \u3617 \u3636 \u3605 )<br>\u3586 . \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3652 \u3617 \u3637 \u3651 \u3594 \u3656 \u3616 \u3634 \u3625 \u3637  (\u3648 \u3594 \u3656 \u3609  \u3607 \u3637 \u3656 \u3592 \u3629 \u3604 \u3615 \u3619 \u3637 )<br>\u3588 . \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3648 \u3591 \u3636 \u3609 \u3629 \u3640 \u3604 \u3627 \u3609 \u3640 \u3609 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3585 \u3634 \u3619 \u3595 \u3639 \u3657 \u3629 \u3619 \u3606 \u3618 \u3609 \u3605 \u3660 \u3652 \u3615 \u3615 \u3657 \u3634 <br>\u3591 . \u3585 \u3634 \u3619 \u3649 \u3592 \u3585 \u3626 \u3606 \u3634 \u3609 \u3637 \u3594 \u3634 \u3619 \u3660 \u3592 \u3626 \u3656 \u3623 \u3609 \u3605 \u3633 \u3623 \u3615 \u3619 \u3637 \u3607 \u3640 \u3585 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3591 . \u3585 \u3634 \u3619 \u3649 \u3592 \u3585 \u3626 \u3606 \u3634 \u3609 \u3637 \u3594 \u3634 \u3619 \u3660 \u3592 \u3626 \u3656 \u3623 \u3609 \u3605 \u3633 \u3623 \u3615 \u3619 \u3637 \u3607 \u3640 \u3585 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  3 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.1 (\u3627 \u3609 \u3657 \u3634  55) \u3619 \u3632 \u3610 \u3640 \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3592 \u3641 \u3591 \u3651 \u3592 \u3652 \u3623 \u3657  3 \u3611 \u3619 \u3632 \u3648 \u3616 \u3607  \u3588 \u3639 \u3629  1) \u3616 \u3634 \u3625 \u3637  (\u3648 \u3594 \u3656 \u3609  \u3616 \u3634 \u3625 \u3637 \u3626 \u3619 \u3619 \u3614 \u3626 \u3634 \u3617 \u3636 \u3605 ) 2) \u3652 \u3617 \u3656 \u3651 \u3594 \u3656 \u3616 \u3634 \u3625 \u3637  (\u3648 \u3594 \u3656 \u3609  \u3607 \u3637 \u3656 \u3592 \u3629 \u3604 \u3615 \u3619 \u3637  \u3626 \u3656 \u3623 \u3609 \u3621 \u3604 \u3588 \u3656 \u3634 \u3652 \u3615 ) \u3649 \u3621 \u3632  3) \u3648 \u3591 \u3636 \u3609 \u3629 \u3640 \u3604 \u3627 \u3609 \u3640 \u3609  \u3649 \u3605 \u3656 \u3652 \u3617 \u3656 \u3652 \u3604 \u3657 \u3619 \u3632 \u3610 \u3640 \u3606 \u3638 \u3591 \u3585 \u3634 \u3619 \u3649 \u3592 \u3585 \u3626 \u3606 \u3634 \u3609 \u3637 \u3594 \u3634 \u3619 \u3660 \u3592 \u3615 \u3619 \u3637 </div></div>\
\
    <div class="qb"><div class="q">70. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.3 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  3 \u3651 \u3627 \u3657 \u3585 \u3634 \u3619 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3651 \u3609 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3595 \u3639 \u3657 \u3629 \u3619 \u3606 \u3618 \u3609 \u3605 \u3660 \u3626 \u3633 \u3609 \u3604 \u3634 \u3611 \u3616 \u3634 \u3618 \u3651 \u3609 \u3619 \u3640 \u3656 \u3609 \u3651 \u3627 \u3617 \u3656 <br>\u3586 . \u3585 \u3634 \u3619 \u3604 \u3633 \u3604 \u3649 \u3611 \u3621 \u3591 \u3619 \u3606 \u3618 \u3609 \u3605 \u3660 \u3648 \u3585 \u3656 \u3634 \u3648 \u3611 \u3655 \u3609 \u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3652 \u3615 \u3615 \u3657 \u3634 \u3604 \u3633 \u3604 \u3649 \u3611 \u3621 \u3591 <br>\u3588 . \u3585 \u3634 \u3619 \u3609 \u3635 \u3648 \u3586 \u3657 \u3634 \u3619 \u3606 \u3618 \u3609 \u3605 \u3660 \u3652 \u3615 \u3615 \u3657 \u3634 \u3617 \u3639 \u3629 \u3626 \u3629 \u3591 <br>\u3591 . \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3586 \u3609 \u3626 \u3656 \u3591 \u3626 \u3634 \u3608 \u3634 \u3619 \u3603 \u3632 \u3607 \u3637 \u3656 \u3651 \u3594 \u3657 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3615 \u3629 \u3626 \u3595 \u3636 \u3621 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3604 \u3633 \u3604 \u3649 \u3611 \u3621 \u3591 \u3619 \u3606 \u3618 \u3609 \u3605 \u3660 \u3648 \u3585 \u3656 \u3634 \u3648 \u3611 \u3655 \u3609 \u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3652 \u3615 \u3615 \u3657 \u3634 \u3604 \u3633 \u3604 \u3649 \u3611 \u3621 \u3591 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  3 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3656 \u3637  1.3 (\u3627 \u3609 \u3657 \u3634  55) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3604 \u3633 \u3604 \u3649 \u3611 \u3621 \u3591 \u3619 \u3606 \u3618 \u3609 \u3605 \u3660 \u3648 \u3585 \u3656 \u3634 \u3648 \u3611 \u3655 \u3609 \u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3652 \u3615 \u3615 \u3657 \u3634 \u3604 \u3633 \u3604 \u3649 \u3611 \u3621 \u3591 "</div></div>\
\
    <div class="qb"><div class="q">71. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637  \u3656  3.3 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637  \u3656  3 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3600 \u3634 \u3609 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3594 \u3636  \u3657 \u3609 \u3626 \u3656 \u3623 \u3609 \u3626 \u3635 \u3588 \u3633 \u3597 \u3651 \u3604  \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
    <div class="c">\uc0\u3585 . \u3649 \u3610 \u3605 \u3648 \u3605 \u3629 \u3619 \u3637 \u3656 <br>\u3586 . \u3618 \u3634 \u3591 \u3619 \u3606 \u3618 \u3609 \u3605 \u3660 <br>\u3588 . \u3605 \u3633 \u3623 \u3606 \u3633 \u3591 \u3619 \u3606 \u3618 \u3609 \u3605 \u3660 <br>\u3591 . \u3585 \u3619 \u3632 \u3592 \u3585 \u3619 \u3606 \u3618 \u3609 \u3605 \u3660 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3649 \u3610 \u3605 \u3648 \u3605 \u3629 \u3619 \u3637 \u3656 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  3 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  3.3 (\u3627 \u3609 \u3657 \u3634  55) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3600 \u3634 \u3609 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3649 \u3610 \u3605 \u3648 \u3605 \u3629 \u3619 \u3637 \u3656  \u3619 \u3623 \u3617 \u3606 \u3638 \u3591 \u3594 \u3636 \u3657 \u3609 \u3626 \u3656 \u3623 \u3609 \u3626 \u3635 \u3588 \u3633 \u3597 \u3616 \u3634 \u3618 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 "</div></div>\
\
    <div class="qb"><div class="q">72. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  10.4 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  3 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3605 \u3656 \u3629 \u3618 \u3629 \u3604 \u3624 \u3641 \u3609 \u3618 \u3660 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3624 \u3641 \u3609 \u3618 \u3660 \u3609 \u3634 \u3650 \u3609 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636 <br>\u3586 . \u3624 \u3641 \u3609 \u3618 \u3660 \u3607 \u3604 \u3626 \u3629 \u3610 \u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3649 \u3621 \u3632 \u3618 \u3634 \u3591 \u3621 \u3657 \u3629 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636 <br>\u3588 . \u3624 \u3641 \u3609 \u3618 \u3660 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660 \u3649 \u3621 \u3632 \u3588 \u3629 \u3617 \u3614 \u3636 \u3623 \u3648 \u3605 \u3629 \u3619 \u3660 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636 <br>\u3591 . \u3624 \u3641 \u3609 \u3618 \u3660 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3624 \u3641 \u3609 \u3618 \u3660 \u3607 \u3604 \u3626 \u3629 \u3610 \u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3649 \u3621 \u3632 \u3618 \u3634 \u3591 \u3621 \u3657 \u3629 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  3 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  10.4 (\u3627 \u3609 \u3657 \u3634  58) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3605 \u3656 \u3629 \u3618 \u3629 \u3604 \u3624 \u3641 \u3609 \u3618 \u3660 \u3607 \u3604 \u3626 \u3629 \u3610 \u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3649 \u3621 \u3632 \u3618 \u3634 \u3591 \u3621 \u3657 \u3629 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636  \u3651 \u3609 \u3585 \u3634 \u3619 \u3607 \u3604 \u3626 \u3629 \u3610 \u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3652 \u3615 \u3615 \u3657 \u3634 \u3649 \u3621 \u3632 \u3594 \u3636 \u3657 \u3609 \u3626 \u3656 \u3623 \u3609 "</div></div>\
\
    <div class="qb"><div class="q">73. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.1 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  4 (\u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 ) \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3651 \u3627 \u3657 \u3616 \u3634 \u3588 \u3648 \u3629 \u3585 \u3594 \u3609 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \u3610 \u3609 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609 \u3586 \u3629 \u3591 \u3626 \u3636 \u3656 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \u3649 \u3612 \u3609 \u3652 \u3607 \u3618 \u3649 \u3621 \u3632 \u3626 \u3617 \u3640 \u3609 \u3652 \u3614 \u3619 <br>\u3586 . \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3586 \u3633 \u3657 \u3609 \u3626 \u3641 \u3591 <br>\u3588 . \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3619 \u3634 \u3588 \u3634 \u3611 \u3619 \u3632 \u3627 \u3618 \u3633 \u3604 <br>\u3591 . \u3585 \u3634 \u3619 \u3648 \u3609 \u3657 \u3609 \u3619 \u3633 \u3610 \u3612 \u3641 \u3657 \u3611 \u3656 \u3623 \u3618 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3586 \u3633 \u3657 \u3609 \u3626 \u3641 \u3591 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  4 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.1 (\u3627 \u3609 \u3657 \u3634  64) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3651 \u3627 \u3657 \u3616 \u3634 \u3588 \u3648 \u3629 \u3585 \u3594 \u3609 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \u3610 \u3609 \u3600 \u3634 \u3609 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3586 \u3633 \u3657 \u3609 \u3626 \u3641 \u3591 "</div></div>\
\
    <div class="qb"><div class="q">74. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  2.1 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  4 \u3617 \u3640 \u3656 \u3591 \u3614 \u3633 \u3602 \u3609 \u3634 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3651 \u3609 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3648 \u3614 \u3639 \u3656 \u3629 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614 \u3610 \u3609 \u3600 \u3634 \u3609 \u3586 \u3629 \u3591 \u3626 \u3636 \u3656 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3588 \u3623 \u3634 \u3617 \u3650 \u3604 \u3604 \u3648 \u3604 \u3656 \u3609 \u3586 \u3629 \u3591 \u3648 \u3629 \u3585 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3652 \u3607 \u3618 <br>\u3586 . \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \u3592 \u3634 \u3585 \u3605 \u3632 \u3623 \u3633 \u3609 \u3605 \u3585 <br>\u3588 . \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3604 \u3657 \u3634 \u3609 \u3619 \u3634 \u3588 \u3634 <br>\u3591 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3650 \u3619 \u3591 \u3614 \u3618 \u3634 \u3610 \u3634 \u3621 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3588 \u3623 \u3634 \u3617 \u3650 \u3604 \u3604 \u3648 \u3604 \u3656 \u3609 \u3586 \u3629 \u3591 \u3648 \u3629 \u3585 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3652 \u3607 \u3618 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  4 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3656 \u3637  2.1 (\u3627 \u3609 \u3657 \u3634  64) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3614 \u3633 \u3602 \u3609 \u3634 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3651 \u3609 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614 \u3610 \u3609 \u3600 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3650 \u3604 \u3604 \u3648 \u3604 \u3656 \u3609 \u3586 \u3629 \u3591 \u3648 \u3629 \u3585 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3652 \u3607 \u3618 "</div></div>\
\
    <div class="qb"><div class="q">75. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  3.4 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  4 \u3617 \u3640 \u3656 \u3591 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3609 \u3635 \u3648 \u3586 \u3657 \u3634 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 <br>\u3586 . \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3648 \u3594 \u3636 \u3591 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 <br>\u3588 . \u3585 \u3634 \u3619 \u3595 \u3639 \u3657 \u3629 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3607 \u3637 \u3656 \u3612 \u3621 \u3636 \u3605 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3591 . \u3585 \u3634 \u3619 \u3649 \u3611 \u3619 \u3619 \u3641 \u3611 \u3619 \u3633 \u3600 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3604 \u3657 \u3634 \u3609 \u3626 \u3634 \u3608 \u3634 \u3619 \u3603 \u3626 \u3640 \u3586 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3585 \u3634 \u3619 \u3595 \u3639 \u3657 \u3629 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3607 \u3637 \u3656 \u3612 \u3621 \u3636 \u3605 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  4 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  3.4 (\u3627 \u3609 \u3657 \u3634  66) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3585 \u3634 \u3619 \u3595 \u3639 \u3657 \u3629 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3607 \u3637 \u3656 \u3612 \u3621 \u3636 \u3605 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 "</div></div>\
\
    <div class="qb"><div class="q">76. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  5.3 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  4 \u3617 \u3640 \u3656 \u3591 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3651 \u3604 \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 </div>\
    <div class="c">\uc0\u3585 . \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3586 \u3609 \u3626 \u3656 \u3591 \u3612 \u3641 \u3657 \u3611 \u3656 \u3623 \u3618 \u3593 \u3640 \u3585 \u3648 \u3593 \u3636 \u3609 <br>\u3586 . \u3619 \u3632 \u3610 \u3610 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3649 \u3621 \u3632 \u3626 \u3634 \u3619 \u3626 \u3609 \u3648 \u3607 \u3624 <br>\u3588 . \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 <br>\u3591 . \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3648 \u3610 \u3636 \u3585 \u3592 \u3656 \u3634 \u3618 \u3611 \u3619 \u3632 \u3585 \u3633 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3619 \u3632 \u3610 \u3610 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3649 \u3621 \u3632 \u3626 \u3634 \u3619 \u3626 \u3609 \u3648 \u3607 \u3624 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  4 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  5.3 (\u3627 \u3609 \u3657 \u3634  68) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3649 \u3621 \u3632 \u3626 \u3634 \u3619 \u3626 \u3609 \u3648 \u3607 \u3624 \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 "</div></div>\
\
    <div class="qb"><div class="q">77. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.3 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  5 (\u3611 \u3619 \u3632 \u3605 \u3641 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 ) \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3612 \u3621 \u3633 \u3585 \u3604 \u3633 \u3609 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3592 \u3634 \u3585 \u3585 \u3619 \u3629 \u3610 \u3588 \u3623 \u3634 \u3617 \u3605 \u3585 \u3621 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3619 \u3629 \u3610 \u3588 \u3623 \u3634 \u3617 \u3605 \u3585 \u3621 \u3591 \u3648 \u3586 \u3605 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 \u3648 \u3626 \u3619 \u3637  (FTA)<br>\u3586 . \u3585 \u3619 \u3629 \u3610 \u3629 \u3609 \u3640 \u3626 \u3633 \u3597 \u3597 \u3634 \u3626 \u3627 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3634 \u3605 \u3636 \u3623 \u3656 \u3634 \u3604 \u3657 \u3623 \u3618 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3626 \u3616 \u3634 \u3614 \u3616 \u3641 \u3617 \u3636 \u3629 \u3634 \u3585 \u3634 \u3624 <br>\u3588 . \u3585 \u3619 \u3629 \u3610 \u3588 \u3623 \u3634 \u3617 \u3619 \u3656 \u3623 \u3617 \u3617 \u3639 \u3629 \u3629 \u3591 \u3588 \u3660 \u3585 \u3634 \u3619 \u3629 \u3609 \u3634 \u3617 \u3633 \u3618 \u3650 \u3621 \u3585 <br>\u3591 . \u3585 \u3619 \u3629 \u3610 \u3588 \u3623 \u3634 \u3617 \u3619 \u3656 \u3623 \u3617 \u3617 \u3639 \u3629 \u3604 \u3657 \u3634 \u3609 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617 \u3618 \u3641 \u3648 \u3609 \u3626 \u3650 \u3585 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3619 \u3629 \u3610 \u3588 \u3623 \u3634 \u3617 \u3605 \u3585 \u3621 \u3591 \u3648 \u3586 \u3605 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 \u3648 \u3626 \u3619 \u3637  (FTA)</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  5 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.3 (\u3627 \u3609 \u3657 \u3634  75) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3612 \u3621 \u3633 \u3585 \u3604 \u3633 \u3609 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3592 \u3634 \u3585 \u3585 \u3619 \u3629 \u3610 \u3588 \u3623 \u3634 \u3617 \u3605 \u3585 \u3621 \u3591 \u3648 \u3586 \u3605 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 \u3648 \u3626 \u3619 \u3637 \u3607 \u3637 \u3656 \u3617 \u3637 \u3629 \u3618 \u3641 \u3656  \u3649 \u3621 \u3632 \u3648 \u3614 \u3636 \u3656 \u3617 \u3648 \u3605 \u3636 \u3617 \u3585 \u3619 \u3629 \u3610 \u3588 \u3623 \u3634 \u3617 \u3605 \u3585 \u3621 \u3591 \u3648 \u3586 \u3605 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 \u3648 \u3626 \u3619 \u3637 \u3607 \u3637 \u3656 \u3626 \u3635 \u3588 \u3633 \u3597 "</div></div>\
\
    <div class="qb"><div class="q">78. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  2.3 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  5 \u3651 \u3627 \u3657 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3586 \u3609 \u3626 \u3656 \u3591 \u3619 \u3632 \u3610 \u3610 \u3651 \u3604 \u3648 \u3611 \u3655 \u3609 \u3614 \u3636 \u3648 \u3624 \u3625  \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3650 \u3588 \u3619 \u3591 \u3586 \u3656 \u3634 \u3618 \u3627 \u3621 \u3633 \u3585 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3586 \u3609 \u3626 \u3656 \u3591 \u3607 \u3634 \u3591 \u3629 \u3634 \u3585 \u3634 \u3624 <br>\u3586 . \u3585 \u3634 \u3619 \u3586 \u3609 \u3626 \u3656 \u3591 \u3607 \u3634 \u3591 \u3606 \u3609 \u3609 <br>\u3588 . \u3585 \u3634 \u3619 \u3586 \u3609 \u3626 \u3656 \u3591 \u3619 \u3632 \u3610 \u3610 \u3619 \u3634 \u3591 <br>\u3591 . \u3585 \u3634 \u3619 \u3586 \u3609 \u3626 \u3656 \u3591 \u3607 \u3634 \u3591 \u3621 \u3635 \u3609 \u3657 \u3635 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3585 \u3634 \u3619 \u3586 \u3609 \u3626 \u3656 \u3591 \u3619 \u3632 \u3610 \u3610 \u3619 \u3634 \u3591 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  5 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  2.3 (\u3627 \u3609 \u3657 \u3634  76) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3651 \u3627 \u3657 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3586 \u3609 \u3626 \u3656 \u3591 \u3619 \u3632 \u3610 \u3610 \u3619 \u3634 \u3591 \u3629 \u3618 \u3656 \u3634 \u3591 \u3605 \u3656 \u3629 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591  \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3650 \u3588 \u3619 \u3591 \u3586 \u3656 \u3634 \u3618 \u3585 \u3634 \u3619 \u3586 \u3609 \u3626 \u3656 \u3591 \u3627 \u3621 \u3633 \u3585 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 "</div></div>\
\
    <div class="qb"><div class="q">79. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  3.2 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  5 \u3648 \u3626 \u3609 \u3629 \u3651 \u3627 \u3657 \u3611 \u3619 \u3633 \u3610 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3616 \u3634 \u3588 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  \u3610 \u3619 \u3636 \u3585 \u3634 \u3619  \u3649 \u3621 \u3632 \u3650 \u3621 \u3592 \u3636 \u3626 \u3605 \u3636 \u3585 \u3626 \u3660  \u3650 \u3604 \u3618 \u3609 \u3635 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3651 \u3604 \u3617 \u3634 \u3651 \u3594 \u3657 \u3648 \u3611 \u3655 \u3609 \u3617 \u3634 \u3605 \u3619 \u3600 \u3634 \u3609 </div>\
    <div class="c">\uc0\u3585 . \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3627 \u3617 \u3640 \u3609 \u3648 \u3623 \u3637 \u3618 \u3609  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3637 \u3648 \u3586 \u3637 \u3618 \u3623  (BCG)<br>\u3586 . \u3617 \u3634 \u3605 \u3619 \u3600 \u3634 \u3609 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3649 \u3610 \u3610 \u3621 \u3637 \u3609  (Lean Manufacturing)<br>\u3588 . \u3617 \u3634 \u3605 \u3619 \u3600 \u3634 \u3609  ISO 9001<br>\u3591 . \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  4.0</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3627 \u3617 \u3640 \u3609 \u3648 \u3623 \u3637 \u3618 \u3609  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3637 \u3648 \u3586 \u3637 \u3618 \u3623  (BCG)</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  5 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  3.2 (\u3627 \u3609 \u3657 \u3634  77) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3611 \u3619 \u3633 \u3610 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3616 \u3634 \u3588 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  \u3616 \u3634 \u3588 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619  \u3649 \u3621 \u3632 \u3650 \u3621 \u3592 \u3636 \u3626 \u3605 \u3636 \u3585 \u3626 \u3660  \u3650 \u3604 \u3618 \u3609 \u3635 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3627 \u3617 \u3640 \u3609 \u3648 \u3623 \u3637 \u3618 \u3609  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3637 \u3648 \u3586 \u3637 \u3618 \u3623  \u3617 \u3634 \u3651 \u3594 \u3657 \u3648 \u3611 \u3655 \u3609 \u3617 \u3634 \u3605 \u3619 \u3600 \u3634 \u3609 "</div></div>\
\
    <div class="qb"><div class="q">80. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.1 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  6 (\u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 ) \u3617 \u3640 \u3656 \u3591 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3626 \u3636 \u3656 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3607 \u3637 \u3656 \u3617 \u3637 \u3586 \u3609 \u3634 \u3604 \u3648 \u3621 \u3655 \u3585 \u3621 \u3591 <br>\u3586 . \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3648 \u3605 \u3655 \u3617 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 <br>\u3588 . \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3607 \u3637 \u3656 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3649 \u3611 \u3619 \u3619 \u3641 \u3611 <br>\u3591 . \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3607 \u3637 \u3656 \u3648 \u3609 \u3657 \u3609 \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3648 \u3605 \u3655 \u3617 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  6 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.1 (\u3627 \u3609 \u3657 \u3634  82) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3649 \u3621 \u3632 \u3649 \u3614 \u3621 \u3605 \u3615 \u3629 \u3619 \u3660 \u3617 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621  \u3648 \u3614 \u3639 \u3656 \u3629 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3648 \u3605 \u3655 \u3617 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 "</div></div>\
\
    <div class="qb"><div class="q">81. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637  \u3656  2.1 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637  \u3656  6 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3651 \u3627 \u3657 \u3612 \u3641  \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3651 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3652 \u3615 \u3615 \u3657 \u3634 \u3649 \u3621 \u3632 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660  \u3614 \u3633 \u3602 \u3609 \u3634 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3592 \u3634 \u3585 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3585 \u3634 \u3619 \u3619 \u3633 \u3610 \u3592 \u3657 \u3634 \u3591 \u3612 \u3621 \u3636 \u3605  (OEM) \u3652 \u3611 \u3626 \u3641 \u3656 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3594 \u3657 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3648 \u3607 \u3656 \u3634 \u3609 \u3633 \u3657 \u3609 <br>\u3586 . \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3607 \u3637 \u3656 \u3617 \u3637 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3626 \u3641 \u3605 \u3619 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660  (ODM/OBM)<br>\u3588 . \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3649 \u3610 \u3610 \u3651 \u3594 \u3657 \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 \u3648 \u3586 \u3657 \u3617 \u3586 \u3657 \u3609 <br>\u3591 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3586 \u3609 \u3634 \u3604 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3621 \u3591 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3607 \u3637 \u3656 \u3617 \u3637 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3626 \u3641 \u3605 \u3619 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660  (ODM/OBM)</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  6 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637  \u3656  2.1 (\u3627 \u3609 \u3657 \u3634  82) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3651 \u3627 \u3657 \u3612 \u3641  \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 ... \u3614 \u3633 \u3602 \u3609 \u3634 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3592 \u3634 \u3585 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3585 \u3634 \u3619 \u3619 \u3633 \u3610 \u3592 \u3657 \u3634 \u3591 \u3612 \u3621 \u3636 \u3605 \u3605 \u3634 \u3617 \u3626 \u3641 \u3605 \u3619 \u3586 \u3629 \u3591 \u3621 \u3641 \u3585 \u3588 \u3657 \u3634  \u3652 \u3611 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3607 \u3637 \u3656 \u3617 \u3637 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3626 \u3641 \u3605 \u3619 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3648 \u3614 \u3656 \u3639 \u3629 \u3609 \u3635 \u3648 \u3626 \u3609 \u3629 \u3649 \u3585 \u3656 \u3621 \u3641 \u3585 \u3588 \u3657 \u3634 "</div></div>\
\
    <div class="qb"><div class="q">82. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  3.1 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  6 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3604 \u3638 \u3591 \u3604 \u3641 \u3604 \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3592 \u3634 \u3585 \u3585 \u3621 \u3640 \u3656 \u3617 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3604 \u3657 \u3634 \u3609 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656 \u3586 \u3629 \u3591 \u3650 \u3621 \u3585 <br>\u3586 . \u3609 \u3633 \u3585 \u3621 \u3591 \u3607 \u3640 \u3609 \u3619 \u3634 \u3618 \u3618 \u3656 \u3629 \u3618 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 <br>\u3588 . \u3585 \u3629 \u3591 \u3607 \u3640 \u3609 \u3610 \u3635 \u3648 \u3627 \u3609 \u3655 \u3592 \u3610 \u3635 \u3609 \u3634 \u3597 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 <br>\u3591 . \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3594 \u3640 \u3617 \u3594 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3604 \u3657 \u3634 \u3609 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656 \u3586 \u3629 \u3591 \u3650 \u3621 \u3585 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  6 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  3.1 (\u3627 \u3609 \u3657 \u3634  83) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3604 \u3638 \u3591 \u3604 \u3641 \u3604 \u3651 \u3627 \u3657 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3604 \u3657 \u3634 \u3609 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656 \u3586 \u3629 \u3591 \u3650 \u3621 \u3585 \u3621 \u3591 \u3607 \u3640 \u3609 \u3651 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3607 \u3637 \u3656 \u3592 \u3632 \u3648 \u3629 \u3657 \u3639 \u3629 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3605 \u3656 \u3629 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3652 \u3607 \u3618 "</div></div>\
\
    <div class="qb"><div class="q">83. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  4.2 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  6 \u3617 \u3637 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3627 \u3621 \u3633 \u3585 \u3651 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3626 \u3636 \u3656 \u3591 \u3651 \u3604 \u3648 \u3614 \u3639 \u3656 \u3629 \u3619 \u3629 \u3591 \u3619 \u3633 \u3610 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3605 \u3633 \u3623 \u3607 \u3634 \u3591 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3585 \u3635 \u3621 \u3633 \u3591 \u3588 \u3609 <br>\u3586 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3627 \u3621 \u3656 \u3591 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 <br>\u3588 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3637 \u3656 \u3604 \u3636 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 <br>\u3591 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3626 \u3585 \u3640 \u3621 \u3648 \u3591 \u3636 \u3609 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3585 \u3635 \u3621 \u3633 \u3591 \u3588 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  6 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  4.2 (\u3627 \u3609 \u3657 \u3634  84) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3614 \u3633 \u3602 \u3609 \u3634 \u3585 \u3635 \u3621 \u3633 \u3591 \u3588 \u3609 \u3648 \u3614 \u3639 \u3656 \u3629 \u3619 \u3629 \u3591 \u3619 \u3633 \u3610 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3605 \u3633 \u3623 \u3607 \u3634 \u3591 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3651 \u3609 \u3629 \u3609 \u3634 \u3588 \u3605 "</div></div>\
\
    <div class="qb"><div class="q">84. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.1 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  7 (SME) \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3648 \u3619 \u3656 \u3591 \u3611 \u3619 \u3633 \u3610 \u3611 \u3619 \u3640 \u3591 \u3585 \u3598 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3629 \u3640 \u3611 \u3626 \u3619 \u3619 \u3588 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3604 \u3635 \u3648 \u3609 \u3636 \u3609 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592  \u3649 \u3621 \u3632 \u3626 \u3619 \u3657 \u3634 \u3591 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3626 \u3636 \u3656 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3612 \u3641 \u3585 \u3586 \u3634 \u3604 \u3650 \u3604 \u3618 \u3619 \u3634 \u3618 \u3651 \u3627 \u3597 \u3656 <br>\u3586 . \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617 <br>\u3588 . \u3585 \u3634 \u3619 \u3629 \u3640 \u3604 \u3627 \u3609 \u3640 \u3609 \u3592 \u3634 \u3585 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 <br>\u3591 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3616 \u3634 \u3625 \u3637 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  7 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.1 (\u3627 \u3609 \u3657 \u3634  91) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3648 \u3619 \u3656 \u3591 \u3611 \u3619 \u3633 \u3610 \u3611 \u3619 \u3640 \u3591 \u3585 \u3598 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3629 \u3640 \u3611 \u3626 \u3619 \u3619 \u3588 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3604 \u3635 \u3648 \u3609 \u3636 \u3609 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592  \u3649 \u3621 \u3632 \u3626 \u3619 \u3657 \u3634 \u3591 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617 "</div></div>\
\
    <div class="qb"><div class="q">85. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  2.1 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  7 \u3648 \u3626 \u3609 \u3629 \u3651 \u3627 \u3657 \u3617 \u3637 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3619 \u3632 \u3610 \u3610 \u3651 \u3604 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3586 \u3609 \u3634 \u3604 \u3585 \u3621 \u3634 \u3591 \u3649 \u3621 \u3632 \u3586 \u3609 \u3634 \u3604 \u3618 \u3656 \u3629 \u3617 </div>\
    <div class="c">\uc0\u3585 . \u3619 \u3632 \u3610 \u3610 \u3652 \u3629 \u3604 \u3637 \u3648 \u3604 \u3637 \u3618 \u3623  (Single ID)<br>\u3586 . \u3619 \u3632 \u3610 \u3610 \u3650 \u3588 \u3623 \u3605 \u3634 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 <br>\u3588 . \u3619 \u3632 \u3610 \u3610 \u3626 \u3627 \u3585 \u3619 \u3603 \u3660 \u3585 \u3621 \u3634 \u3591 <br>\u3591 . \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3588 \u3657 \u3635 \u3611 \u3619 \u3632 \u3585 \u3633 \u3609 \u3626 \u3636 \u3609 \u3648 \u3594 \u3639 \u3656 \u3629 \u3650 \u3604 \u3618 \u3619 \u3633 \u3600 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3619 \u3632 \u3610 \u3610 \u3652 \u3629 \u3604 \u3637 \u3648 \u3604 \u3637 \u3618 \u3623  (Single ID)</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  7 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  2.1 (\u3627 \u3609 \u3657 \u3634  91) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3592 \u3633 \u3604 \u3651 \u3627 \u3657 \u3617 \u3637 \u3619 \u3632 \u3610 \u3610 \u3652 \u3629 \u3604 \u3637 \u3648 \u3604 \u3637 \u3618 \u3623 \u3586 \u3629 \u3591 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3586 \u3609 \u3634 \u3604 \u3585 \u3621 \u3634 \u3591 \u3649 \u3621 \u3632 \u3586 \u3609 \u3634 \u3604 \u3618 \u3656 \u3629 \u3617 "</div></div>\
\
    <div class="qb"><div class="q">86. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637  \u3656  3.3 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637  \u3656  7 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657  SME \u3619 \u3632 \u3604 \u3617 \u3607 \u3640 \u3609 \u3612 \u3656 \u3634 \u3609 \u3649 \u3627 \u3621 \u3656 \u3591 \u3607 \u3640 \u3609 \u3607 \u3634 \u3591 \u3648 \u3621 \u3639 \u3629 \u3585 \u3651 \u3604  \u3609 \u3629 \u3585 \u3648 \u3627 \u3609 \u3639 \u3629 \u3592 \u3634 \u3585 \u3626 \u3636 \u3609 \u3648 \u3594 \u3639 \u3656 \u3629 \u3608 \u3609 \u3634 \u3588 \u3634 \u3619 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3585 \u3641 \u3657 \u3618 \u3639 \u3617 \u3648 \u3591 \u3636 \u3609 \u3609 \u3629 \u3585 \u3619 \u3632 \u3610 \u3610 <br>\u3586 . \u3605 \u3621 \u3634 \u3604 \u3607 \u3640 \u3609  (\u3648 \u3594 \u3656 \u3609  \u3605 \u3621 \u3634 \u3604  \u3648 \u3629 \u3655 \u3617  \u3648 \u3629  \u3652 \u3629 )<br>\u3588 . \u3585 \u3634 \u3619 \u3592 \u3635 \u3609 \u3629 \u3591 \u3607 \u3637 \u3656 \u3604 \u3636 \u3609 <br>\u3591 . \u3585 \u3634 \u3619 \u3586 \u3634 \u3618 \u3626 \u3636 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3660 \u3606 \u3634 \u3623 \u3619 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3605 \u3621 \u3634 \u3604 \u3607 \u3640 \u3609  (\u3648 \u3594 \u3656 \u3609  \u3605 \u3621 \u3634 \u3604  \u3648 \u3629 \u3655 \u3617  \u3648 \u3629  \u3652 \u3629 )</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  7 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  3.3 (\u3627 \u3609 \u3657 \u3634  92) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3586 \u3609 \u3634 \u3604 \u3585 \u3621 \u3634 \u3591 \u3649 \u3621 \u3632 \u3586 \u3609 \u3634 \u3604 \u3618 \u3656 \u3629 \u3617 \u3619 \u3632 \u3604 \u3617 \u3607 \u3640 \u3609 \u3612 \u3656 \u3634 \u3609 \u3605 \u3621 \u3634 \u3604 \u3607 \u3640 \u3609 ... \u3629 \u3634 \u3607 \u3636  \u3585 \u3634 \u3619 \u3619 \u3632 \u3604 \u3617 \u3607 \u3640 \u3609 \u3612 \u3656 \u3634 \u3609 \u3605 \u3621 \u3634 \u3604  \u3648 \u3629 \u3655 \u3617  \u3648 \u3629  \u3652 \u3629  (MAI)"</div></div>\
\
    <div class="qb"><div class="q">87. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3607 \u3637 \u3656  6 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  7 \u3617 \u3637 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3651 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3609 \u3636 \u3648 \u3623 \u3624 \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3611 \u3619 \u3632 \u3648 \u3616 \u3607 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3633 \u3591 \u3588 \u3617 <br>\u3586 . \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3588 \u3619 \u3629 \u3610 \u3588 \u3619 \u3633 \u3623 <br>\u3588 . \u3626 \u3605 \u3634 \u3619 \u3660 \u3607 \u3629 \u3633 \u3614  (Startup)<br>\u3591 . \u3619 \u3633 \u3600 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3626 \u3605 \u3634 \u3619 \u3660 \u3607 \u3629 \u3633 \u3614  (Startup)</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  7 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3607 \u3637 \u3656  6 (\u3627 \u3609 \u3657 \u3634  93) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3609 \u3636 \u3648 \u3623 \u3624 \u3651 \u3627 \u3657 \u3648 \u3629 \u3639 \u3657 \u3629 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3626 \u3605 \u3634 \u3619 \u3660 \u3607 \u3629 \u3633 \u3614 "</div></div>\
\
    <div class="qb"><div class="q">88. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.1 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  8 (\u3648 \u3617 \u3639 \u3629 \u3591 \u3609 \u3656 \u3634 \u3629 \u3618 \u3641 \u3656 ) \u3651 \u3594 \u3657 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3651 \u3604 \u3651 \u3609 \u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3592 \u3634 \u3618 \u3588 \u3623 \u3634 \u3617 \u3648 \u3592 \u3619 \u3636 \u3597 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3652 \u3611 \u3626 \u3641 \u3656 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3636 \u3648 \u3624 \u3625 <br>\u3586 . \u3585 \u3634 \u3619 \u3629 \u3640 \u3604 \u3627 \u3609 \u3640 \u3609 \u3616 \u3634 \u3588 \u3648 \u3585 \u3625 \u3605 \u3619 \u3651 \u3609 \u3594 \u3609 \u3610 \u3607 <br>\u3588 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3609 \u3636 \u3588 \u3617 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3651 \u3609 \u3585 \u3619 \u3640 \u3591 \u3648 \u3607 \u3614 \u3631 <br>\u3591 . \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3648 \u3594 \u3636 \u3591 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3636 \u3648 \u3624 \u3625 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  8 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.1 (\u3627 \u3609 \u3657 \u3634  99) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3614 \u3633 \u3602 \u3609 \u3634 \u3616 \u3634 \u3588 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3600 \u3634 \u3609 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3650 \u3604 \u3618 \u3651 \u3594 \u3657 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3616 \u3634 \u3588  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3636 \u3648 \u3624 \u3625 "</div></div>\
\
    <div class="qb"><div class="q">89. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  2.3 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  8 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3617 \u3639 \u3629 \u3591 \u3651 \u3609 \u3621 \u3633 \u3585 \u3625 \u3603 \u3632 \u3651 \u3604  \u3607 \u3637 \u3656 \u3614 \u3619 \u3657 \u3629 \u3617 \u3619 \u3633 \u3610 \u3617 \u3639 \u3629 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3649 \u3621 \u3632 \u3616 \u3633 \u3618 \u3614 \u3636 \u3610 \u3633 \u3605 \u3636 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3617 \u3639 \u3629 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 <br>\u3586 . \u3648 \u3617 \u3639 \u3629 \u3591 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 <br>\u3588 . \u3648 \u3617 \u3639 \u3629 \u3591 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632  (Smart City)<br>\u3591 . \u3648 \u3617 \u3639 \u3629 \u3591 \u3611 \u3636 \u3604 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3648 \u3617 \u3639 \u3629 \u3591 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632  (Smart City)</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  8 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  2.3 (\u3627 \u3609 \u3657 \u3634  100) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3617 \u3639 \u3629 \u3591 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 \u3607 \u3637 \u3656 \u3614 \u3619 \u3657 \u3629 \u3617 \u3619 \u3633 \u3610 \u3617 \u3639 \u3629 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3649 \u3621 \u3632 \u3616 \u3633 \u3618 \u3614 \u3636 \u3610 \u3633 \u3605 \u3636 "</div></div>\
\
    <div class="qb"><div class="q">90. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  4.2 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  8 \u3617 \u3640 \u3656 \u3591 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3604 \u3657 \u3634 \u3609 \u3651 \u3604 \u3586 \u3629 \u3591 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3623 \u3636 \u3592 \u3633 \u3618 <br>\u3586 . \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609  \u3585 \u3634 \u3619 \u3588 \u3621 \u3633 \u3591  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3607 \u3640 \u3609 <br>\u3588 . \u3585 \u3634 \u3619 \u3626 \u3634 \u3608 \u3634 \u3619 \u3603 \u3626 \u3640 \u3586 <br>\u3591 . \u3585 \u3634 \u3619 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609  \u3585 \u3634 \u3619 \u3588 \u3621 \u3633 \u3591  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3607 \u3640 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  8 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  4.2 (\u3627 \u3609 \u3657 \u3634  102) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609 \u3585 \u3634 \u3619 \u3588 \u3621 \u3633 \u3591 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3607 \u3640 \u3609 \u3651 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656 "</div></div>\
\
    <div class="qb"><div class="q">91. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.2 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9 (\u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3618 \u3634 \u3585 \u3592 \u3609 \u3586 \u3657 \u3634 \u3617 \u3619 \u3640 \u3656 \u3609 ) \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3649 \u3621 \u3632 \u3648 \u3614 \u3656 \u3636 \u3617 \u3610 \u3607 \u3610 \u3634 \u3607 \u3586 \u3629 \u3591 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3651 \u3604 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3611 \u3633 \u3597 \u3627 \u3634 </div>\
    <div class="c">\uc0\u3585 . \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3626 \u3656 \u3623 \u3609 \u3585 \u3621 \u3634 \u3591  (\u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 )<br>\u3586 . \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3626 \u3656 \u3623 \u3609 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 \u3649 \u3621 \u3632 \u3626 \u3656 \u3623 \u3609 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609 <br>\u3588 . \u3616 \u3634 \u3588 \u3648 \u3629 \u3585 \u3594 \u3609 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656 <br>\u3591 . \u3629 \u3591 \u3588 \u3660 \u3585 \u3619 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3626 \u3656 \u3623 \u3609 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 \u3649 \u3621 \u3632 \u3626 \u3656 \u3623 \u3609 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.2 (\u3627 \u3609 \u3657 \u3634  108) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614  \u3649 \u3621 \u3632 \u3648 \u3614 \u3636 \u3656 \u3617 \u3610 \u3607 \u3610 \u3634 \u3607 \u3586 \u3629 \u3591 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3626 \u3656 \u3623 \u3609 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 \u3649 \u3621 \u3632 \u3626 \u3656 \u3623 \u3609 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3611 \u3633 \u3597 \u3627 \u3634 \u3588 \u3623 \u3634 \u3617 \u3618 \u3634 \u3585 \u3592 \u3609 \u3586 \u3657 \u3634 \u3617 \u3619 \u3640 \u3656 \u3609 "</div></div>\
\
    <div class="qb"><div class="q">92. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  2.1 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 \u3618 \u3634 \u3585 \u3592 \u3609 \u3586 \u3657 \u3634 \u3617 \u3619 \u3640 \u3656 \u3609 \u3651 \u3627 \u3657 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3648 \u3621 \u3637 \u3657 \u3618 \u3591 \u3604 \u3641 \u3648 \u3604 \u3655 \u3585 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3605 \u3633 \u3657 \u3591 \u3649 \u3605 \u3656 \u3594 \u3656 \u3623 \u3591 \u3651 \u3604 \u3606 \u3638 \u3591 \u3594 \u3656 \u3623 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3605 \u3633 \u3657 \u3591 \u3649 \u3605 \u3656 \u3649 \u3619 \u3585 \u3648 \u3585 \u3636 \u3604  \u3606 \u3638 \u3591  6 \u3611 \u3637 <br>\u3586 . \u3605 \u3633 \u3657 \u3591 \u3649 \u3605 \u3656 \u3588 \u3619 \u3619 \u3616 \u3660 \u3617 \u3634 \u3619 \u3604 \u3634  \u3592 \u3609 \u3606 \u3638 \u3591  \u3611 \u3600 \u3617 \u3623 \u3633 \u3618 <br>\u3588 . \u3605 \u3633 \u3657 \u3591 \u3649 \u3605 \u3656 \u3611 \u3600 \u3617 \u3623 \u3633 \u3618  \u3606 \u3638 \u3591  \u3617 \u3633 \u3608 \u3618 \u3617 \u3624 \u3638 \u3585 \u3625 \u3634 <br>\u3591 . \u3605 \u3633 \u3657 \u3591 \u3649 \u3605 \u3656 \u3649 \u3619 \u3585 \u3648 \u3585 \u3636 \u3604  \u3606 \u3638 \u3591  \u3610 \u3619 \u3619 \u3621 \u3640 \u3609 \u3636 \u3605 \u3636 \u3616 \u3634 \u3623 \u3632 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3605 \u3633 \u3657 \u3591 \u3649 \u3605 \u3656 \u3588 \u3619 \u3619 \u3616 \u3660 \u3617 \u3634 \u3619 \u3604 \u3634  \u3592 \u3609 \u3606 \u3638 \u3591  \u3611 \u3600 \u3617 \u3623 \u3633 \u3618 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  2.1 (\u3627 \u3609 \u3657 \u3634  108) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 \u3618 \u3634 \u3585 \u3592 \u3609 \u3586 \u3657 \u3634 \u3617 \u3619 \u3640 \u3656 \u3609 \u3651 \u3627 \u3657 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3648 \u3621 \u3637 \u3657 \u3618 \u3591 \u3604 \u3641 \u3648 \u3604 \u3655 \u3585 \u3605 \u3633 \u3657 \u3591 \u3649 \u3605 \u3656 \u3588 \u3619 \u3619 \u3616 \u3660 \u3617 \u3634 \u3619 \u3604 \u3634 \u3592 \u3609 \u3606 \u3638 \u3591 \u3611 \u3600 \u3617 \u3623 \u3633 \u3618 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 "</div></div>\
\
    <div class="qb"><div class="q">93. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  3.2 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9 \u3617 \u3640 \u3656 \u3591 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3611 \u3619 \u3632 \u3585 \u3633 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 \u3651 \u3627 \u3657 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3605 \u3629 \u3610 \u3626 \u3609 \u3629 \u3591 \u3588 \u3623 \u3634 \u3617 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3586 \u3629 \u3591 \u3585 \u3621 \u3640 \u3656 \u3617 \u3651 \u3604 \u3648 \u3611 \u3655 \u3609 \u3614 \u3636 \u3648 \u3624 \u3625 </div>\
    <div class="c">\uc0\u3585 . \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 <br>\u3586 . \u3614 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 \u3619 \u3633 \u3600 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 <br>\u3588 . \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 \u3609 \u3629 \u3585 \u3619 \u3632 \u3610 \u3610 <br>\u3591 . \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 \u3605 \u3656 \u3634 \u3591 \u3604 \u3657 \u3634 \u3623 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 \u3609 \u3629 \u3585 \u3619 \u3632 \u3610 \u3610 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  3.2 (\u3627 \u3609 \u3657 \u3634  109) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3611 \u3619 \u3632 \u3585 \u3633 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 \u3651 \u3627 \u3657 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3605 \u3629 \u3610 \u3626 \u3609 \u3629 \u3591 \u3588 \u3623 \u3634 \u3617 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3586 \u3629 \u3591 \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 \u3609 \u3629 \u3585 \u3619 \u3632 \u3610 \u3610 "</div></div>\
\
    <div class="qb"><div class="q">94. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  4.3 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9 \u3617 \u3640 \u3656 \u3591 \u3592 \u3633 \u3604 \u3607 \u3635 \u3619 \u3632 \u3610 \u3610 \u3651 \u3604 \u3648 \u3614 \u3656 \u3639 \u3629 \u3594 \u3656 \u3623 \u3618 \u3648 \u3627 \u3621 \u3639 \u3629 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 </div>\
    <div class="c">\uc0\u3585 . \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 \u3607 \u3634 \u3591 \u3652 \u3585 \u3621 <br>\u3586 . \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3648 \u3618 \u3637 \u3618 \u3623 \u3618 \u3634 \u3594 \u3656 \u3623 \u3618 \u3648 \u3627 \u3621 \u3639 \u3629 \u3651 \u3609 \u3616 \u3634 \u3623 \u3632 \u3623 \u3636 \u3585 \u3620 \u3605 <br>\u3588 . \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3592 \u3657 \u3634 \u3591 \u3591 \u3634 \u3609 \u3648 \u3619 \u3656 \u3591 \u3604 \u3656 \u3623 \u3609 <br>\u3591 . \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3626 \u3636 \u3609 \u3648 \u3594 \u3639 \u3656 \u3629 \u3604 \u3629 \u3585 \u3648 \u3610 \u3637 \u3657 \u3618 \u3605 \u3656 \u3635 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3648 \u3618 \u3637 \u3618 \u3623 \u3618 \u3634 \u3594 \u3656 \u3623 \u3618 \u3648 \u3627 \u3621 \u3639 \u3629 \u3651 \u3609 \u3616 \u3634 \u3623 \u3632 \u3623 \u3636 \u3585 \u3620 \u3605 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  9 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  4.3 (\u3627 \u3609 \u3657 \u3634  110) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3592 \u3633 \u3604 \u3607 \u3635 \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3648 \u3618 \u3637 \u3618 \u3623 \u3618 \u3634 \u3594 \u3656 \u3623 \u3618 \u3648 \u3627 \u3621 \u3639 \u3629 \u3651 \u3609 \u3616 \u3634 \u3623 \u3632 \u3623 \u3636 \u3585 \u3620 \u3605 "</div></div>\
\
    <div class="qb"><div class="q">95. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.2 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  10 (\u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3627 \u3617 \u3640 \u3609 \u3648 \u3623 \u3637 \u3618 \u3609 ) \u3612 \u3621 \u3633 \u3585 \u3604 \u3633 \u3609 \u3651 \u3627 \u3657 \u3609 \u3635 \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3651 \u3604 \u3617 \u3634 \u3651 \u3594 \u3657 \u3651 \u3609 \u3616 \u3634 \u3588 \u3648 \u3629 \u3585 \u3594 \u3609 \u3648 \u3614 \u3639 \u3656 \u3629 \u3611 \u3619 \u3633 \u3610 \u3611 \u3619 \u3640 \u3591 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3586 \u3618 \u3634 \u3618 \u3588 \u3623 \u3634 \u3617 \u3619 \u3633 \u3610 \u3612 \u3636 \u3604 \u3594 \u3629 \u3610 \u3586 \u3629 \u3591 \u3612 \u3641 \u3657 \u3612 \u3621 \u3636 \u3605  (EPR)<br>\u3586 . \u3585 \u3634 \u3619 \u3605 \u3621 \u3634 \u3604 \u3609 \u3635 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 <br>\u3588 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3585 \u3634 \u3619 \u3592 \u3657 \u3634 \u3591 \u3591 \u3634 \u3609 <br>\u3591 . \u3585 \u3634 \u3619 \u3648 \u3614 \u3636 \u3656 \u3617 \u3594 \u3633 \u3656 \u3623 \u3650 \u3617 \u3591 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3585 \u3634 \u3619 \u3586 \u3618 \u3634 \u3618 \u3588 \u3623 \u3634 \u3617 \u3619 \u3633 \u3610 \u3612 \u3636 \u3604 \u3594 \u3629 \u3610 \u3586 \u3629 \u3591 \u3612 \u3641 \u3657 \u3612 \u3621 \u3636 \u3605  (EPR)</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  10 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.2 (\u3627 \u3609 \u3657 \u3634  115) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3609 \u3635 \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3586 \u3618 \u3634 \u3618 \u3588 \u3623 \u3634 \u3617 \u3619 \u3633 \u3610 \u3612 \u3636 \u3604 \u3594 \u3629 \u3610 \u3586 \u3629 \u3591 \u3612 \u3641 \u3657 \u3612 \u3621 \u3636 \u3605  (Extended Producer Responsibility: EPR) \u3617 \u3634 \u3651 \u3594 \u3657 \u3612 \u3621 \u3633 \u3585 \u3604 \u3633 \u3609 \u3651 \u3627 \u3657 \u3616 \u3634 \u3588 \u3648 \u3629 \u3585 \u3594 \u3609 \u3617 \u3637 \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3648 \u3614 \u3639 \u3656 \u3629 \u3611 \u3619 \u3633 \u3610 \u3611 \u3619 \u3640 \u3591 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 "</div></div>\
\
    <div class="qb"><div class="q">96. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  2.3 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  10 \u3617 \u3640 \u3656 \u3591 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3591 \u3588 \u3660 \u3588 \u3623 \u3634 \u3617 \u3619 \u3641 \u3657 \u3649 \u3621 \u3632 \u3600 \u3634 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3626 \u3636 \u3656 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3605 \u3621 \u3634 \u3604 \u3627 \u3621 \u3633 \u3585 \u3607 \u3619 \u3633 \u3614 \u3618 \u3660 <br>\u3586 . \u3605 \u3621 \u3634 \u3604 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 <br>\u3588 . \u3605 \u3621 \u3634 \u3604 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3648 \u3585 \u3625 \u3605 \u3619 \u3621 \u3656 \u3623 \u3591 \u3627 \u3609 \u3657 \u3634 <br>\u3591 . \u3605 \u3621 \u3634 \u3604 \u3629 \u3626 \u3633 \u3591 \u3627 \u3634 \u3619 \u3636 \u3617 \u3607 \u3619 \u3633 \u3614 \u3618 \u3660 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3605 \u3621 \u3634 \u3604 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  10 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  2.3 (\u3627 \u3609 \u3657 \u3634  115) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3605 \u3621 \u3634 \u3604 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3648 \u3585 \u3655 \u3610 \u3585 \u3633 \u3585 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 \u3651 \u3609 \u3616 \u3634 \u3588 \u3611 \u3656 \u3634 \u3652 \u3617 \u3657 "</div></div>\
\
    <div class="qb"><div class="q">97. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.1 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  11 (\u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3656 \u3618 \u3591 \u3616 \u3633 \u3618 \u3614 \u3636 \u3610 \u3633 \u3605 \u3636 ) \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3648 \u3594 \u3636 \u3591 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3585 \u3656 \u3629 \u3609 \u3648 \u3585 \u3636 \u3604 \u3616 \u3633 \u3618  \u3648 \u3594 \u3656 \u3609 \u3586 \u3657 \u3629 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3585 \u3634 \u3619 \u3649 \u3592 \u3585 \u3606 \u3640 \u3591 \u3618 \u3633 \u3591 \u3594 \u3637 \u3614 <br>\u3586 . \u3585 \u3634 \u3619 \u3592 \u3656 \u3634 \u3618 \u3648 \u3591 \u3636 \u3609 \u3594 \u3604 \u3648 \u3594 \u3618 <br>\u3588 . \u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3612 \u3633 \u3591 \u3648 \u3617 \u3639 \u3629 \u3591  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3626 \u3619 \u3619 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3607 \u3637 \u3656 \u3604 \u3636 \u3609 <br>\u3591 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3624 \u3641 \u3609 \u3618 \u3660 \u3629 \u3614 \u3618 \u3614 \u3594 \u3633 \u3656 \u3623 \u3588 \u3619 \u3634 \u3623 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . \u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3612 \u3633 \u3591 \u3648 \u3617 \u3639 \u3629 \u3591  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3626 \u3619 \u3619 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3607 \u3637 \u3656 \u3604 \u3636 \u3609 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  11 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.1 (\u3627 \u3609 \u3657 \u3634  124) \u3619 \u3632 \u3610 \u3640 \u3605 \u3633 \u3623 \u3629 \u3618 \u3656 \u3634 \u3591 \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3648 \u3594 \u3636 \u3591 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3652 \u3623 \u3657 \u3623 \u3656 \u3634  "\u3629 \u3634 \u3607 \u3636  \u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3612 \u3633 \u3591 \u3648 \u3617 \u3639 \u3629 \u3591  \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3626 \u3619 \u3619 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3607 \u3637 \u3656 \u3604 \u3636 \u3609 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3611 \u3655 \u3609 \u3619 \u3632 \u3610 \u3610 "</div></div>\
\
    <div class="qb"><div class="q">98. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  2.1 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  11 \u3617 \u3640 \u3656 \u3591 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3607 \u3640 \u3585 \u3616 \u3634 \u3588 \u3626 \u3656 \u3623 \u3609 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3619 \u3641 \u3657 \u3588 \u3623 \u3634 \u3617 \u3648 \u3586 \u3657 \u3634 \u3651 \u3592 \u3649 \u3621 \u3632 \u3605 \u3619 \u3632 \u3627 \u3609 \u3633 \u3585 \u3606 \u3638 \u3591 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3656 \u3618 \u3591 \u3649 \u3621 \u3632 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3592 \u3634 \u3585 \u3616 \u3633 \u3618 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3626 \u3616 \u3634 \u3614 \u3616 \u3641 \u3617 \u3636 \u3629 \u3634 \u3585 \u3634 \u3624 <br>\u3586 . \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3651 \u3609 \u3605 \u3621 \u3634 \u3604 \u3627 \u3621 \u3633 \u3585 \u3607 \u3619 \u3633 \u3614 \u3618 \u3660 <br>\u3588 . \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 <br>\u3591 . \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3629 \u3634 \u3594 \u3637 \u3614 \u3651 \u3609 \u3616 \u3634 \u3588 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3656 \u3618 \u3591 \u3649 \u3621 \u3632 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3592 \u3634 \u3585 \u3616 \u3633 \u3618 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3626 \u3616 \u3634 \u3614 \u3616 \u3641 \u3617 \u3636 \u3629 \u3634 \u3585 \u3634 \u3624 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  11 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  2.1 (\u3627 \u3609 \u3657 \u3634  124) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3607 \u3640 \u3585 \u3616 \u3634 \u3588 \u3626 \u3656 \u3623 \u3609 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3619 \u3641 \u3657 \u3588 \u3623 \u3634 \u3617 \u3648 \u3586 \u3657 \u3634 \u3651 \u3592 \u3605 \u3619 \u3632 \u3627 \u3609 \u3633 \u3585 \u3606 \u3638 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3656 \u3618 \u3591 \u3649 \u3621 \u3632 \u3611 \u3619 \u3633 \u3610 \u3605 \u3633 \u3623 \u3619 \u3633 \u3610 \u3617 \u3639 \u3629 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3592 \u3634 \u3585 \u3616 \u3633 \u3618 \u3608 \u3619 \u3619 \u3617 \u3594 \u3634 \u3605 \u3636 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3626 \u3616 \u3634 \u3614 \u3616 \u3641 \u3617 \u3636 \u3629 \u3634 \u3585 \u3634 \u3624 "</div></div>\
\
    <div class="qb"><div class="q">99. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637  \u3656  1.2 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637  \u3656  12 (\u3585 \u3635 \u3621 \u3633 \u3591 \u3588 \u3609 \u3626 \u3617 \u3619 \u3619 \u3606 \u3609 \u3632 \u3626 \u3641 \u3591 ) \u3617 \u3640  \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 \u3619 \u3632 \u3604 \u3633 \u3610 \u3614 \u3657 \u3639 \u3609 \u3600 \u3634 \u3609  \u3650 \u3604 \u3618 \u3611 \u3619 \u3633 \u3610 \u3610 \u3607 \u3610 \u3634 \u3607 \u3586 \u3629 \u3591 \u3588 \u3619 \u3641 \u3592 \u3634 \u3585  "\u3612 \u3641 \u3657 \u3626 \u3629 \u3609 " \u3652 \u3611 \u3648 \u3611 \u3655 \u3609 \u3626 \u3636 \u3656 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . "\u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 "<br>\u3586 . "\u3612 \u3641 \u3657 \u3588 \u3623 \u3610 \u3588 \u3640 \u3617 "<br>\u3588 . "\u3650 \u3588 \u3657 \u3594 "<br>\u3591 . "\u3609 \u3633 \u3585 \u3623 \u3636 \u3592 \u3633 \u3618 "</div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3588 . "\u3650 \u3588 \u3657 \u3594 "</div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  12 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.2 (\u3627 \u3609 \u3657 \u3634  132) \u3586 \u3657 \u3629  5) \u3585 \u3634 \u3619 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3588 \u3619 \u3641 \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3611 \u3619 \u3633 \u3610 \u3610 \u3607 \u3610 \u3634 \u3607 \u3586 \u3629 \u3591 \u3588 \u3619 \u3641 \u3592 \u3634 \u3585  \'93\u3612 \u3641 \u3657 \u3626 \u3629 \u3609 \'94 \u3648 \u3611 \u3655 \u3609  \'93\u3650 \u3588 \u3657 \u3594 \'94 \u3607 \u3637 \u3656 \u3629 \u3635 \u3609 \u3623 \u3618 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3650 \u3604 \u3618 \u3618 \u3638 \u3604 \u3612 \u3641 \u3657 \u3648 \u3619 \u3637 \u3618 \u3609 \u3648 \u3611 \u3655 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 "</div></div>\
\
    <div class="qb" style="border-bottom:none;"><div class="q">100. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  3.1 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  12 \u3617 \u3640 \u3656 \u3591 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3609 \u3636 \u3648 \u3623 \u3624 \u3648 \u3614 \u3639 \u3656 \u3629 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3605 \u3621 \u3629 \u3604 \u3594 \u3637 \u3623 \u3636 \u3605  \u3612 \u3656 \u3634 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3626 \u3636 \u3656 \u3591 \u3651 \u3604 </div>\
    <div class="c">\uc0\u3585 . \u3648 \u3617 \u3639 \u3629 \u3591 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657  \u3649 \u3627 \u3621 \u3656 \u3591 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657  \u3649 \u3621 \u3632 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3619 \u3619 \u3588 \u3660 <br>\u3586 . \u3650 \u3619 \u3591 \u3648 \u3619 \u3637 \u3618 \u3609 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656 \u3651 \u3609 \u3648 \u3617 \u3639 \u3629 \u3591 \u3627 \u3621 \u3633 \u3585 <br>\u3588 . \u3617 \u3627 \u3634 \u3623 \u3636 \u3607 \u3618 \u3634 \u3621 \u3633 \u3618 \u3607 \u3637 \u3656 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3623 \u3636 \u3592 \u3633 \u3618 <br>\u3591 . \u3627 \u3621 \u3633 \u3585 \u3626 \u3641 \u3605 \u3619 \u3616 \u3634 \u3588 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3604 \u3657 \u3634 \u3609 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 </div>\
    <div class="ans"><div class="ca">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3648 \u3617 \u3639 \u3629 \u3591 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657  \u3649 \u3627 \u3621 \u3656 \u3591 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657  \u3649 \u3621 \u3632 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3619 \u3619 \u3588 \u3660 </div>\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 : \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  12 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  3.1 (\u3627 \u3609 \u3657 \u3634  136) \u3586 \u3657 \u3629  1) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3616 \u3634 \u3588 \u3626 \u3656 \u3623 \u3609 \u3605 \u3656 \u3634 \u3591  \u3654  \u3626 \u3619 \u3657 \u3634 \u3591 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3617 \u3639 \u3629 \u3591 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657  \u3649 \u3627 \u3621 \u3656 \u3591 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657  \u3649 \u3621 \u3632 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3619 \u3619 \u3588 \u3660 \u3607 \u3656 \u3637 \u3627 \u3621 \u3634 \u3585 \u3627 \u3621 \u3634 \u3618 "</div></div>\
\
</div>\
