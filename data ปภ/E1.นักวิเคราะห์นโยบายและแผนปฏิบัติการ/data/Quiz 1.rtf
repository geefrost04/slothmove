    <div class="container">\
        <h1>\uc0\u3649 \u3609 \u3623 \u3586 \u3657 \u3629 \u3626 \u3629 \u3610  \u3588 \u3623 \u3634 \u3617 \u3619 \u3641 \u3657 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3626 \u3634 \u3608 \u3634 \u3619 \u3603 \u3632 \u3631 </h1>\
\
        <div class="question-block">\
            <div class="question">1. \uc0\u3585 \u3634 \u3619 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3626 \u3634 \u3608 \u3634 \u3619 \u3603 \u3632  (Public Policy Analysis) \u3651 \u3609 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609  "\u3585 \u3634 \u3619 \u3585 \u3635 \u3627 \u3609 \u3604 \u3611 \u3633 \u3597 \u3627 \u3634 " \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597  \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 \u3617 \u3634 \u3585 \u3607 \u3656 \u3637 \u3626 \u3640 \u3604 ?</div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3607 \u3619 \u3634 \u3610 \u3623 \u3656 \u3634 \u3651 \u3588 \u3619 \u3648 \u3611 \u3655 \u3609 \u3648 \u3592 \u3657 \u3634 \u3586 \u3629 \u3591 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 </li>\
                <li>\uc0\u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3619 \u3632 \u3610 \u3640 \u3626 \u3634 \u3648 \u3627 \u3605 \u3640 \u3607 \u3637 \u3656 \u3649 \u3607 \u3657 \u3592 \u3619 \u3636 \u3591 \u3649 \u3621 \u3632 \u3586 \u3629 \u3610 \u3648 \u3586 \u3605 \u3586 \u3629 \u3591 \u3611 \u3633 \u3597 \u3627 \u3634 \u3607 \u3637 \u3656 \u3626 \u3656 \u3591 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3605 \u3656 \u3629 \u3626 \u3656 \u3623 \u3609 \u3619 \u3623 \u3617 </li>\
                <li>\uc0\u3588 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3588 \u3633 \u3604 \u3648 \u3621 \u3639 \u3629 \u3585 \u3605 \u3633 \u3623 \u3610 \u3640 \u3588 \u3588 \u3621 \u3607 \u3637 \u3656 \u3592 \u3632 \u3617 \u3634 \u3604 \u3635 \u3619 \u3591 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3588 \u3603 \u3632 \u3585 \u3619 \u3619 \u3617 \u3585 \u3634 \u3619 </li>\
                <li>\uc0\u3591 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3592 \u3633 \u3604 \u3607 \u3635 \u3619 \u3634 \u3618 \u3591 \u3634 \u3609 \u3648 \u3626 \u3609 \u3629 \u3605 \u3656 \u3629 \u3588 \u3603 \u3632 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 \u3648 \u3614 \u3637 \u3618 \u3591 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3604 \u3637 \u3618 \u3623 </li>\
            </ul>\
        </div>\
\
        <div class="question-block">\
            <div class="question">2. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3621 \u3633 \u3585 \u3625 \u3603 \u3632 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591  "\u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3626 \u3634 \u3608 \u3634 \u3619 \u3603 \u3632 " (Public Policy)?</div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3648 \u3611 \u3655 \u3609 \u3585 \u3636 \u3592 \u3585 \u3619 \u3619 \u3617 \u3607 \u3637 \u3656 \u3610 \u3640 \u3588 \u3588 \u3621 \u3651 \u3604 \u3610 \u3640 \u3588 \u3588 \u3621 \u3627 \u3609 \u3638 \u3656 \u3591 \u3648 \u3621 \u3639 \u3629 \u3585 \u3607 \u3635 \u3648 \u3614 \u3656 \u3639 \u3629 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3626 \u3656 \u3623 \u3609 \u3605 \u3633 \u3623 </li>\
                <li>\uc0\u3586 . \u3648 \u3611 \u3655 \u3609 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3586 \u3629 \u3591 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3607 \u3637 \u3656 \u3617 \u3640 \u3656 \u3591 \u3605 \u3629 \u3610 \u3626 \u3609 \u3629 \u3591 \u3605 \u3656 \u3629 \u3611 \u3633 \u3597 \u3627 \u3634 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 </li>\
                <li>\uc0\u3588 . \u3648 \u3611 \u3655 \u3609 \u3585 \u3634 \u3619 \u3605 \u3633 \u3604 \u3626 \u3636 \u3609 \u3651 \u3592 \u3586 \u3629 \u3591 \u3616 \u3634 \u3588 \u3648 \u3629 \u3585 \u3594 \u3609 \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3614 \u3656 \u3636 \u3617 \u3585 \u3635 \u3652 \u3619 \u3626 \u3641 \u3591 \u3626 \u3640 \u3604 </li>\
                <li>\uc0\u3591 . \u3648 \u3611 \u3655 \u3609 \u3585 \u3598 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610 \u3607 \u3637 \u3656 \u3651 \u3594 \u3657 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3648 \u3593 \u3614 \u3634 \u3632 \u3616 \u3634 \u3618 \u3651 \u3609 \u3588 \u3619 \u3629 \u3610 \u3588 \u3619 \u3633 \u3623 \u3648 \u3607 \u3656 \u3634 \u3609 \u3633 \u3657 \u3609 </li>\
            </ul>\
        </div>\
\
        <div class="question-block">\
            <div class="question">3. \uc0\u3585 \u3634 \u3619 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3652 \u3611 \u3652 \u3604 \u3657  (Feasibility Analysis) \u3651 \u3609 \u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3649 \u3612 \u3609 \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619  \u3586 \u3657 \u3629 \u3651 \u3604 \u3652 \u3617 \u3656 \u3651 \u3594 \u3656 \u3604 \u3657 \u3634 \u3609 \u3627 \u3621 \u3633 \u3585 \u3607 \u3637 \u3656 \u3605 \u3657 \u3629 \u3591 \u3614 \u3636 \u3592 \u3634 \u3619 \u3603 \u3634 ?</div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3652 \u3611 \u3652 \u3604 \u3657 \u3607 \u3634 \u3591 \u3648 \u3607 \u3588 \u3609 \u3636 \u3588 </li>\
                <li>\uc0\u3586 . \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3652 \u3611 \u3652 \u3604 \u3657 \u3607 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609 </li>\
                <li>\uc0\u3588 . \u3588 \u3623 \u3634 \u3617 \u3626 \u3623 \u3618 \u3591 \u3634 \u3617 \u3586 \u3629 \u3591 \u3605 \u3619 \u3634 \u3626 \u3633 \u3597 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 </li>\
                <li>\uc0\u3591 . \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3652 \u3611 \u3652 \u3604 \u3657 \u3607 \u3634 \u3591 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3649 \u3621 \u3632 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610 \u3607 \u3637 \u3656 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3586 \u3657 \u3629 \u3591 </li>\
            </ul>\
        </div>\
\
        <div class="question-block">\
            <div class="question">4. \uc0\u3585 \u3634 \u3619 \u3651 \u3594 \u3657  SWOT Analysis \u3651 \u3609 \u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3649 \u3612 \u3609 \u3648 \u3594 \u3636 \u3591 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660  "\u3650 \u3629 \u3585 \u3634 \u3626  (Opportunities)" \u3627 \u3617 \u3634 \u3618 \u3606 \u3638 \u3591 \u3611 \u3633 \u3592 \u3592 \u3633 \u3618 \u3651 \u3609 \u3586 \u3657 \u3629 \u3651 \u3604 ?</div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3611 \u3633 \u3592 \u3592 \u3633 \u3618 \u3616 \u3634 \u3618 \u3651 \u3609 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3592 \u3640 \u3604 \u3649 \u3586 \u3655 \u3591 \u3586 \u3629 \u3591 \u3629 \u3591 \u3588 \u3660 \u3585 \u3619 </li>\
                <li>\uc0\u3586 . \u3611 \u3633 \u3592 \u3592 \u3633 \u3618 \u3616 \u3634 \u3618 \u3609 \u3629 \u3585 \u3607 \u3637 \u3656 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3629 \u3591 \u3588 \u3660 \u3585 \u3619 \u3610 \u3619 \u3619 \u3621 \u3640 \u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 </li>\
                <li>\uc0\u3588 . \u3586 \u3657 \u3629 \u3592 \u3635 \u3585 \u3633 \u3604 \u3616 \u3634 \u3618 \u3651 \u3609 \u3607 \u3637 \u3656 \u3607 \u3635 \u3651 \u3627 \u3657 \u3585 \u3634 \u3619 \u3604 \u3635 \u3648 \u3609 \u3636 \u3609 \u3591 \u3634 \u3609 \u3621 \u3656 \u3634 \u3594 \u3657 \u3634 </li>\
                <li>\uc0\u3591 . \u3629 \u3640 \u3611 \u3626 \u3619 \u3619 \u3588 \u3592 \u3634 \u3585 \u3626 \u3616 \u3634 \u3614 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 \u3607 \u3656 \u3637 \u3588 \u3623 \u3610 \u3588 \u3640 \u3617 \u3652 \u3617 \u3656 \u3652 \u3604 \u3657 </li>\
            </ul>\
        </div>\
\
        <div class="question-block">\
            <div class="question">5. \uc0\u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3651 \u3604 \u3651 \u3609 \u3623 \u3591 \u3592 \u3619 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618  (Policy Cycle) \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3585 \u3634 \u3619 \u3609 \u3635 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3652 \u3611 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 ?</div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3585 \u3634 \u3619 \u3585 \u3656 \u3629 \u3605 \u3633 \u3623 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 </li>\
                <li>\uc0\u3586 . \u3585 \u3634 \u3619 \u3585 \u3635 \u3627 \u3609 \u3604 \u3607 \u3634 \u3591 \u3648 \u3621 \u3639 \u3629 \u3585 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 </li>\
                <li>\uc0\u3588 . \u3585 \u3634 \u3619 \u3609 \u3635 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3652 \u3611 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636  (Policy Implementation)</li>\
                <li>\uc0\u3591 . \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3612 \u3621 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 </li>\
            </ul>\
        </div>\
\
        <div class="question-block">\
            <div class="question">6. \uc0\u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3651 \u3604 \u3607 \u3637 \u3656 \u3609 \u3636 \u3618 \u3617 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619  "\u3605 \u3636 \u3604 \u3605 \u3634 \u3617 \u3612 \u3621 " (Monitoring) \u3588 \u3623 \u3634 \u3617 \u3585 \u3657 \u3634 \u3623 \u3627 \u3609 \u3657 \u3634 \u3586 \u3629 \u3591 \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 \u3651 \u3609 \u3648 \u3594 \u3636 \u3591 \u3648 \u3623 \u3621 \u3634 ?</div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3649 \u3612 \u3609 \u3616 \u3641 \u3617 \u3636 \u3649 \u3585 \u3609 \u3607 \u3660  (Gantt Chart)</li>\
                <li>\uc0\u3586 . \u3585 \u3634 \u3619 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3629 \u3633 \u3605 \u3619 \u3634 \u3612 \u3621 \u3605 \u3629 \u3610 \u3649 \u3607 \u3609 \u3616 \u3634 \u3618 \u3651 \u3609  (IRR)</li>\
                <li>\uc0\u3588 . \u3649 \u3612 \u3609 \u3612 \u3633 \u3591 \u3585 \u3657 \u3634 \u3591 \u3611 \u3621 \u3634  (Fishbone Diagram)</li>\
                <li>\uc0\u3591 . \u3585 \u3634 \u3619 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3588 \u3623 \u3634 \u3617 \u3629 \u3656 \u3629 \u3609 \u3652 \u3627 \u3623  (Sensitivity Analysis)</li>\
            </ul>\
        </div>\
\
        <div class="question-block">\
            <div class="question">7. \uc0\u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3612 \u3621 \u3626 \u3633 \u3617 \u3620 \u3607 \u3608 \u3636 \u3660 \u3586 \u3629 \u3591 \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 \u3617 \u3633 \u3585 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3652 \u3611 \u3607 \u3637 \u3656 \u3626 \u3636 \u3656 \u3591 \u3651 \u3604 ?</div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3592 \u3635 \u3609 \u3623 \u3609 \u3648 \u3591 \u3636 \u3609 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3607 \u3637 \u3656 \u3648 \u3627 \u3621 \u3639 \u3629 \u3592 \u3656 \u3634 \u3618 </li>\
