        <div class="question-block">\
            <div class="question">40. \uc0\u3619 \u3632 \u3610 \u3610  "Zoning by Agri-Map" \u3606 \u3641 \u3585 \u3609 \u3635 \u3617 \u3634 \u3651 \u3594 \u3657 \u3648 \u3614 \u3656 \u3639 \u3629 \u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3651 \u3604 \u3651 \u3609 \u3616 \u3634 \u3588 \u3648 \u3585 \u3625 \u3605 \u3619 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3585 \u3634 \u3619 \u3618 \u3638 \u3604 \u3607 \u3637 \u3656 \u3604 \u3636 \u3609 \u3607 \u3635 \u3585 \u3636 \u3609 \u3586 \u3629 \u3591 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3588 \u3639 \u3609 </li>\
                <li>\uc0\u3586 . \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3605 \u3619 \u3607 \u3637 \u3656 \u3626 \u3629 \u3604 \u3588 \u3621 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3586 \u3629 \u3591 \u3604 \u3636 \u3609 \u3649 \u3621 \u3632 \u3649 \u3627 \u3621 \u3656 \u3591 \u3609 \u3657 \u3635 </li>\
