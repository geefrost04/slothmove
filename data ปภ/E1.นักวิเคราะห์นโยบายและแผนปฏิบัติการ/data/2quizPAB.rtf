            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3650 \u3629 \u3585 \u3634 \u3626 \u3651 \u3609 \u3585 \u3634 \u3619 \u3627 \u3634 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3649 \u3621 \u3632 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3626 \u3633 \u3591 \u3588 \u3617 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 \u3605 \u3656 \u3635 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3605 \u3633 \u3657 \u3591 \u3605 \u3621 \u3634 \u3604 \u3595 \u3639 \u3657 \u3629 \u3586 \u3634 \u3618 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 \u3648 \u3588 \u3619 \u3604 \u3636 \u3605 \u3648 \u3611 \u3655 \u3609 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3607 \u3634 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3607 \u3637 \u3656 \u3594 \u3656 \u3623 \u3618 \u3651 \u3627 \u3657 \u3594 \u3640 \u3617 \u3594 \u3609 \u3649 \u3621 \u3632 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3652 \u3607 \u3618 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3585 \u3634 \u3619 \u3604 \u3641 \u3649 \u3621 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657  \u3650 \u3604 \u3618 \u3648 \u3593 \u3614 \u3634 \u3632 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3607 \u3637 \u3656 \u3611 \u3619 \u3633 \u3610 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3617 \u3634 \u3607 \u3635 \u3585 \u3634 \u3619 \u3648 \u3585 \u3625 \u3605 \u3619 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3586 \u3634 \u3618 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609 \u3648 \u3588 \u3619 \u3604 \u3636 \u3605 \u3651 \u3627 \u3657 \u3585 \u3633 \u3610 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3607 \u3637 \u3656 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3621 \u3604 \u3585 \u3634 \u3619 \u3611 \u3621 \u3656 \u3629 \u3618 \u3585 \u3658 \u3634 \u3595 \u3648 \u3619 \u3639 \u3629 \u3609 \u3585 \u3619 \u3632 \u3