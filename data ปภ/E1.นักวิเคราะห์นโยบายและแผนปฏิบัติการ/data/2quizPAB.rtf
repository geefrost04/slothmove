        <div class="question-block">\
            <div class="question">48. \uc0\u3585 \u3634 \u3619 \u3626 \u3639 \u3656 \u3629 \u3626 \u3634 \u3619 \u3648 \u3594 \u3636 \u3591 \u3619 \u3640 \u3585 \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3633 \u3656 \u3609 \u3651 \u3627 \u3657 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3586 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3585 \u3634 \u3619 \u3611 \u3585 \u3611 \u3636 \u3604 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3586 \u3656 \u3634 \u3623 \u3626 \u3634 \u3619 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3604 \u3657 \u3634 \u3609 \u3621 \u3610 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 </li>\
                <li>\uc0\u3586 . \u3585 \u3634 \u3619 \u3626 \u3639 \u3656 \u3629 \u3626 \u3634 \u3619 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591  \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623  \u3649 \u3621 \u3632 \u3648 \u3609 \u3657 \u3609 \u3588 \u3623 \u3634 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 </li>\
                <li>\uc0\u3588 . \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3604 \u3634 \u3619 \u3634 \u3605 \u3656 \u3634 \u3591 \u3594 \u3634 \u3605 \u3636 \u3617 \u3634 \u3650 \u3590 \u3625 \u3603 \u3634 \u3648 \u3614 \u3637 \u3618 \u3591 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3604 \u3637 \u3618 \u3623 </li>\
                <li>\uc0\u3591 . \u3585 \u3634 \u3619 \u3649 \u3592 \u3585 \u3651 \u3610 \u3611 \u3621 \u3636 \u3623 \u3605 \u3634 \u3617 \u3626 \u3606 \u3634 \u3609 \u3607 \u3637 \u3656 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3605 \u3656 \u3634 \u3591 \u3654 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3626 \u3639 \u3656 \u3629 \u3626 \u3634 \u3619 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591  \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623  \u3649 \u3621 \u3632 \u3648 \u3609 \u3657 \u3609 \u3588 \u3623 \u3634 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3585 \u3634 \u3619 \u3626 \u3639 \u3656 \u3629 \u3626 \u3634 \u3619 \u3648 \u3594 \u3636 \u3591 \u3619 \u3640 \u3585 \u3651 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3605 \u3634 \u3617 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621  \u3588 \u3639 \u3629 \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591  \u3588 \u3619 \u3610 \u3606 \u3657 \u3623 \u3609 \u3649 \u3621 \u3632 \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623  \u3650 \u3604 \u3618 \u3648 \u3593 \u3614 \u3634 \u3632 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3604 \u3657 \u3634 \u3609 \u3588 \u3623 \u3634 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3626 \u3634 \u3608 \u3634 \u3619 \u3603 \u3626 \u3640 \u3586  \u3648 \u3614 \u3639  \u3656 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3594 \u3639  \u3656 \u3629 \u3617 \u3633  \u3656 \u3609 \u3651 \u3627 \u3657 \u3585 \u3633 \u3610 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3607 \u3633 \u3656 \u3623 \u3650 \u3621 \u3585  \u3648 \u3611 \u3655 \u3609 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3651 \u3609 \u3585 \u3634 \u3619 \u3626 \u3639 \u3656 \u3629 \u3626 \u3634 \u3619 \u3650 \u3604 \u3618 \u3605 \u3619 \u3591 \u3585 \u3633 \u3610 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3648 \u3614 \u3639 \u3656 \u3629 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3607 \u3637 \u3656 \u3588 \u3621 \u3634 \u3604 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3649 \u3621 \u3632 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3616 \u3634 \u3614 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3607 \u3637 \u3656 \u3604 \u3637 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3651 \u3609 \u3600 \u3634 \u3609 \u3632 \u3610 \u3657 \u3634 \u3609 \u3627 \u3621 \u3633 \u3591 \u3607 \u3637 \u3656 \u3626 \u3629 \u3591 \u3586 \u3629 \u3591 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 </div>\
            </div>\
        </div>\
