            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3605 \u3657 \u3629 \u3591 \u3648 \u3614 \u3656 \u3636 \u3617 \u3586 \u3637 \u3604 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3649 \u3621 \u3632 \u3607 \u3635 \u3651 \u3627 \u3657 \u3594 \u3637 \u3623 \u3636 \u3605 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3604 \u3637 \u3586 \u3638 \u3657 \u3609 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618  (Regulatory Impact Assessment) \u3648 \u3611 \u3655 \u3609 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3626 \u3635 \u3588 \u3633 \u3597 \u3585 \u3656 \u3629 \u3609 \u3585 \u3634 \u3619 \u3629 \u3629 \u3585 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3651 \u3627 \u3617 \u3656  \u3648 \u3614 \u3656 \u3639 \u3629 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3629 \u3618 \u3656 \u3634 \u3591 \u3619 \u3629 \u3610 \u3604 \u3657 \u3634 \u3609 \u3623 \u3656 \u3634 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3609 \u3633 \u3657 \u3609 \u3592 \u3632 \u3626 \u3656 \u3591 \u3612 \u3621 \u3604 \u3637 \u3605 \u3656 \u3629 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619  \u3650 \u3604 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3648 \u3609 \u3657 \u3609 \u3623 \u3656 \u3634 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3651 \u3627 \u3617 \u3656 \u3605 \u3657 \u3629 \u3591 \u3652 \u3617 \u3656 \u3626 \u3619 \u3657 \u3634 \u3591 \u3616 \u3634 \u3619 \u3632 \u3648 \u3585 \u3636 \u3609 \u3626 \u3617 \u3588 \u3623 \u3619  \u3605 \u3657 \u3629 \u3591 \u3592 \u3635 \u3585 \u3633 \u3604 \u3626 \u3636 \u3607 \u3608 \u3636 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3648 \u3607 \u3656 \u3634 \u3607 \u3637 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609  \u3649 \u3621 \u3632 \u3605 \u3657 \u3629 \u3591 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3