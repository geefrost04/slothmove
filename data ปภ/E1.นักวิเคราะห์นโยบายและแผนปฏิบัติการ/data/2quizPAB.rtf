        <div class="question-block">\
            <div class="question">28. \uc0\u3609 \u3650 \u3618 \u3610 \u3634 \u3618  "\u3648 \u3619 \u3637 \u3618 \u3609 \u3615 \u3619 \u3637 \u3617 \u3637 \u3591 \u3634 \u3609 \u3607 \u3635 " \u3651 \u3594 \u3657 \u3649 \u3614 \u3621 \u3605 \u3615 \u3629 \u3619 \u3660 \u3617 \u3651 \u3604 \u3648 \u3611 \u3655 \u3609 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3626 \u3635 \u3588 \u3633 \u3597 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3649 \u3614 \u3621 \u3605 \u3615 \u3629 \u3619 \u3660 \u3617 \u3650 \u3595 \u3648 \u3594 \u3637 \u3618 \u3621 \u3617 \u3637 \u3648 \u3604 \u3637 \u3618 \u3607 \u3633 \u3656 \u3623 \u3652 \u3611 </li>\
                <li>\uc0\u3586 . \u3649 \u3614 \u3621 \u3605 \u3615 \u3629 \u3619 \u3660 \u3617 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660 \u3615 \u3619 \u3637 \u3607 \u3637 \u3656 \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591 \u3652 \u3604 \u3657 \u3607 \u3640 \u3585 \u3607 \u3637 \u3656 \u3607 \u3640 \u3585 \u3648 \u3623 \u3621 \u3634 </li>\
                <li>\uc0\u3588 . \u3585 \u3634 \u3619 \u3649 \u3592 \u3585 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3648 \u3619 \u3637 \u3618 \u3609 \u3648 \u3611 \u3655 \u3609 \u3648 \u3621 \u3656 \u3617 \u3651 \u3627 \u3657 \u3617 \u3634 \u3585 \u3586 \u3657 \u3638 \u3609 </li>\
                <li>\uc0\u3591 . \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3609 \u3633 \u3585 \u3648 \u3619 \u3637 \u3618 \u3609 \u3652 \u3611 \u3613 \u3638 \u3585 \u3591 \u3634 \u3609 \u3651 \u3609 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3607 \u3640 \u3585 \u3588 \u3609 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3649 \u3614 \u3621 \u3605 \u3615 \u3629 \u3619 \u3660 \u3617 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660 \u3615 \u3619 \u3637 \u3607 \u3637 \u3656 \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591 \u3652 \u3604 \u3657 \u3607 \u3640 \u3585 \u3607 \u3637 \u3656 \u3607 \u3640 \u3585 \u3648 \u3623 \u3621 \u3634 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3648 \u3614 \u3639 \u3656 \u3629 \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3648 \u3627 \u3621 \u3639 \u3656 \u3629 \u3617 \u3621 \u3657 \u3635 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634  \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3652 \u3604 \u3657 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3614 \u3621 \u3605 \u3615 \u3629 \u3619 \u3660 \u3617 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660 \u3615 \u3619 \u3637 \u3607 \u3637 \u3656 \u3652 \u3617 \u3656 \u3617 \u3637 \u3588 \u3656 \u3634 \u3651 \u3594 \u3657 \u3592 \u3656 \u3634 \u3618 \u3651 \u3609 \u3585 \u3634 \u3619 \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591  (\u3619 \u3623 \u3617 \u3606 \u3638 \u3591 \u3585 \u3634 \u3619 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3605 \u3656 \u3629 \u3629 \u3636 \u3609 \u3648 \u3607 \u3629 \u3619 \u3660 \u3648 \u3609 \u3655 \u3605 ) \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3607 \u3640 \u3585 \u3585 \u3621 \u3640 \u3656 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3607 \u3633 \u3585 \u3625 \u3632 \u3651 \u3627 \u3617 \u3656 \u3654  \u3652 \u3604 \u3657 \u3604 \u3657 \u3623 \u3618 \u3605 \u3609 \u3648 \u3629 \u3591 \u3605 \u3621 \u3629 \u3604 \u3648 \u3623 \u3621 \u3634  \u3648 \u3611 \u3655 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3605 \u3621 \u3629 \u3604 \u3594 \u3637 \u3623 \u3636 \u3605 \u3649 \u3621 \u3632 \u3594 \u3656 \u3623 \u3618 \u3651 \u3627 \u3657 \u3588 \u3609 \u3652 \u3607 \u3618 \u3617 \u3637 \u3607 \u3633 \u3585 \u3625 \u3632 \u3607 \u3637 \u3656 \u3614 \u3619 \u3657 \u3629 \u3617 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3651 \u3609 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3618 \u3640 \u3588 \u3651 \u3627 \u3617 \u3656 </div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">29. \uc0\u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3616 \u3633 \u3618 \u3588 \u3640 \u3585 \u3588 \u3634 \u3617 \u3607 \u3634 \u3591 \u3652 \u3595 \u3648 \u3610 \u3629 \u3619 \u3660 \u3651 \u3609 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3619 \u3623 \u3617 \u3606 \u3638 \u3591 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3651 \u3604 \u3610 \u3657 \u3634 \u3591 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3648 \u3593 \u3614 \u3634 \u3632 \u3585 \u3634 \u3619 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3652 \u3623 \u3619 \u3633 \u3626 \u3588 \u3629 \u3617 \u3614 \u3636 \u3623 \u3648 \u3605 \u3629 \u3619 \u3660 \u3651 \u3609 \u3626 \u3635 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 </li>\
                <li>\uc0\u3586 . \u3626 \u3649 \u3585 \u3617 \u3648 \u3617 \u3629 \u3619 \u3660  \u3585 \u3634 \u3619 \u3627 \u3621 \u3629 \u3585 \u3621 \u3623 \u3591 \u3607 \u3634 \u3591 \u3652 \u3595 \u3648 \u3610 \u3629 \u3619 \u3660  \u3649 \u3621 \u3632 \u3629 \u3634 \u3594 \u3597 \u3634 \u3585 \u3619 \u3586 \u3657 \u3634 \u3617 \u3594 \u3634 \u3605 \u3636 </li>\
                <li>\uc0\u3588 . \u3585 \u3634 \u3619 \u3611 \u3636 \u3604 \u3585 \u3657 \u3633 \u3609 \u3626 \u3639 \u3656 \u3629 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660 \u3607 \u3637 \u3656 \u3623 \u3636 \u3614 \u3634 \u3585 \u3625 \u3660 \u3623 \u3636 \u3592 \u3634 \u3619 \u3603 \u3660 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 </li>\
                <li>\uc0\u3591 . \u3585 \u3634 \u3619 \u3618 \u3585 \u3648 \u3621 \u3636 \u3585 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3626 \u3617 \u3634 \u3619 \u3660 \u3607 \u3650 \u3615 \u3609 \u3651 \u3609 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3626 \u3649 \u3585 \u3617 \u3648 \u3617 \u3629 \u3619 \u3660  \u3585 \u3634 \u3619 \u3627 \u3621 \u3629 \u3585 \u3621 \u3623 \u3591 \u3607 \u3634 \u3591 \u3652 \u3595 \u3648 \u3610 \u3629 \u3619 \u3660  \u3649 \u3621 \u3632 \u3629 \u3634 \u3594 \u3597 \u3634 \u3585 \u3619 \u3586 \u3657 \u3634 \u3617 \u3594 \u3634 \u3605 \u3636 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3616 \u3633 \u3618 \u3588 \u3640 \u3585 \u3588 \u3634 \u3617 \u3607 \u3634 \u3591 \u3652 \u3595 \u3648 \u3610 \u3629 \u3619 \u3660 \u3651 \u3609 \u3617 \u3640 \u3617 \u3617 \u3629 \u3591 \u3586 \u3629 \u3591 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3611 \u3633 \u3592 \u3592 \u3640 \u3610 \u3633 \u3609 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3595 \u3633 \u3610 \u3595 \u3657 \u3629 \u3609 \u3649 \u3621 \u3632 \u3585 \u3619 \u3632 \u3607 \u3610 \u3605 \u3656 \u3629 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3650 \u3604 \u3618 \u3605 \u3619 \u3591  \u3652 \u3604 \u3657 \u3649 \u3585 \u3656  \u3648 \u3588 \u3619 \u3639 \u3629 \u3586 \u3656 \u3634 \u3618 \u3626 \u3649 \u3585 \u3617 \u3648 \u3617 \u3629 \u3619 \u3660  \u3585 \u3634 \u3619 \u3593 \u3657 \u3629 \u3650 \u3585 \u3591 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660  \u3585 \u3634 \u3619 \u3615 \u3629 \u3585 \u3648 \u3591 \u3636 \u3609  \u3649 \u3621 \u3632 \u3629 \u3634 \u3594 \u3597 \u3634 \u3585 \u3619 \u3619 \u3617 \u3586 \u3657 \u3634 \u3617 \u3594 \u3634 \u3605 \u3636  \u3595 \u3638 \u3656 \u3591 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3605 \u3657 \u3629 \u3591 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3585 \u3634 \u3619 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3651 \u3594 \u3657 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3649 \u3621 \u3632 \u3651 \u3594 \u3657 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3626 \u3634 \u3619 \u3626 \u3609 \u3648 \u3607 \u3624 \u3607 \u3637 \u3656 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618 \u3617 \u3634 \u3605 \u3619 \u3623 \u3592 \u3592 \u3633 \u3610  \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609  \u3649 \u3621 \u3632 \u3605 \u3633 \u3604 \u3594 \u3656 \u3629 \u3591 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609 \u3586 \u3629 \u3591 \u3629 \u3634 \u3594 \u3597 \u3634 \u3585 \u3619 \u3648 \u3627 \u3621 \u3656 \u3634 \u3609 \u3637 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3604 \u3655 \u3604 \u3586 \u3634 \u3604 </div>\
            </div>\
        </div>\
