        <div class="question-block">\
            <div class="question">15. "Cultural Diplomacy" \uc0\u3627 \u3619 \u3639 \u3629 \u3585 \u3634 \u3619 \u3607 \u3641 \u3605 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617  \u3606 \u3641 \u3585 \u3609 \u3635 \u3617 \u3634 \u3651 \u3594 \u3657 \u3648 \u3611 \u3655 \u3609 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3651 \u3609 \u3604 \u3657 \u3634 \u3609 \u3651 \u3604 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3585 \u3634 \u3619 \u3648 \u3612 \u3618 \u3649 \u3614 \u3619 \u3656 \u3624 \u3634 \u3626 \u3609 \u3634 \u3651 \u3609 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </li>\
                <li>\uc0\u3586 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3586 \u3657 \u3634 \u3651 \u3592 \u3629 \u3633 \u3609 \u3604 \u3637 \u3649 \u3621 \u3632 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3616 \u3634 \u3614 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3649 \u3621 \u3632 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 </li>\
                <li>\uc0\u3588 . \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3652 \u3611 \u3624 \u3638 \u3585 \u3625 \u3634 \u3604 \u3641 \u3591 \u3634 \u3609 \u3604 \u3657 \u3634 \u3609 \u3624 \u3636 \u3621 \u3611 \u3632 </li>\
                <li>\uc0\u3591 . \u3585 \u3634 \u3619 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3651 \u3627 \u3657 \u3588 \u3609 \u3605 \u3656 \u3634 \u3591 \u3594 \u3634 \u3605 \u3636 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3605 \u3634 \u3617 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617 \u3652 \u3607 \u3618 </li>\
