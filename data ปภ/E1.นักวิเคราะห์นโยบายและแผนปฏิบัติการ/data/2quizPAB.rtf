        <div class="question-block">\
            <div class="question">66. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  2.1 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3651 \u3627 \u3657 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3649 \u3621 \u3632 \u3626 \u3605 \u3634 \u3619 \u3660 \u3607 \u3629 \u3633 \u3614 \u3611 \u3619 \u3632 \u3618 \u3640 \u3585 \u3605 \u3660 \u3651 \u3594 \u3657 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3651 \u3604 \u3651 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3649 \u3621 \u3632 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3656 \u3636 \u3617 \u3651 \u3627 \u3657 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3619 \u3619 \u3588 \u3660  \u3648 \u3629 \u3585 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3607 \u3634 \u3591 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617  \u3649 \u3621 \u3632 \u3595 \u3629 \u3615 \u3605 \u3660 \u3614 \u3634 \u3623 \u3648 \u3623 \u3629 \u3619 \u3660 </li>\
                <li>\uc0\u3586 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3605 \u3657 \u3609 \u3607 \u3640 \u3609 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3604 \u3657 \u3634 \u3609 \u3619 \u3634 \u3588 \u3634 </li>\
                <li>\uc0\u3588 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3649 \u3627 \u3621 \u3656 \u3591 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656 </li>\
                <li>\uc0\u3591 . \u3585 \u3634 \u3619 \u3614 \u3638 \u3656 \u3591 \u3614 \u3634 \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3592 \u3634 \u3585 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3619 \u3619 \u3588 \u3660  \u3648 \u3629 \u3585 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3607 \u3634 \u3591 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617  \u3649 \u3621 \u3632 \u3595 \u3629 \u3615 \u3605 \u3660 \u3614 \u3634 \u3623 \u3648 \u3623 \u3629 \u3619 \u3660 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  2.1 (\u3627 \u3609 \u3657 \u3634  46) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3651 \u3627 \u3657 \u3612 \u3641  \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619  \u3649 \u3621 \u3632 \u3626 \u3605 \u3634 \u3619 \u3660 \u3607 \u3629 \u3633 \u3614  \u3611 \u3619 \u3632 \u3618 \u3640 \u3585 \u3605 \u3660 \u3651 \u3594 \u3657 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3619 \u3619 \u3588 \u3660  \u3648 \u3629 \u3585 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3607 \u3634 \u3591 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617  \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637  \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 ... \u3619 \u3623 \u3617 \u3607 \u3633 \u3657 \u3591 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3595 \u3629 \u3615 \u3605 \u3660 \u3614 \u3634 \u3623 \u3648 \u3623 \u3629 \u3619 \u3660 \u3648 \u3611 \u3655 \u3609 \u3605 \u3633 \u3623 \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 "</div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">67. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  3.3 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2 \u3648 \u3626 \u3609 \u3629 \u3651 \u3627 \u3657 \u3617 \u3637 \u3585 \u3634 \u3619 \u3648 \u3585 \u3655 \u3610 \u3588 \u3656 \u3634 \u3608 \u3619 \u3619 \u3617 \u3648 \u3609 \u3637 \u3618 \u3617 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3648 \u3586 \u3657 \u3634 \u3585 \u3629 \u3591 \u3607 \u3640 \u3609 \u3651 \u3604 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3585 \u3629 \u3591 \u3607 \u3640 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3585 \u3637 \u3628 \u3634 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636 </li>\
                <li>\uc0\u3586 . \u3585 \u3629 \u3591 \u3607 \u3640 \u3609 \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3652 \u3607 \u3618 </li>\
                <li>\uc0\u3588 . \u3585 \u3629 \u3591 \u3607 \u3640 \u3609 \u3629 \u3609 \u3640 \u3619 \u3633 \u3585 \u3625 \u3660 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 </li>\
                <li>\uc0\u3591 . \u3585 \u3629 \u3591 \u3607 \u3640 \u3609 \u3615 \u3657 \u3639 \u3609 \u3615 \u3641 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3629 \u3591 \u3607 \u3640 \u3609 \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3652 \u3607 \u3618 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  3.3 (\u3627 \u3609 \u3657 \u3634  47) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3651 \u3627 \u3657 \u3617 \u3637 \u3585 \u3634 \u3619 \u3648 \u3585 \u3655 \u3610 \u3588 \u3656 \u3634 \u3608 \u3619 \u3619 \u3617 \u3648 \u3609 \u3637 \u3618 \u3617 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3648 \u3586 \u3657 \u3634  \'93\u3585 \u3629 \u3591 \u3607 \u3640 \u3609 \u3648 \u3614 \u3656 \u3639 \u3629 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3652 \u3607 \u3618 \'94"</div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">68. \uc0\u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  5.2 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3611 \u3619 \u3640 \u3591 \u3586 \u3657 \u3629 \u3592 \u3635 \u3585 \u3633 \u3604 \u3586 \u3629 \u3591 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3649 \u3621 \u3632 \u3621 \u3604 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3629 \u3640 \u3611 \u3626 \u3619 \u3619 \u3588 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3607 \u3635 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592  \u3650 \u3604 \u3618 \u3648 \u3593 \u3614 \u3634 \u3632 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3611 \u3619 \u3632 \u3648 \u3616 \u3607 \u3651 \u3604 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3609 \u3635 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3649 \u3621 \u3632 \u3617 \u3633 \u3588 \u3588 \u3640 \u3648 \u3607 \u3624 \u3585 \u3660 </li>\
                <li>\uc0\u3586 . \u3607 \u3637 \u3656 \u3614 \u3633 \u3585 \u3649 \u3619 \u3617  \u3649 \u3621 \u3632 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3629 \u3656 \u3639 \u3609 \u3607 \u3637 \u3656 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3586 \u3657 \u3629 \u3591 </li>\
                <li>\uc0\u3588 . \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3619 \u3657 \u3634 \u3609 \u3629 \u3634 \u3627 \u3634 \u3619 \u3649 \u3621 \u3632 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3604 \u3639 \u3656 \u3617 </li>\
                <li>\uc0\u3591 . \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3585 \u3634 \u3619 \u3610 \u3636 \u3609 \u3649 \u3621 \u3632 \u3586 \u3609 \u3626 \u3656 \u3591 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3607 \u3637 \u3656 \u3614 \u3633 \u3585 \u3649 \u3619 \u3617  \u3649 \u3621 \u3632 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3629 \u3639 \u3656 \u3609 \u3607 \u3637 \u3656 \u3648 \u3585 \u3656 \u3637 \u3618 \u3623 \u3586 \u3657 \u3629 \u3591 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  2 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  5.2 (\u3627 \u3609 \u3657 \u3634  48) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634  "\u3611 \u3619 \u3633 \u3610 \u3611 \u3619 \u3640 \u3591 \u3586 \u3657 \u3629 \u3592 \u3635 \u3585 \u3633 \u3604 \u3586 \u3629 \u3591 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618  \u3621 \u3604 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3607 \u3637 \u3656 \u3621 \u3657 \u3634 \u3626 \u3617 \u3633 \u3618 \u3649 \u3621 \u3632 \u3648 \u3611 \u3655 \u3609 \u3629 \u3640 \u3611 \u3626 \u3619 \u3619 \u3588 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3607 \u3635 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 ... \u3650 \u3604 \u3618 \u3648 \u3593 \u3614 \u3634 \u3632 \u3607 \u3637 \u3656 \u3614 \u3633 \u3585 \u3649 \u3619 \u3617  \u3649 \u3621 \u3632 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3629 \u3639 \u3656 \u3609 \u3607 \u3637 \u3656 \u3648 \u3585 \u3656 \u3637 \u3618 \u3623 \u3586 \u3657 \u3629 \u3591 "</div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">69. \uc0\u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  3 (\u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3652 \u3615 \u3615 \u3657 \u3634 ) \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.1 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3592 \u3641 \u3591 \u3651 \u3592 \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3618 \u3634 \u3609 \u3618 \u3609 \u3605 \u3660 \u3652 \u3615 \u3615 \u3657 \u3634  \u3586 \u3657 \u3629 \u3651 \u3604  \u3652 \u3617 \u3656 \u3651 \u3594 \u3656  \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3619 \u3632 \u3610 \u3640 \u3652 \u3623 \u3657 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3607 \u3634 \u3591 \u3604 \u3657 \u3634 \u3609 \u3616 \u3634 \u3625 \u3637  (\u3648 \u3594 \u3656 \u3609  \u3616 \u3634 \u3625 \u3637 \u3626 \u3619 \u3619 \u3614 \u3626 \u3634 \u3617 \u3636 \u3605 )</li>\
                <li>\uc0\u3586 . \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3652 \u3617 \u3637 \u3651 \u3594 \u3656 \u3616 \u3634 \u3625 \u3637  (\u3648 \u3594 \u3656 \u3609  \u3607 \u3637 \u3656 \u3592 \u3629 \u3604 \u3615 \u3619 \u3637 )</li>\
                <li>\uc0\u3588 . \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3648 \u3591 \u3636 \u3609 \u3629 \u3640 \u3604 \u3627 \u3609 \u3640 \u3609 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3585 \u3634 \u3619 \u3595 \u3639 \u3657 \u3629 \u3619 \u3606 \u3618 \u3609 \u3605 \u3660 \u3652 \u3615 \u3615 \u3657 \u3634 </li>\
                <li>\uc0\u3591 . \u3585 \u3634 \u3619 \u3649 \u3592 \u3585 \u3626 \u3606 \u3634 \u3609 \u3637 \u3594 \u3634 \u3619 \u3660 \u3592 \u3626 \u3656 \u3623 \u3609 \u3605 \u3633 \u3623 \u3615 \u3619 \u3637 \u3607 \u3640 \u3585 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3591 . \u3585 \u3634 \u3619 \u3649 \u3592 \u3585 \u3626 \u3606 \u3634 \u3609 \u3637 \u3594 \u3634 \u3619 \u3660 \u3592 \u3626 \u3656 \u3623 \u3609 \u3605 \u3633 \u3623 \u3615 \u3619 \u3637 \u3607 \u3640 \u3585 \u3588 \u3619 \u3633 \u3623 \u3648 \u3619 \u3639 \u3629 \u3609 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3651 \u3609 \u3627 \u3617 \u3640 \u3604 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656  3 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3618 \u3656 \u3629 \u3618 \u3607 \u3637 \u3656  1.1 (\u3627 \u3609 \u3657 \u3634  55) \u3619 \u3632 \u3610 \u3640 \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3592 \u3641 \u3591 \u3651 \u3592 \u3652 \u3623 \u3657  3 \u3611 \u3619 \u3632 \u3648 \u3616 \u3607  \u3588 \u3639 \u3629  1) \u3616 \u3634 \u3625 \u3637  (\u3648 \u3594 \u3656 \u3609  \u3616 \u3634 \u3625 \u3637 \u3626 \u3619 \u3619 \u3614 \u3626 \u3634 \u3617 \u3636 \u3605 ) 2) \u3652 \u3617 \u3656 \u3651 \u3594 \u3656 \u3616 \u3634 \u3625 \u3637  (\u3648 \u3594 \u3656 \u3609  \u3607 \u3637 \u3656 \u3592 \u3629 \u3604 \u3615 \u3619 \u3637  \u3626 \u3656 \u3623 \u3609 \u3621 \u3604 \u3588 \u3656 \u3634 \u3652 \u3615 ) \u3649 \u3621 \u3632  3) \u3648 \u3591 \u3636 \u3609 \u3629 \u3640 \u3604 \u3627 \u3609 \u3640 \u3609  \u3649 \u3605 \u3656 \u3652 \u3617 \u3656 \u3652 \u3604 \u3657 \u3619 \u3632 \u3610 \u3640 \u3606 \u3638 \u3591 \u3585 \u3634 \u3619 \u3649 \u3592 \u3585 \u3626 \u3606 \u3634 \u3609 \u3637 \u3594 \u3634 \u3619 \u3660 \u3592 \u3615 \u3619 \u3637 </div>\
            </div>\
        </div>\
