        <div class="question-block">\
            <div class="question">42. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3648 \u3614 \u3639 \u3656 \u3629 \u3621 \u3604 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 \u3588 \u3629 \u3619 \u3660 \u3619 \u3633 \u3611 \u3594 \u3633 \u3609 \u3651 \u3609 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3629 \u3609 \u3640 \u3617 \u3633 \u3605 \u3636 \u3629 \u3609 \u3640 \u3597 \u3634 \u3605 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3585 \u3634 \u3619 \u3648 \u3614 \u3636 \u3656 \u3617 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3585 \u3634 \u3619 \u3629 \u3609 \u3640 \u3617 \u3633 \u3605 \u3636 \u3651 \u3627 \u3657 \u3617 \u3634 \u3585 \u3586 \u3638 \u3657 \u3609 </li>\
                <li>\uc0\u3586 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3604 \u3640 \u3621 \u3614 \u3636 \u3609 \u3636 \u3592 \u3586 \u3629 \u3591 \u3648 \u3592 \u3657 \u3634 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3649 \u3621 \u3632 \u3651 \u3594 \u3657 \u3619 \u3632 \u3610 \u3610 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3607 \u3637 \u3656 \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3652 \u3604 \u3657 </li>\
                <li>\uc0\u3588 . \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3609 \u3635 \u3648 \u3591 \u3636 \u3609 \u3617 \u3634 \u3592 \u3656 \u3634 \u3618 \u3612 \u3656 \u3634 \u3609 \u3594 \u3656 \u3629 \u3591 \u3607 \u3634 \u3591 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3605 \u3657 \u3629 \u3591 \u3617 \u3637 \u3651 \u3610 \u3648 \u3626 \u3619 \u3655 \u3592 </li>\
                <li>\uc0\u3591 . \u3585 \u3634 \u3619 \u3618 \u3585 \u3648 \u3621 \u3636 \u3585 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3629 \u3609 \u3640 \u3617 \u3633 \u3605 \u3636 \u3629 \u3609 \u3640 \u3597 \u3634 \u3605 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3604 \u3640 \u3621 \u3614 \u3636 \u3609 \u3636 \u3592 \u3586 \u3629 \u3591 \u3648 \u3592 \u3657 \u3634 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3649 \u3621 \u3632 \u3651 \u3594 \u3657 \u3619 \u3632 \u3610 \u3610 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3607 \u3637 \u3656 \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3652 \u3604 \u3657 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3627 \u3621 \u3633 \u3585 \u3651 \u3609 \u3585 \u3634 \u3619 \u3621 \u3604 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 \u3588 \u3639 \u3629 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3629 \u3609 \u3640 \u3617 \u3633 \u3605 \u3636 \u3629 \u3609 \u3640 \u3597 \u3634 \u3605 \u3651 \u3627 \u3657 \u3648 \u3611 \u3655 \u3609 \u3619 \u3632 \u3610 \u3610 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632  (Smart License) \u3595 \u3638 \u3656 \u3591 \u3594 \u3656 \u3623 \u3618 \u3621 \u3604 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3604 \u3640 \u3621 \u3614 \u3636 \u3609 \u3636 \u3592 \u3586 \u3629 \u3591 \u3648 \u3592 \u3657 \u3634 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656  (Discretion) \u3649 \u3621 \u3632 \u3607 \u3635 \u3651 \u3627 \u3657 \u3607 \u3640 \u3585 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626  \u3611 \u3619 \u3632 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3605 \u3636 \u3604 \u3605 \u3634 \u3617 \u3626 \u3606 \u3634 \u3609 \u3632 \u3588 \u3635 \u3586 \u3629 \u3652 \u3604 \u3657 \u3649 \u3610 \u3610 \u3648 \u3619 \u3637 \u3618 \u3621 \u3652 \u3607 \u3617 \u3660  \u3595 \u3638 \u3656 \u3591 \u3648 \u3611 \u3655 \u3609 \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3611 \u3633 \u3597 \u3627 \u3634 \u3607 \u3637 \u3656 \u3605 \u3657 \u3609 \u3648 \u3627 \u3605 \u3640 \u3649 \u3621 \u3632 \u3607 \u3635 \u3651 \u3627 \u3657 \u3585 \u3634 \u3619 \u3605 \u3636 \u3604 \u3605 \u3656 \u3629 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3632 \u3604 \u3623 \u3585 \u3649 \u3621 \u3632 \u3618 \u3640 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3607 \u3640 \u3585 \u3588 \u3609 </div>\
            </div>\
        </div>\
