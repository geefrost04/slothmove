<body>\
    <div class="container">\
        <h1>\uc0\u3649 \u3609 \u3623 \u3586 \u3657 \u3629 \u3626 \u3629 \u3610 \u3649 \u3621 \u3632 \u3648 \u3593 \u3621 \u3618 : \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3626 \u3633 \u3591 \u3588 \u3617 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13 (\u3614 .\u3624 . 2566 - 2570)</h1>\
\
        <div class="question-block">\
            <div class="question">1. \uc0\u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3626 \u3633 \u3591 \u3588 \u3617 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13 \u3617 \u3637 \u3585 \u3619 \u3629 \u3610 \u3619 \u3632 \u3618 \u3632 \u3648 \u3623 \u3621 \u3634 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3651 \u3594 \u3657 \u3605 \u3634 \u3617 \u3586 \u3657 \u3629 \u3651 \u3604 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . 1 \u3617 \u3585 \u3619 \u3634 \u3588 \u3617  2566 - 31 \u3608 \u3633 \u3609 \u3623 \u3634 \u3588 \u3617  2570</li>\
                <li>\uc0\u3586 . 1 \u3605 \u3640 \u3621 \u3634 \u3588 \u3617  2565 - 30 \u3585 \u3633 \u3609 \u3618 \u3634 \u3618 \u3609  2570</li>\
                <li>\uc0\u3588 . 1 \u3617 \u3585 \u3619 \u3634 \u3588 \u3617  2565 - 31 \u3608 \u3633 \u3609 \u3623 \u3634 \u3588 \u3617  2569</li>\
                <li>\uc0\u3591 . 1 \u3605 \u3640 \u3621 \u3634 \u3588 \u3617  2566 - 30 \u3585 \u3633 \u3609 \u3618 \u3634 \u3618 \u3609  2571</li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . 1 \u3605 \u3640 \u3621 \u3634 \u3588 \u3617  2565 - 30 \u3585 \u3633 \u3609 \u3618 \u3634 \u3618 \u3609  2570</div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3605 \u3634 \u3617 \u3611 \u3619 \u3632 \u3585 \u3634 \u3624 \u3651 \u3609 \u3619 \u3634 \u3594 \u3585 \u3636 \u3592 \u3592 \u3634 \u3609 \u3640 \u3648 \u3610 \u3585 \u3625 \u3634  \u3649 \u3621 \u3632 \u3648 \u3609 \u3639 \u3657 \u3629 \u3627 \u3634 \u3651 \u3609 \u3611 \u3600 \u3617 \u3610 \u3607  (\u3627 \u3609 \u3657 \u3634  3) \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634 \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13 \u3617 \u3637 \u3612 \u3621 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3651 \u3594 \u3657 \u3605 \u3633 \u3657 \u3591 \u3649 \u3605 \u3656 \u3623 \u3633 \u3609 \u3607 \u3637 \u3656  1 \u3605 \u3640 \u3621 \u3634 \u3588 \u3617  2565 \u3592 \u3609 \u3606 \u3638 \u3591 \u3623 \u3633 \u3609 \u3607 \u3637 \u3656  30 \u3585 \u3633 \u3609 \u3618 \u3634 \u3618 \u3609  2570 \u3595 \u3638 \u3656 \u3591 \u3588 \u3619 \u3629 \u3610 \u3588 \u3621 \u3640 \u3617 \u3611 \u3637 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603  \u3614 .\u3624 . 2566 \'96 2570</div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">2. \uc0\u3605 \u3634 \u3617 \u3611 \u3619 \u3632 \u3585 \u3634 \u3624 \u3651 \u3609 \u3619 \u3634 \u3594 \u3585 \u3636 \u3592 \u3592 \u3634 \u3609 \u3640 \u3648 \u3610 \u3585 \u3625 \u3634  \u3612 \u3641 \u3657 \u3651 \u3604 \u3648 \u3611 \u3655 \u3609 \u3612 \u3641 \u3657 \u3619 \u3633 \u3610 \u3626 \u3609 \u3629 \u3591 \u3614 \u3619 \u3632 \u3610 \u3619 \u3617 \u3619 \u3634 \u3594 \u3650 \u3629 \u3591 \u3585 \u3634 \u3619 \u3651 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3585 \u3634 \u3624 \u3651 \u3594 \u3657 \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13</div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3609 \u3634 \u3618 \u3585 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 </li>\
                <li>\uc0\u3586 . \u3611 \u3619 \u3632 \u3608 \u3634 \u3609 \u3619 \u3633 \u3600 \u3626 \u3616 \u3634 </li>\
                <li>\uc0\u3588 . \u3611 \u3619 \u3632 \u3608 \u3634 \u3609 \u3624 \u3634 \u3621 \u3598 \u3637 \u3585 \u3634 </li>\
                <li>\uc0\u3591 . \u3648 \u3621 \u3586 \u3634 \u3608 \u3636 \u3585 \u3634 \u3619 \u3626 \u3616 \u3634 \u3614 \u3633 \u3602 \u3609 \u3634 \u3585 \u3634 \u3619 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3626 \u3633 \u3591 \u3588 \u3617 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3609 \u3634 \u3618 \u3585 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3651 \u3609 \u3627 \u3609 \u3657 \u3634 \u3611 \u3619 \u3632 \u3585 \u3634 \u3624  (\u3627 \u3609 \u3657 \u3634  1) \u3619 \u3632 \u3610 \u3640 \u3594 \u3639 \u3656 \u3629  \u3614 \u3621 \u3648 \u3629 \u3585  \u3611 \u3619 \u3632 \u3618 \u3640 \u3607 \u3608 \u3660  \u3592 \u3633 \u3609 \u3607 \u3619 \u3660 \u3650 \u3629 \u3594 \u3634  \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591  \u3609 \u3634 \u3618 \u3585 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637  \u3648 \u3611 \u3655 \u3609 \u3612 \u3641 \u3657 \u3619 \u3633 \u3610 \u3626 \u3609 \u3629 \u3591 \u3614 \u3619 \u3632 \u3610 \u3619 \u3617 \u3619 \u3634 \u3594 \u3650 \u3629 \u3591 \u3585 \u3634 \u3619 </div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">3. \uc0\u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13 \u3606 \u3639 \u3629 \u3648 \u3611 \u3655 \u3609 \u3649 \u3612 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3651 \u3604 \u3605 \u3634 \u3617 \u3585 \u3621 \u3652 \u3585 \u3585 \u3634 \u3619 \u3649 \u3611 \u3621 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636 \u3652 \u3611 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3649 \u3612 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  1</li>\
                <li>\uc0\u3586 . \u3649 \u3612 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  2</li>\
                <li>\uc0\u3588 . \u3649 \u3612 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  3</li>\
                <li>\uc0\u3591 . \u3649 \u3612 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  4</li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3649 \u3612 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  2</div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3651 \u3609 \u3611 \u3600 \u3617 \u3610 \u3607  (\u3627 \u3609 \u3657 \u3634  3) \u3649 \u3621 \u3632  \u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  1 (\u3627 \u3609 \u3657 \u3634  8-9) \u3619 \u3632 \u3610 \u3640 \u3594 \u3633 \u3604 \u3648 \u3592 \u3609 \u3623 \u3656 \u3634  \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3649 \u3621 \u3632 \u3626 \u3633 \u3591 \u3588 \u3617 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636  \u3617 \u3637 \u3626 \u3606 \u3634 \u3609 \u3632 \u3648 \u3611 \u3655 \u3609  "\u3649 \u3612 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3637 \u3656  2" \u3595 \u3638 \u3656 \u3591 \u3607 \u3635 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3649 \u3611 \u3621 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3594 \u3634 \u3605 \u3636  (\u3649 \u3612 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3607 \u3656 \u3637  1) \u3652 \u3611 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 </div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">4. \uc0\u3586 \u3657 \u3629 \u3651 \u3604  \u3652 \u3617 \u3656 \u3651 \u3594 \u3656  1 \u3651 \u3609  4 \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3649 \u3621 \u3632 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3626 \u3635 \u3588 \u3633 \u3597 \u3607 \u3637 \u3656 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3585 \u3635 \u3627 \u3609 \u3604 \u3607 \u3636 \u3624 \u3607 \u3634 \u3591 \u3586 \u3629 \u3591 \u3649 \u3612 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3631  \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  13</div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3627 \u3621 \u3633 \u3585 \u3611 \u3619 \u3633 \u3594 \u3597 \u3634 \u3586 \u3629 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3629 \u3648 \u3614 \u3637 \u3618 \u3591 </li>\
                <li>\uc0\u3586 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3627 \u3617 \u3640 \u3609 \u3648 \u3623 \u3637 \u3618 \u3609  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3637 \u3648 \u3586 \u3637 \u3618 \u3623  (BCG)</li>\
                <li>\uc0\u3588 . \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3586 \u3629 \u3591 \u3626 \u3627 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3634 \u3605 \u3636  (SDGs)</li>\
                <li>\uc0\u3591 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3627 \u3609 \u3633 \u3585 \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585  (Heavy Industry Focus)</li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3591 . \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3627 \u3609 \u3633 \u3585 \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585  (Heavy Industry Focus)</div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3651 \u3609 \u3611 \u3600 \u3617 \u3610 \u3607  (\u3627 \u3609 \u3657 \u3634  3-4) \u3619 \u3632 \u3610 \u3640 \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3649 \u3621 \u3632 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604  4 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619 \u3652 \u3623 \u3657 \u3594 \u3633 \u3604 \u3648 \u3592 \u3609  \u3652 \u3604 \u3657 \u3649 \u3585 \u3656  1) \u3627 \u3621 \u3633 \u3585 \u3611 \u3619 \u3633 \u3594 \u3597 \u3634 \u3586 \u3629 \u3591 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3614 \u3629 \u3648 \u3614 \u3637 \u3618 \u3591  2) \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619  \'93\u3621 \u3657 \u3617 \u3649 \u3621 \u3657 \u3623  \u3621 \u3640 \u3585 \u3652 \u3623 \'94 (Resilience) 3) \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609  (SDGs) \u3649 \u3621 \u3632  4) \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3627 \u3617 \u3640 \u3609 \u3648 \u3623 \u3637 \u3618 \u3609  \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3637 \u3648 \u3586 \u3637 \u3618 \u3623  (BCG)</div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">5. \uc0\u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619  "\u3621 \u3657 \u3617 \u3649 \u3621 \u3657 \u3623  \u3621 \u3640 \u3585 \u3652 \u3623 " (Resilience) \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3604 \u3657 \u3623 \u3618 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3651 \u3609  3 \u3619 \u3632 \u3604 \u3633 \u3610  \u3618 \u3585 \u3648 \u3623 \u3657 \u3609 \u3586 \u3657 \u3629 \u3651 \u3604 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3619 \u3632 \u3604 \u3633 \u3610  "\u3629 \u3618 \u3641 \u3656 \u3619 \u3629 \u3604 " (\u3585 \u3634 \u3619 \u3614 \u3619 \u3657 \u3629 \u3617 \u3619 \u3633 \u3610 )</li>\
                <li>\uc0\u3586 . \u3619 \u3632 \u3604 \u3633 \u3610  "\u3614 \u3629 \u3648 \u3614 \u3637 \u3618 \u3591 " (\u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3605 \u3633 \u3623 )</li>\
                <li>\uc0\u3588 . \u3619 \u3632 \u3604 \u3633 \u3610  "\u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 " (\u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 )</li>\
                <li>\uc0\u3591 . \u3619 \u3632 \u3604 \u3633 \u3610  "\u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 " (\u3585 \u3634 \u3619 \u3594 \u3636 \u3591 \u3588 \u3623 \u3634 \u3617 \u3652 \u3604 \u3657 \u3648 \u3611 \u3619 \u3637 \u3618 \u3610 )</li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3591 . \u3619 \u3632 \u3604 \u3633 \u3610  "\u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 " (\u3585 \u3634 \u3619 \u3594 \u3636 \u3591 \u3588 \u3623 \u3634 \u3617 \u3652 \u3604 \u3657 \u3648 \u3611 \u3619 \u3637 \u3618 \u3610 )</div>\
