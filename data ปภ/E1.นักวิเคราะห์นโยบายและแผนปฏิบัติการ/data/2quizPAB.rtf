        <div class="question-block">\
            <div class="question">14. \uc0\u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3609 \u3657 \u3635 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3611 \u3655 \u3609 \u3619 \u3632 \u3610 \u3610 \u3648 \u3614 \u3639 \u3656 \u3629 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3616 \u3633 \u3618 \u3614 \u3636 \u3610 \u3633 \u3605 \u3636 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3649 \u3610 \u3610 \u3651 \u3604 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3605 \u3656 \u3634 \u3591 \u3588 \u3609 \u3605 \u3656 \u3634 \u3591 \u3607 \u3635 \u3605 \u3634 \u3617 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3586 \u3629 \u3591 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3605 \u3609 \u3648 \u3629 \u3591 </li>\
                <li>\uc0\u3586 . \u3585 \u3634 \u3619 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3649 \u3621 \u3632 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3619 \u3633 \u3610 \u3612 \u3636 \u3604 \u3594 \u3629 \u3610 \u3594 \u3633 \u3604 \u3648 \u3592 \u3609 </li>\
