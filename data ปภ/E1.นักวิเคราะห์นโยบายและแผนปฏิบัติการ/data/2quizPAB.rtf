        <div class="question-block">\
            <div class="question">18. \uc0\u3609 \u3650 \u3618 \u3610 \u3634 \u3618  "365 \u3623 \u3633 \u3609  (Destination Thailand)" \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3616 \u3634 \u3588 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3619 \u3634 \u3588 \u3634 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3651 \u3627 \u3657 \u3606 \u3641 \u3585 \u3607 \u3656 \u3637 \u3626 \u3640 \u3604 \u3651 \u3609 \u3650 \u3621 \u3585 </li>\
                <li>\uc0\u3586 . \u3585 \u3634 \u3619 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3592 \u3634 \u3585 \u3648 \u3609 \u3657 \u3609 \u3611 \u3619 \u3636 \u3617 \u3634 \u3603 \u3652 \u3611 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3626 \u3641 \u3591 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3627 \u3621 \u3634 \u3585 \u3627 \u3621 \u3634 \u3618 </li>\
                <li>\uc0\u3588 . \u3585 \u3634 \u3619 \u3629 \u3609 \u3640 \u3597 \u3634 \u3605 \u3651 \u3627 \u3657 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3629 \u3618 \u3641 \u3656 \u3652 \u3604 \u3657 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3605 \u3657 \u3629 \u3591 \u3617 \u3637 \u3623 \u3637 \u3595 \u3656 \u3634 \u3605 \u3621 \u3629 \u3604 \u3611 \u3637 </li>\
                <li>\uc0\u3591 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3623 \u3609 \u3626 \u3609 \u3640 \u3585 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656 \u3651 \u3609 \u3607 \u3640 \u3585 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3592 \u3634 \u3585 \u3648 \u3609 \u3657 \u3609 \u3611 \u3619 \u3636 \u3617 \u3634 \u3603 \u3652 \u3611 \u3626 \u3641 \u3656 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3626 \u3641 \u3591 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3627 \u3621 \u3634 \u3585 \u3627 \u3621 \u3634 \u3618 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3609 \u3650 \u3618 \u3610 \u3634 \u3618  "Destination Thailand 365 \u3623 \u3633 \u3609 " \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3605 \u3621 \u3629 \u3604 \u3607 \u3633 \u3657 \u3591 \u3611 \u3637  \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3592 \u3635 \u3585 \u3633 \u3604 \u3648 \u3593 \u3614 \u3634 \u3632 \u3594 \u3656 \u3623 \u3591 \u3652 \u3630 \u3595 \u3637 \u3595 \u3633 \u3656 \u3609  \u3650 \u3604 \u3618 \u3585 \u3634 \u3619 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3616 \u3634 \u3588 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3648 \u3609 \u3657 \u3609 \u3592 \u3635 \u3609 \u3623 \u3609 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623  (Quantity) \u3652 \u3611 \u3626  \u3641  \u3656 \u3585 \u3634 \u3619 \u3626 \u3619  \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3626  \u3641 \u3591  (Value-added) \u3604 \u3657 \u3623 \u3618 \u3585 \u3634 \u3619 \u3609 \u3635 \u3648 \u3626 \u3609 \u3629 \u3611 \u3619 \u3632 \u3626 \u3610 \u3585 \u3634 \u3619 \u3603 \u3660 \u3585 \u3634 \u3619 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637  \u3656 \u3618 \u3623 \u3648 \u3594  \u3636 \u3591 \u3626  \u3640 \u3586 \u3616 \u3634 \u3614  \u3624 \u3636 \u3621 \u3611 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617  \u3649 \u3621 \u3632 \u3585 \u3636 \u3592 \u3585 \u3619 \u3619 \u3617 \u3626 \u3633 \u3609 \u3607 \u3609 \u3634 \u3585 \u3634 \u3619 \u3619 \u3632 \u3604 \u3633 \u3610 \u3650 \u3621 \u3585  \u3648 \u3614 \u3639 \u3656 \u3629 \u3604 \u3638 \u3591 \u3604 \u3641 \u3604 \u3609 \u3633 \u3585 \u3607 \u3656 \u3629 \u3591 \u3648 \u3607 \u3637 \u3656 \u3618 \u3623 \u3607 \u3637 \u3656 \u3617 \u3637 \u3585 \u3635 \u3621 \u3633 \u3591 \u3595 \u3639 \u3657 \u3629 \u3626 \u3641 \u3591 \u3649 \u3621 \u3632 \u3585 \u3619 \u3632 \u3592 \u3634 \u3618 \u3619 \u3634 \u3618 \u3652 \u3604 \u3626 \u3641 \u3657 \u3656 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 </div>\
            </div>\
        </div>\
