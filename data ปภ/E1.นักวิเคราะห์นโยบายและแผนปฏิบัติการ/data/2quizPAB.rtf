            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3621 \u3640 \u3656 \u3617 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 \u3648 \u3614 \u3639 \u3656 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3649 \u3621 \u3632 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3594 \u3637 \u3623 \u3636 \u3605 \u3607 \u3637 \u3656 \u3604 \u3637 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> Silver Economy \u3627 \u3619 \u3639 \u3629 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3641 \u3591 \u3623 \u3633 \u3618  \u3648 \u3611 \u3655 \u3609 \u3649 \u3609 \u3623 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3648 \u3614 \u3639  \u3656 \u3629 \u3619 \u3629 \u3591 \u3619 \u3633 \u3610 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3585 \u3619 \u3652 \u3607 \u3618 \u3648 \u3586 \u3657 \u3634 \u3626 \u3641 \u3656 \u3626 \u3633 \u3591 \u3588 \u3617 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640  \u3650 \u3604 \u3618 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3605 \u3629 \u3610 \u3650 \u3592 \u3607 \u3618 \u3660 \u3588 \u3623 \u3634 \u3617 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3586 \u3629 \u3591 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640  \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3592 \u3657 \u3634 \u3591 \u3591 \u3634 \u3609 \u3612 \u3641  \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 \u3607 \u3637  \u3656 \u3617 \u3637 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3607 \u3637 \u3656 \u3594 \u3656 \u3623 \u3618 \u3629 \u3635 \u3609 \u3623 \u3618 \u3588 \u3623 \u3634 \u3617 \u3626 \u3632 \u3604 \u3623 \u3585 \u3651 \u3609 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3594 \u3637 \u3623 \u3636 \u3605  \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3612 \u3641 \u3657 \u3626 \u3641 \u3591 \u3629 \u3634 \u3618 \u3640 \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3594 \u3637 \u3623 \u3636 \u3605 \u3607 \u3637 \u3656 \u3604 \u3637 \u3649 \u3621 \u3632 \u3618 \u3633 \u3591 \u3648 \u3611 \u3655 \u3609 \u3614 \u3621 \u3633 \u3591 \u3651 \u3609 \u3585 \u3634 \u3619 \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3652 \u3604 \u3657 </div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">31. \uc0\u3585 \u3634 \u3619 \u3605 \u3636 \u3604 \u3605 \u3634 \u3617 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3612 \u3621 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3592 \u3632 \u3651 \u3594 \u3657 \u3604 \u3633 \u3594 \u3609 \u3637 \u3651 \u3604 \u3648 \u3611 \u3655 \u3609 \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3648 \u3619 \u3655 \u3592 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3634 \u3610 \u3611 \u3619 \u3634 \u3617 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3592 \u3635 \u3609 \u3623 \u3609 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3621 \u3591 \u3650 \u3607 \u3625 </li>\
                <li>\uc0\u3586 . \u3619 \u3632 \u3604 \u3633 \u3610 \u3604 \u3633 \u3594 \u3609 \u3637 \u3585 \u3634 \u3619 \u3619 \u3633 \u3610 \u3619 \u3641 \u3657 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605  (CPI) \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3607 \u3637 \u3656 \u3611 \u3619 \u3633 \u3610 \u3605 \u3633 \u3623 \u3604 \u3637 \u3586 \u3638 \u3657 \u3609 </li>\
                <li>\uc0\u3588 . \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3607 \u3656 \u3637 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3650 \u3590 \u3625 \u3603 \u3634 \u3605 \u3656 \u3629 \u3605 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 </li>\
                <li>\uc0\u3591 . \u3592 \u3635 \u3609 \u3623 \u3609 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3606 \u3641 \u3585 \u3605 \u3633 \u3657 \u3591 \u3586 \u3638 \u3657 \u3609 \u3651 \u3627 \u3617 \u3656 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3619 \u3632 \u3604 \u3633 \u3610 \u3604 \u3633 \u3594 \u3609 \u3637 \u3585 \u3634 \u3619 \u3619 \u3633 \u3610 \u3619 \u3641 \u3657 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605  (CPI) \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3607 \u3637 \u3656 \u3611 \u3619 \u3633 \u3610 \u3605 \u3633 \u3623 \u3604 \u3637 \u3586 \u3638 \u3657 \u3609 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3648 \u3619 \u3655 \u3592 \u3607 \u3637 \u3656 \u3594 \u3633 \u3604 \u3648 \u3592 \u3609 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 \u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3605 \u3656 \u3629 \u3605 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3588 \u3639 \u3629  "\u3619 \u3632 \u3604 \u3633 \u3610 \u3604 \u3633 \u3594 \u3609 \u3637 \u3585 \u3634 \u3619 \u3619 \u3633 \u3610 \u3619 \u3641 \u3657 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605  (Corruption Perceptions Index: CPI)" \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3592 \u3632 \u3605 \u3657 \u3629 \u3591 \u3611 \u3619 \u3633 \u3610 \u3605 \u3633 \u3623 \u3604 \u3637 \u3586 \u3638 \u3657 \u3609  \u3595 \u3638 \u3656 \u3591 \u3604 \u3633 \u3594 \u3609 \u3637 \u3609 \u3637 \u3657 \u3648 \u3611 \u3655 \u3609 \u3617 \u3634 \u3605 \u3619 \u3600 \u3634 \u3609 \u3626 \u3634 \u3585 \u3621 \u3607 \u3637 \u3656 \u3609 \u3633 \u3585 \u3621 \u3591 \u3607 \u3640 \u3609 \u3607 \u3633 \u3656 \u3623 \u3650 \u3621 \u3585 \u3651 \u3594 \u3657 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3588 \u3623 \u3634 \u3617 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3585 \u3634 \u3619 \u3605 \u3633 \u3657 \u3591 \u3648 \u3611 \u3657 \u3634 \u3609 \u3637 \u3657 \u3592 \u3638 \u3591 \u3648 \u3611 \u3655 \u3609 \u3585 \u3634 \u3619 \u3649 \u3626 \u3604 \u3591 \u3648 \u3592 \u3605 \u3609 \u3634 \u3619 \u3617 \u3603 \u3660 \u3651 \u3609 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3608 \u3619 \u3619 \u3617 \u3634 \u3616 \u3636 \u3610 \u3634 \u3621 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3629 \u3618 \u3656 \u3634 \u3591 \u3592 \u3619 \u3636 \u3591 \u3592 \u3633 \u3591 </div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">32. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3610 \u3607 \u3610 \u3634 \u3607 \u3651 \u3627 \u3617 \u3656 \u3586 \u3629 \u3591 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3617 \u3640 \u3656 \u3591 \u3627 \u3623 \u3633 \u3591 \u3592 \u3632 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3592 \u3634 \u3585  "\u3612 \u3641 \u3657 \u3588 \u3623 \u3610 \u3588 \u3640 \u3617 "</div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3612 \u3641 \u3657 \u3626 \u3633 \u3656 \u3591 \u3585 \u3634 \u3619  (Commander)</li>\
                <li>\uc0\u3586 . \u3612 \u3641 \u3657 \u3629 \u3635 \u3609 \u3623 \u3618 \u3588 \u3623 \u3634 \u3617 \u3626 \u3632 \u3604 \u3623 \u3585  (Facilitator)</li>\
                <li>\uc0\u3588 . \u3612 \u3641 \u3657 \u3586 \u3633 \u3604 \u3586 \u3623 \u3634 \u3591  (Interrupter)</li>\
                <li>\uc0\u3591 . \u3612 \u3641 \u3657 \u3607 \u3635 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3649 \u3586 \u3656 \u3591 \u3585 \u3633 \u3610 \u3648 \u3629 \u3585 \u3594 \u3609  (Competitor)</li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3612 \u3641 \u3657 \u3629 \u3635 \u3609 \u3623 \u3618 \u3588 \u3623 \u3634 \u3617 \u3626 \u3632 \u3604 \u3623 \u3585  (Facilitator)</div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3619 \u3632 \u3610 \u3610 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3588 \u3639 \u3629 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3610 \u3607 \u3610 \u3634 \u3607  (Role Model) \u3586 \u3629 \u3591 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600  \u3592 \u3634 \u3585 \u3648 \u3604 \u3636 \u3617 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609  "\u3612 \u3641 \u3657 \u3626 \u3633 \u3656 \u3591 \u3585 \u3634 \u3619 " \u3627 \u3619 \u3639 \u3629  "\u3612 \u3641 \u3657 \u3588 \u3623 \u3610 \u3588 \u3640 \u3617 " (Controller) \u3607 \u3637 \u3656 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3649 \u3605 \u3656 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610 \u3585 \u3598 \u3648 \u3585 \u3603 \u3601 \u3660  \u3617 \u3634 \u3648 \u3611 \u3655 \u3609  "\u3612 \u3641 \u3657 \u3629 \u3635 \u3609 \u3623 \u3618 \u3588 \u3623 \u3634 \u3617 \u3626 \u3632 \u3604 \u3623 \u3585 " (Facilitator) \u3607 \u3637 \u3656 \u3617 \u3640 \u3656 \u3591 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3616 \u3634 \u3588 \u3648 \u3629 \u3585 \u3594 \u3609 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3651 \u3627 \u3657 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3604 \u3635 \u3619 \u3591 \u3594 \u3637 \u3623 \u3636 \u3605 \u3649 \u3621 \u3632 \u3607 \u3635 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3652 \u3604 \u3657 \u3591 \u3656 \u3634 \u3618 \u3586 \u3638 \u3657 \u3609  \u3650 \u3604 \u3618 \u3588 \u3591 \u3610 \u3607 \u3610 \u3634 \u3607 \u3588 \u3623 \u3610 \u3588 \u3640 \u3617 \u3652 \u3623 \u3657 \u3648 \u3607 \u3656 \u3634 \u3607 \u3656 \u3637 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3592 \u3619 \u3636 \u3591 \u3654  \u3648 \u3607 \u3656 \u3634 \u3609 \u3633 \u3657 \u3609 </div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">33. \uc0\u3585 \u3634 \u3619 \u3621 \u3604 \u3619 \u3634 \u3618 \u3592 \u3656 \u3634 \u3618 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3637 \u3656 \u3652 \u3617 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3606 \u3641 \u3585 \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634 \u3588 \u3623 \u3619 \u3648 \u3619 \u3636 \u3656 \u3617 \u3605 \u3657 \u3609 \u3592 \u3634 \u3585 \u3626 \u3656 \u3623 \u3609 \u3651 \u3604 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3648 \u3591 \u3636 \u3609 \u3648 \u3604 \u3639 \u3629 \u3609 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3594 \u3633 \u3657 \u3609 \u3612 \u3641 \u3657 \u3609 \u3657 \u3629 \u3618 </li>\
                <li>\uc0\u3586 . \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3651 \u3609 \u3626 \u3636 \u3656 \u3591 \u3611 \u3621 \u3641 \u3585 \u3626 \u3619 \u3657 \u3634 \u3591 \u3607 \u3637 \u3656 \u3652 \u3617 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 \u3604 \u3641 \u3591 \u3634 \u3609 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </li>\
                <li>\uc0\u3588 . \u3585 \u3634 \u3619 \u3618 \u3585 \u3648 \u3621 \u3636 \u3585 \u3585 \u3634 \u3619 \u3619 \u3633 \u3585 \u3625 \u3634 \u3614 \u3618 \u3634 \u3610 \u3634 \u3621 \u3615 \u3619 \u3637 </li>\
                <li>\uc0\u3591 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3629 \u3634 \u3627 \u3634 \u3619 \u3585 \u3621 \u3634 \u3591 \u3623 \u3633 \u3609 \u3609 \u3633 \u3585 \u3648 \u3619 \u3637 \u3618 \u3609 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3651 \u3609 \u3626 \u3636 \u3656 \u3591 \u3611 \u3621 \u3641 \u3585 \u3626 \u3619 \u3657 \u3634 \u3591 \u3607 \u3637 \u3656 \u3652 \u3617 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3624 \u3638 \u3585 \u3625 \u3634 \u3604 \u3641 \u3591 \u3634 \u3609 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3617 \u3637 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3611 \u3619 \u3633 \u3610 \u3621 \u3604 \u3619 \u3634 \u3618 \u3592 \u3656 \u3634 \u3618 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3637 \u3656 \u3595 \u3657 \u3635 \u3595 \u3657 \u3629 \u3609 \u3649 \u3621 \u3632 \u3652 \u3617 \u3656 \u3585 \u3656 \u3629 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3650 \u3604 \u3618 \u3605 \u3619 \u3591 \u3605 \u3656 \u3629 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609  \u3650 \u3604 \u3618 \u3648 \u3593 \u3614 \u3634 \u3632 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3651 \u3609 \u3626 \u3636  \u3656 \u3591 \u3611 \u3621 \u3641 \u3585 \u3626 \u3619 \u3657 \u3634 \u3591 \u3607 \u3637  \u3656 \u3618 \u3633 \u3591 \u3652 \u3617 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3627 \u3619 \u3639 \u3629 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3624 \u3638 \u3585 \u3625 \u3634 \u3604 \u3641 \u3591 \u3634 \u3609 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3648 \u3614 \u3639 \u3656 \u3629 \u3609 \u3635 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3648 \u3627 \u3621 \u3656 \u3634 \u3609 \u3633 \u3657 \u3609 \u3652 \u3611 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3652 \u3586 \u3611 \u3633 \u3597 \u3627 \u3634 \u3648 \u3619 \u3656 \u3591 \u3604 \u3656 \u3623 \u3609  \u3648 \u3594 \u3656 \u3609  \u3585 \u3634 \u3619 \u3610 \u3619 \u3619 \u3648 \u3607 \u3634 \u3616 \u3633 \u3618 \u3649 \u3621 \u3657 \u3591  \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3652 \u3586 \u3627 \u3609 \u3637 \u3657 \u3626 \u3636 \u3609  \u3627 \u3619 \u3639 \u3629 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3607 \u3640 \u3609 \u3617 \u3609 \u3640 \u3625 \u3618 \u3660 \u3605 \u3634 \u3617 \u3588 \u3623 \u3634 \u3617 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3586 \u3629 \u3591 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 </div>\
            </div>\
        </div>\
