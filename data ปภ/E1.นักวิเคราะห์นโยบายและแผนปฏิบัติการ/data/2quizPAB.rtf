        <div class="question-block">\
            <div class="question">50. \uc0\u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3626 \u3619 \u3640 \u3611 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3640 \u3604 \u3607 \u3657 \u3634 \u3618 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3612 \u3656 \u3609 \u3604 \u3636 \u3609 \u3652 \u3623 \u3657 \u3623 \u3656 \u3634 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3648 \u3611 \u3655 \u3609 \u3648 \u3592 \u3657 \u3634 \u3650 \u3621 \u3585 </li>\
                <li>\uc0\u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3609 \u3635 \u3588 \u3623 \u3634 \u3617 \u3585 \u3636 \u3609 \u3604 \u3637 \u3629 \u3618 \u3641 \u3656 \u3604 \u3637 \u3649 \u3621 \u3632 \u3626 \u3619 \u3657 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3626 \u3591 \u3610 \u3626 \u3640 \u3586 \u3651 \u3627 \u3657 \u3588 \u3609 \u3652 \u3607 \u3618 \u3607 \u3640 \u3585 \u3588 \u3609 </li>\
                <li>\uc0\u3588 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3640 \u3586 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 </li>\
                <li>\uc0\u3591 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3617 \u3637 \u3585 \u3634 \u3619 \u3648 \u3621 \u3639 \u3629 \u3585 \u3605 \u3633 \u3657 \u3591 \u3610 \u3656 \u3629 \u3618 \u3607 \u3656 \u3637 \u3626 \u3640 \u3604 </li>\
