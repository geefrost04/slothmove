            <td>\uc0\u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 \u3623 \u3656 \u3634 \u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  (\u3613 \u3656 \u3634 \u3618 \u3585 \u3634 \u3619 \u3648 \u3617 \u3639 \u3629 \u3591 ) <br>\u3611 \u3621 \u3633 \u3604 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  (\u3613 \u3656 \u3634 \u3618 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3592 \u3635 )</td>\
        </tr>\
        <tr>\
            <td><strong>\uc0\u3619 \u3632 \u3604 \u3633 \u3610 \u3626 \u3635 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 </strong></td>\
            <td>\
                - \uc0\u3626 \u3635 \u3609 \u3633 \u3585 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637  <span class="eng">(Office of the Minister)</span><br>\
                - \uc0\u3626 \u3635 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 \u3611 \u3621 \u3633 \u3604 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  <span class="eng">(Office of the Permanent Secretary)</span>\
            </td>\
        </tr>\
        <tr>\
            <td><strong>\uc0\u3585 \u3621 \u3640 \u3656 \u3617 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 </strong><br><span class="eng">Industrial Economic Cluster</span></td>\
            <td>\
                - \uc0\u3626 \u3635 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  <span class="eng">(OIE)</span><br>\
                - \uc0\u3626 \u3635 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 \u3588 \u3603 \u3632 \u3585 \u3619 \u3619 \u3617 \u3585 \u3634 \u3619 \u3629 \u3657 \u3629 \u3618 \u3649 \u3621 \u3632 \u3609 \u3657 \u3635 \u3605 \u3634 \u3621 \u3607 \u3619 \u3634 \u3618  <span class="eng">(OCSB)</span>\
            </td>\
        </tr>\
        <tr>\
            <td><strong>\uc0\u3585 \u3621 \u3640 \u3656 \u3617 \u3585 \u3635 \u3585 \u3633 \u3610 \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 </strong><br><span class="eng">Production Process Supervision Cluster</span></td>\
            <td>\
                - \uc0\u3585 \u3619 \u3617 \u3650 \u3619 \u3591 \u3591 \u3634 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  <span class="eng">(DIW)</span><br>\
                - \uc0\u3585 \u3619 \u3617 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3648 \u3627 \u3617 \u3639 \u3629 \u3591 \u3649 \u3619 \u3656  <span class="eng">(DPIM)</span>\
            </td>\
        </tr>\
        <tr>\
            <td><strong>\uc0\u3585 \u3621 \u3640 \u3656 \u3617 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 </strong><br><span class="eng">Industrial & Entrepreneurial Promotion Cluster</span></td>\
            <td>\
                - \uc0\u3585 \u3619 \u3617 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  <span class="eng">(DIPROM)</span><br>\
                - \uc0\u3626 \u3635 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 \u3617 \u3634 \u3605 \u3619 \u3600 \u3634 \u3609 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  <span class="eng">(TISI)</span>\
            </td>\
        </tr>\
        <tr>\
            <td><strong>\uc0\u3619 \u3633 \u3600 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 </strong><br><span class="eng">State Enterprise</span></td>\
            <td>- \uc0\u3585 \u3634 \u3619 \u3609 \u3636 \u3588 \u3617 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3627 \u3656 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618  <span class="eng">(IEAT)</span></td>\
        </tr>\
        <tr>\
            <td><strong>\uc0\u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3648 \u3588 \u3619 \u3639 \u3629 \u3586 \u3656 \u3634 \u3618  (11 \u3649 \u3627 \u3656 \u3591 )</strong><br><span class="eng">Autonomous Agencies</span></td>\
            <td>\uc0\u3648 \u3594 \u3656 \u3609  \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3652 \u3607 \u3618 -\u3648 \u3618 \u3629 \u3619 \u3617 \u3633 \u3609 , \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3648 \u3614 \u3636 \u3656 \u3617 \u3612 \u3621 \u3612 \u3621 \u3636 \u3605 \u3649 \u3627 \u3656 \u3591 \u3594 \u3634 \u3605 \u3636 , \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3629 \u3634 \u3627 \u3634 \u3619 , \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3619 \u3633 \u3610 \u3619 \u3629 \u3591 \u3617 \u3634 \u3605 \u3619 \u3600 \u3634 \u3609 \u3652 \u3629 \u3648 \u3629 \u3626 \u3650 \u3629  (MASCI), \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3614 \u3633 \u3602 \u3609 \u3634 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3586 \u3609 \u3634 \u3604 \u3585 \u3621 \u3634 \u3591 \u3649 \u3621 \u3632 \u3586 \u3609 \u3634 \u3604 \u3618 \u3656 \u3629 \u3617  (ISMED)</td>\
        </tr>\
    </table>\
\
    <h2>\uc0\u55356 \u57263  2. \u3648 \u3592 \u3634 \u3632 \u3621 \u3638 \u3585  \u3626 \u3635 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 \u3611 \u3621 \u3633 \u3604 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  (\u3626 \u3611 .\u3629 \u3585 .)</h2>\
    <p>\uc0\u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3609 \u3637 \u3657 \u3648 \u3611 \u3619 \u3637 \u3618 \u3610 \u3648 \u3626 \u3617 \u3639 \u3629 \u3609  <strong>"\u3617 \u3633 \u3609 \u3626 \u3617 \u3629 \u3591 \u3649 \u3621 \u3632 \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 "</strong> \u3652 \u3617 \u3656 \u3651 \u3594 \u3656 \u3613 \u3656 \u3634 \u3618 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3585 \u3634 \u3619 \u3605 \u3619 \u3623 \u3592 \u3650 \u3619 \u3591 \u3591 \u3634 \u3609  (\u3595 \u3638 \u3656 \u3591 \u3648 \u3611 \u3655 \u3609 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3585 \u3619 \u3617 \u3650 \u3619 \u3591 \u3591 \u3634 \u3609 \u3631 )</p>\
    <ul>\
        <li><span class="highlight">\uc0\u3623 \u3636 \u3626 \u3633 \u3618 \u3607 \u3633 \u3624 \u3609 \u3660 :</span> \'93\u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3649 \u3621 \u3632 \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3651 \u3627 \u3657 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \'94</li>\
        <li><strong>\uc0\u3629 \u3635 \u3609 \u3634 \u3592 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3627 \u3621 \u3633 \u3585  8 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619  (\u3618 \u3656 \u3629 ):</strong> 1. \u3648 \u3626 \u3609 \u3629 \u3649 \u3609 \u3632 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637  2. \u3614 \u3633 \u3602 \u3609 \u3634 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660  3. \u3649 \u3611 \u3621 \u3591 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3648 \u3611 \u3655 \u3609 \u3649 \u3612 \u3609  4. \u3592 \u3633 \u3604 \u3626 \u3619 \u3619 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 /\u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603  5. \u3585 \u3635 \u3585 \u3633 \u3610 \u3605 \u3636 \u3604 \u3605 \u3634 \u3617 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3612 \u3621  6. \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610  IT 7. \u3611 \u3619 \u3632 \u3626 \u3634 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  8. \u3604 \u3641 \u3649 \u3621 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3651 \u3609 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588  (\u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604 )</li>\
        <li><strong>\uc0\u3649 \u3612 \u3609 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619  \u3614 .\u3624 . 2566 - 2570 (4 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3627 \u3621 \u3633 \u3585 ):</strong>\
            1) \uc0\u3612 \u3621 \u3633 \u3585 \u3604 \u3633 \u3609 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3648 \u3585 \u3636 \u3604  <span class="highlight">\u3612 \u3621 \u3626 \u3633 \u3617 \u3620 \u3607 \u3608 \u3636 \u3660 </span>\
            2) \uc0\u3614 \u3633 \u3602 \u3609 \u3634 \u3624 \u3633 \u3585 \u3618 \u3616 \u3634 \u3614 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3651 \u3609  <span class="highlight">\u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 </span>\
            3) \uc0\u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3604 \u3657 \u3623 \u3618  <span class="highlight">BCG Model</span>\
            4) \uc0\u3614 \u3633 \u3602 \u3609 \u3634  <span class="highlight">\u3626 \u3617 \u3619 \u3619 \u3606 \u3609 \u3632 \u3629 \u3591 \u3588 \u3660 \u3585 \u3619 </span>\
        </li>\
        <li><strong>\uc0\u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3616 \u3634 \u3618 \u3651 \u3609 :</strong> \u3585 \u3629 \u3591 \u3605 \u3619 \u3623 \u3592 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619  (\u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3588 \u3640 \u3603 \u3626 \u3617 \u3633 \u3588 \u3619 ), \u3585 \u3629 \u3591 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3649 \u3621 \u3632 \u3649 \u3612 \u3609 \u3591 \u3634 \u3609 , \u3585 \u3629 \u3591 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 , \u3626 \u3635 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604  76 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604  \u3631 \u3621 \u3631 </li>\
    </ul>\
\
    <h2>\uc0\u55356 \u57137  3. \u3609 \u3650 \u3618 \u3610 \u3634 \u3618  MIND \u3649 \u3621 \u3632 \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 \u3592 \u3636 \u3605 \u3629 \u3634 \u3626 \u3634 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 </h2>\
\
    <div class="box-mind">\
        <strong>\uc0\u55358 \u56800  \u3649 \u3610 \u3619 \u3609 \u3604 \u3660  "MIND" \u3649 \u3621 \u3632 \u3617 \u3636 \u3605 \u3636 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3648 \u3619 \u3655 \u3592  4 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619 </strong>\
        <p>\uc0\u3585 \u3634 \u3619 \u3651 \u3594 \u3657  "\u3627 \u3633 \u3623 " \u3649 \u3621 \u3632  "\u3651 \u3592 " \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3629 \u3591 \u3588 \u3660 \u3585 \u3619  \u3648 \u3614 \u3639 \u3656 \u3629 \u3611 \u3633 \u3657 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3588 \u3641 \u3656 \u3594 \u3640 \u3617 \u3594 \u3609  \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3604 \u3657 \u3623 \u3618 :</p>\
        <ol>\
            <li><strong>\uc0\u3608 \u3640 \u3619 \u3585 \u3636 \u3592  (Profit):</strong> \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605  \u3617 \u3637 \u3585 \u3635 \u3652 \u3619  \u3619 \u3633 \u3585 \u3625 \u3634 \u3592 \u3619 \u3636 \u3618 \u3608 \u3619 \u3619 \u3617 </li>\
            <li><strong>\uc0\u3626 \u3633 \u3591 \u3588 \u3617 /\u3594 \u3640 \u3617 \u3594 \u3609  (Social):</strong> \u3650 \u3619 \u3591 \u3591 \u3634 \u3609 \u3648 \u3611 \u3636 \u3604 \u3651 \u3592 \u3619 \u3633 \u3610 \u3615 \u3633 \u3591  \u3619 \u3656 \u3623 \u3617 \u3614 \u3633 \u3602 \u3609 \u3634 \u3594 \u3640 \u3617 \u3594 \u3609 </li>\
            <li><strong>\uc0\u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617  (Environment):</strong> \u3621 \u3604 \u3617 \u3621 \u3614 \u3636 \u3625  \u3651 \u3594 \u3657 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3588 \u3640 \u3657 \u3617 \u3588 \u3656 \u3634 </li>\
            <li><strong>\uc0\u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3592 \u3634 \u3618 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657  (Income):</strong> \u3626 \u3619 \u3657 \u3634 \u3591 \u3629 \u3634 \u3594 \u3637 \u3614  \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3600 \u3634 \u3609 \u3619 \u3634 \u3585 </li>\
        </ol>\
    </div>\
\
    <h3>\uc0\u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 \u3648 \u3619 \u3639 \u3629 \u3608 \u3591 \u3592 \u3636 \u3605 \u3629 \u3634 \u3626 \u3634  "\u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3619 \u3623 \u3617 \u3651 \u3592  \u3604 \u3641 \u3649 \u3621 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617  \u3604 \u3636 \u3609  \u3609 \u3657 \u3635  \u3621 \u3617  \u3652 \u3615 "</h3>\
    <ul>\
        <li><strong>\uc0\u55356 \u57137  \u3604 \u3636 \u3609  (\u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3600 \u3614 \u3637 ):</strong> \u3614 \u3633 \u3602 \u3609 \u3634 \u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656 \u3611 \u3621 \u3641 \u3585 \u3629 \u3657 \u3629 \u3618  <span class="highlight">100,000 \u3652 \u3619 \u3656 </span> \u3604 \u3657 \u3623 \u3618 \u3585 \u3634 \u3585 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618  (Circular Economy)</li>\
        <li><strong>\uc0\u55357 \u56487  \u3609 \u3657 \u3635  (\u3615 \u3639 \u3657 \u3609 \u3615 \u3641 \u3649 \u3627 \u3621 \u3656 \u3591 \u3609 \u3657 \u3635 ):</strong> \u3604 \u3641 \u3649 \u3621 \u3588 \u3621 \u3629 \u3591  <span class="highlight">72 \u3626 \u3634 \u3618 </span> \u3605 \u3619 \u3623 \u3592 \u3623 \u3633 \u3604 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3609 \u3657 \u3635  \u3605 \u3636 \u3604 \u3605 \u3633 \u3657 \u3591 \u3619 \u3632 \u3610 \u3610 \u3604 \u3633 \u3585 \u3652 \u3586 \u3617 \u3633 \u3609  (\u3648 \u3594 \u3656 \u3609  \u3619 \u3629 \u3610 \u3623 \u3633 \u3604 \u3610 \u3623 \u3619 \u3609 \u3636 \u3648 \u3623 \u3624 \u3623 \u3636 \u3627 \u3634 \u3619 )</li>\
        <li><strong>\uc0\u55356 \u57132 \u65039  \u3621 \u3617  (\u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3629 \u3634 \u3585 \u3634 \u3624 ):</strong> \u3611 \u3621 \u3641 \u3585 \u3611 \u3656 \u3634 \u3594 \u3634 \u3618 \u3648 \u3621 \u3609  <span class="highlight">100 \u3652 \u3619 \u3656  (77,100 \u3605 \u3657 \u3609 )</span> \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618  Net Zero \u3649 \u3621 \u3632 \u3621 \u3604 \u3613 \u3640 \u3656 \u3609  PM 2.5</li>\
        <li><strong>\uc0\u55357 \u56613  \u3652 \u3615  (\u3588 \u3623 \u3634 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 ):</strong> \u3592 \u3636 \u3605 \u3629 \u3634 \u3626 \u3634 \u3614 \u3636 \u3607 \u3633 \u3585 \u3625 \u3660 \u3624 \u3634 \u3626 \u3609 \u3626 \u3606 \u3634 \u3609  <span class="highlight">87 \u3649 \u3627 \u3656 \u3591 </span> \u3648 \u3586 \u3657 \u3634 \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3619 \u3632 \u3610 \u3610 \u3652 \u3615 \u3615 \u3657 \u3634 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3648 \u3614 \u3621 \u3636 \u3591 \u3652 \u3627 \u3617 \u3657 </li>\
        <li><strong>\uc0\u55358 \u56605  \u3585 \u3634 \u3619 \u3626 \u3591 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 :</strong> \u3609 \u3617 \u3592 \u3636 \u3605 \u3629 \u3634 \u3626 \u3634 \u3607 \u3604 \u3649 \u3607 \u3609 \u3609 \u3617 \u3649 \u3617 \u3656 \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3604 \u3655 \u3585 \u3585 \u3635 \u3614 \u3619 \u3657 \u3634  \u3649 \u3621 \u3632 \u3606 \u3640 \u3591 \u3618 \u3633 \u3591 \u3594 \u3637 \u3614 \u3594 \u3656 \u3623 \u3618 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3626 \u3610 \u3616 \u3633 \u3618 </li>\
    </ul>\
\
    <h2>\uc0\u55357 \u56608  4. \u3588 \u3621 \u3633 \u3591 \u3588 \u3635 \u3624 \u3633 \u3614 \u3607 \u3660 \u3649 \u3621 \u3632 \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3626 \u3635 \u3588 \u3633 \u3597 </h2>\
    <div class="box-vocab">\
        <ul>\
            <li><span class="highlight">ASIA (\uc0\u3588 \u3656 \u3634 \u3609 \u3636 \u3618 \u3617 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 ):</span> <br>\
                - <strong>A</strong>ccountability: \uc0\u3619 \u3633 \u3610 \u3612 \u3636 \u3604 \u3594 \u3629 \u3610 \u3651 \u3609 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 <br>\
                - <strong>S</strong>uggestion: \uc0\u3648 \u3626 \u3609 \u3629 \u3649 \u3609 \u3632 \u3629 \u3618 \u3656 \u3634 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3619 \u3619 \u3588 \u3660 <br>\
                - <strong>I</strong>ntegrity: \uc0\u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3595 \u3639 \u3656 \u3629 \u3626 \u3633 \u3605 \u3618 \u3660 \u3626 \u3640 \u3592 \u3619 \u3636 \u3605 <br>\
                - <strong>A</strong>chievement Motivation: \uc0\u3617 \u3640 \u3656 \u3591 \u3612 \u3621 \u3626 \u3633 \u3617 \u3620 \u3607 \u3608 \u3636 \u3660 \
            </li>\
            <li><span class="highlight">BCG Model:</span> \uc0\u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614  <span class="eng">(Bio)</span>, \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3627 \u3617 \u3640 \u3609 \u3648 \u3623 \u3637 \u3618 \u3609  <span class="eng">(Circular)</span>, \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3637 \u3648 \u3586 \u3637 \u3618 \u3623  <span class="eng">(Green)</span></li>\
            <li><span class="highlight">Net Zero:</span> \uc0\u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3585 \u3621 \u3634 \u3591 \u3607 \u3634 \u3591 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609  (\u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3611 \u3621 \u3641 \u3585 \u3611 \u3656 \u3634 \u3594 \u3634 \u3618 \u3648 \u3621 \u3609 /\u3621 \u3617 )</li>\
            <li><span class="highlight">Resilience:</span> \uc0\u3621 \u3657 \u3617 \u3649 \u3621 \u3657 \u3623 \u3621 \u3640 \u3585 \u3652 \u3623  (\u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3605 \u3633 \u3623 \u3619 \u3633 \u3610 \u3623 \u3636 \u3585 \u3620 \u3605 )</li>\
            <li><span class="highlight">Integration:</span> \uc0\u3585 \u3634 \u3619 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619  / \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3619 \u3656 \u3623 \u3617 \u3585 \u3633 \u3609 </li>\
        </ul>\
    </div>\
\
    <h2>\uc0\u55357 \u56424 \u8205 \u55357 \u56508  5. \u3610 \u3607 \u3610 \u3634 \u3607  "\u3609 \u3633 \u3585 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3649 \u3621 \u3632 \u3649 \u3612 \u3609 " (\u3626 \u3633 \u3591 \u3585 \u3633 \u3604 \u3585 \u3629 \u3591 \u3605 \u3619 \u3623 \u3592 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 )</h2>\
    <p>\uc0\u3616 \u3634 \u3619 \u3585 \u3636 \u3592 \u3627 \u3621 \u3633 \u3585 \u3649 \u3610 \u3656 \u3591 \u3648 \u3611 \u3655 \u3609  4 \u3604 \u3657 \u3634 \u3609 \u3605 \u3634 \u3617 \u3617 \u3634 \u3605 \u3619 \u3600 \u3634 \u3609 \u3586 \u3629 \u3591 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3626 \u3634 \u3618 \u3591 \u3634 \u3609 \u3609 \u3637 \u3657 :</p>\
    <ol>\
        <li><strong>\uc0\u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3585 \u3634 \u3619 :</strong> \u3619 \u3623 \u3610 \u3619 \u3623 \u3617  \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660  \u3611 \u3619 \u3632 \u3617 \u3623 \u3621 \u3612 \u3621 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621  \u3648 \u3614 \u3639 \u3656 \u3629 \u3592 \u3633 \u3604 \u3607 \u3635 \u3649 \u3612 \u3609 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660  \u3649 \u3621 \u3632 \u3605 \u3636 \u3604 \u3605 \u3634 \u3617 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3612 \u3621 \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 </li>\
        <li><strong>\uc0\u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3649 \u3612 \u3609 :</strong> \u3619 \u3656 \u3623 \u3617 \u3604 \u3635 \u3648 \u3609 \u3636 \u3609 \u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3649 \u3612 \u3609 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3586 \u3629 \u3591 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3651 \u3627 \u3657 \u3610 \u3619 \u3619 \u3621 \u3640 \u3612 \u3621 \u3626 \u3633 \u3617 \u3620 \u3607 \u3608 \u3636 \u3660  (SMART, Logframe)</li>\
        <li><strong>\uc0\u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3626 \u3634 \u3609 \u3591 \u3634 \u3609 :</strong> \u3611 \u3619 \u3632 \u3626 \u3634 \u3609 \u3591 \u3634 \u3609 \u3616 \u3634 \u3618 \u3651 \u3609 \u3649 \u3621 \u3632 \u3616 \u3634 \u3618 \u3609 \u3629 \u3585  \u3594 \u3637 \u3657 \u3649 \u3592 \u3591 \u3586 \u3657 \u3629 \u3648 \u3607 \u3655 \u3592 \u3592 \u3619 \u3636 \u3591 \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3588 \u3623 \u3634 \u3617 \u3619 \u3656 \u3623 \u3617 \u3617 \u3639 \u3629 </li>\
        <li><strong>\uc0\u3604 \u3657 \u3634 \u3609 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 :</strong> \u3648 \u3612 \u3618 \u3649 \u3614 \u3619 \u3656 \u3588 \u3623 \u3634 \u3617 \u3619 \u3641 \u3657  \u3651 \u3627 \u3657 \u3588 \u3635 \u3611 \u3619 \u3638 \u3585 \u3625 \u3634  \u3649 \u3609 \u3632 \u3609 \u3635 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3607 \u3635 \u3649 \u3612 \u3609 \u3591 \u3634 \u3609 /\u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 </li>\
    </ol>\
