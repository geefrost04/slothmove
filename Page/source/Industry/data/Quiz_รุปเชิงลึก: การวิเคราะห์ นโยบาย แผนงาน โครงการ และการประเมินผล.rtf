\
    <div class="question-box">\
        <div class="question">8. \uc0\u3585 \u3634 \u3619 \u3617 \u3637 \u3626 \u3656 \u3623 \u3609 \u3619 \u3656 \u3623 \u3617 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 \u3651 \u3609 \u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3649 \u3612 \u3609 \u3649 \u3621 \u3632 \u3585 \u3635 \u3627 \u3609 \u3604 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 </div>\
