    <h2>\uc0\u55356 \u57307 \u65039  1. \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3629 \u3591 \u3588 \u3660 \u3585 \u3619 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  (Organization Structure)</h2>\
    <p>\uc0\u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3617 \u3637 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3591 \u3634 \u3609 \u3649 \u3610 \u3610 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619  \u3650 \u3604 \u3618 \u3649 \u3610 \u3656 \u3591 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3585 \u3634 \u3619 \u3604 \u3635 \u3648 \u3609 \u3636 \u3609 \u3591 \u3634 \u3609 \u3605 \u3634 \u3617 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 \u3627 \u3621 \u3633 \u3585  \u3604 \u3633 \u3591 \u3609 \u3637 \u3657 :</p>\
\
    <h3>1.1 \uc0\u3612 \u3641 \u3657 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3619 \u3632 \u3604 \u3633 \u3610 \u3626 \u3641 \u3591 \u3626 \u3640 \u3604 </h3>\
    <ul>\
        <li><strong>\uc0\u3613 \u3656 \u3634 \u3618 \u3585 \u3634 \u3619 \u3648 \u3617 \u3639 \u3629 \u3591 :</strong> \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 \u3623 \u3656 \u3634 \u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  (\u3611 \u3633 \u3592 \u3592 \u3640 \u3610 \u3633 \u3609 \u3588 \u3639 \u3629  \u3609 \u3634 \u3618 \u3623 \u3619 \u3634 \u3623 \u3640 \u3608  \u3624 \u3636 \u3621 \u3611 \u3629 \u3634 \u3594 \u3634 )</li>\
        <li><strong>\uc0\u3613 \u3656 \u3634 \u3618 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3592 \u3635 :</strong> \u3611 \u3621 \u3633 \u3604 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  (\u3611 \u3633 \u3592 \u3592 \u3640 \u3610 \u3633 \u3609 \u3588 \u3639 \u3629  \u3609 \u3634 \u3618 \u3603 \u3633 \u3600 \u3614 \u3621  \u3619 \u3633 \u3591 \u3626 \u3636 \u3605 \u3614 \u3621 )</li>\
    </ul>\
\
    <h3>1.2 \uc0\u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3619 \u3632 \u3604 \u3633 \u3610 \u3585 \u3619 \u3617 \u3649 \u3621 \u3632 \u3585 \u3621 \u3640 \u3656 \u3617 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592  (Clusters & Departments)</h3>\
    <ul>\
        <li><strong>\uc0\u3626 \u3635 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 \u3611 \u3621 \u3633 \u3604 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  <span class="eng-vocab">(Office of the Permanent Secretary)</span>:</strong> \u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3585 \u3635 \u3627 \u3609 \u3604 \u3607 \u3636 \u3624 \u3607 \u3634 \u3591  \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660  \u3649 \u3621 \u3632 \u3592 \u3633 \u3604 \u3626 \u3619 \u3619 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 </li>\
        <li><strong>\uc0\u3585 \u3621 \u3640 \u3656 \u3617 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 \u3604 \u3657 \u3634 \u3609 \u3585 \u3635 \u3585 \u3633 \u3610 \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 :</strong> \u3585 \u3619 \u3617 \u3650 \u3619 \u3591 \u3591 \u3634 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  <span class="eng-vocab">(Department of Industrial Works)</span> \u3649 \u3621 \u3632  \u3585 \u3619 \u3617 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3648 \u3627 \u3617 \u3639 \u3629 \u3591 \u3649 \u3619 \u3656  <span class="eng-vocab">(Department of Primary Industries and Mines)</span></li>\
        <li><strong>\uc0\u3585 \u3621 \u3640 \u3656 \u3617 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 \u3604 \u3657 \u3634 \u3609 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 :</strong> \u3626 \u3635 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  <span class="eng-vocab">(Office of Industrial Economics)</span> \u3649 \u3621 \u3632  \u3626 \u3635 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 \u3588 \u3603 \u3632 \u3585 \u3619 \u3619 \u3617 \u3585 \u3634 \u3619 \u3629 \u3657 \u3629 \u3618 \u3649 \u3621 \u3632 \u3609 \u3657 \u3635 \u3605 \u3634 \u3621 \u3607 \u3619 \u3634 \u3618  <span class="eng-vocab">(Office of the Cane and Sugar Board)</span></li>\
        <li><strong>\uc0\u3585 \u3621 \u3640 \u3656 \u3617 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 \u3604 \u3657 \u3634 \u3609 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 :</strong> \u3585 \u3619 \u3617 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  <span class="eng-vocab">(Department of Industrial Promotion)</span> \u3649 \u3621 \u3632  \u3626 \u3635 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 \u3617 \u3634 \u3605 \u3619 \u3600 \u3634 \u3609 \u3612 \u3621 \u3636 \u3605 \u3616 \u3633 \u3603 \u3601 \u3660 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  <span class="eng-vocab">(Thai Industrial Standards Institute)</span></li>\
        <li><strong>\uc0\u3619 \u3633 \u3600 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 :</strong> \u3585 \u3634 \u3619 \u3609 \u3636 \u3588 \u3617 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3627 \u3656 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618  <span class="eng-vocab">(Industrial Estate Authority of Thailand)</span></li>\
        <li><strong>\uc0\u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3585 \u3635 \u3585 \u3633 \u3610 \u3619 \u3656 \u3623 \u3617 \u3585 \u3633 \u3610 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3585 \u3634 \u3619 \u3588 \u3621 \u3633 \u3591 :</strong> \u3608 \u3609 \u3634 \u3588 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3586 \u3609 \u3634 \u3604 \u3585 \u3621 \u3634 \u3591 \u3649 \u3621 \u3632 \u3586 \u3609 \u3634 \u3604 \u3618 \u3656 \u3629 \u3617 \u3649 \u3627 \u3656 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618  (SME D Bank)</li>\
    </ul>\
\
    <h2>\uc0\u55356 \u57263  2. \u3623 \u3636 \u3626 \u3633 \u3618 \u3607 \u3633 \u3624 \u3609 \u3660  \u3614 \u3633 \u3609 \u3608 \u3585 \u3636 \u3592  \u3649 \u3621 \u3632 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660  (Strategic Direction \u3614 .\u3624 . 2566 - 2570)</h2>\
\
    <h3>2.1 \uc0\u3616 \u3634 \u3614 \u3619 \u3623 \u3617 \u3619 \u3632 \u3604 \u3633 \u3610 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 </h3>\
    <ul>\
        <li><span class="highlight">\uc0\u3623 \u3636 \u3626 \u3633 \u3618 \u3607 \u3633 \u3624 \u3609 \u3660 :</span> \'93\u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3652 \u3607 \u3618 \u3626 \u3641 \u3656 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3607 \u3637 \u3656 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \u3588 \u3641 \u3656 \u3594 \u3640 \u3617 \u3594 \u3609 \'94</li>\
        <li><strong>\uc0\u3614 \u3633 \u3609 \u3608 \u3585 \u3636 \u3592  4 \u3604 \u3657 \u3634 \u3609 :</strong>\
            <ol>\
                <li>\uc0\u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3652 \u3604 \u3657 \u3651 \u3609 \u3605 \u3621 \u3634 \u3604 \u3650 \u3621 \u3585 \u3604 \u3657 \u3623 \u3618 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3621 \u3632 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 </li>\
                <li>\uc0\u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3649 \u3621 \u3632 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3609 \u3636 \u3648 \u3623 \u3624 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  (Ecosystem) \u3626 \u3641 \u3656 \u3618 \u3640 \u3588 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  4.0</li>\
                <li>\uc0\u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3636 \u3592 \u3585 \u3634 \u3619 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3605 \u3634 \u3617 \u3650 \u3617 \u3648 \u3604 \u3621 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592  BCG</li>\
                <li>\uc0\u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3591 \u3588 \u3660 \u3585 \u3619 \u3626 \u3641 \u3656 \u3629 \u3591 \u3588 \u3660 \u3585 \u3619 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3648 \u3614 \u3639 \u3656 \u3629 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3629 \u3618 \u3656 \u3634 \u3591 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 </li>\
            </ol>\
        </li>\
    </ul>\
\
    <h3>2.2 \uc0\u3616 \u3634 \u3614 \u3619 \u3623 \u3617 \u3619 \u3632 \u3604 \u3633 \u3610 \u3626 \u3635 \u3609 \u3633 \u3585 \u3591 \u3634 \u3609 \u3611 \u3621 \u3633 \u3604 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  (\u3626 \u3611 .\u3629 \u3585 .)</h3>\
    <ul>\
        <li><span class="highlight">\uc0\u3623 \u3636 \u3626 \u3633 \u3618 \u3607 \u3633 \u3624 \u3609 \u3660  \u3626 \u3611 .\u3629 \u3585 .:</span> \'93\u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3649 \u3621 \u3632 \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3651 \u3627 \u3657 \u3648 \u3605 \u3636 \u3610 \u3650 \u3605 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 \'94</li>\
        <li><strong>\uc0\u3629 \u3635 \u3609 \u3634 \u3592 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3627 \u3621 \u3633 \u3585 :</strong> \u3624 \u3638 \u3585 \u3625 \u3634  \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660  \u3592 \u3633 \u3604 \u3607 \u3635 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3626 \u3609 \u3629 \u3649 \u3609 \u3632 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3605 \u3656 \u3629 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 , \u3614 \u3633 \u3602 \u3609 \u3634 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 , \u3649 \u3611 \u3621 \u3591 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3648 \u3611 \u3655 \u3609 \u3649 \u3612 \u3609 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3591 \u3634 \u3609 , \u3592 \u3633 \u3604 \u3626 \u3619 \u3619 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 , \u3649 \u3621 \u3632 \u3585 \u3635 \u3585 \u3633 \u3610 \u3605 \u3636 \u3604 \u3605 \u3634 \u3617 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3591 \u3634 \u3609 \u3586 \u3629 \u3591 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3651 \u3609 \u3626 \u3633 \u3591 \u3585 \u3633 \u3604 </li>\
    </ul>\
\
    <h2>\uc0\u55358 \u56800  3. \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3629 \u3591 \u3588 \u3660 \u3585 \u3619 \u3649 \u3621 \u3632 \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 \u3592 \u3636 \u3605 \u3629 \u3634 \u3626 \u3634  (MIND & CSR)</h2>\
    <p>\uc0\u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3609 \u3657 \u3629 \u3617 \u3609 \u3635 \u3614 \u3619 \u3632 \u3610 \u3619 \u3617 \u3619 \u3634 \u3650 \u3594 \u3610 \u3634 \u3618 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3592 \u3636 \u3605 \u3629 \u3634 \u3626 \u3634  \u3617 \u3634 \u3612 \u3609 \u3623 \u3585 \u3585 \u3633 \u3610 \u3649 \u3609 \u3623 \u3588 \u3636 \u3604  <span class="highlight">MIND</span> (\u3651 \u3594 \u3657  "\u3627 \u3633 \u3623 " \u3649 \u3621 \u3632  "\u3651 \u3592 " \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 ) \u3612 \u3656 \u3634 \u3609 \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 \u3648 \u3619 \u3639 \u3629 \u3608 \u3591  <strong>"\u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3619 \u3623 \u3617 \u3651 \u3592  \u3604 \u3641 \u3649 \u3621 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617  \u3604 \u3636 \u3609  \u3609 \u3657 \u3635  \u3621 \u3617  \u3652 \u3615 "</strong></p>\
    <ul>\
        <li><strong>\uc0\u3604 \u3636 \u3609  (\u3614 \u3633 \u3602 \u3609 \u3634 \u3611 \u3600 \u3614 \u3637 ):</strong> \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656 \u3611 \u3621 \u3641 \u3585 \u3629 \u3657 \u3629 \u3618  100,000 \u3652 \u3619 \u3656  \u3604 \u3657 \u3623 \u3618 \u3585 \u3634 \u3585 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3607 \u3637 \u3656 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618  \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3627 \u3617 \u3640 \u3609 \u3648 \u3623 \u3637 \u3618 \u3609  (Circular Economy)</li>\
        <li><strong>\uc0\u3609 \u3657 \u3635  (\u3615 \u3639 \u3657 \u3609 \u3615 \u3641 \u3649 \u3627 \u3621 \u3656 \u3591 \u3609 \u3657 \u3635 ):</strong> \u3585 \u3636 \u3592 \u3585 \u3619 \u3619 \u3617 \u3604 \u3641 \u3649 \u3621 \u3588 \u3621 \u3629 \u3591  72 \u3626 \u3634 \u3618  \u3605 \u3619 \u3623 \u3592 \u3623 \u3633 \u3604 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3609 \u3657 \u3635  \u3649 \u3621 \u3632 \u3605 \u3636 \u3604 \u3605 \u3633 \u3657 \u3591 \u3619 \u3632 \u3610 \u3610 \u3604 \u3633 \u3585 \u3652 \u3586 \u3617 \u3633 \u3609 </li>\
        <li><strong>\uc0\u3621 \u3617  (\u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3629 \u3634 \u3585 \u3634 \u3624 ):</strong> \u3611 \u3621 \u3641 \u3585 \u3611 \u3656 \u3634 \u3594 \u3634 \u3618 \u3648 \u3621 \u3609 \u3648 \u3614 \u3636 \u3656 \u3617 \u3614 \u3639 \u3657 \u3609 \u3607 \u3637 \u3656 \u3626 \u3637 \u3648 \u3586 \u3637 \u3618 \u3623  \u3617 \u3640 \u3656 \u3591 \u3626 \u3641 \u3656 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3585 \u3621 \u3634 \u3591 \u3607 \u3634 \u3591 \u3588 \u3634 \u3619 \u3660 \u3610 \u3629 \u3609  (Net Zero) \u3649 \u3621 \u3632 \u3621 \u3604 \u3613 \u3640 \u3656 \u3609  PM 2.5</li>\
        <li><strong>\uc0\u3652 \u3615  (\u3588 \u3623 \u3634 \u3617 \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618 ):</strong> \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 \u3614 \u3636 \u3607 \u3633 \u3585 \u3625 \u3660 \u3624 \u3634 \u3626 \u3609 \u3626 \u3606 \u3634 \u3609  87 \u3649 \u3627 \u3656 \u3591  \u3626 \u3656 \u3591 \u3623 \u3636 \u3624 \u3623 \u3585 \u3619 \u3592 \u3636 \u3605 \u3629 \u3634 \u3626 \u3634 \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3619 \u3632 \u3610 \u3610 \u3652 \u3615 \u3615 \u3657 \u3634 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3629 \u3633 \u3588 \u3588 \u3637 \u3616 \u3633 \u3618 </li>\
        <li><strong>\uc0\u3594 \u3656 \u3623 \u3618 \u3648 \u3627 \u3621 \u3639 \u3629 \u3626 \u3633 \u3591 \u3588 \u3617 :</strong> \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 \u3609 \u3617 \u3592 \u3636 \u3605 \u3629 \u3634 \u3626 \u3634 \u3607 \u3604 \u3649 \u3607 \u3609 \u3609 \u3617 \u3649 \u3617 \u3656 \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3604 \u3655 \u3585 \u3585 \u3635 \u3614 \u3619 \u3657 \u3634  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3648 \u3605 \u3619 \u3637 \u3618 \u3617 \u3606 \u3640 \u3591 \u3618 \u3633 \u3591 \u3594 \u3637 \u3614 \u3594 \u3656 \u3623 \u3618 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3626 \u3610 \u3616 \u3633 \u3618 \u3614 \u3636 \u3610 \u3633 \u3605 \u3636 </li>\
    </ul>\
\
    <h2>\uc0\u55357 \u56538  4. \u3588 \u3621 \u3633 \u3591 \u3588 \u3635 \u3624 \u3633 \u3614 \u3607 \u3660 \u3593 \u3610 \u3633 \u3610 \u3592 \u3633 \u3604 \u3648 \u3605 \u3655 \u3617  (Comprehensive Vocabulary)</h2>\
\
    <div class="vocab-box">\
        <h3>\uc0\u55357 \u56481  \u3627 \u3617 \u3623 \u3604 \u3588 \u3656 \u3634 \u3609 \u3636 \u3618 \u3617 \u3649 \u3621 \u3632 \u3623 \u3636 \u3626 \u3633 \u3618 \u3607 \u3633 \u3624 \u3609 \u3660  (Core Values & Vision)</h3>\
        <ul>\
            <li><span class="highlight">ASIA:</span> \uc0\u3588 \u3656 \u3634 \u3609 \u3636 \u3618 \u3617 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3604 \u3657 \u3623 \u3618  <strong>A</strong>ccountability (\u3588 \u3623 \u3634 \u3617 \u3619 \u3633 \u3610 \u3612 \u3636 \u3604 \u3594 \u3629 \u3610 ), <strong>S</strong>uggestion (\u3585 \u3634 \u3619 \u3648 \u3626 \u3609 \u3629 \u3649 \u3609 \u3632 \u3629 \u3618 \u3656 \u3634 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3619 \u3619 \u3588 \u3660 ), <strong>I</strong>ntegrity (\u3588 \u3623 \u3634 \u3617 \u3595 \u3639 \u3656 \u3629 \u3626 \u3633 \u3605 \u3618 \u3660 \u3626 \u3640 \u3592 \u3619 \u3636 \u3605 ), <strong>A</strong>chievement Motivation (\u3617 \u3640 \u3656 \u3591 \u3612 \u3621 \u3626 \u3633 \u3617 \u3620 \u3607 \u3608 \u3636 \u3660 )</li>\
            <li><span class="highlight">MIND:</span> \uc0\u3649 \u3609 \u3623 \u3588 \u3636 \u3604 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3627 \u3633 \u3623 \u3649 \u3621 \u3632 \u3651 \u3592 \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3591 \u3634 \u3609  \u3617 \u3640 \u3656 \u3591 \u3626 \u3635 \u3648 \u3619 \u3655 \u3592  4 \u3617 \u3636 \u3605 \u3636  \u3588 \u3639 \u3629  \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 , \u3626 \u3633 \u3591 \u3588 \u3617 /\u3594 \u3640 \u3617 \u3594 \u3609 , \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 , \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3592 \u3634 \u3618 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 </li>\
            <li><span class="highlight">BCG Model:</span> \uc0\u3650 \u3617 \u3648 \u3604 \u3621 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3594 \u3637 \u3623 \u3616 \u3634 \u3614  (Bio) \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3627 \u3617 \u3640 \u3609 \u3648 \u3623 \u3637 \u3618 \u3609  (Circular) \u3649 \u3621 \u3632 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3626 \u3637 \u3648 \u3586 \u3637 \u3618 \u3623  (Green)</li>\
            <li><span class="highlight">Ecosystem:</span> \uc0\u3619 \u3632 \u3610 \u3610 \u3609 \u3636 \u3648 \u3623 \u3624 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617  \u3627 \u3619 \u3639 \u3629  \u3626 \u3616 \u3634 \u3614 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617 \u3649 \u3621 \u3632 \u3611 \u3633 \u3592 \u3592 \u3633 \u3618 \u3648 \u3585 \u3639 \u3657 \u3629 \u3627 \u3609 \u3640 \u3609 \u3607 \u3637 \u3656 \u3648 \u3629 \u3639 \u3657 \u3629 \u3605 \u3656 \u3629 \u3585 \u3634 \u3619 \u3607 \u3635 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 </li>\
            <li><span class="highlight">Sustainability:</span> \uc0\u3588 \u3623 \u3634 \u3617 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 </li>\
        </ul>\
    </div>\
\
    <div class="vocab-box">\
        <h3>\uc0\u55357 \u56523  \u3627 \u3617 \u3623 \u3604 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3649 \u3621 \u3632 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618  (Administration & Policy)</h3>\
        <ul>\
            <li><span class="highlight">Strategic Planning:</span> \uc0\u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3649 \u3612 \u3609 \u3648 \u3594 \u3636 \u3591 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 </li>\
            <li><span class="highlight">Action Plan:</span> \uc0\u3649 \u3612 \u3609 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </li>\
            <li><span class="highlight">Good Governance:</span> \uc0\u3627 \u3621 \u3633 \u3585 \u3608 \u3619 \u3619 \u3617 \u3634 \u3616 \u3636 \u3610 \u3634 \u3621  / \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3585 \u3636 \u3592 \u3585 \u3634 \u3619 \u3610 \u3657 \u3634 \u3609 \u3648 \u3617 \u3639 \u3629 \u3591 \u3607 \u3637 \u3656 \u3604 \u3637 </li>\
            <li><span class="highlight">Integration:</span> \uc0\u3585 \u3634 \u3619 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619  / \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3619 \u3656 \u3623 \u3617 \u3585 \u3633 \u3609 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 </li>\
            <li><span class="highlight">Resilience:</span> \uc0\u3588 \u3623 \u3634 \u3617 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3609 \u3585 \u3634 \u3619 \u3611 \u3619 \u3633 \u3610 \u3605 \u3633 \u3623 \u3619 \u3633 \u3610 \u3617 \u3639 \u3629 \u3623 \u3636 \u3585 \u3620 \u3605  (\u3621 \u3657 \u3617 \u3649 \u3621 \u3657 \u3623  \u3621 \u3640 \u3585 \u3652 \u3623 )</li>\
            <li><span class="highlight">Zero-Based Budgeting (ZBB):</span> \uc0\u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3649 \u3610 \u3610 \u3600 \u3634 \u3609 \u3624 \u3641 \u3609 \u3618 \u3660  (\u3614 \u3636 \u3592 \u3634 \u3619 \u3603 \u3634 \u3619 \u3634 \u3618 \u3592 \u3656 \u3634 \u3618 \u3651 \u3627 \u3617 \u3656 \u3607 \u3633 \u3657 \u3591 \u3627 \u3617 \u3604 \u3607 \u3640 \u3585 \u3611 \u3637 )</li>\
        </ul>\
    </div>\
\
    <div class="vocab-box">\
        <h3>\uc0\u55357 \u56520  \u3627 \u3617 \u3623 \u3604 \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3648 \u3617 \u3636 \u3609 \u3612 \u3621  (Monitoring & Evaluation)</h3>\
        <ul>\
            <li><span class="highlight">KPIs (Key Performance Indicators):</span> \uc0\u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3612 \u3621 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3591 \u3634 \u3609 \u3627 \u3621 \u3633 \u3585 </li>\
            <li><span class="highlight">Input Indicators:</span> \uc0\u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3611 \u3633 \u3592 \u3592 \u3633 \u3618 \u3609 \u3635 \u3648 \u3586 \u3657 \u3634  (\u3648 \u3594 \u3656 \u3609  \u3592 \u3635 \u3609 \u3623 \u3609 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603  \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 )</li>\
            <li><span class="highlight">Process Indicators:</span> \uc0\u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3604 \u3635 \u3648 \u3609 \u3636 \u3609 \u3591 \u3634 \u3609 </li>\
            <li><span class="highlight">Output Indicators:</span> \uc0\u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3612 \u3621 \u3612 \u3621 \u3636 \u3605  (\u3626 \u3636 \u3656 \u3591 \u3607 \u3637 \u3656 \u3652 \u3604 \u3657 \u3607 \u3633 \u3609 \u3607 \u3637 \u3648 \u3617 \u3639 \u3656 \u3629 \u3592 \u3610 \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619  \u3648 \u3594 \u3656 \u3609  \u3592 \u3635 \u3609 \u3623 \u3609 \u3588 \u3609 \u3648 \u3586 \u3657 \u3634 \u3629 \u3610 \u3619 \u3617 )</li>\
            <li><span class="highlight">Outcome Indicators:</span> \uc0\u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3612 \u3621 \u3621 \u3633 \u3614 \u3608 \u3660  (\u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3619 \u3632 \u3604 \u3633 \u3610 \u3585 \u3621 \u3634 \u3591  \u3648 \u3594 \u3656 \u3609  \u3588 \u3623 \u3634 \u3617 \u3614 \u3638 \u3591 \u3614 \u3629 \u3651 \u3592  \u3627 \u3619 \u3639 \u3629 \u3585 \u3634 \u3619 \u3609 \u3635 \u3588 \u3623 \u3634 \u3617 \u3619 \u3641 \u3657 \u3652 \u3611 \u3651 \u3594 \u3657 )</li>\
            <li><span class="highlight">Impact Indicators:</span> \uc0\u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610  (\u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3649 \u3611 \u3621 \u3591 \u3619 \u3632 \u3618 \u3632 \u3618 \u3634 \u3623  \u3648 \u3594 \u3656 \u3609  \u3585 \u3634 \u3619 \u3621 \u3604 \u3621 \u3591 \u3586 \u3629 \u3591 \u3585 \u3658 \u3634 \u3595 \u3648 \u3619 \u3639 \u3629 \u3609 \u3585 \u3619 \u3632 \u3592 \u3585 )</li>\
            <li><span class="highlight">CBA (Cost-Benefit Analysis):</span> \uc0\u3585 \u3634 \u3619 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3605 \u3657 \u3609 \u3607 \u3640 \u3609 \u3649 \u3621 \u3632 \u3612 \u3621 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3651 \u3609 \u3619 \u3641 \u3611 \u3605 \u3633 \u3623 \u3648 \u3591 \u3636 \u3609 </li>\
        </ul>\
    </div>\
