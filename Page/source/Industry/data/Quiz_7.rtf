    <div class="q-box"><div class="question">35. \uc0\u3651 \u3609 \u3585 \u3634 \u3619 \u3648 \u3586 \u3637 \u3618 \u3609  "\u3629 \u3657 \u3634 \u3591 \u3606 \u3638 \u3591 " \u3605 \u3657 \u3629 \u3591 \u3619 \u3632 \u3610 \u3640 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3651 \u3604 \u3610 \u3657 \u3634 \u3591 ?</div>\
    <ul class="choices"><li>\uc0\u3585 . \u3619 \u3632 \u3610 \u3640 \u3649 \u3588 \u3656 \u3594 \u3639 \u3656 \u3629 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 </li><li>\u3586 . \u3619 \u3632 \u3610 \u3640 \u3611 \u3619 \u3632 \u3648 \u3616 \u3607 \u3626 \u3636 \u3656 \u3591 \u3614 \u3636 \u3617 \u3614 \u3660  \u3594 \u3639 \u3656 \u3629 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3648 \u3592 \u3657 \u3634 \u3586 \u3629 \u3591 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629  \u3648 \u3621 \u3586 \u3607 \u3637 \u3656  \u3649 \u3621 \u3632 \u3623 \u3633 \u3609 \u3648 \u3604 \u3639 \u3629 \u3609 \u3611 \u3637 \u3607 \u3637 \u3656 \u3629 \u3629 \u3585 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 </li><li>\u3588 . \u3619 \u3632 \u3610 \u3640 \u3594 \u3639 \u3656 \u3629 \u3612 \u3641 \u3657 \u3648 \u3595 \u3655 \u3609 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3593 \u3610 \u3633 \u3610 \u3585 \u3656 \u3629 \u3609 </li><li>\u3591 . \u3619 \u3632 \u3610 \u3640 \u3648 \u3593 \u3614 \u3634 \u3632 \u3648 \u3621 \u3586 \u3607 \u3637 \u3656 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 </li></ul></div>\
\
    <div class="q-box"><div class="question">36. \uc0\u3627 \u3633 \u3623 \u3586 \u3657 \u3629  "\u3626 \u3636 \u3656 \u3591 \u3607 \u3637 \u3656 \u3626 \u3656 \u3591 \u3617 \u3634 \u3604 \u3657 \u3623 \u3618 " \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3619 \u3603 \u3637 \u3651 \u3604 ?</div>\
    <ul class="choices"><li>\uc0\u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3649 \u3592 \u3657 \u3591 \u3594 \u3656 \u3629 \u3591 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3605 \u3636 \u3604 \u3605 \u3656 \u3629 \u3585 \u3621 \u3633 \u3610 </li><li>\u3586 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3629 \u3657 \u3634 \u3591 \u3629 \u3636 \u3591 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 </li><li>\u3588 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3621 \u3591 \u3594 \u3639 \u3656 \u3629 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 /\u3626 \u3636 \u3656 \u3591 \u3586 \u3629 \u3591 \u3607 \u3637 \u3656 \u3626 \u3656 \u3591 \u3652 \u3611 \u3614 \u3619 \u3657 \u3629 \u3617 \u3585 \u3633 \u3610 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 </li><li>\u3591 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3619 \u3632 \u3610 \u3640 \u3605 \u3633 \u3623 \u3610 \u3640 \u3588 \u3588 \u3621 \u3607 \u3637 \u3656 \u3609 \u3635 \u3626 \u3656 \u3591 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 </li></ul></div>\
