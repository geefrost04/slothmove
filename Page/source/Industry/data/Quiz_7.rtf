    <div class="q-box"><div class="question">37. \uc0\u3627 \u3634 \u3585 \u3626 \u3636 \u3656 \u3591 \u3607 \u3637 \u3656 \u3626 \u3656 \u3591 \u3617 \u3634 \u3604 \u3657 \u3623 \u3618 \u3652 \u3617 \u3656 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3610 \u3619 \u3619 \u3592 \u3640 \u3651 \u3626 \u3656 \u3595 \u3629 \u3591 \u3648 \u3604 \u3637 \u3618 \u3623 \u3585 \u3633 \u3609 \u3585 \u3633 \u3610 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3652 \u3604 \u3657  \u3605 \u3657 \u3629 \u3591 \u3607 \u3635 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 ?</div>\
    <ul class="choices"><li>\uc0\u3585 . \u3652 \u3617 \u3656 \u3605 \u3657 \u3629 \u3591 \u3626 \u3656 \u3591 \u3652 \u3611 </li><li>\u3586 . \u3651 \u3627 \u3657 \u3618 \u3585 \u3648 \u3621 \u3636 \u3585 \u3627 \u3633 \u3623 \u3586 \u3657 \u3629 \u3609 \u3637 \u3657 \u3607 \u3636 \u3657 \u3591 \u3652 \u3611 </li><li>\u3588 . \u3651 \u3627 \u3657 \u3649 \u3592 \u3657 \u3591 \u3604 \u3657 \u3623 \u3618 \u3623 \u3656 \u3634 \u3626 \u3656 \u3591 \u3652 \u3611 \u3650 \u3604 \u3618 \u3607 \u3634 \u3591 \u3652 \u3627 \u3609  (\u3648 \u3594 \u3656 \u3609  \u3626 \u3656 \u3591 \u3607 \u3634 \u3591 \u3614 \u3633 \u3626 \u3604 \u3640 \u3652 \u3611 \u3619 \u3625 \u3603 \u3637 \u3618 \u3660 )</li><li>\u3591 . \u3651 \u3627 \u3657 \u3612 \u3641 \u3657 \u3619 \u3633 \u3610 \u3617 \u3634 \u3619 \u3633 \u3610 \u3604 \u3657 \u3623 \u3618 \u3605 \u3609 \u3648 \u3629 \u3591 </li></ul></div>\
