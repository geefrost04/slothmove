    <h1>\uc0\u55357 \u56541  \u3586 \u3657 \u3629 \u3626 \u3629 \u3610 \u3592 \u3635 \u3621 \u3629 \u3591  100 \u3586 \u3657 \u3629 </h1>\
    <h3>\uc0\u3627 \u3633 \u3623 \u3586 \u3657 \u3629 : \u3588 \u3623 \u3634 \u3617 \u3619 \u3641 \u3657 \u3648 \u3610 \u3639 \u3657 \u3629 \u3591 \u3605 \u3657 \u3609 \u3585 \u3634 \u3619 \u3648 \u3586 \u3637 \u3618 \u3609 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619  (\u3629 \u3657 \u3634 \u3591 \u3629 \u3636 \u3591 \u3592 \u3634 \u3585 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610 \u3591 \u3634 \u3609 \u3626 \u3634 \u3619 \u3610 \u3619 \u3619 \u3603 )</h3>\
\
    <!-- \uc0\u3588 \u3635 \u3606 \u3634 \u3617  1-10: \u3609 \u3636 \u3618 \u3634 \u3617 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597  -->\
    <div class="q-box"><div class="question">1. \uc0\u3605 \u3634 \u3617 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610 \u3591 \u3634 \u3609 \u3626 \u3634 \u3619 \u3610 \u3619 \u3619 \u3603  "\u3591 \u3634 \u3609 \u3626 \u3634 \u3619 \u3610 \u3619 \u3619 \u3603 " \u3627 \u3617 \u3634 \u3618 \u3606 \u3638 \u3591 \u3629 \u3632 \u3652 \u3619 ?</div>\
    <ul class="choices"><li>\uc0\u3585 . \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3595 \u3639 \u3657 \u3629 \u3592 \u3633 \u3604 \u3592 \u3657 \u3634 \u3591 </li><li>\u3586 . \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3591 \u3634 \u3609 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619  \u3648 \u3619 \u3636 \u3656 \u3617 \u3605 \u3633 \u3657 \u3591 \u3649 \u3605 \u3656 \u3592 \u3633 \u3604 \u3607 \u3635 \u3592 \u3609 \u3606 \u3638 \u3591 \u3607 \u3635 \u3621 \u3634 \u3618 </li><li>\u3588 . \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619 \u3610 \u3640 \u3588 \u3588 \u3621 </li><li>\u3591 . \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3619 \u3656 \u3634 \u3591 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 </li></ul></div>\
\
    <div class="q-box"><div class="question">2. \uc0\u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3626 \u3640 \u3604 \u3607 \u3657 \u3634 \u3618 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3591 \u3634 \u3609 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3605 \u3634 \u3617 \u3609 \u3636 \u3618 \u3634 \u3617 \u3586 \u3629 \u3591 \u3591 \u3634 \u3609 \u3626 \u3634 \u3619 \u3610 \u3619 \u3619 \u3603 \u3588 \u3639 \u3629 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3651 \u3604 ?</div>\
    <ul class="choices"><li>\uc0\u3585 . \u3585 \u3634 \u3619 \u3648 \u3585 \u3655 \u3610 \u3619 \u3633 \u3585 \u3625 \u3634 </li><li>\u3586 . \u3585 \u3634 \u3619 \u3618 \u3639 \u3617 </li><li>\u3588 . \u3585 \u3634 \u3619 \u3607 \u3635 \u3621 \u3634 \u3618 </li><li>\u3591 . \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3626 \u3656 \u3591 </li></ul></div>\
\
    <div class="q-box"><div class="question">3. \uc0\u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3607 \u3635 \u3621 \u3634 \u3618 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3651 \u3609 \u3591 \u3634 \u3609 \u3626 \u3634 \u3619 \u3610 \u3619 \u3619 \u3603 \u3588 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 ?</div>\
    <ul class="choices"><li>\uc0\u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3611 \u3585 \u3611 \u3636 \u3604 \u3588 \u3623 \u3634 \u3617 \u3621 \u3633 \u3610 \u3607 \u3634 \u3591 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </li><li>\u3586 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3652 \u3617 \u3656 \u3651 \u3627 \u3657 \u3617 \u3637 \u3585 \u3634 \u3619 \u3648 \u3585 \u3655 \u3610 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3607 \u3637 \u3656 \u3652 \u3617 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3652 \u3623 \u3657 \u3651 \u3609 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </li><li>\u3588 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3611 \u3619 \u3632 \u3627 \u3618 \u3633 \u3604 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3595 \u3639 \u3657 \u3629 \u3585 \u3619 \u3632 \u3604 \u3634 \u3625 </li><li>\u3591 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3621 \u3604 \u3592 \u3635 \u3609 \u3623 \u3609 \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 </li></ul></div>\
\
    <div class="q-box"><div class="question">4. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3652 \u3617 \u3656 \u3651 \u3594 \u3656 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3591 \u3634 \u3609 \u3626 \u3634 \u3619 \u3610 \u3619 \u3619 \u3603 ?</div>\
    <ul class="choices"><li>\uc0\u3585 . \u3648 \u3611 \u3655 \u3609 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3607 \u3637 \u3656 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3629 \u3657 \u3634 \u3591 \u3629 \u3636 \u3591 </li><li>\u3586 . \u3648 \u3611 \u3655 \u3609 \u3627 \u3621 \u3633 \u3585 \u3600 \u3634 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3617 \u3637 \u3588 \u3640 \u3603 \u3588 \u3656 \u3634 </li><li>\u3588 . \u3648 \u3611 \u3655 \u3609 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3607 \u3637 \u3656 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3626 \u3623 \u3591 \u3627 \u3634 \u3612 \u3621 \u3585 \u3635 \u3652 \u3619 </li><li>\u3591 . \u3648 \u3611 \u3655 \u3609 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3607 \u3637 \u3656 \u3594 \u3656 \u3623 \u3618 \u3651 \u3609 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </li></ul></div>\
\
    <div class="q-box"><div class="question">5. "\uc0\u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 " \u3605 \u3634 \u3617 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610 \u3627 \u3617 \u3634 \u3618 \u3606 \u3638 \u3591 \u3629 \u3632 \u3652 \u3619 ?</div>\
    <ul class="choices"><li>\uc0\u3585 . \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3614 \u3636 \u3617 \u3614 \u3660 \u3586 \u3629 \u3591 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 </li><li>\u3586 . \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3627 \u3621 \u3633 \u3585 \u3600 \u3634 \u3609 \u3651 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </li><li>\u3588 . \u3605 \u3635 \u3619 \u3634 \u3648 \u3619 \u3637 \u3618 \u3609 \u3651 \u3609 \u3626 \u3606 \u3634 \u3609 \u3624 \u3638 \u3585 \u3625 \u3634 \u3586 \u3629 \u3591 \u3619 \u3633 \u3600 </li><li>\u3591 . \u3626 \u3617 \u3640 \u3604 \u3610 \u3633 \u3609 \u3607 \u3638 \u3585 \u3586 \u3629 \u3591 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </li></ul></div>\
\
    <div class="q-box"><div class="question">6. \uc0\u3586 \u3657 \u3629 \u3651 \u3604  \u3652 \u3617 \u3656 \u3648 \u3586 \u3657 \u3634 \u3586 \u3656 \u3634 \u3618  \u3648 \u3611 \u3655 \u3609 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 ?</div>\
    <ul class="choices"><li>\uc0\u3585 . \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3607 \u3637 \u3656 \u3617 \u3637 \u3652 \u3611 \u3617 \u3634 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </li><li>\u3586 . \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3607 \u3637 \u3656 \u3607 \u3634 \u3591 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3607 \u3635 \u3586 \u3638 \u3657 \u3609 \u3605 \u3634 \u3617 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 </li><li>\u3588 . \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3607 \u3637 \u3656 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3617 \u3637 \u3652 \u3611 \u3606 \u3638 \u3591 \u3610 \u3640 \u3588 \u3588 \u3621 \u3616 \u3634 \u3618 \u3609 \u3629 \u3585 </li><li>\u3591 . \u3592 \u3604 \u3627 \u3617 \u3634 \u3618 \u3626 \u3656 \u3623 \u3609 \u3605 \u3633 \u3623 \u3586 \u3629 \u3591 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3626 \u3656 \u3591 \u3606 \u3638 \u3591 \u3648 \u3614 \u3639 \u3656 \u3629 \u3609 </li></ul></div>\
