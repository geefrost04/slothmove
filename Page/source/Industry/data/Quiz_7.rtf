    <div class="q-box"><div class="question">39. \uc0\u3627 \u3634 \u3585 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3616 \u3634 \u3618 \u3609 \u3629 \u3585 \u3651 \u3594 \u3657 \u3588 \u3635 \u3586 \u3638 \u3657 \u3609 \u3605 \u3657 \u3609 \u3623 \u3656 \u3634  "\u3585 \u3619 \u3634 \u3610 \u3648 \u3619 \u3637 \u3618 \u3609 " \u3588 \u3623 \u3619 \u3651 \u3594 \u3657 \u3588 \u3635 \u3621 \u3591 \u3607 \u3657 \u3634 \u3618 \u3623 \u3656 \u3634 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 ?</div>\
    <ul class="choices"><li>\uc0\u3585 . \u3586 \u3629 \u3649 \u3626 \u3604 \u3591 \u3588 \u3623 \u3634 \u3617 \u3609 \u3633 \u3610 \u3606 \u3639 \u3629 </li><li>\u3586 . \u3586 \u3629 \u3649 \u3626 \u3604 \u3591 \u3588 \u3623 \u3634 \u3617 \u3648 \u3588 \u3634 \u3619 \u3614 </li><li>\u3588 . \u3586 \u3629 \u3649 \u3626 \u3604 \u3591 \u3588 \u3623 \u3634 \u3617 \u3609 \u3633 \u3610 \u3606 \u3639 \u3629 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3636 \u3656 \u3591 </li><li>\u3591 . \u3604 \u3657 \u3623 \u3618 \u3588 \u3623 \u3634 \u3617 \u3648 \u3588 \u3634 \u3619 \u3614 \u3629 \u3618 \u3656 \u3634 \u3591 \u3626 \u3641 \u3591 </li></ul></div>\
\
    <div class="q-box"><div class="question">40. \uc0\u3585 \u3634 \u3619 \u3621 \u3591 \u3594 \u3639 \u3656 \u3629 \u3651 \u3609 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3616 \u3634 \u3618 \u3609 \u3629 \u3585  \u3627 \u3634 \u3585 \u3648 \u3592 \u3657 \u3634 \u3586 \u3629 \u3591 \u3621 \u3634 \u3618 \u3617 \u3639 \u3629 \u3594 \u3639 \u3656 \u3629 \u3648 \u3611 \u3655 \u3609 \u3610 \u3640 \u3588 \u3588 \u3621 \u3608 \u3619 \u3619 \u3617 \u3604 \u3634  \u3651 \u3627 \u3657 \u3614 \u3636 \u3617 \u3614 \u3660 \u3594 \u3639 \u3656 \u3629 \u3648 \u3605 \u3655 \u3617 \u3651 \u3605 \u3657 \u3621 \u3634 \u3618 \u3617 \u3639 \u3629 \u3594 \u3639 \u3656 \u3629 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 ?</div>\
    <ul class="choices"><li>\uc0\u3585 . \u3652 \u3617 \u3656 \u3605 \u3657 \u3629 \u3591 \u3617 \u3637 \u3588 \u3635 \u3609 \u3635 \u3627 \u3609 \u3657 \u3634 \u3594 \u3639 \u3656 \u3629 </li><li>\u3586 . \u3651 \u3627 \u3657 \u3617 \u3637 \u3588 \u3635 \u3609 \u3635 \u3627 \u3609 \u3657 \u3634 \u3594 \u3639 \u3656 \u3629  (\u3609 \u3634 \u3618  \u3609 \u3634 \u3591  \u3609 \u3634 \u3591 \u3626 \u3634 \u3623 ) \u3627 \u3609 \u3657 \u3634 \u3594 \u3639 \u3656 \u3629 \u3648 \u3605 \u3655 \u3617 \u3651 \u3609 \u3623 \u3591 \u3648 \u3621 \u3655 \u3610 </li><li>\u3588 . \u3651 \u3627 \u3657 \u3651 \u3626 \u3656 \u3588 \u3635 \u3623 \u3656 \u3634  "\u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 " \u3609 \u3635 \u3627 \u3609 \u3657 \u3634 </li><li>\u3591 . \u3651 \u3627 \u3657 \u3651 \u3626 \u3656 \u3618 \u3624 \u3607 \u3634 \u3591 \u3607 \u3627 \u3634 \u3619 \u3648 \u3626 \u3617 \u3629 \u3649 \u3617 \u3657 \u3652 \u3617 \u3656 \u3617 \u3637 </li></ul></div>\
\
    <div class="q-box"><div class="question">41. \uc0\u3627 \u3634 \u3585 \u3612 \u3641 \u3657 \u3621 \u3591 \u3609 \u3634 \u3617 \u3617 \u3637 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3607 \u3634 \u3591 \u3623 \u3636 \u3594 \u3634 \u3585 \u3634 \u3619  (\u3648 \u3594 \u3656 \u3609  \u3619 \u3629 \u3591 \u3624 \u3634 \u3626 \u3605 \u3619 \u3634 \u3592 \u3634 \u3619 \u3618 \u3660 ) \u3605 \u3657 \u3629 \u3591 \u3614 \u3636 \u3617 \u3614 \u3660 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 \u3651 \u3609 \u3623 \u3591 \u3648 \u3621 \u3655 \u3610 \u3594 \u3639 \u3656 \u3629 \u3648 \u3605 \u3655 \u3617 ?</div>\
    <ul class="choices"><li>\uc0\u3585 . \u3614 \u3636 \u3617 \u3614 \u3660 \u3588 \u3635 \u3648 \u3605 \u3655 \u3617 \u3586 \u3629 \u3591 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3623 \u3636 \u3594 \u3634 \u3585 \u3634 \u3619 \u3652 \u3623 \u3657 \u3627 \u3609 \u3657 \u3634 \u3594 \u3639 \u3656 \u3629 \u3648 \u3605 \u3655 \u3617 \u3651 \u3609 \u3623 \u3591 \u3648 \u3621 \u3655 \u3610 </li><li>\u3586 . \u3614 \u3636 \u3617 \u3614 \u3660 \u3629 \u3633 \u3585 \u3625 \u3619 \u3618 \u3656 \u3629  (\u3619 \u3624 .) \u3652 \u3623 \u3657 \u3627 \u3609 \u3657 \u3634 \u3594 \u3639 \u3656 \u3629 \u3648 \u3605 \u3655 \u3617 </li><li>\u3588 . \u3614 \u3636 \u3617 \u3614 \u3660 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3623 \u3636 \u3594 \u3634 \u3585 \u3634 \u3619 \u3652 \u3623 \u3657 \u3605 \u3656 \u3629 \u3607 \u3657 \u3634 \u3618 \u3594 \u3639 \u3656 \u3629 </li><li>\u3591 . \u3652 \u3617 \u3656 \u3605 \u3657 \u3629 \u3591 \u3614 \u3636 \u3617 \u3614 \u3660 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3623 \u3636 \u3594 \u3634 \u3585 \u3634 \u3619 \u3651 \u3604 \u3654 </li></ul></div>\
\
    <div class="q-box"><div class="question">42. \uc0\u3627 \u3633 \u3623 \u3586 \u3657 \u3629  "\u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3648 \u3592 \u3657 \u3634 \u3586 \u3629 \u3591 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 " \u3614 \u3636 \u3617 \u3614 \u3660 \u3652 \u3623 \u3657 \u3605 \u3619 \u3591 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3651 \u3604 \u3586 \u3629 \u3591 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3616 \u3634 \u3618 \u3609 \u3629 \u3585 ?</div>\
