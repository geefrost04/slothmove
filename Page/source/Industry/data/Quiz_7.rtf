    <div class="q-box"><div class="question">34. \uc0\u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3648 \u3586 \u3637 \u3618 \u3609 \u3627 \u3633 \u3623 \u3586 \u3657 \u3629  "\u3629 \u3657 \u3634 \u3591 \u3606 \u3638 \u3591 " \u3650 \u3604 \u3618 \u3611 \u3585 \u3605 \u3636 \u3588 \u3623 \u3619 \u3629 \u3657 \u3634 \u3591 \u3606 \u3638 \u3591 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3585 \u3637 \u3656 \u3593 \u3610 \u3633 \u3610 ?</div>\
    <ul class="choices"><li>\uc0\u3585 . \u3629 \u3657 \u3634 \u3591 \u3606 \u3638 \u3591 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3607 \u3640 \u3585 \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656 \u3648 \u3588 \u3618 \u3650 \u3605 \u3657 \u3605 \u3629 \u3610 \u3585 \u3633 \u3609 </li><li>\u3586 . \u3629 \u3657 \u3634 \u3591 \u3606 \u3638 \u3591 \u3648 \u3593 \u3614 \u3634 \u3632 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3593 \u3610 \u3633 \u3610 \u3649 \u3619 \u3585 \u3626 \u3640 \u3604 </li><li>\u3588 . \u3629 \u3657 \u3634 \u3591 \u3606 \u3638 \u3591 \u3648 \u3593 \u3614 \u3634 \u3632 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3593 \u3610 \u3633 \u3610 \u3621 \u3656 \u3634 \u3626 \u3640 \u3604 \u3607 \u3637 \u3656 \u3605 \u3636 \u3604 \u3605 \u3656 \u3629 \u3585 \u3633 \u3609 \u3648 \u3614 \u3637 \u3618 \u3591 \u3593 \u3610 \u3633 \u3610 \u3648 \u3604 \u3637 \u3618 \u3623  (\u3648 \u3623 \u3657 \u3609 \u3649 \u3605 \u3656 \u3593 \u3610 \u3633 \u3610 \u3629 \u3639 \u3656 \u3609 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3605 \u3657 \u3629 \u3591 \u3614 \u3636 \u3592 \u3634 \u3619 \u3603 \u3634 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 )</li><li>\u3591 . \u3652 \u3617 \u3656 \u3629 \u3609 \u3640 \u3597 \u3634 \u3605 \u3651 \u3627 \u3657 \u3629 \u3657 \u3634 \u3591 \u3606 \u3638 \u3591 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3651 \u3604 \u3654  \u3648 \u3621 \u3618 </li></ul></div>\
