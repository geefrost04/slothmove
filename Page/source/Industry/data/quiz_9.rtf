        <h1>\uc0\u3649 \u3609 \u3623 \u3586 \u3657 \u3629 \u3626 \u3629 \u3610 \u3649 \u3621 \u3632 \u3648 \u3593 \u3621 \u3618 : \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621  \u3609 \u3634 \u3618 \u3629 \u3609 \u3640 \u3607 \u3636 \u3609  \u3594 \u3634 \u3597 \u3623 \u3637 \u3619 \u3585 \u3641 \u3621  \u3609 \u3634 \u3618 \u3585 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 </h1>\
\
        <div class="question-block">\
            <div class="question">1. \uc0\u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3626 \u3635 \u3588 \u3633 \u3597  3 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3651 \u3594 \u3657 \u3648 \u3611 \u3655 \u3609 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609 \u3651 \u3609 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3612 \u3656 \u3609 \u3604 \u3636 \u3609 \u3588 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3626 \u3633 \u3609 \u3605 \u3636 \u3616 \u3634 \u3614  \u3648 \u3626 \u3606 \u3637 \u3618 \u3619 \u3616 \u3634 \u3614  \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3591 \u3588 \u3656 \u3633 \u3591 </li>\
                <li>\uc0\u3586 . \u3585 \u3634 \u3619 \u3614 \u3636 \u3607 \u3633 \u3585 \u3625 \u3660 \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3631 , \u3618 \u3638 \u3604 \u3617 \u3633 \u3656 \u3609 \u3611 \u3619 \u3632 \u3594 \u3634 \u3608 \u3636 \u3611 \u3652 \u3605 \u3618  \u3649 \u3621 \u3632 \u3627 \u3621 \u3633 \u3585 \u3609 \u3636 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 </li>\
                <li>\uc0\u3588 . \u3588 \u3623 \u3634 \u3617 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626  \u3588 \u3623 \u3634 \u3617 \u3588 \u3640 \u3657 \u3617 \u3588 \u3656 \u3634  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3617 \u3637 \u3626 \u3656 \u3623 \u3609 \u3619 \u3656 \u3623 \u3617 </li>\
                <li>\uc0\u3591 . \u3588 \u3623 \u3634 \u3617 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618  \u3588 \u3623 \u3634 \u3617 \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3621 \u3604 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3614 \u3636 \u3607 \u3633 \u3585 \u3625 \u3660 \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3631 , \u3618 \u3638 \u3604 \u3617 \u3633 \u3656 \u3609 \u3611 \u3619 \u3632 \u3594 \u3634 \u3608 \u3636 \u3611 \u3652 \u3605 \u3618  \u3649 \u3621 \u3632 \u3627 \u3621 \u3633 \u3585 \u3609 \u3636 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3619 \u3632 \u3610 \u3640 \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3626 \u3635 \u3588 \u3633 \u3597  3 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619 \u3588 \u3639 \u3629  1. \u3614 \u3636 \u3607 \u3633 \u3585 \u3625 \u3660 \u3619 \u3633 \u3585 \u3625 \u3634 \u3652 \u3623 \u3657 \u3595 \u3638 \u3656 \u3591 \u3626 \u3606 \u3634 \u3610 \u3633 \u3609 \u3594 \u3634 \u3605 \u3636  \u3624 \u3634 \u3626 \u3609 \u3634  \u3649 \u3621 \u3632 \u3614 \u3619 \u3632 \u3617 \u3627 \u3634 \u3585 \u3625 \u3633 \u3605 \u3619 \u3636 \u3618 \u3660  2. \u3618 \u3638 \u3604 \u3617 \u3633 \u3656 \u3609 \u3585 \u3634 \u3619 \u3611 \u3585 \u3588 \u3619 \u3629 \u3591 \u3651 \u3609 \u3619 \u3632 \u3610 \u3629 \u3610 \u3611 \u3619 \u3632 \u3594 \u3634 \u3608 \u3636 \u3611 \u3652 \u3605 \u3618 \u3629 \u3633 \u3609 \u3617 \u3637 \u3614 \u3619 \u3632 \u3617 \u3627 \u3634 \u3585 \u3625 \u3633 \u3605 \u3619 \u3636 \u3618 \u3660 \u3607 \u3619 \u3591 \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3617 \u3640 \u3586  \u3649 \u3621 \u3632  3. \u3618 \u3638 \u3604 \u3617 \u3633 \u3656 \u3609 \u3651 \u3609 \u3627 \u3621 \u3633 \u3585 \u3609 \u3636 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617  \u3585 \u3634 \u3619 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3651 \u3594 \u3657 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3612 \u3656 \u3609 \u3604 \u3636 \u3609 \u3610 \u3609 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609 \u3586 \u3629 \u3591 \u3608 \u3619 \u3619 \u3617 \u3634 \u3616 \u3636 \u3610 \u3634 \u3621  \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3611 \u3655 \u3609 \u3585 \u3619 \u3629 \u3610 \u3609 \u3635 \u3607 \u3634 \u3591 \u3651 \u3609 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3588 \u3623 \u3634 \u3617 \u3626 \u3591 \u3610 \u3626 \u3640 \u3586 \u3649 \u3621 \u3632 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3649 \u3585 \u3656 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3633 \u3656 \u3591 \u3618 \u3639 \u3609 </div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">2. \uc0\u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3649 \u3610 \u3610  "Cluster" \u3617 \u3637 \u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3627 \u3621 \u3633 \u3585 \u3648 \u3614 \u3656 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3614 \u3656 \u3636 \u3617 \u3592 \u3635 \u3609 \u3623 \u3609 \u3610 \u3640 \u3588 \u3621 \u3634 \u3585 \u3619 \u3651 \u3609 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597 </li>\
                <li>\uc0\u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3648 \u3594 \u3636 \u3591 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3610 \u3609 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3649 \u3621 \u3632 \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3648 \u3604 \u3637 \u3618 \u3623 \u3585 \u3633 \u3609 </li>\
                <li>\uc0\u3588 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3649 \u3618 \u3585 \u3626 \u3656 \u3623 \u3609 \u3591 \u3634 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3651 \u3627 \u3657 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3629 \u3636 \u3626 \u3619 \u3632 \u3605 \u3656 \u3629 \u3585 \u3633 \u3609 \u3617 \u3634 \u3585 \u3586 \u3657 \u3638 \u3609 </li>\
                <li>\uc0\u3591 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3621 \u3604 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3619 \u3634 \u3618 \u3592 \u3656 \u3634 \u3618 \u3651 \u3609 \u3616 \u3634 \u3614 \u3619 \u3623 \u3617 \u3586 \u3629 \u3591 \u3649 \u3605 \u3656 \u3621 \u3632 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3648 \u3594 \u3636 \u3591 \u3610 \u3641 \u3619 \u3603 \u3634 \u3585 \u3634 \u3619 \u3610 \u3609 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3649 \u3621 \u3632 \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3648 \u3604 \u3637 \u3618 \u3623 \u3585 \u3633 \u3609 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3649 \u3610 \u3610  Cluster \u3627 \u3619 \u3639 \u3629 \u3585 \u3621 \u3640 \u3656 \u3617 \u3618 \u3640 \u3607 \u3608 \u3624 \u3634 \u3626 \u3605 \u3619 \u3660  \u3648 \u3611 \u3655 \u3609 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3607 \u3637 \u3656 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3607 \u3621 \u3634 \u3618 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3649 \u3610 \u3610 \u3649 \u3618 \u3585 \u3626 \u3656 \u3623 \u3609  (Silos) \u3650 \u3604 \u3618 \u3585 \u3635 \u3627 \u3609 \u3604 \u3651 \u3627 \u3657 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3617 \u3637 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591 \u3585 \u3633 \u3609 \u3617 \u3634 \u3607 \u3635 \u3591 \u3634 \u3609 \u3619 \u3656 \u3623 \u3617 \u3585 \u3633 \u3609 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3649 \u3621 \u3632 \u3605 \u3633 \u3623 \u3594 \u3637 \u3657 \u3623 \u3633 \u3604 \u3648 \u3604 \u3637 \u3618 \u3623 \u3585 \u3633 \u3609  \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 \u3626 \u3641 \u3591 \u3626 \u3640 \u3604 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3611 \u3633 \u3597 \u3627 \u3634 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3595 \u3657 \u3635 \u3595 \u3657 \u3629 \u3609 \u3586 \u3629 \u3591 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603  \u3649 \u3621 \u3632 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3605 \u3629 \u3610 \u3626 \u3609 \u3629 \u3591 \u3588 \u3623 \u3634 \u3617 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3588 \u3619 \u3629 \u3610 \u3588 \u3621 \u3640 \u3617 \u3607 \u3640 \u3585 \u3617 \u3636 \u3605 \u3636 </div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">3. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3635 \u3588 \u3633 \u3597 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3612 \u3656 \u3634 \u3609 \u3626 \u3641 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621  (Government Digital Transformation)</div>\
