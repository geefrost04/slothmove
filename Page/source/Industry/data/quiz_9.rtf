        <div class="question-block">\
            <div class="question">34. \uc0\u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3651 \u3604 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3609 \u3635 \u3617 \u3634 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3619 \u3632 \u3610 \u3610 \u3611 \u3619 \u3632 \u3585 \u3633 \u3609 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614  (\u3619 \u3633 \u3585 \u3625 \u3634 \u3607 \u3640 \u3585 \u3607 \u3656 \u3637 \u3652 \u3604 \u3657 \u3607 \u3633 \u3609 \u3607 \u3637 )</div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3619 \u3632 \u3610 \u3610 \u3610 \u3633 \u3605 \u3619 \u3588 \u3636 \u3623 \u3649 \u3610 \u3610 \u3585 \u3619 \u3632 \u3604 \u3634 \u3625 </li>\
                <li>\uc0\u3586 . \u3619 \u3632 \u3610 \u3610 \u3600 \u3634 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614 \u3626 \u3656 \u3623 \u3609 \u3610 \u3640 \u3588 \u3588 \u3621 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \u3607 \u3634 \u3591 \u3652 \u3585 \u3621  (Telemedicine)</li>\
                <li>\uc0\u3588 . \u3585 \u3634 \u3619 \u3648 \u3614 \u3656 \u3636 \u3617 \u3592 \u3635 \u3609 \u3623 \u3609 \u3614 \u3618 \u3634 \u3610 \u3634 \u3621 \u3651 \u3609 \u3607 \u3640 \u3585 \u3627 \u3617 \u3641 \u3656 \u3610 \u3657 \u3634 \u3609 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3651 \u3594 \u3657 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 </li>\
                <li>\uc0\u3591 . \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3614 \u3636 \u3617 \u3614 \u3660 \u3604 \u3637 \u3604 \u3651 \u3609 \u3585 \u3634 \u3619 \u3610 \u3633 \u3609 \u3607 \u3638 \u3585 \u3611 \u3619 \u3632 \u3623 \u3633 \u3605 \u3636 \u3588 \u3609 \u3652 \u3586 \u3657 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3619 \u3632 \u3610 \u3610 \u3600 \u3634 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614 \u3626 \u3656 \u3623 \u3609 \u3610 \u3640 \u3588 \u3588 \u3621 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \u3607 \u3634 \u3591 \u3652 \u3585 \u3621  (Telemedicine)</div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3648 \u3614 \u3639 \u3656 \u3629 \u3618 \u3585 \u3619 \u3632 \u3604 \u3633 \u3610 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614 \u3651 \u3627 \u3657 \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623 \u3649 \u3621 \u3632 \u3648 \u3607 \u3656 \u3634 \u3648 \u3607 \u3637 \u3618 \u3617  \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621  \u3648 \u3594 \u3656 \u3609  \u3619 \u3632 \u3610 \u3610 \u3600 \u3634 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3626 \u3640 \u3586 \u3616 \u3634 \u3614 \u3626 \u3656 \u3623 \u3609 \u3610 \u3640 \u3588 \u3588 \u3621 \u3607 \u3637  \u3656 \u3648 \u3594  \u3639  \u3656 \u3629 \u3617 \u3650 \u3618 \u3591 \u3606 \u3638 \u3591 \u3585 \u3633 \u3609  (Personal Health Record) \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3649 \u3614 \u3607 \u3618 \u3660 \u3607 \u3634 \u3591 \u3652 \u3585 \u3621  (Telemedicine) \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3623 \u3636 \u3609 \u3636 \u3592 \u3593 \u3633 \u3618 \u3649 \u3621 \u3632 \u3619 \u3633 \u3585 \u3625 \u3634 \u3648 \u3610 \u3639 \u3657 \u3629 \u3591 \u3605 \u3657 \u3609 \u3652 \u3604 \u3657 \u3607 \u3633 \u3609 \u3607 \u3637 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3605 \u3657 \u3629 \u3591 \u3648 \u3604 \u3636 \u3609 \u3607 \u3634 \u3591 \u3652 \u3611 \u3650 \u3619 \u3591 \u3614 \u3618 \u3634 \u3610 \u3634 \u3621 \u3651 \u3627 \u3597 \u3656  \u3648 \u3611 \u3655 \u3609 \u3585 \u3634 \u3619 \u3621 \u3604 \u3588 \u3623 \u3634 \u3617 \u3649 \u3629 \u3629 \u3633 \u3604 \u3649 \u3621 \u3632 \u3648 \u3614 \u3656 \u36