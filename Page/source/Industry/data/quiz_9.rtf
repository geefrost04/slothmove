        <div class="question-block">\
            <div class="question">15. "Cultural Diplomacy" \uc0\u3627 \u3619 \u3639 \u3629 \u3585 \u3634 \u3619 \u3607 \u3641 \u3605 \u3623 \u3633 \u3602 \u3609 \u3608 \u3619 \u3619 \u3617  \u3606 \u3641 \u3585 \u3609 \u3635 \u3617 \u3634 \u3651 \u3594 \u3657 \u3648 \u3611 \u3655 \u3609 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3651 \u3609 \u3604 \u3657 \u3634 \u3609 \u3651 \u3604 </div>\
            <ul class="choices">\
