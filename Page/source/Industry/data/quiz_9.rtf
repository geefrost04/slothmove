            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3585 . \u3619 \u3632 \u3610 \u3610 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3652 \u3615 \u3615 \u3657 \u3634 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632 \u3648 \u3614 \u3656 \u3639 \u3629 \u3619 \u3629 \u3591 \u3619 \u3633 \u3610 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3626 \u3632 \u3629 \u3634 \u3604 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> Smart Grid \u3627 \u3619 \u3639 \u3629 \u3619 \u3632 \u3610 \u3610 \u3650 \u3588 \u3619 \u3591 \u3586 \u3656 \u3634 \u3618 \u3652 \u3615 \u3615 \u3657 \u3634 \u3629 \u3633 \u3592 \u3593 \u3619 \u3636 \u3618 \u3632  \u3648 \u3611 \u3655 \u3609 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3626 \u3635 \u3588 \u3633 \u3597 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3592 \u3632 \u3609 \u3635 \u3617 \u3634 \u3651 \u3594 \u3657 \u3611 \u3619 \u3633 \u3610 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3605 \u3621 \u3634 \u3604 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609  \u3648 \u3614 \u3639 \u3656 \u3629 \u3619 \u3629 \u3591 \u3619 \u3633 \u3610 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3649 \u3621 \u3632 \u3651 \u3594 \u3657 \u3652 \u3615 \u3615 \u3657 \u3634 \u3592 \u3634 \u3585 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3626 \u3632 \u3629 \u3634 \u3604  (\u3648 \u3594 \u3656 \u3609  \u3649 \u3626 \u3591 \u3629 \u3634 \u3607 \u3636 \u3605 \u3618 \u3660 ) \u3650 \u3604 \u3618 \u3619 \u3632 \u3610 \u3610 \u3609 \u3637 \u3657 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3585 \u3634 \u3619 \u3652 \u3627 \u3621 \u3586 \u3629 \u3591 \u3652 \u3615 \u3615 \u3657 \u3634 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614  \u3594 \u3656 \u3623 \u3618 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3652 \u3615 \u3615 \u3657 \u3634 \u3650 \u3604 \u3618 \u3612 \u3641 \u3657 \u3610 \u3619 \u3636 \u3650 \u3616 \u3588  (Prosumer) \u3649 \u3621 \u3632 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3588 \u3623 \u3634 \u3617 \u3617 \u3656 \u3633 \u3609 \u3588 \u3591 \u3607 \u3634 \u3591 \u3614 \u3621 \u3633 \u3591 \u3591 \u3634 \u3609 \u3651 \u3609 \u3619 \u3632 \u3604 \u3633 \u3610 \u3594 \u3640 \u3617 \u3594 \u3609 \u3649 \u3621 \u3632 \u3619 \u3632 \u3604 \u3633 \u3610 \u3594 \u3634 \u3605 \u3636 </div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">22. "Digital Literacy" \uc0\u3606 \u3641 \u3585 \u3619 \u3632 \u3610 \u3640 \u3623 \u3656 \u3634 \u3648 \u3611 \u3655 \u3609 \u3607 \u3633 \u3585 \u3625 \u3632 \u3607 \u3637 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3651 \u3588 \u3619 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3648 \u3593 \u3614 \u3634 \u3632 \u3648 \u3604 \u3655 \u3585 \u3649 \u3621 \u3632 \u3648 \u3618 \u3634 \u3623 \u3594 \u3609 \u3648 \u3607 \u3656 \u3634 \u3609 \u3633 \u3657 \u3609 </li>\
                <li>\uc0\u3586 . \u3588 \u3609 \u3652 \u3607 \u3618 \u3607 \u3640 \u3585 \u3585 \u3621 \u3640 \u3656 \u3617 \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3648 \u3607 \u3656 \u3634 \u3607 \u3633 \u3609 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3627 \u3656 \u3591 \u3629 \u3609 \u3634 \u3588 \u3605 </li>\
                <li>\uc0\u3588 . \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3619 \u3632 \u3604 \u3633 \u3610 \u3626 \u3641 \u3591 \u3648 \u3607 \u3656 \u3634 \u3609 \u3633 \u3657 \u3609 </li>\
                <li>\uc0\u3591 . \u3648 \u3593 \u3614 \u3634 \u3632 \u3612 \u3641 \u3657 \u3607 \u3637 \u3656 \u3607 \u3635 \u3591 \u3634 \u3609 \u3651 \u3609 \u3610 \u3619 \u3636 \u3625 \u3633 \u3607 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3588 \u3609 \u3652 \u3607 \u3618 \u3607 \u3640 \u3585 \u3585 \u3621 \u3640 \u3656 \u3617 \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3648 \u3607 \u3656 \u3634 \u3607 \u3633 \u3609 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3649 \u3627 \u3656 \u3591 \u3629 \u3609 \u3634 \u3588 \u3605 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> Digital Literacy \u3627 \u3619 \u3639 \u3629 \u3588 \u3623 \u3634 \u3617 \u3619 \u3641 \u3657 \u3588 \u3623 \u3634 \u3617 \u3648 \u3586 \u3657 \u3634 \u3651 \u3592 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621  \u3648 \u3611 \u3655 \u3609 \u3607 \u3633 \u3585 \u3625 \u3632 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3588 \u3609 \u3652 \u3607 \u3618 \u3607 \u3640 \u3585 \u3585 \u3621 \u3640 \u3656 \u3617 \u3649 \u3621 \u3632 \u3607 \u3640 \u3585 \u3594 \u3656 \u3623 \u3591 \u3623 \u3633 \u3618 \u3617 \u3637 \u3605 \u3636 \u3604 \u3605 \u3633 \u3623  \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3651 \u3594 \u3657 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3592 \u3634 \u3585 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591  \u3611 \u3621 \u3629 \u3604 \u3616 \u3633 \u3618  \u3649 \u3621 \u3632 \u3626 \u3619 \u3657 \u3634 \u3591 \u3626 \u3619 \u3619 \u3588 \u3660  \u3595 \u3638 \u3656 \u3591 \u3592 \u3632 \u3648 \u3611 \u3655 \u3609 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609 \u3626 \u3635 \u3588 \u3633 \u3597 \u3651 \u3609 \u3585 \u3634 \u3619 \u3585 \u3657 \u3634 \u3623 \u3648 \u3586 \u3657 \u3634 \u3626 \u3641 \u3656 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621  \u3649 \u3621 \u3632 \u3594 \u3656 \u3623 \u3618 \u3611 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3606 \u3641 \u3585 \u3627 \u3621 \u3629 \u3585 \u3621 \u3623 \u3591 \u3612 \u3656 \u3634 \u3609 \u3626 \u3639 \u3656 \u3629 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660 \u3627 \u3619 \u3639 \u3629 \u3626 \u3649 \u3585 \u3617 \u3648 \u3617 \u3629 \u3619 \u3660 \u3651 \u3609 \u3611 \u3633 \u3592 \u3592 \u3640 \u3610 \u3633 \u3609 </div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">23. \uc0\u3651 \u3609 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3595 \u3639 \u3657 \u3629 \u3592 \u3633 \u3604 \u3592 \u3657 \u3634 \u3591 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600  \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3651 \u3627 \u3617 \u3656 \u3651 \u3627 \u3657 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597 \u3585 \u3633 \u3610 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3651 \u3604 \u3617 \u3634 \u3585 \u3585 \u3623 \u3656 \u3634  "\u3619 \u3634 \u3588 \u3634 \u3605 \u3656 \u3635 \u3626 \u3640 \u3604 "</div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3588 \u3623 \u3634 \u3617 \u3626 \u3633 \u3617 \u3614 \u3633 \u3609 \u3608 \u3660 \u3585 \u3633 \u3610 \u3612 \u3641 \u3657 \u3586 \u3634 \u3618 </li>\
                <li>\uc0\u3586 . \u3588 \u3623 \u3634 \u3617 \u3588 \u3640 \u3657 \u3617 \u3588 \u3656 \u3634  \u3626 \u3617 \u3648 \u3627 \u3605 \u3640 \u3626 \u3617 \u3612 \u3621  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </li>\
                <li>\uc0\u3588 . \u3585 \u3634 \u3619 \u3648 \u3621 \u3639 \u3629 \u3585 \u3610 \u3619 \u3636 \u3625 \u3633 \u3607 \u3607 \u3637 \u3656 \u3617 \u3637 \u3586 \u3609 \u3634 \u3604 \u3651 \u3627 \u3597 \u3656 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 </li>\
                <li>\uc0\u3591 . \u3585 \u3634 \u3619 \u3609 \u3635 \u3648 \u3586 \u3657 \u3634 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3592 \u3634 \u3585 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3648 \u3614 \u3656 \u3639 \u3629 \u3588 \u3623 \u3634 \u3617 \u3607 \u3633 \u3609 \u3626 \u3617 \u3633 \u3618 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3588 \u3623 \u3634 \u3617 \u3588 \u3640 \u3657 \u3617 \u3588 \u3656 \u3634  \u3626 \u3617 \u3648 \u3627 \u3605 \u3640 \u3626 \u3617 \u3612 \u3621  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3595 \u3639 \u3657 \u3629 \u3592 \u3633 \u3604 \u3592 \u3657 \u3634 \u3591 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3618 \u3640 \u3588 \u3651 \u3627 \u3617 \u3656 \u3592 \u3632 \u3606 \u3641 \u3585 \u3611 \u3619 \u3633 \u3610 \u3611 \u3619 \u3640 \u3591 \u3652 \u3617 \u3656 \u3651 \u3627 \u3657 \u3588 \u3635 \u3609 \u3638 \u3591 \u3606 \u3638 \u3591  "\u3619 \u3634 \u3588 \u3634 \u3605 \u3656 \u3635 \u3626 \u3640 \u3604 " \u3648 \u3614 \u3637 \u3618 \u3591 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3604 \u3637 \u3618 \u3623  \u3649 \u3605 \u3656 \u3592 \u3632 \u3648 \u3609 \u3657 \u3609 \u3607 \u3637 \u3656 \u3588 \u3623 \u3634 \u3617 \u3588 \u3640 \u3657 \u3617 \u3588 \u3656 \u3634  \u3588 \u3640 \u3603 \u3616 \u3634 \u3614 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3626 \u3609 \u3633 \u3610 \u3626 \u3609 \u3640 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  (Made in Thailand First) \u3619 \u3623 \u3617 \u3606 \u3638 \u3591 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3609 \u3623 \u3633 \u3605 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3617 \u3636 \u3605 \u3619 \u3605 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3649 \u3623 \u3604 \u3621 \u3657 \u3629 \u3617  \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3586 \u3629 \u3591 \u3619 \u3633 \u3600 \u3585 \u3619 \u3632 \u3592 \u3634 \u3618 \u3652 \u3611 \u3626 \u3641 \u3656 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3652 \u3607 \u3618 \u3649 \u3621 \u3632 \u3594 \u3656 \u3623 \u3618 \u3586 \u3633 \u3610 \u3648 \u3588 \u3621 \u3639 \u3656 \u3629 \u3609 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3649 \u3607 \u3657 \u3592 \u3619 \u3636 \u3591 </div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">24. \uc0\u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3611 \u3633 \u3597 \u3627 \u3634  "\u3609 \u3629 \u3617 \u3636 \u3609 \u3637 " \u3651 \u3609 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 \u3617 \u3637 \u3623 \u3633 \u3605 \u3606 \u3640 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3648 \u3614 \u3656 \u3639 \u3629 \u3629 \u3632 \u3652 \u3619 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3614 \u3656 \u3636 \u3617 \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3588 \u3656 \u3634 \u3611 \u3619 \u3633 \u3610 </li>\
                <li>\uc0\u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3621 \u3604 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3605 \u3656 \u3629 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3652 \u3607 \u3618 \u3649 \u3621 \u3632 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3594 \u3640 \u3617 \u3594 \u3609 </li>\
                <li>\uc0\u3588 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3585 \u3637 \u3604 \u3585 \u3633 \u3609 \u3585 \u3634 \u3619 \u3621 \u3591 \u3607 \u3640 \u3609 \u3592 \u3634 \u3585 \u3605 \u3656 \u3634 \u3591 \u3594 \u3634 \u3605 \u3636 \u3607 \u3640 \u3585 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 </li>\
                <li>\uc0\u3591 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3648 \u3586 \u3657 \u3634 \u3652 \u3611 \u3648 \u3611 \u3655 \u3609 \u3648 \u3592 \u3657 \u3634 \u3586 \u3629 \u3591 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3648 \u3629 \u3585 \u3594 \u3609 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3648 \u3614 \u3656 \u3639 \u3629 \u3621 \u3604 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3605 \u3656 \u3629 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3652 \u3607 \u3618 \u3649 \u3621 \u3632 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3594 \u3640 \u3617 \u3594 \u3609 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3611 \u3633 \u3597 \u3627 \u3634 \u3609 \u3629 \u3617 \u3636 \u3609 \u3637  (Nominee) \u3627 \u3619 \u3639 \u3629 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3605 \u3633 \u3657 \u3591 \u3609 \u3629 \u3617 \u3636 \u3609 \u3637 \u3648 \u3614 \u3656 \u3639 \u3629 \u3607 \u3635 \u3608 \u3640 \u3619 \u3585 \u3636 \u3592 \u3650 \u3604 \u3618 \u3652 \u3617 \u3656 \u3605 \u3619 \u3591 \u3652 \u3611 \u3605 \u3619 \u3591 \u3617 \u3634  \u3626 \u3656 \u3591 \u3612 \u3621 \u3585 \u3619 \u3632 \u3607 \u3610 \u3629 \u3618 \u3656 \u3634 \u3591 \u3619 \u3640 \u3609 \u3649 \u3619 \u3591 \u3605 \u3656 \u3629 \u3612 \u3641 \u3657 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3585 \u3634 \u3619 \u3652 \u3607 \u3618  \u3650 \u3604 \u3618 \u3648 \u3593 \u3614 \u3634 \u3632  SMEs \u3649 \u3621 \u3632 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592 \u3594 \u3640 \u3617 \u3594 \u3609 \u3607 \u3637 \u3656 \u3652 \u3617 \u3656 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3652 \u3604 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617  \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3592 \u3638 \u3591 \u3605 \u3657 \u3629 \u3591 \u3617 \u3637 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3609 \u3637 \u3657 \u3629 \u3618 \u3656 \u3634 \u3591 \u3592 \u3619 \u3636 \u3591 \u3592 \u3633 \u3591 \u3648 \u3614 \u3639 \u3656 \u3629 \u3611 \u3585 \u3611 \u3657 \u3629 \u3591 \u3626 \u3636 \u3607 \u3608 \u3636 \u3586 \u3629 \u3591 \u3588 \u3609 \u3652 \u3607 \u3618 \u3649 \u3621 \u3632 \u3626 \u3619 \u3657 \u3634 \u3591 \u3610 \u3619 \u3619 \u3618 \u3634 \u3585 \u3634 \u3624 \u3585 \u3634 \u3619 \u3649 \u3586 \u3656 \u3591 \u3586 \u3633 \u3609 \u3607 \u3637 \u3656 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3652 \u3607 \u3618 </div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">25. \uc0\u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3626 \u3619 \u3619 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3651 \u3609 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3648 \u3609 \u3657 \u3609 \u3588 \u3623 \u3634 \u3617 \u3588 \u3640 \u3657 \u3617 \u3588 \u3656 \u3634 \u3612 \u3656 \u3634 \u3609 \u3585 \u3621 \u3652 \u3585 \u3651 \u3604 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3585 \u3634 \u3619 \u3585 \u3641 \u3657 \u3648 \u3591 \u3636 \u3609 \u3651 \u3627 \u3657 \u3617 \u3634 \u3585 \u3607 \u3637 \u3656 \u3626 \u3640 \u3604 \u3648 \u3614 \u3639 \u3656 \u3629 \u3585 \u3619 \u3632 \u3605 \u3640 \u3657 \u3609 \u3648 \u3624 \u3619 \u3625 \u3600 \u3585 \u3636 \u3592 </li>\
                <li>\uc0\u3586 . \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3626 \u3636 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3660 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3651 \u3627 \u3657 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626 \u3649 \u3621 \u3632 \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3652 \u3604 \u3657 </li>\
                <li>\uc0\u3588 . \u3585 \u3634 \u3619 \u3605 \u3633 \u3604 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3604 \u3657 \u3634 \u3609 \u3626 \u3623 \u3633 \u3626 \u3604 \u3636 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 </li>\
                <li>\uc0\u3591 . \u3585 \u3634 \u3619 \u3619 \u3629 \u3651 \u3627 \u3657 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3648 \u3627 \u3621 \u3639 \u3629 \u3592 \u3656 \u3634 \u3618 \u3649 \u3621 \u3657 \u3623 \u3588 \u3656 \u3629 \u3618 \u3609 \u3635 \u3617 \u3634 \u3651 \u3594 \u3657 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3626 \u3636 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3660 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3651 \u3627 \u3657 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626 \u3649 \u3621 \u3632 \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3652 \u3604 \u3657 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3626 \u3619 \u3619 \u3649 \u3621 \u3632 \u3651 \u3594 \u3657 \u3592 \u3656 \u3634 \u3618 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3616 \u3634 \u3618 \u3651 \u3605 \u3657 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3609 \u3637 \u3657  \u3592 \u3632 \u3618 \u3638 \u3604 \u3627 \u3621 \u3633 \u3585 \u3623 \u3636 \u3609 \u3633 \u3618 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619 \u3648 \u3591 \u3636 \u3609 \u3585 \u3634 \u3619 \u3588 \u3621 \u3633 \u3591 \u3629 \u3618 \u3656 \u3634 \u3591 \u3648 \u3588 \u3619 \u3656 \u3591 \u3588 \u3619 \u3633 \u3604  \u3650 \u3604 \u3618 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3626 \u3636 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3660 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3651 \u3627 \u3657 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3588 \u3640 \u3657 \u3617 \u3588 \u3656 \u3634 \u3626 \u3641 \u3591 \u3626 \u3640 \u3604  \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626  \u3649 \u3621 \u3632 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3652 \u3604 \u3657 \u3651 \u3609 \u3607 \u3640 \u3585 \u3586 \u3633  \u3657 \u3609 \u3605 \u3629 \u3609  \u3619 \u3623 \u3617 \u3606 \u3638 \u3591 \u3585 \u3634 \u3619 \u3626 \u3656 \u3591 \u3648 \u3626 \u3619 \u3636 \u3617 \u3651 \u3627 \u3657 \u3616 \u3634 \u3588 \u3648 \u3629 \u3585 \u3594 \u3609 \u3648 \u3586 \u3657 \u3634 \u3617 \u3634 \u3619 \u3656 \u3623 \u3617 \u3621 \u3591 \u3607 \u3640 \u3609 \u3651 \u3609 \u3650 \u3588 \u3619 \u3591 \u3585 \u3634 \u3619 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609 \u3648 \u3614 \u3639  \u3656 \u3629 \u3621 \u3604 \u3616 \u3634 \u3619 \u3632 \u3627 \u3609 \u3637 \u3657 \u3626 \u3634 \u3608 \u3634 \u3619 \u3603 \u3632 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3651 \u3609 \u3619 \u3632 \u3618 \u3632 \u3618 \u3634 \u3623 </div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">26. \uc0\u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3617 \u3637 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619 \u3651 \u3609 \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591  "\u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3607 \u3634 \u3591 \u3629 \u3634 \u3627 \u3634 \u3619 \u3586 \u3629 \u3591 \u3650 \u3621 \u3585 "</div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3585 \u3634 \u3619 \u3627 \u3657 \u3634 \u3617 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3648 \u3585 \u3625 \u3605 \u3619 \u3607 \u3640 \u3585 \u3594 \u3609 \u3636 \u3604 </li>\
                <li>\uc0\u3586 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3656 \u3636 \u3617 \u3605 \u3621 \u3629 \u3604 \u3627 \u3656 \u3623 \u3591 \u3650 \u3595 \u3656 \u3629 \u3640 \u3611 \u3607 \u3634 \u3609 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3648 \u3592 \u3619 \u3592 \u3634 \u3648 \u3614 \u3656 \u3636 \u3617 \u3605 \u3621 \u3634 \u3604 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 </li>\
                <li>\uc0\u3588 . \u3585 \u3634 \u3619 \u3621 \u3604 \u3592 \u3635 \u3609 \u3623 \u3609 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3621 \u3591 \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3614 \u3656 \u3636 \u3617 \u3614 \u3657 \u3639 \u3609 \u3607 \u3637 \u3656 \u3609 \u3636 \u3588 \u3617 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 </li>\
                <li>\uc0\u3591 . \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3626 \u3634 \u3619 \u3648 \u3588 \u3617 \u3637 \u3651 \u3609 \u3616 \u3634 \u3588 \u3648 \u3585 \u3625 \u3605 \u3619 \u3648 \u3614 \u3656 \u3639 \u3629 \u3648 \u3614 \u3656 \u3636 \u3617 \u3612 \u3621 \u3612 \u3621 \u3636 \u3605 \u3629 \u3618 \u3656 \u3634 \u3591 \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3656 \u3636 \u3617 \u3605 \u3621 \u3629 \u3604 \u3627 \u3656 \u3623 \u3591 \u3650 \u3595 \u3656 \u3629 \u3640 \u3611 \u3607 \u3634 \u3609 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3648 \u3592 \u3619 \u3592 \u3634 \u3648 \u3614 \u3656 \u3636 \u3617 \u3605 \u3621 \u3634 \u3604 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3585 \u3634 \u3619 \u3648 \u3611 \u3655 \u3609  "\u3624 \u3641 \u3609 \u3618 \u3660 \u3585 \u3621 \u3634 \u3591 \u3588 \u3623 \u3634 \u3617 \u3617 \u3633 \u3656 \u3609 \u3588 \u3591 \u3607 \u3634 \u3591 \u3629 \u3634 \u3627 \u3634 \u3619 \u3586 \u3629 \u3591 \u3650 \u3621 \u3585 " \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3648 \u3609 \u3657 \u3609 \u3585 \u3621 \u3618 \u3640 \u3607 \u3608 \u3660 \u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3592 \u3634 \u3585 \u3648 \u3585 \u3625 \u3605 \u3619 \u3585 \u3619 \u3619 \u3617 \u3649 \u3610 \u3610 \u3604 \u3633 \u3657 \u3591 \u3648 \u3604 \u3636 \u3617 \u3652 \u3611 \u3626 \u3641 \u3656 \u3648 \u3585 \u3625 \u3605 \u3619 \u3649 \u3617 \u3656 \u3609 \u3618 \u3635 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3649 \u3611 \u3619 \u3619 \u3641 \u3611 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3648 \u3585 \u3625 \u3605 \u3619 \u3648 \u3614 \u3639 \u3656 \u3629 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3641 \u3621 \u3588 \u3656 \u3634 \u3648 \u3614 \u3636 \u3656 \u3617  (High Value) \u3588 \u3623 \u3610 \u3588 \u3641 \u3656 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3607 \u3637 \u3617 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618 \u3651 \u3609 \u3585 \u3634 \u3619 \u3648 \u3592 \u3619 \u3592 \u3634 \u3585 \u3634 \u3619 \u3588 \u3657 \u3634 \u3648 \u3594 \u3636 \u3591 \u3619 \u3640 \u3585 \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3611 \u3636 \u3604 \u3605 \u3621 \u3634 \u3604 \u3651 \u3627 \u3617 \u3656 \u3654  \u3651 \u3609 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624  \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3617 \u3633 \u3656 \u3609 \u3651 \u3592 \u3623 \u3656 \u3634 \u3626 \u3636 \u3609 \u3588 \u3657 \u3634 \u3648 \u3585 \u3625 \u3605 \u3619 \u3652 \u3607 \u3618 \u3617 \u3637 \u3588 \u3640 \u3603 \u3616 \u3634 \u3614  \u3617 \u3634 \u3605 \u3619 \u3600 \u3634 \u3609  \u3649 \u3621 \u3632 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3626 \u3656 \u3591 \u3629 \u3629 \u3585 \u3652 \u3611 \u3586 \u3634 \u3618 \u3652 \u3604 \u3657 \u3651 \u3609 \u3619 \u3634 \u3588 \u3634 \u3607 \u3637 \u3656 \u3626 \u3641 \u3591 \u3586 \u3638 \u3657 \u3609 </div>\
            </div>\
        </div>\
\
        <div class="question-block">\
            <div class="question">27. \uc0\u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634  "Deep Tech" \u3627 \u3619 \u3639 \u3629 \u3648 \u3607 \u3588 \u3650 \u3609 \u3650 \u3621 \u3618 \u3637 \u3648 \u3594 \u3636 \u3591 \u3621 \u3638 \u3585 \u3651 \u3609 \u3619 \u3632 \u3618 \u3632 \u3649 \u3619 \u3585 \u3648 \u3609 \u3657 \u3609 \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3651 \u3604 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3629 \u3640 \u3605 \u3626 \u3634 \u3627 \u3585 \u3619 \u3619 \u3617 \u3649 \u3615 \u3594 \u3633 \u3656 \u3609 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3629 \u3629 \u3585 \u3649 \u3610 \u3610 </li>\
                <li>\uc0\u3586 . \u3648 \u3585 \u3625 \u3605 \u3619  \u3629 \u3634 \u3627 \u3634 \u3619  \u3618 \u3634  \u3649 \u3621 \u3632 \u3648 \u3595 \u3617 \u3636 \u3588 \u3629 \u3609 \u3604 \u3633 \u3585 \u3648 \u3605 \u3629 \u3619 \u3660 </li>\
                <li>\uc0\u3588 . \u3585 \u3634 \u3619 \u3612 \u3621 \u3636 \u3605 \u3648 \u3615 \u3629 \u3619 \u3660 \u3609 \u3636 \u3648 \u3592 \u3629 \u3619 \u3660 \u3652 \u3617 \u3657 </li>\
                <li>\uc0\u3591 . \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3648 \u3621 \u3637 \u3657 \u3618 \u3591 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3650 \u3619 \u3591 \u3649 \u3619 \u3617 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3648 \u3585 \u3625 \u3605 \u3619  \u3629 \u3634 \u3627 \u3634 \u3619  \u3618 \u3634  \u3649 \u3621 \u3632 \u3648 \u3595 \u3617 \u3636 \u3588 \u3629 \u3609 \u3604 \u3633 \u3585 \u3648 \u3605 \u3629 \u3619 \u3660 </div>\
