        <div class="question-block">\
            <div class="question">28. \uc0\u3609 \u3650 \u3618 \u3610 \u3634 \u3618  "\u3648 \u3619 \u3637 \u3618 \u3609 \u3615 \u3619 \u3637 \u3617 \u3637 \u3591 \u3634 \u3609 \u3607 \u3635 " \u3651 \u3594 \u3657 \u3649 \u3614 \u3621 \u3605 \u3615 \u3629 \u3619 \u3660 \u3617 \u3651 \u3604 \u3648 \u3611 \u3655 \u3609 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3626 \u3635 \u3588 \u3633 \u3597 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3649 \u3614 \u3621 \u3605 \u3615 \u3629 \u3619 \u3660 \u3617 \u3650 \u3595 \u3648 \u3594 \u3637 \u3618 \u3621 \u3617 \u3637 \u3648 \u3604 \u3637 \u3618 \u3607 \u3633 \u3656 \u3623 \u3652 \u3611 </li>\
                <li>\uc0\u3586 . \u3649 \u3614 \u3621 \u3605 \u3615 \u3629 \u3619 \u3660 \u3617 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3609 \u3619 \u3641 \u3657 \u3629 \u3629 \u3609 \u3652 \u3621 \u3609 \u3660 \u3615 \u3619 \u3637 \u3607 \u3637 \u3656 \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591 \u3652 \u3604 \u3657 \u3607 \u3640 \u3585 \u3607 \u3637 \u3656 \u3607 \u3640 \u3585 \u3648 \u3623 \u3621 \u3634 </li>\
