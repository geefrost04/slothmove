        <div class="question-block">\
            <div class="question">16. \uc0\u3586 \u3657 \u3629 \u3651 \u3604 \u3588 \u3639 \u3629 \u3588 \u3623 \u3634 \u3617 \u3648 \u3626 \u3637 \u3656 \u3618 \u3591 \u3648 \u3594 \u3636 \u3591 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3651 \u3627 \u3657 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597 \u3651 \u3609 \u3585 \u3634 \u3619 \u3649 \u3585 \u3657 \u3652 \u3586 \u3604 \u3657 \u3623 \u3618 \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3607 \u3634 \u3591 \u3592 \u3619 \u3636 \u3618 \u3608 \u3619 \u3619 \u3617 </div>\
            <ul class="choices">\
                <li>\uc0\u3585 . \u3611 \u3633 \u3597 \u3627 \u3634 \u3609 \u3657 \u3635 \u3607 \u3656 \u3623 \u3617 \u3595 \u3657 \u3635 \u3595 \u3634 \u3585 </li>\
                <li>\uc0\u3586 . \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 \u3588 \u3629 \u3619 \u3660 \u3619 \u3633 \u3611 \u3594 \u3633 \u3609 \u3649 \u3621 \u3632 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3629 \u3609 \u3640 \u3617 \u3633 \u3605 \u3636 \u3607 \u3656 \u3637 \u3621 \u3656 \u3634 \u3594 \u3657 \u3634 </li>\
                <li>\uc0\u3588 . \u3585 \u3634 \u3619 \u3586 \u3634 \u3604 \u3649 \u3588 \u3621 \u3609 \u3649 \u3619 \u3591 \u3591 \u3634 \u3609 \u3651 \u3609 \u3616 \u3634 \u3588 \u3648 \u3585 \u3625 \u3605 \u3619 </li>\
                <li>\uc0\u3591 . \u3585 \u3634 \u3619 \u3648 \u3626 \u3639 \u3656 \u3629 \u3617 \u3626 \u3616 \u3634 \u3614 \u3586 \u3629 \u3591 \u3606 \u3609 \u3609 \u3627 \u3621 \u3623 \u3591 </li>\
            </ul>\
            <div class="answer-box">\
                <div class="correct-answer">\uc0\u3648 \u3593 \u3621 \u3618 : \u3586 . \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 \u3588 \u3629 \u3619 \u3660 \u3619 \u3633 \u3611 \u3594 \u3633 \u3609 \u3649 \u3621 \u3632 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3629 \u3609 \u3640 \u3617 \u3633 \u3605 \u3636 \u3607 \u3656 \u3637 \u3621 \u3656 \u3634 \u3594 \u3657 \u3634 </div>\
                <div class="explanation"><strong>\uc0\u3588 \u3635 \u3629 \u3608 \u3636 \u3610 \u3634 \u3618 :</strong> \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3623 \u3656 \u3634 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 \u3588 \u3629 \u3619 \u3660 \u3619 \u3633 \u3611 \u3594 \u3633 \u3609 \u3648 \u3594 \u3636 \u3591 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3617 \u3633 \u3585 \u3648 \u3585 \u3636 \u3604 \u3592 \u3634 \u3585 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3629 \u3609 \u3640 \u3617 \u3633 \u3605 \u3636 \u3629 \u3609 \u3640 \u3597 \u3634 \u3605 \u3607 \u3637 \u3656 \u3651 \u3594 \u3657 \u3604 \u3640 \u3621 \u3614 \u3636 \u3609 \u3636 \u3592 \u3586 \u3629 \u3591 \u3648 \u3592 \u3657 \u3634 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3617 \u3634 \u3585 \u3648 \u3585 \u3636 \u3609 \u3652 \u3611 \u3649 \u3621 \u3632 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3621 \u3656 \u3634 \u3594 \u3657 \u3634  \u3592 \u3638 \u3591 \u3585 \u3635 \u3627 \u3609 \u3604 \u3617 \u3634 \u3605 \u3619 \u3585 \u3634 \u3619 \u3607 \u3634 \u3591 \u3592 \u3619 \u3636 \u3618 \u3608 \u3619 \u3619 \u3617 \u3588 \u3623 \u3610 \u3588 \u3641 \u3656 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3619 \u3632 \u3610 \u3610 \u3604 \u3636 \u3592 \u3636 \u3607 \u3633 \u3621 \u3617 \u3634 \u3621 \u3604 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3649 \u3621 \u3632 \u3604 \u3640 \u3621 \u3614 \u3636 \u3609 \u3636 \u3592  \u3648 \u3614 \u3656 \u3639 \u3629 \u3651 \u3627 \u3657 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626  \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3652 \u3604 \u3657  \u3649 \u3621 \u3632 \u3621 \u3604 \u3650 \u3629 \u3585 \u3634 \u3626 \u3651 \u3609 \u3585 \u3634 \u3619 \u3648 \u3619 \u3637 \u3618 \u3585 \u3619 \u3633 \u3610 \u3612 \u3621 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660  \u3595 \u3638 \u3656 \u3591 \u3592 \u3632 \u3626 \u3656 \u3591 \u3612 \u3621 \u3604 \u3637 \u3605 \u3656 \u3629 \u3616 \u3634 \u3614 \u3621 \u3633 \u3585 \u3625 \u3603 \u3660 \u3604 \u3633 \u3594 \u3609 \u3637 \u3585 \u3634 \u3619 \u3619 \u3633 \u3610 \u3619 \u3641 \u3657 \u3585 \u3634 \u3619 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 </div>\
            </div>\
        </div>\
