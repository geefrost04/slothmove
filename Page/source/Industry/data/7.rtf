    <h3>\uc0\u3588 \u3623 \u3634 \u3617 \u3627 \u3617 \u3634 \u3618 \u3586 \u3629 \u3591  "\u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 " 6 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619 </h3>\
    <ol>\
        <li>\uc0\u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3607 \u3637 \u3656 \u3617 \u3637 \u3652 \u3611 \u3617 \u3634 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </li>\
        <li>\uc0\u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3607 \u3637 \u3656 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3617 \u3637 \u3652 \u3611 \u3606 \u3638 \u3591 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3629 \u3639 \u3656 \u3609 \u3651 \u3604 \u3627 \u3619 \u3639 \u3629 \u3610 \u3640 \u3588 \u3588 \u3621 \u3616 \u3634 \u3618 \u3609 \u3629 \u3585 </li>\
        <li>\uc0\u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3607 \u3637 \u3656 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3629 \u3639 \u3656 \u3609 \u3651 \u3604 \u3627 \u3619 \u3639 \u3629 \u3610 \u3640 \u3588 \u3588 \u3621 \u3616 \u3634 \u3618 \u3609 \u3629 \u3585 \u3617 \u3637 \u3617 \u3634 \u3606 \u3638 \u3591 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </li>\
        <li>\uc0\u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3607 \u3637 \u3656 \u3607 \u3634 \u3591 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3607 \u3635 \u3586 \u3638 \u3657 \u3609 \u3627 \u3619 \u3639 \u3629 \u3619 \u3633 \u3610 \u3652 \u3623 \u3657 \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3611 \u3655 \u3609 \u3627 \u3621 \u3633 \u3585 \u3600 \u3634 \u3609 \u3651 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </li>\
        <li>\uc0\u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3607 \u3637 \u3656 \u3607 \u3634 \u3591 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3607 \u3635 \u3586 \u3638 \u3657 \u3609 \u3605 \u3634 \u3617 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618  \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610 \u3627 \u3619 \u3639 \u3629 \u3586 \u3657 \u3629 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 </li>\
        <li>\uc0\u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3586 \u3656 \u3634 \u3623 \u3626 \u3634 \u3619 \u3627 \u3619 \u3639 \u3629 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3607 \u3637 \u3656 \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 \u3592 \u3634 \u3585 \u3619 \u3632 \u3610 \u3610 \u3626 \u3634 \u3619 \u3610 \u3619 \u3619 \u3603 \u3629 \u3636 \u3648 \u3621 \u3655 \u3585 \u3607 \u3619 \u3629 \u3609 \u3636 \u3585 \u3626 \u3660 </li>\
    </ol>\
\
    <h2>\uc0\u55356 \u57263  2. \u3627 \u3621 \u3633 \u3585  5C \u3649 \u3621 \u3632 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3585 \u3634 \u3619 \u3648 \u3586 \u3637 \u3618 \u3609 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </h2>\
