    <h2>\uc0\u55357 \u56514  1. \u3588 \u3623 \u3634 \u3617 \u3619 \u3641 \u3657 \u3614 \u3639 \u3657 \u3609 \u3600 \u3634 \u3609 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3585 \u3633 \u3610  "\u3591 \u3634 \u3609 \u3626 \u3634 \u3619 \u3610 \u3619 \u3619 \u3603 " \u3649 \u3621 \u3632  "\u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 "</h2>\
\
    <h3>\uc0\u3588 \u3623 \u3634 \u3617 \u3627 \u3617 \u3634 \u3618 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597 </h3>\
    <ul>\
        <li><span class="vocab">\uc0\u3591 \u3634 \u3609 \u3626 \u3634 \u3619 \u3610 \u3619 \u3619 \u3603 :</span> \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3591 \u3634 \u3609 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619  \u3648 \u3619 \u3636 \u3656 \u3617 \u3605 \u3633 \u3657 \u3591 \u3649 \u3605 \u3656 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3607 \u3635  \u3585 \u3634 \u3619 \u3619 \u3633 \u3610  \u3585 \u3634 \u3619 \u3626 \u3656 \u3591  \u3585 \u3634 \u3619 \u3648 \u3585 \u3655 \u3610 \u3619 \u3633 \u3585 \u3625 \u3634  \u3585 \u3634 \u3619 \u3618 \u3639 \u3617  \u3592 \u3609 \u3606 \u3638 \u3591 \u3585 \u3634 \u3619 \u3607 \u3635 \u3621 \u3634 \u3618  \u3648 \u3614 \u3639 \u3656 \u3629 \u3652 \u3617 \u3656 \u3651 \u3627 \u3657 \u3648 \u3585 \u3655 \u3610 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3607 \u3637 \u3656 \u3652 \u3617 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 \u3652 \u3623 \u3657 </li>\
        <li><span class="vocab">\uc0\u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597 :</span> \u3648 \u3611 \u3655 \u3609 \u3648 \u3629 \u3585 \u3626 \u3634 \u3619 \u3649 \u3621 \u3632 \u3627 \u3621 \u3633 \u3585 \u3600 \u3634 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 , \u3648 \u3611 \u3655 \u3609 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3629 \u3657 \u3634 \u3591 \u3629 \u3636 \u3591 , \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3594 \u3656 \u3623 \u3618 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 , \u3649 \u3621 \u3632 \u3648 \u3588 \u3619 \u3639 \u3656 \u3629 \u3591 \u3617 \u3639 \u3629 \u3605 \u3636 \u3604 \u3605 \u3656 \u3629 \u3626 \u3639 \u3656 \u3629 \u3626 \u3634 \u3619 </li>\
        <li><span class="vocab">\uc0\u3585 \u3634 \u3619 \u3648 \u3586 \u3637 \u3618 \u3609 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 :</span> \u3605 \u3657 \u3629 \u3591 \u3648 \u3619 \u3637 \u3618 \u3610 \u3648 \u3619 \u3637 \u3618 \u3591 \u3649 \u3618 \u3585 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3648 \u3627 \u3605 \u3640 \u3612 \u3621 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3617 \u3640 \u3656 \u3591 \u3627 \u3617 \u3634 \u3618  \u3650 \u3604 \u3618 \u3605 \u3633 \u3657 \u3591 \u3627 \u3633 \u3623 \u3586 \u3657 \u3629 \u3623 \u3656 \u3634  \u3629 \u3632 \u3652 \u3619  \u3648 \u3617 \u3639 \u3656 \u3629 \u3652 \u3619  \u3607 \u3637 \u3656 \u3652 \u3627 \u3609  \u3651 \u3588 \u3619  \u3607 \u3635 \u3652 \u3617  \u3629 \u3618 \u3656 \u3634 \u3591 \u3652 \u3619  \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3648 \u3586 \u3637 \u3618 \u3609 \u3588 \u3639 \u3629  "\u3586 \u3638 \u3657 \u3609 \u3605 \u3657 \u3609 \u3648 \u3619 \u3636 \u3656 \u3617 \u3651 \u3592 \u3588 \u3623 \u3634 \u3617 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3648 \u3627 \u3605 \u3640 \u3585 \u3656 \u3629 \u3609  \u3605 \u3656 \u3629 \u3652 \u3611 \u3592 \u3638 \u3591 \u3648 \u3611 \u3655 \u3609 \u3586 \u3657 \u3629 \u3588 \u3623 \u3634 \u3617 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3649 \u3621 \u3632 \u3586 \u3657 \u3629 \u3605 \u3585 \u3621 \u3591 "</li>\
    </ul>\
