    <h3>5 \uc0\u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3651 \u3609 \u3585 \u3634 \u3619 \u3648 \u3586 \u3637 \u3618 \u3609 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </h3>\
    <ol>\
        <li><strong>\uc0\u3624 \u3638 \u3585 \u3625 \u3634 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 :</strong> \u3624 \u3638 \u3585 \u3625 \u3634 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3617 \u3634  \u3585 \u3598 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610  \u3626 \u3636 \u3656 \u3591 \u3607 \u3637 \u3656 \u3604 \u3635 \u3648 \u3609 \u3636 \u3609 \u3585 \u3634 \u3619 \u3652 \u3611 \u3649 \u3621 \u3657 \u3623 </li>\
        <li><strong>\uc0\u3619 \u3623 \u3610 \u3619 \u3623 \u3617 \u3588 \u3623 \u3634 \u3617 \u3588 \u3636 \u3604 :</strong> \u3626 \u3619 \u3640 \u3611 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3588 \u3623 \u3634 \u3617 \u3588 \u3636 \u3604 \u3607 \u3637 \u3656 \u3594 \u3633 \u3604 \u3648 \u3592 \u3609 \u3623 \u3656 \u3634 \u3592 \u3632 \u3648 \u3586 \u3637 \u3618 \u3609 \u3652 \u3611 \u3607 \u3636 \u3624 \u3607 \u3634 \u3591 \u3651 \u3604 </li>\
        <li><strong>\uc0\u3619 \u3623 \u3610 \u3619 \u3623 \u3617 \u3611 \u3619 \u3632 \u3648 \u3604 \u3655 \u3609 \u3649 \u3621 \u3632 \u3592 \u3633 \u3604 \u3621 \u3635 \u3604 \u3633 \u3610 \u3648 \u3609 \u3639 \u3657 \u3629 \u3627 \u3634 :</strong> \u3648 \u3621 \u3639 \u3629 \u3585 \u3626 \u3619 \u3619 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3617 \u3634 \u3626 \u3619 \u3640 \u3611 \u3649 \u3621 \u3632 \u3592 \u3633 \u3604 \u3621 \u3635 \u3604 \u3633 \u3610 \u3651 \u3627 \u3657 \u3626 \u3633 \u3617 \u3614 \u3633 \u3609 \u3608 \u3660 \u3585 \u3633 \u3610 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 </li>\
        <li><strong>\uc0\u3621 \u3591 \u3617 \u3639 \u3629 \u3648 \u3586 \u3637 \u3618 \u3609 :</strong> \u3648 \u3586 \u3637 \u3618 \u3609 \u3651 \u3627 \u3657 \u3588 \u3619 \u3610  3 \u3626 \u3656 \u3623 \u3609  \u3588 \u3639 \u3629  \u3626 \u3656 \u3623 \u3609 \u3648 \u3627 \u3605 \u3640  \u3626 \u3656 \u3623 \u3609 \u3612 \u3621  \u3649 \u3621 \u3632 \u3626 \u3619 \u3640 \u3611 \u3588 \u3623 \u3634 \u3617 </li>\
        <li><strong>\uc0\u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3649 \u3621 \u3632 \u3611 \u3619 \u3633 \u3610 \u3611 \u3619 \u3640 \u3591 :</strong> \u3605 \u3619 \u3623 \u3592 \u3626 \u3629 \u3610 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610  \u3648 \u3609 \u3639 \u3657 \u3629 \u3627 \u3634  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3616 \u3634 \u3625 \u3634  \u3623 \u3619 \u3619 \u3588 \u3605 \u3629 \u3609 \u3651 \u3627 \u3657 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591 </li>\
    </ol>\
\
    <h2>\uc0\u55356 \u57307 \u65039  3. \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3649 \u3621 \u3632 \u3626 \u3656 \u3623 \u3609 \u3611 \u3619 \u3632 \u3585 \u3629 \u3610 \u3586 \u3629 \u3591 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </h2>\
    <p>\uc0\u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3610 \u3656 \u3591 \u3629 \u3629 \u3585 \u3648 \u3611 \u3655 \u3609  <span class="highlight">6 \u3611 \u3619 \u3632 \u3648 \u3616 \u3607 </span> \u3652 \u3604 \u3657 \u3649 \u3585 \u3656 : 1. \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3616 \u3634 \u3618 \u3609 \u3629 \u3585  2. \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3616 \u3634 \u3618 \u3651 \u3609  3. \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3611 \u3619 \u3632 \u3607 \u3633 \u3610 \u3605 \u3619 \u3634  4. \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3626 \u3633 \u3656 \u3591 \u3585 \u3634 \u3619  5. \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3611 \u3619 \u3632 \u3594 \u3634 \u3626 \u3633 \u3617 \u3614 \u3633 \u3609 \u3608 \u3660  6. \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3607 \u3637 \u3656 \u3648 \u3592 \u3657 \u3634 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3607 \u3635 \u3586 \u3638 \u3657 \u3609 \u3627 \u3619 \u3639 \u3629 \u3619 \u3633 \u3610 \u3652 \u3623 \u3657 \u3648 \u3611 \u3655 \u3609 \u3627 \u3621 \u3633 \u3585 \u3600 \u3634 \u3609 </p>\
\
    <h3>\uc0\u55357 \u56516  3.1 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3616 \u3634 \u3618 \u3609 \u3629 \u3585  (External Letter)</h3>\
    <p>\uc0\u3651 \u3594 \u3657 \u3605 \u3636 \u3604 \u3605 \u3656 \u3629 \u3619 \u3632 \u3627 \u3623 \u3656 \u3634 \u3591 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619  \u3627 \u3619 \u3639 \u3629 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3585 \u3633 \u3610 \u3610 \u3640 \u3588 \u3588 \u3621 \u3616 \u3634 \u3618 \u3609 \u3629 \u3585  \u3648 \u3611 \u3655 \u3609 \u3649 \u3610 \u3610 \u3614 \u3636 \u3608 \u3637 \u3607 \u3634 \u3591 \u3585 \u3634 \u3619  <span class="highlight">\u3651 \u3594 \u3657 \u3585 \u3619 \u3632 \u3604 \u3634 \u3625 \u3605 \u3619 \u3634 \u3588 \u3619 \u3640 \u3601  (\u3586 \u3609 \u3634 \u3604 \u3588 \u3619 \u3640 \u3601  3 \u3595 \u3617 .)</span></p>\
    <ul>\
        <li><strong>\uc0\u3607 \u3637 \u3656 :</strong> \u3629 \u3618 \u3641 \u3656 \u3595 \u3657 \u3634 \u3618 \u3610 \u3609 \u3626 \u3640 \u3604  \u3648 \u3614 \u3639 \u3656 \u3629 \u3648 \u3611 \u3655 \u3609 \u3586 \u3657 \u3629 \u3629 \u3657 \u3634 \u3591 \u3629 \u3636 \u3591 \u3651 \u3609 \u3585 \u3634 \u3619 \u3588 \u3657 \u3609 \u3627 \u3634 \u3649 \u3621 \u3632 \u3607 \u3635 \u3626 \u3606 \u3636 \u3605 \u3636 </li>\
        <li><strong>\uc0\u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3648 \u3592 \u3657 \u3634 \u3586 \u3629 \u3591 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 :</strong> \u3629 \u3618 \u3641 \u3656 \u3586 \u3623 \u3634 \u3626 \u3640 \u3604  \u3610 \u3619 \u3619 \u3607 \u3633 \u3604 \u3648 \u3604 \u3637 \u3618 \u3623 \u3585 \u3633 \u3610  "\u3607 \u3637 \u3656 " \u3614 \u3619 \u3657 \u3629 \u3617 \u3607 \u3637 \u3656 \u3605 \u3633 \u3657 \u3591 \u3652 \u3611 \u3619 \u3625 \u3603 \u3637 \u3618 \u3660 </li>\
        <li><strong>\uc0\u3623 \u3633 \u3609  \u3648 \u3604 \u3639 \u3629 \u3609  \u3611 \u3637 :</strong> \u3629 \u3618 \u3641 \u3656 \u3585 \u3638 \u3656 \u3591 \u3585 \u3621 \u3634 \u3591 \u3627 \u3609 \u3657 \u3634 \u3585 \u3619 \u3632 \u3604 \u3634 \u3625  <span class="highlight">\u3652 \u3617 \u3656 \u3605 \u3657 \u3629 \u3591 \u3617 \u3637 \u3588 \u3635 \u3623 \u3656 \u3634  "\u3623 \u3633 \u3609 \u3607 \u3637 \u3656 ", "\u3648 \u3604 \u3639 \u3629 \u3609 ", "\u3614 .\u3624 ." \u3609 \u3635 \u3627 \u3609 \u3657 \u3634 </span></li>\
        <li><strong>\uc0\u3648 \u3619 \u3639 \u3656 \u3629 \u3591 :</strong> \u3651 \u3592 \u3588 \u3623 \u3634 \u3617 \u3626 \u3633 \u3657 \u3609  \u3585 \u3632 \u3607 \u3633 \u3604 \u3619 \u3633 \u3604  \u3588 \u3619 \u3629 \u3610 \u3588 \u3621 \u3640 \u3617 \u3648 \u3609 \u3639 \u3657 \u3629 \u3627 \u3634 </li>\
        <li><strong>\uc0\u3588 \u3635 \u3586 \u3638 \u3657 \u3609 \u3605 \u3657 \u3609 :</strong> \u3619 \u3632 \u3610 \u3640 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3612 \u3641 \u3657 \u3619 \u3633 \u3610  <span class="highlight">\u3652 \u3617 \u3656 \u3605 \u3657 \u3629 \u3591 \u3617 \u3637 \u3588 \u3635 \u3623 \u3656 \u3634  "\u3631 \u3614 \u3603 \u3631 " \u3627 \u3619 \u3639 \u3629  "\u3607 \u3656 \u3634 \u3609 " \u3609 \u3635 \u3627 \u3609 \u3657 \u3634 </span> (\u3648 \u3594 \u3656 \u3609  \u3648 \u3619 \u3637 \u3618 \u3609  \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 \u3623 \u3656 \u3634 \u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 ...)</li>\
        <li><strong>\uc0\u3629 \u3657 \u3634 \u3591 \u3606 \u3638 \u3591 :</strong> \u3629 \u3657 \u3634 \u3591 \u3648 \u3593 \u3614 \u3634 \u3632 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3593 \u3610 \u3633 \u3610 \u3621 \u3656 \u3634 \u3626 \u3640 \u3604 \u3648 \u3614 \u3637 \u3618 \u3591 \u3593 \u3610 \u3633 \u3610 \u3648 \u3604 \u3637 \u3618 \u3623  (\u3619 \u3632 \u3610 \u3640 \u3594 \u3639 \u3656 \u3629 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619  \u3648 \u3621 \u3586 \u3607 \u3637 \u3656  \u3623 \u3633 \u3609 \u3648 \u3604 \u3639 \u3629 \u3609 \u3611 \u3637 )</li>\
        <li><strong>\uc0\u3626 \u3636 \u3656 \u3591 \u3607 \u3637 \u3656 \u3626 \u3656 \u3591 \u3617 \u3634 \u3604 \u3657 \u3623 \u3618 :</strong> \u3619 \u3632 \u3610 \u3640 \u3594 \u3639 \u3656 \u3629 \u3626 \u3636 \u3656 \u3591 \u3586 \u3629 \u3591 /\u3648 \u3629 \u3585 \u3626 \u3634 \u3619  \u3627 \u3634 \u3585 \u3610 \u3619 \u3619 \u3592 \u3640 \u3595 \u3629 \u3591 \u3648 \u3604 \u3637 \u3618 \u3623 \u3585 \u3633 \u3609 \u3652 \u3617 \u3656 \u3652 \u3604 \u3657 \u3651 \u3627 \u3657 \u3649 \u3592 \u3657 \u3591 \u3623 \u3656 \u3634 \u3626 \u3656 \u3591 \u3607 \u3634 \u3591 \u3652 \u3627 \u3609 </li>\
        <li><strong>\uc0\u3586 \u3657 \u3629 \u3588 \u3623 \u3634 \u3617 :</strong> \u3649 \u3610 \u3656 \u3591 \u3648 \u3611 \u3655 \u3609  3 \u3626 \u3656 \u3623 \u3609  \u3588 \u3639 \u3629  (1) \u3648 \u3627 \u3605 \u3640 \u3612 \u3621  (2) \u3592 \u3640 \u3604 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660  (3) \u3626 \u3619 \u3640 \u3611 </li>\
        <li><strong>\uc0\u3588 \u3635 \u3621 \u3591 \u3607 \u3657 \u3634 \u3618 :</strong> \u3605 \u3657 \u3629 \u3591 \u3626 \u3633 \u3617 \u3614 \u3633 \u3609 \u3608 \u3660 \u3585 \u3633 \u3610 \u3588 \u3635 \u3586 \u3638 \u3657 \u3609 \u3605 \u3657 \u3609  (\u3648 \u3594 \u3656 \u3609  \u3648 \u3619 \u3637 \u3618 \u3609  -> \u3586 \u3629 \u3649 \u3626 \u3604 \u3591 \u3588 \u3623 \u3634 \u3617 \u3609 \u3633 \u3610 \u3606 \u3639 \u3629 , \u3585 \u3619 \u3634 \u3610 \u3648 \u3619 \u3637 \u3618 \u3609  -> \u3586 \u3629 \u3649 \u3626 \u3604 \u3591 \u3588 \u3623 \u3634 \u3617 \u3609 \u3633 \u3610 \u3606 \u3639 \u3629 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3636 \u3656 \u3591 )</li>\
        <li><strong>\uc0\u3621 \u3591 \u3594 \u3639 \u3656 \u3629 :</strong> \u3621 \u3634 \u3618 \u3617 \u3639 \u3629 \u3594 \u3639 \u3656 \u3629  \u3649 \u3621 \u3632 \u3614 \u3636 \u3617 \u3614 \u3660 \u3594 \u3639 \u3656 \u3629 \u3648 \u3605 \u3655 \u3617 \u3651 \u3609 \u3623 \u3591 \u3648 \u3621 \u3655 \u3610 \u3651 \u3605 \u3657 \u3621 \u3634 \u3618 \u3617 \u3639 \u3629 \u3594 \u3639 \u3656 \u3629  \u3617 \u3637 \u3588 \u3635 \u3609 \u3635 \u3627 \u3609 \u3657 \u3634  (\u3609 \u3634 \u3618 /\u3609 \u3634 \u3591 /\u3609 \u3634 \u3591 \u3626 \u3634 \u3623 ) \u3627 \u3634 \u3585 \u3617 \u3637 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3623 \u3636 \u3594 \u3634 \u3585 \u3634 \u3619  (\u3624 ., \u3619 \u3624 ., \u3612 \u3624 .) \u3651 \u3627 \u3657 \u3614 \u3636 \u3617 \u3614 \u3660 \u3652 \u3623 \u3657 \u3627 \u3609 \u3657 \u3634 \u3594 \u3639 \u3656 \u3629 \u3651 \u3609 \u3623 \u3591 \u3648 \u3621 \u3655 \u3610 </li>\
        <li><strong>\uc0\u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 :</strong> \u3629 \u3618 \u3641 \u3656 \u3651 \u3605 \u3657 \u3594 \u3639 \u3656 \u3629 \u3648 \u3605 \u3655 \u3617 </li>\
        <li><strong>\uc0\u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3648 \u3592 \u3657 \u3634 \u3586 \u3629 \u3591 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 :</strong> \u3614 \u3636 \u3617 \u3614 \u3660 \u3652 \u3623 \u3657 \u3617 \u3640 \u3617 \u3621 \u3656 \u3634 \u3591 \u3595 \u3657 \u3634 \u3618  \u3606 \u3633 \u3604 \u3592 \u3634 \u3585 \u3610 \u3619 \u3619 \u3607 \u3633 \u3604 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 </li>\
        <li><strong>\uc0\u3650 \u3607 \u3619 . \u3649 \u3621 \u3632  \u3626 \u3635 \u3648 \u3609 \u3634 \u3626 \u3656 \u3591  (\u3606 \u3657 \u3634 \u3617 \u3637 ):</strong> \u3629 \u3618 \u3641 \u3656 \u3651 \u3605 \u3657 \u3594 \u3639 \u3656 \u3629 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3648 \u3592 \u3657 \u3634 \u3586 \u3629 \u3591 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 </li>\
    </ul>\
\
    <h3>\uc0\u55357 \u56541  3.2 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3616 \u3634 \u3618 \u3651 \u3609  (Internal Letter)</h3>\
    <p>\uc0\u3651 \u3594 \u3657 \u3605 \u3636 \u3604 \u3605 \u3656 \u3629 \u3616 \u3634 \u3618 \u3651 \u3609 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591  \u3607 \u3610 \u3623 \u3591  \u3585 \u3619 \u3617  \u3627 \u3619 \u3639 \u3629 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604 \u3648 \u3604 \u3637 \u3618 \u3623 \u3585 \u3633 \u3609  \u3617 \u3637 \u3649 \u3610 \u3610 \u3614 \u3636 \u3608 \u3637 \u3609 \u3657 \u3629 \u3618 \u3585 \u3623 \u3656 \u3634  <span class="highlight">\u3651 \u3594 \u3657 \u3585 \u3619 \u3632 \u3604 \u3634 \u3625 \u3610 \u3633 \u3609 \u3607 \u3638 \u3585 \u3586 \u3657 \u3629 \u3588 \u3623 \u3634 \u3617  (\u3586 \u3609 \u3634 \u3604 \u3588 \u3619 \u3640 \u3601  1.5 \u3595 \u3617 .)</span></p>\
    <ul>\
        <li><strong>\uc0\u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 :</strong> \u3621 \u3591 \u3594 \u3639 \u3656 \u3629 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3629 \u3629 \u3585 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629  \u3614 \u3619 \u3657 \u3629 \u3617 \u3648 \u3610 \u3629 \u3619 \u3660 \u3650 \u3607 \u3619 \u3624 \u3633 \u3614 \u3607 \u3660 </li>\
        <li><strong>\uc0\u3607 \u3637 \u3656 :</strong> \u3619 \u3627 \u3633 \u3626 \u3614 \u3618 \u3633 \u3597 \u3594 \u3609 \u3632 \u3649 \u3621 \u3632 \u3648 \u3621 \u3586 \u3611 \u3619 \u3632 \u3592 \u3635 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619  / \u3648 \u3621 \u3586 \u3607 \u3632 \u3648 \u3610 \u3637 \u3618 \u3609 \u3626 \u3656 \u3591 </li>\
        <li><strong>\uc0\u3623 \u3633 \u3609 \u3607 \u3637 \u3656 :</strong> \u3605 \u3633 \u3623 \u3648 \u3621 \u3586 \u3623 \u3633 \u3609  \u3594 \u3639 \u3656 \u3629 \u3648 \u3605 \u3655 \u3617 \u3648 \u3604 \u3639 \u3629 \u3609  \u3649 \u3621 \u3632 \u3611 \u3637  <span class="highlight">(\u3652 \u3617 \u3656 \u3617 \u3637 \u3588 \u3635 \u3623 \u3656 \u3634  \u3648 \u3604 \u3639 \u3629 \u3609  \u3649 \u3621 \u3632  \u3614 .\u3624 .)</span></li>\
        <li><strong>\uc0\u3648 \u3619 \u3639 \u3656 \u3629 \u3591 :</strong> \u3651 \u3592 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597  \u3627 \u3619 \u3639 \u3629 \u3651 \u3594 \u3657 \u3594 \u3639 \u3656 \u3629 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3648 \u3604 \u3636 \u3617 \u3627 \u3634 \u3585 \u3605 \u3656 \u3629 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591 \u3585 \u3633 \u3609 </li>\
        <li><strong>\uc0\u3588 \u3635 \u3586 \u3638 \u3657 \u3609 \u3605 \u3657 \u3609 :</strong> \u3605 \u3634 \u3617 \u3600 \u3634 \u3609 \u3632 \u3612 \u3641 \u3657 \u3619 \u3633 \u3610 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 </li>\
        <li><strong>\uc0\u3586 \u3657 \u3629 \u3588 \u3623 \u3634 \u3617 :</strong> \u3649 \u3610 \u3656 \u3591  3 \u3626 \u3656 \u3623 \u3609 \u3648 \u3594 \u3656 \u3609 \u3585 \u3633 \u3609  <span class="highlight">\u3649 \u3605 \u3656 \u3592 \u3632 \u3652 \u3617 \u3656 \u3617 \u3637 \u3627 \u3633 \u3623 \u3586 \u3657 \u3629  "\u3629 \u3657 \u3634 \u3591 \u3606 \u3638 \u3591 " \u3649 \u3621 \u3632  "\u3626 \u3636 \u3656 \u3591 \u3607 \u3637 \u3656 \u3626 \u3656 \u3591 \u3617 \u3634 \u3604 \u3657 \u3623 \u3618 " \u3649 \u3618 \u3585 \u3619 \u3632 \u3610 \u3640 \u3605 \u3656 \u3634 \u3591 \u3627 \u3634 \u3585 </span> \u3627 \u3634 \u3585 \u3617 \u3637 \u3651 \u3627 \u3657 \u3629 \u3657 \u3634 \u3591 \u3629 \u3636 \u3591 \u3649 \u3607 \u3619 \u3585 \u3652 \u3611 \u3651 \u3609 \u3648 \u3609 \u3639 \u3657 \u3629 \u3627 \u3634 \u3648 \u3621 \u3618 </li>\
        <li><strong>\uc0\u3621 \u3591 \u3594 \u3639 \u3656 \u3629 \u3649 \u3621 \u3632 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 :</strong> \u3607 \u3635 \u3648 \u3594 \u3656 \u3609 \u3648 \u3604 \u3637 \u3618 \u3623 \u3585 \u3633 \u3610 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3616 \u3634 \u3618 \u3609 \u3629 \u3585 </li>\
    </ul>\
\
    <h2>\uc0\u9997 \u65039  4. \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3648 \u3586 \u3637 \u3618 \u3609 \u3649 \u3621 \u3632 \u3626 \u3635 \u3609 \u3623 \u3609 \u3616 \u3634 \u3625 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619  (Do's & Don'ts)</h2>\
\
    <div class="box-technique">\
        <strong>\uc0\u55358 \u56800  \u3648 \u3607 \u3588 \u3609 \u3636 \u3588 \u3585 \u3634 \u3619 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3585 \u3656 \u3629 \u3609 \u3619 \u3656 \u3634 \u3591 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629  (\u3627 \u3621 \u3633 \u3585  5 \u3629 \u3623 \u3633 \u3618 \u3623 \u3632 )</strong>\
        <ul>\
            <li><strong>\uc0\u3605 \u3634 :</strong> \u3629 \u3656 \u3634 \u3609 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3651 \u3627 \u3657 \u3619 \u3641 \u3657 \u3588 \u3623 \u3634 \u3617 \u3648 \u3611 \u3655 \u3609 \u3617 \u3634 \u3649 \u3621 \u3632 \u3612 \u3621 \u3626 \u3639 \u3610 \u3648 \u3609 \u3639 \u3656 \u3629 \u3591 </li>\
            <li><strong>\uc0\u3611 \u3634 \u3585 :</strong> \u3606 \u3634 \u3617 \u3612 \u3641 \u3657 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3586 \u3657 \u3629 \u3591 \u3627 \u3619 \u3639 \u3629 \u3586 \u3629 \u3619 \u3634 \u3618 \u3621 \u3632 \u3648 \u3629 \u3637 \u3618 \u3604 \u3648 \u3614 \u3636 \u3656 \u3617 \u3648 \u3605 \u3636 \u3617 </li>\
            <li><strong>\uc0\u3627 \u3641 :</strong> \u3615 \u3633 \u3591 \u3648 \u3610 \u3639 \u3657 \u3629 \u3591 \u3627 \u3609 \u3657 \u3634 \u3648 \u3610 \u3639 \u3657 \u3629 \u3591 \u3627 \u3621 \u3633 \u3591 </li>\
            <li><strong>\uc0\u3627 \u3633 \u3623  (\u3651 \u3592 ):</strong> \u3588 \u3636 \u3604 \u3623 \u3636 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3627 \u3634 \u3649 \u3585 \u3656 \u3609 \u3649 \u3607 \u3657 \u3586 \u3629 \u3591 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591  \u3605 \u3633 \u3657 \u3591 \u3651 \u3592 \u3624 \u3638 \u3585 \u3625 \u3634 \u3652 \u3617 \u3656 \u3651 \u3592 \u3621 \u3629 \u3618 </li>\
            <li><strong>\uc0\u3617 \u3639 \u3629 :</strong> \u3588 \u3657 \u3609 \u3588 \u3623 \u3657 \u3634 \u3586 \u3657 \u3629 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3649 \u3621 \u3632 \u3605 \u3633 \u3623 \u3629 \u3618 \u3656 \u3634 \u3591 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3648 \u3585 \u3656 \u3634 </li>\
        </ul>\
    </div>\
\
    <h3>4.1 \uc0\u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3588 \u3635 \u3586 \u3638 \u3657 \u3609 \u3605 \u3657 \u3609 \u3648 \u3609 \u3639 \u3657 \u3629 \u3627 \u3634  (\u3626 \u3656 \u3623 \u3609 \u3648 \u3627 \u3605 \u3640 \u3612 \u3621 )</h3>\
    <ul>\
        <li><strong>\uc0\u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3651 \u3627 \u3617 \u3656 /\u3605 \u3636 \u3604 \u3605 \u3656 \u3629 \u3588 \u3619 \u3633 \u3657 \u3591 \u3649 \u3619 \u3585 :</strong> \u3617 \u3633 \u3585 \u3586 \u3638 \u3657 \u3609 \u3605 \u3657 \u3609 \u3604 \u3657 \u3623 \u3618  <span class="vocab">"\u3604 \u3657 \u3623 \u3618 ..."</span> \u3627 \u3619 \u3639 \u3629  <span class="vocab">"\u3648 \u3609 \u3639 \u3656 \u3629 \u3591 \u3604 \u3657 \u3623 \u3618 ..."</span></li>\
        <li><strong>\uc0\u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3607 \u3637 \u3656 \u3648 \u3588 \u3618 \u3605 \u3636 \u3604 \u3605 \u3656 \u3629 \u3585 \u3633 \u3609 \u3617 \u3634 \u3649 \u3621 \u3657 \u3623 :</strong> \u3617 \u3633 \u3585 \u3586 \u3638 \u3657 \u3609 \u3605 \u3657 \u3609 \u3604 \u3657 \u3623 \u3618  <span class="vocab">"\u3605 \u3634 \u3617 ..."</span>, <span class="vocab">"\u3605 \u3634 \u3617 \u3607 \u3637 \u3656 ..."</span> \u3627 \u3619 \u3639 \u3629  <span class="vocab">"\u3629 \u3609 \u3640 \u3626 \u3609 \u3608 \u3636 "</span></li>\
        <li><strong>\uc0\u3585 \u3634 \u3619 \u3611 \u3636 \u3604 \u3607 \u3657 \u3634 \u3618 \u3626 \u3656 \u3623 \u3609 \u3648 \u3627 \u3605 \u3640 \u3612 \u3621 :</strong> \u3588 \u3635 \u3626 \u3640 \u3604 \u3607 \u3657 \u3634 \u3618 \u3586 \u3629 \u3591 \u3618 \u3656 \u3629 \u3627 \u3609 \u3657 \u3634 \u3626 \u3656 \u3623 \u3609 \u3648 \u3627 \u3605 \u3640 \u3605 \u3657 \u3629 \u3591 \u3592 \u3610 \u3604 \u3657 \u3623 \u3618 \u3588 \u3635 \u3623 \u3656 \u3634  <span class="highlight">"\u3609 \u3633 \u3657 \u3609 "</span> \u3648 \u3626 \u3617 \u3629  (\u3648 \u3623 \u3657 \u3609  1 \u3594 \u3656 \u3623 \u3591 \u3605 \u3633 \u3623 \u3629 \u3633 \u3585 \u3625 \u3619 )</li>\
        <li><strong>\uc0\u3627 \u3634 \u3585 \u3629 \u3657 \u3634 \u3591 \u3629 \u3636 \u3591 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3648 \u3604 \u3636 \u3617 :</strong> \u3586 \u3638 \u3657 \u3609 \u3605 \u3657 \u3609 \u3623 \u3656 \u3634  "\u3605 \u3634 \u3617 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3607 \u3637 \u3656 \u3629 \u3657 \u3634 \u3591 \u3606 \u3638 \u3591 ..." \u3649 \u3621 \u3632 \u3611 \u3636 \u3604 \u3607 \u3657 \u3634 \u3618 \u3623 \u3656 \u3634  "...\u3588 \u3623 \u3634 \u3617 \u3621 \u3632 \u3648 \u3629 \u3637 \u3618 \u3604 \u3649 \u3592 \u3657 \u3591 \u3649 \u3621 \u3657 \u3623 \u3609 \u3633 \u3657 \u3609 "</li>\
    </ul>\
\
    <h3>4.2 \uc0\u3585 \u3634 \u3619 \u3648 \u3586 \u3637 \u3618 \u3609 \u3626 \u3656 \u3623 \u3609 \u3592 \u3640 \u3604 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3649 \u3621 \u3632 \u3626 \u3656 \u3623 \u3609 \u3626 \u3619 \u3640 \u3611 </h3>\
    <ul>\
        <li>\uc0\u3626 \u3656 \u3623 \u3609 \u3592 \u3640 \u3604 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 \u3617 \u3633 \u3585 \u3586 \u3638 \u3657 \u3609 \u3605 \u3657 \u3609 \u3604 \u3657 \u3623 \u3618 \u3588 \u3635 \u3623 \u3656 \u3634  <span class="vocab">"\u3592 \u3638 \u3591 ..."</span></li>\
        <li><strong>\uc0\u3648 \u3614 \u3639 \u3656 \u3629 \u3607 \u3619 \u3634 \u3610 :</strong> "\u3592 \u3638 \u3591 \u3648 \u3619 \u3637 \u3618 \u3609 \u3617 \u3634 \u3648 \u3614 \u3639 \u3656 \u3629 \u3650 \u3611 \u3619 \u3604 \u3607 \u3619 \u3634 \u3610 " \u3627 \u3619 \u3639 \u3629  "\u3592 \u3638 \u3591 \u3648 \u3619 \u3637 \u3618 \u3609 \u3617 \u3634 \u3648 \u3614 \u3639 \u3656 \u3629 \u3607 \u3619 \u3634 \u3610 "</li>\
        <li><strong>\uc0\u3648 \u3614 \u3639 \u3656 \u3629 \u3604 \u3635 \u3648 \u3609 \u3636 \u3609 \u3585 \u3634 \u3619 :</strong> "\u3592 \u3638 \u3591 \u3648 \u3619 \u3637 \u3618 \u3609 \u3617 \u3634 \u3648 \u3614 \u3639 \u3656 \u3629 \u3650 \u3611 \u3619 \u3604 \u3614 \u3636 \u3592 \u3634 \u3619 \u3603 \u3634 \u3604 \u3635 \u3648 \u3609 \u3636 \u3609 \u3585 \u3634 \u3619 \u3605 \u3656 \u3629 \u3652 \u3611 "</li>\
        <li><strong>\uc0\u3648 \u3614 \u3639 \u3656 \u3629 \u3629 \u3609 \u3640 \u3617 \u3633 \u3605 \u3636 /\u3605 \u3633 \u3604 \u3626 \u3636 \u3609 \u3651 \u3592 :</strong> "\u3592 \u3638 \u3591 \u3648 \u3619 \u3637 \u3618 \u3609 \u3617 \u3634 \u3648 \u3614 \u3639 \u3656 \u3629 \u3650 \u3611 \u3619 \u3604 \u3614 \u3636 \u3592 \u3634 \u3619 \u3603 \u3634 \u3629 \u3609 \u3640 \u3617 \u3633 \u3605 \u3636 "</li>\
        <li><strong>\uc0\u3585 \u3634 \u3619 \u3586 \u3629 \u3588 \u3623 \u3634 \u3617 \u3629 \u3609 \u3640 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 :</strong> "\u3627 \u3623 \u3633 \u3591 \u3648 \u3611 \u3655 \u3609 \u3629 \u3618 \u3656 \u3634 \u3591 \u3618 \u3636 \u3656 \u3591 \u3623 \u3656 \u3634 \u3588 \u3591 \u3592 \u3632 \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 \u3588 \u3623 \u3634 \u3617 \u3629 \u3609 \u3640 \u3648 \u3588 \u3619 \u3634 \u3632 \u3627 \u3660 \u3592 \u3634 \u3585 \u3607 \u3656 \u3634 \u3609  \u3649 \u3621 \u3632 \u3586 \u3629 \u3586 \u3629 \u3610 \u3614 \u3619 \u3632 \u3588 \u3640 \u3603 \u3648 \u3611 \u3655 \u3609 \u3629 \u3618 \u3656 \u3634 \u3591 \u3626 \u3641 \u3591 \u3617 \u3634  \u3603  \u3650 \u3629 \u3585 \u3634 \u3626 \u3609 \u3637 \u3657 "</li>\
    </ul>\
\
    <h3>4.3 \uc0\u3585 \u3598 \u3648 \u3627 \u3621 \u3655 \u3585 \u3607 \u3637 \u3656 \u3605 \u3657 \u3629 \u3591 \u3619 \u3632 \u3623 \u3633 \u3591 \u3651 \u3609 \u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3616 \u3634 \u3625 \u3634 </h3>\
    <ul>\
        <li><strong>\uc0\u3626 \u3619 \u3619 \u3614 \u3609 \u3634 \u3617 :</strong> \u3627 \u3657 \u3634 \u3617 \u3651 \u3594 \u3657 \u3588 \u3635 \u3623 \u3656 \u3634  \u3585 \u3619 \u3632 \u3612 \u3617 , \u3604 \u3636 \u3593 \u3633 \u3609 , \u3586 \u3657 \u3634 \u3614 \u3648 \u3592 \u3657 \u3634  \u3651 \u3627 \u3657 \u3651 \u3594 \u3657  <span class="highlight">\u3594 \u3639 \u3656 \u3629 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </span> \u3648 \u3611 \u3655 \u3609 \u3626 \u3619 \u3619 \u3614 \u3609 \u3634 \u3617 \u3610 \u3640 \u3619 \u3640 \u3625 \u3607 \u3637 \u3656  1 \u3649 \u3607 \u3609 </li>\
        <li><strong>\uc0\u3585 \u3634 \u3619 \u3605 \u3633 \u3604 \u3588 \u3635 :</strong> \u3627 \u3657 \u3634 \u3617 \u3614 \u3636 \u3617 \u3614 \u3660 \u3605 \u3633 \u3604 \u3588 \u3635 \u3586 \u3657 \u3634 \u3617 \u3610 \u3619 \u3619 \u3607 \u3633 \u3604  \u3648 \u3594 \u3656 \u3609  \u3614 \u3618 \u3633 \u3597 \u3594 \u3609 \u3632 \u3605 \u3657 \u3609 \u3629 \u3618 \u3641 \u3656 \u3629 \u3637 \u3585 \u3610 \u3619 \u3619 \u3607 \u3633 \u3604  \u3626 \u3619 \u3632 /\u3605 \u3633 \u3623 \u3626 \u3632 \u3585 \u3604 \u3629 \u3618 \u3641 \u3656 \u3629 \u3637 \u3585 \u3610 \u3619 \u3619 \u3607 \u3633 \u3604  (\u3648 \u3594 \u3656 \u3609  \u3617 \u3627 \u3634 \u3623 \u3636 \u3607 - \u3618 \u3634 \u3621 \u3633 \u3618  \u3649 \u3610 \u3610 \u3609 \u3637 \u3657 \u3612 \u3636 \u3604 )</li>\
        <li><strong>\uc0\u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3629 \u3633 \u3585 \u3625 \u3619 \u3618 \u3656 \u3629 :</strong> \u3651 \u3594 \u3657 \u3652 \u3604 \u3657 \u3648 \u3593 \u3614 \u3634 \u3632 \u3588 \u3635 \u3607 \u3637 \u3656 \u3649 \u3614 \u3619 \u3656 \u3627 \u3621 \u3634 \u3618  (\u3648 \u3594 \u3656 \u3609  \u3585 \u3607 \u3617 ., \u3614 .\u3619 .\u3610 .) \u3627 \u3619 \u3639 \u3629 \u3648 \u3586 \u3637 \u3618 \u3609 \u3648 \u3605 \u3655 \u3617 \u3651 \u3609 \u3588 \u3619 \u3633 \u3657 \u3591 \u3649 \u3619 \u3585 \u3649 \u3621 \u3657 \u3623 \u3623 \u3591 \u3648 \u3621 \u3655 \u3610 \u3629 \u3633 \u3585 \u3625 \u3619 \u3618 \u3656 \u3629 \u3652 \u3623 \u3657 \u3604 \u3657 \u3634 \u3609 \u3627 \u3621 \u3633 \u3591 </li>\
        <li><strong>\uc0\u3585 \u3634 \u3619 \u3651 \u3594 \u3657 \u3652 \u3611 \u3618 \u3634 \u3621 \u3609 \u3657 \u3629 \u3618  (\u3631 ):</strong> \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3588 \u3635 \u3623 \u3636 \u3626 \u3634 \u3617 \u3634 \u3609 \u3618 \u3609 \u3634 \u3617 \u3586 \u3609 \u3634 \u3604 \u3618 \u3634 \u3623  \u3651 \u3627 \u3657 \u3648 \u3586 \u3637 \u3618 \u3609 \u3648 \u3605 \u3655 \u3617 \u3651 \u3609 \u3588 \u3619 \u3633 \u3657 \u3591 \u3649 \u3619 \u3585  \u3588 \u3619 \u3633 \u3657 \u3591 \u3605 \u3656 \u3629 \u3652 \u3611 \u3648 \u3586 \u3637 \u3618 \u3609 \u3618 \u3656 \u3629 \u3649 \u3621 \u3657 \u3623 \u3651 \u3626 \u3656  \u3631  \u3605 \u3634 \u3617 \u3627 \u3621 \u3633 \u3591 </li>\
        <li><strong>\uc0\u3627 \u3609 \u3657 \u3634 \u3585 \u3619 \u3632 \u3604 \u3634 \u3625 \u3607 \u3637 \u3656  2 \u3586 \u3638 \u3657 \u3609 \u3652 \u3611 :</strong> \u3627 \u3634 \u3585 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3618 \u3634 \u3623 \u3648 \u3585 \u3636 \u3609  1 \u3627 \u3609 \u3657 \u3634  \u3651 \u3627 \u3657 \u3651 \u3594 \u3657 \u3585 \u3619 \u3632 \u3604 \u3634 \u3625 \u3605 \u3619 \u3634 \u3588 \u3619 \u3640 \u3601 \u3649 \u3588 \u3656 \u3627 \u3609 \u3657 \u3634 \u3649 \u3619 \u3585  \u3627 \u3609 \u3657 \u3634 \u3605 \u3656 \u3629 \u3652 \u3611 \u3651 \u3594 \u3657 \u3585 \u3619 \u3632 \u3604 \u3634 \u3625 \u3586 \u3634 \u3623 \u3608 \u3619 \u3619 \u3617 \u3604 \u3634 \u3586 \u3609 \u3634 \u3604 \u3648 \u3607 \u3656 \u3634 \u3585 \u3633 \u3609 </li>\
    </ul>\
\
    <h3>4.4 \uc0\u3621 \u3633 \u3585 \u3625 \u3603 \u3632 \u3626 \u3635 \u3609 \u3623 \u3609 \u3616 \u3634 \u3625 \u3634 \u3607 \u3637 \u3656 \u3610 \u3585 \u3614 \u3619 \u3656 \u3629 \u3591  (\u3605 \u3657 \u3629 \u3591 \u3627 \u3621 \u3637 \u3585 \u3648 \u3621 \u3637 \u3656 \u3618 \u3591 )</h3>\
    <ol>\
        <li><span class="vocab">\uc0\u3652 \u3617 \u3656 \u3594 \u3633 \u3604 \u3648 \u3592 \u3609 :</span> \u3588 \u3621 \u3640 \u3617 \u3648 \u3588 \u3619 \u3639 \u3629  \u3605 \u3637 \u3588 \u3623 \u3634 \u3617 \u3652 \u3604 \u3657 \u3627 \u3621 \u3634 \u3618 \u3629 \u3618 \u3656 \u3634 \u3591  (\u3648 \u3594 \u3656 \u3609  "\u3650 \u3611 \u3619 \u3604 \u3649 \u3592 \u3657 \u3591 \u3651 \u3627 \u3657 \u3607 \u3619 \u3634 \u3610 \u3604 \u3657 \u3623 \u3618 " \u3588 \u3623 \u3619 \u3649 \u3585 \u3657 \u3648 \u3611 \u3655 \u3609  "\u3650 \u3611 \u3619 \u3604 \u3649 \u3592 \u3657 \u3591 \u3651 \u3627 \u3657 \u3607 \u3619 \u3634 \u3610 \u3616 \u3634 \u3618 \u3651 \u3609  7 \u3623 \u3633 \u3609 ...")</li>\
        <li><span class="vocab">\uc0\u3652 \u3617 \u3656 \u3626 \u3640 \u3616 \u3634 \u3614 \u3649 \u3609 \u3610 \u3648 \u3609 \u3637 \u3618 \u3609 :</span> \u3651 \u3594 \u3657 \u3588 \u3635 \u3627 \u3657 \u3623 \u3609  \u3627 \u3619 \u3639 \u3629 \u3586 \u3641 \u3656 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610  (\u3648 \u3594 \u3656 \u3609  "\u3617 \u3636 \u3593 \u3632 \u3609 \u3633 \u3657 \u3609 \u3592 \u3632 \u3592 \u3633 \u3604 \u3585 \u3634 \u3619 \u3605 \u3634 \u3617 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610 " \u3588 \u3623 \u3619 \u3651 \u3594 \u3657  "\u3648 \u3614 \u3639 \u3656 \u3629 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3651 \u3627 \u3657 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591 \u3605 \u3634 \u3617 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610 \u3605 \u3656 \u3629 \u3652 \u3611 ")</li>\
        <li><span class="vocab">\uc0\u3652 \u3617 \u3656 \u3606 \u3641 \u3585 \u3605 \u3657 \u3629 \u3591 :</span> \u3651 \u3594 \u3657 \u3616 \u3634 \u3625 \u3634 \u3614 \u3641 \u3604 \u3627 \u3619 \u3639 \u3629 \u3612 \u3636 \u3604 \u3619 \u3632 \u3604 \u3633 \u3610  (\u3648 \u3594 \u3656 \u3609  "\u3652 \u3617 \u3656 \u3619 \u3633 \u3610 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3629 \u3632 \u3652 \u3619 \u3648 \u3621 \u3618 " \u3588 \u3623 \u3619 \u3649 \u3585 \u3657 \u3648 \u3611 \u3655 \u3609  "\u3652 \u3617 \u3656 \u3652 \u3604 \u3657 \u3619 \u3633 \u3610 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3629 \u3633 \u3609 \u3651 \u3604 ")</li>\
        <li><span class="vocab">\uc0\u3652 \u3617 \u3656 \u3652 \u3604 \u3657 \u3588 \u3623 \u3634 \u3617 \u3626 \u3617 \u3610 \u3641 \u3619 \u3603 \u3660 :</span> \u3586 \u3634 \u3604 \u3626 \u3634 \u3619 \u3632 \u3626 \u3635 \u3588 \u3633 \u3597 \u3610 \u3634 \u3591 \u3605 \u3629 \u3609 </li>\
        <li><span class="vocab">\uc0\u3652 \u3617 \u3656 \u3585 \u3632 \u3607 \u3633 \u3604 \u3619 \u3633 \u3604 :</span> \u3651 \u3594 \u3657 \u3611 \u3619 \u3632 \u3650 \u3618 \u3588 \u3615 \u3640 \u3656 \u3617 \u3648 \u3615 \u3639 \u3629 \u3618 \u3648 \u3585 \u3636 \u3609 \u3588 \u3623 \u3634 \u3617 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609  \u3623 \u3585 \u3623 \u3609 </li>\
        <li><span class="vocab">\uc0\u3586 \u3634 \u3604 \u3588 \u3623 \u3634 \u3617 \u3626 \u3621 \u3632 \u3626 \u3621 \u3623 \u3618 :</span> \u3648 \u3619 \u3637 \u3618 \u3591 \u3621 \u3635 \u3604 \u3633 \u3610 \u3588 \u3623 \u3634 \u3617 \u3652 \u3617 \u3656 \u3648 \u3611 \u3655 \u3609 \u3652 \u3611 \u3605 \u3634 \u3617 \u3588 \u3623 \u3634 \u3617 \u3626 \u3635 \u3588 \u3633 \u3597  \u3586 \u3634 \u3604 \u3648 \u3629 \u3585 \u3616 \u3634 \u3614 </li>\
    </ol>\
\
    <h2>\uc0\u55357 \u56523  5. \u3585 \u3634 \u3619 \u3621 \u3591 \u3594 \u3639 \u3656 \u3629 \u3612 \u3641 \u3657 \u3617 \u3637 \u3629 \u3635 \u3609 \u3634 \u3592 \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3592 \u3656 \u3634 \u3627 \u3609 \u3657 \u3634 \u3595 \u3629 \u3591 </h2>\
    <ul>\
        <li><span class="vocab">\uc0\u3585 \u3634 \u3619 \u3621 \u3591 \u3609 \u3634 \u3617 \u3649 \u3607 \u3609 :</span> \u3627 \u3634 \u3585 \u3612 \u3641 \u3657 \u3617 \u3637 \u3629 \u3635 \u3609 \u3634 \u3592 \u3617 \u3629 \u3610 \u3627 \u3617 \u3634 \u3618 \u3651 \u3627 \u3657 \u3612 \u3641 \u3657 \u3629 \u3639 \u3656 \u3609 \u3621 \u3591 \u3609 \u3634 \u3617  \u3651 \u3627 \u3657 \u3614 \u3636 \u3617 \u3614 \u3660 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3612 \u3641 \u3657 \u3621 \u3591 \u3609 \u3634 \u3617  \u3649 \u3621 \u3632 \u3621 \u3633 \u3585 \u3625 \u3603 \u3632 \u3585 \u3634 \u3619 \u3649 \u3607 \u3609  \u3648 \u3594 \u3656 \u3609  <span class="highlight">"\u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3607 \u3609 ", "\u3619 \u3633 \u3585 \u3625 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3607 \u3609 "</span> \u3652 \u3623 \u3657 \u3651 \u3609 \u3610 \u3619 \u3619 \u3607 \u3633 \u3604 \u3648 \u3604 \u3637 \u3618 \u3623 \u3585 \u3633 \u3609  \u3649 \u3621 \u3632 \u3619 \u3632 \u3610 \u3640 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3586 \u3629 \u3591 \u3648 \u3592 \u3657 \u3634 \u3586 \u3629 \u3591 \u3648 \u3619 \u3639 \u3656 \u3629 \u3591 \u3605 \u3633 \u3623 \u3592 \u3619 \u3636 \u3591 \u3651 \u3609 \u3610 \u3619 \u3619 \u3607 \u3633 \u3604 \u3606 \u3633 \u3604 \u3617 \u3634 </li>\
        <li><span class="vocab">\uc0\u3585 \u3634 \u3619 \u3592 \u3656 \u3634 \u3627 \u3609 \u3657 \u3634 \u3595 \u3629 \u3591 :</span>\
            <ul>\
                <li>\uc0\u3619 \u3632 \u3610 \u3640 \u3594 \u3639 \u3656 \u3629 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619  \u3626 \u3606 \u3634 \u3609 \u3607 \u3637 \u3656 \u3605 \u3633 \u3657 \u3591  \u3649 \u3621 \u3632  <span class="highlight">\u3648 \u3621 \u3586 \u3607 \u3637 \u3656 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 </span> \u3652 \u3623 \u3657 \u3617 \u3640 \u3617 \u3610 \u3609 \u3595 \u3657 \u3634 \u3618 \u3651 \u3605 \u3657 \u3605 \u3633 \u3623 \u3588 \u3619 \u3640 \u3601 </li>\
                <li>\uc0\u3614 \u3636 \u3617 \u3614 \u3660 \u3586 \u3657 \u3629 \u3588 \u3623 \u3634 \u3617  "\u3594 \u3635 \u3619 \u3632 \u3588 \u3656 \u3634 \u3613 \u3634 \u3585 \u3626 \u3656 \u3591 \u3648 \u3611 \u3655 \u3609 \u3619 \u3634 \u3618 \u3648 \u3604 \u3639 \u3629 \u3609 ..." \u3586 \u3609 \u3634 \u3604  2x4 \u3595 \u3617 . \u3617 \u3640 \u3617 \u3610 \u3609 \u3586 \u3623 \u3634 </li>\
                <li>\uc0\u3619 \u3632 \u3610 \u3640 \u3609 \u3634 \u3617 \u3612 \u3641 \u3657 \u3619 \u3633 \u3610 \u3605 \u3619 \u3591 \u3585 \u3621 \u3634 \u3591 \u3595 \u3629 \u3591 </li>\
                <li>\uc0\u3648 \u3592 \u3657 \u3634 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3613 \u3634 \u3585 \u3626 \u3656 \u3591 \u3605 \u3657 \u3629 \u3591 \u3648 \u3595 \u3655 \u3609 \u3594 \u3639 \u3656 \u3629 \u3627 \u3619 \u3639 \u3629 \u3611 \u3619 \u3632 \u3607 \u3633 \u3610 \u3605 \u3619 \u3634 \u3585 \u3635 \u3585 \u3633 \u3610 \u3617 \u3640 \u3617 \u3621 \u3656 \u3634 \u3591 \u3595 \u3657 \u3634 \u3618 \u3595 \u3629 \u3591 </li>\
            </ul>\
        </li>\
    </ul>\
\
</div>\
\
