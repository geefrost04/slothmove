    <div class="box-info">\
        <h3 style="margin-top: 0; border: none; background: none; color: #d84315;">\uc0\u55357 \u56481  \u3605 \u3633 \u3623 \u3648 \u3621 \u3586 \u3649 \u3621 \u3632 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3626 \u3606 \u3636 \u3605 \u3636 \u3607 \u3637 \u3656 \u3605 \u3657 \u3629 \u3591 \u3592 \u3635 \u3649 \u3617 \u3656 \u3609 \u3618 \u3635  (\u3629 \u3629 \u3585 \u3626 \u3629 \u3610 \u3610 \u3656 \u3629 \u3618 )</h3>\
        <ul>\
            <li><span class="highlight">6 \uc0\u3611 \u3619 \u3632 \u3648 \u3616 \u3607 :</span> \u3611 \u3619 \u3632 \u3648 \u3616 \u3607 \u3586 \u3629 \u3591 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3617 \u3637  6 \u3594 \u3609 \u3636 \u3604 </li>\
            <li><span class="highlight">3 \uc0\u3626 \u3656 \u3623 \u3609 :</span> \u3586 \u3657 \u3629 \u3588 \u3623 \u3634 \u3617 \u3627 \u3619 \u3639 \u3629 \u3648 \u3609 \u3639 \u3657 \u3629 \u3627 \u3634 \u3651 \u3609 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3610 \u3656 \u3591 \u3648 \u3611 \u3655 \u3609  3 \u3626 \u3656 \u3623 \u3609  \u3588 \u3639 \u3629  \u3626 \u3656 \u3623 \u3609 \u3648 \u3627 \u3605 \u3640 \u3612 \u3621 , \u3626 \u3656 \u3623 \u3609 \u3592 \u3640 \u3604 \u3611 \u3619 \u3632 \u3626 \u3591 \u3588 \u3660 , \u3626 \u3656 \u3623 \u3609 \u3626 \u3619 \u3640 \u3611 </li>\
            <li><span class="highlight">3 \uc0\u3648 \u3595 \u3609 \u3605 \u3636 \u3648 \u3617 \u3605 \u3619 :</span> \u3586 \u3609 \u3634 \u3604 \u3586 \u3629 \u3591 \u3605 \u3619 \u3634 \u3588 \u3619 \u3640 \u3601 \u3651 \u3609  <strong>\u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3616 \u3634 \u3618 \u3609 \u3629 \u3585 </strong></li>\
            <li><span class="highlight">1.5 \uc0\u3648 \u3595 \u3609 \u3605 \u3636 \u3648 \u3617 \u3605 \u3619 :</span> \u3586 \u3609 \u3634 \u3604 \u3586 \u3629 \u3591 \u3605 \u3619 \u3634 \u3588 \u3619 \u3640 \u3601 \u3651 \u3609  <strong>\u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3616 \u3634 \u3618 \u3651 \u3609 </strong></li>\
            <li><span class="highlight">60 \uc0\u3585 \u3619 \u3633 \u3617 \u3605 \u3656 \u3629 \u3605 \u3634 \u3619 \u3634 \u3591 \u3648 \u3617 \u3605 \u3619 :</span> \u3609 \u3657 \u3635 \u3627 \u3609 \u3633 \u3585 \u3586 \u3633 \u3657 \u3609 \u3605 \u3656 \u3635 \u3586 \u3629 \u3591 \u3585 \u3619 \u3632 \u3604 \u3634 \u3625 \u3611 \u3629 \u3609 \u3604 \u3660 \u3586 \u3634 \u3623 \u3607 \u3637 \u3656 \u3651 \u3594 \u3657 \u3614 \u3636 \u3617 \u3614 \u3660 \u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </li>\
            <li><span class="highlight">210 x 297 \uc0\u3617 \u3636 \u3621 \u3621 \u3636 \u3648 \u3617 \u3605 \u3619 :</span> \u3586 \u3609 \u3634 \u3604 \u3586 \u3629 \u3591 \u3585 \u3619 \u3632 \u3604 \u3634 \u3625 \u3607 \u3637 \u3656 \u3651 \u3594 \u3657  (\u3585 \u3619 \u3632 \u3604 \u3634 \u3625 \u3586 \u3609 \u3634 \u3604  A4)</li>\
            <li><span class="highlight">2 x 4 \uc0\u3648 \u3595 \u3609 \u3605 \u3636 \u3648 \u3617 \u3605 \u3619 :</span> \u3586 \u3609 \u3634 \u3604 \u3585 \u3619 \u3629 \u3610 \u3626 \u3637 \u3656 \u3648 \u3627 \u3621 \u3637 \u3656 \u3618 \u3617 \u3612 \u3639 \u3609 \u3612 \u3657 \u3634 \u3649 \u3609 \u3623 \u3609 \u3629 \u3609  \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3614 \u3636 \u3617 \u3614 \u3660 \u3586 \u3657 \u3629 \u3588 \u3623 \u3634 \u3617  "\u3594 \u3635 \u3619 \u3632 \u3588 \u3656 \u3634 \u3613 \u3634 \u3585 \u3626 \u3656 \u3591 \u3648 \u3611 \u3655 \u3609 \u3619 \u3634 \u3618 \u3648 \u3604 \u3639 \u3629 \u3609 " \u3617 \u3640 \u3617 \u3610 \u3609 \u3586 \u3623 \u3634 \u3595 \u3629 \u3591 </li>\
        </ul>\
