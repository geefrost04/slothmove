  // ==========================================\
  // \uc0\u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  1: \u3588 \u3635 \u3624 \u3633 \u3614 \u3607 \u3660 \u3626 \u3635 \u3588 \u3633 \u3597 \u3607 \u3637 \u3656 \u3617 \u3633 \u3585 \u3629 \u3629 \u3585 \u3626 \u3629 \u3610  (Important Vocabulary)\
  // ==========================================\
  importantVocabulary: \{\
    coreConcepts: [\
      \{\
        term: "\uc0\u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3626 \u3640 \u3586 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 ",\
        definition: "\uc0\u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3641 \u3591 \u3626 \u3640 \u3604 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3605 \u3634 \u3617  \u3614 .\u3619 .\u3610 . \u3593 \u3610 \u3633 \u3610 \u3609 \u3637 \u3657 ,."\
      \},\
      \{\
        term: "\uc0\u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3585 \u3636 \u3592 \u3585 \u3634 \u3619 \u3610 \u3657 \u3634 \u3609 \u3648 \u3617 \u3639 \u3629 \u3591 \u3607 \u3637 \u3656 \u3604 \u3637  (Good Governance)",\
        definition: "\uc0\u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3626 \u3635 \u3588 \u3633 \u3597 \u3607 \u3637 \u3656 \u3648 \u3614 \u3636 \u3656 \u3617 \u3648 \u3586 \u3657 \u3634 \u3617 \u3634 \u3651 \u3609 \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  5 (\u3614 .\u3624 . 2545) \u3648 \u3609 \u3657 \u3609 \u3612 \u3621 \u3626 \u3633 \u3617 \u3620 \u3607 \u3608 \u3636 \u3660 \u3605 \u3656 \u3629 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 \u3586 \u3629 \u3591 \u3619 \u3633 \u3600  \u3588 \u3623 \u3634 \u3617 \u3588 \u3640 \u3657 \u3617 \u3588 \u3656 \u3634  \u3585 \u3634 \u3619 \u3621 \u3604 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609  \u3649 \u3621 \u3632 \u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3592 \u3634 \u3618 \u3629 \u3635 \u3609 \u3634 \u3592 ,."\
      \},\
      \{\
        term: "\uc0\u3588 \u3623 \u3634 \u3617 \u3588 \u3640 \u3657 \u3617 \u3588 \u3656 \u3634 \u3651 \u3609 \u3648 \u3594 \u3636 \u3591 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 \u3649 \u3627 \u3656 \u3591 \u3619 \u3633 \u3600 ",\
        definition: "\uc0\u3585 \u3634 \u3619 \u3648 \u3611 \u3619 \u3637 \u3618 \u3610 \u3648 \u3607 \u3637 \u3618 \u3610 \u3612 \u3621 \u3621 \u3633 \u3614 \u3608 \u3660 \u3607 \u3637 \u3656 \u3652 \u3604 \u3657 \u3585 \u3633 \u3610 \u3607 \u3619 \u3633 \u3614 \u3618 \u3634 \u3585 \u3619  (\u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 , \u3588 \u3609 , \u3648 \u3623 \u3621 \u3634 ) \u3607 \u3637 \u3656 \u3651 \u3594 \u3657 \u3652 \u3611  \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3648 \u3585 \u3636 \u3604 \u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3626 \u3641 \u3591 \u3626 \u3640 \u3604 ,."\
      \}\
    ],\
    legalStatus: [\
      \{\
        term: "\uc0\u3609 \u3636 \u3605 \u3636 \u3610 \u3640 \u3588 \u3588 \u3621  (Juristic Person)",\
        definition: "\uc0\u3626 \u3606 \u3634 \u3609 \u3632 \u3605 \u3634 \u3617 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3607 \u3635 \u3609 \u3636 \u3605 \u3636 \u3585 \u3619 \u3619 \u3617 \u3649 \u3621 \u3632 \u3615 \u3657 \u3629 \u3591 \u3619 \u3657 \u3629 \u3591 \u3652 \u3604 \u3657  \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3648 \u3611 \u3655 \u3609 \u3609 \u3636 \u3605 \u3636 \u3610 \u3640 \u3588 \u3588 \u3621  \u3652 \u3604 \u3657 \u3649 \u3585 \u3656  \u3626 \u3635 \u3609 \u3633 \u3585 \u3609 \u3634 \u3618 \u3585 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 , \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 , \u3607 \u3610 \u3623 \u3591 , \u3585 \u3619 \u3617  \u3649 \u3621 \u3632  \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604 ,,."\
      \},\
      \{\
        term: "\uc0\u3585 \u3629 \u3591  \u3649 \u3621 \u3632  \u3629 \u3635 \u3648 \u3616 \u3629 ",\
        definition: "\uc0\u3648 \u3611 \u3655 \u3609 \u3648 \u3614 \u3637 \u3618 \u3591 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3616 \u3634 \u3618 \u3651 \u3609 \u3649 \u3621 \u3632 \u3648 \u3586 \u3605 \u3585 \u3634 \u3619 \u3611 \u3585 \u3588 \u3619 \u3629 \u3591  \u3652 \u3617 \u3656 \u3617 \u3637 \u3600 \u3634 \u3609 \u3632 \u3648 \u3611 \u3655 \u3609 \u3609 \u3636 \u3605 \u3636 \u3610 \u3640 \u3588 \u3588 \u3621 ,."\
      \}\
    ],\
    operations: [\
      \{\
        term: "\uc0\u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3607 \u3609 ",\
        definition: "\uc0\u3585 \u3634 \u3619  '\u3617 \u3629 \u3610 \u3629 \u3635 \u3609 \u3634 \u3592 ' \u3651 \u3627 \u3657 \u3612 \u3641 \u3657 \u3629 \u3639 \u3656 \u3609 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3591 \u3634 \u3609 \u3649 \u3607 \u3609 \u3648 \u3614 \u3639 \u3656 \u3629 \u3588 \u3623 \u3634 \u3617 \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623 \u3649 \u3621 \u3632 \u3629 \u3635 \u3609 \u3623 \u3618 \u3588 \u3623 \u3634 \u3617 \u3626 \u3632 \u3604 \u3623 \u3585  \u3605 \u3657 \u3629 \u3591 \u3607 \u3635 \u3648 \u3611 \u3655 \u3609  '\u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 ' \u3649 \u3621 \u3632 \u3612 \u3641 \u3657 \u3617 \u3629 \u3610 \u3618 \u3633 \u3591 \u3588 \u3591 \u3617 \u3637 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3585 \u3635 \u3585 \u3633 \u3610 \u3604 \u3641 \u3649 \u3621 \u3605 \u3636 \u3604 \u3605 \u3634 \u3617 \u3612 \u3621 ,,."\
      \},\
      \{\
        term: "\uc0\u3585 \u3634 \u3619 \u3619 \u3633 \u3585 \u3625 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3607 \u3609 ",\
        definition: "\uc0\u3585 \u3634 \u3619 \u3648 \u3586 \u3657 \u3634 \u3607 \u3635 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3649 \u3607 \u3609 \u3651 \u3609 \u3585 \u3619 \u3603 \u3637 \u3607 \u3637 \u3656  '\u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3623 \u3656 \u3634 \u3591 \u3621 \u3591 ' \u3627 \u3619 \u3639 \u3629 \u3612 \u3641 \u3657 \u3604 \u3635 \u3619 \u3591 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591  '\u3652 \u3617 \u3656 \u3629 \u3634 \u3592 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3652 \u3604 \u3657 ' \u3612 \u3641 \u3657 \u3619 \u3633 \u3585 \u3625 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3607 \u3609 \u3617 \u3637 \u3629 \u3635 \u3609 \u3634 \u3592 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3648 \u3594 \u3656 \u3609 \u3648 \u3604 \u3637 \u3618 \u3623 \u3585 \u3633 \u3610 \u3612 \u3641 \u3657 \u3604 \u3635 \u3619 \u3591 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3648 \u3604 \u3636 \u3617 \u3607 \u3640 \u3585 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619 ,."\
      \},\
      \{\
        term: "\uc0\u3585 \u3621 \u3640 \u3656 \u3617 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592  (Cluster)",\
        definition: "\uc0\u3585 \u3634 \u3619 \u3609 \u3635 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3619 \u3632 \u3604 \u3633 \u3610 \u3585 \u3619 \u3617 \u3605 \u3633 \u3657 \u3591 \u3649 \u3605 \u3656  2 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3586 \u3638 \u3657 \u3609 \u3652 \u3611 \u3607 \u3637 \u3656 \u3617 \u3637 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3586 \u3657 \u3629 \u3591 \u3585 \u3633 \u3609 \u3617 \u3634 \u3619 \u3623 \u3617 \u3652 \u3623 \u3657 \u3604 \u3657 \u3623 \u3618 \u3585 \u3633 \u3609  \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3617 \u3637 \u3648 \u3629 \u3585 \u3616 \u3634 \u3614 \u3649 \u3621 \u3632 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 ,."\
      \},\
      \{\
        term: "\uc0\u3627 \u3609 \u3656 \u3623 \u3618 \u3610 \u3619 \u3636 \u3585 \u3634 \u3619 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3614 \u3636 \u3648 \u3624 \u3625 ",\
        definition: "\uc0\u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3617 \u3636 \u3651 \u3594 \u3656 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3621 \u3632 \u3617 \u3636 \u3651 \u3594 \u3656 \u3619 \u3633 \u3600 \u3623 \u3636 \u3626 \u3634 \u3627 \u3585 \u3636 \u3592  \u3649 \u3605 \u3656 \u3629 \u3618 \u3641 \u3656 \u3651 \u3609 \u3585 \u3635 \u3585 \u3633 \u3610 \u3586 \u3629 \u3591 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619  \u3619 \u3634 \u3618 \u3652 \u3604 \u3657 \u3652 \u3617 \u3656 \u3605 \u3657 \u3629 \u3591 \u3609 \u3635 \u3626 \u3656 \u3591 \u3588 \u3621 \u3633 \u3591 \u3648 \u3614 \u3639 \u3656 \u3629 \u3588 \u3623 \u3634 \u3617 \u3588 \u3621 \u3656 \u3629 \u3591 \u3605 \u3633 \u3623 \u3651 \u3609 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 ,."\
      \},\
      \{\
        term: "\uc0\u3588 \u3603 \u3632 \u3612 \u3641 \u3657 \u3649 \u3607 \u3609  (\u3651 \u3609 \u3605 \u3656 \u3634 \u3591 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 )",\
        definition: "\uc0\u3610 \u3619 \u3619 \u3604 \u3634 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3613 \u3656 \u3634 \u3618 \u3614 \u3621 \u3648 \u3619 \u3639 \u3629 \u3609 \u3627 \u3619 \u3639 \u3629 \u3607 \u3627 \u3634 \u3619 \u3607 \u3637 \u3656 \u3611 \u3619 \u3632 \u3592 \u3635 \u3585 \u3634 \u3619 \u3651 \u3609 \u3626 \u3606 \u3634 \u3609 \u3607 \u3641 \u3605 \u3627 \u3619 \u3639 \u3629 \u3626 \u3606 \u3634 \u3609 \u3585 \u3591 \u3626 \u3640 \u3621  \u3650 \u3604 \u3618 \u3617 \u3637 \u3627 \u3633 \u3623 \u3627 \u3609 \u3657 \u3634 \u3588 \u3603 \u3632 \u3612 \u3641 \u3657 \u3649 \u3607 \u3609  (Ambassador) \u3648 \u3611 \u3655 \u3609 \u3612 \u3641 \u3657 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3610 \u3633 \u3597 \u3594 \u3634 ,."\
      \}\
    ],\
    committees: [\
      \{\
        term: "\uc0\u3585 .\u3614 .\u3619 . (\u3588 \u3603 \u3632 \u3585 \u3619 \u3619 \u3617 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 )",\
        definition: "\uc0\u3588 \u3603 \u3632 \u3585 \u3619 \u3619 \u3617 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3607 \u3635 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3651 \u3627 \u3657 \u3588 \u3635 \u3611 \u3619 \u3638 \u3585 \u3625 \u3634  \u3648 \u3626 \u3609 \u3629 \u3649 \u3609 \u3632  \u3588 \u3619 \u3617 . \u3648 \u3614 \u3639 \u3656 \u3629 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619  \u3617 \u3637 \u3609 \u3634 \u3618 \u3585 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 \u3627 \u3619 \u3639 \u3629 \u3619 \u3629 \u3591 \u3609 \u3634 \u3618 \u3585 \u3631  \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3608 \u3634 \u3609 ,."\
      \},\
