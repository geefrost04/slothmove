\outl0\strokewidth0 \strokec2 <h1>\uc0\u3626 \u3619 \u3640 \u3611  \u3614 .\u3619 .\u3610 .\u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3612 \u3656 \u3609 \u3604 \u3636 \u3609  \u3614 .\u3624 . 2534 (\u3649 \u3585 \u3657 \u3652 \u3586 \u3648 \u3614 \u3636 \u3656 \u3617 \u3648 \u3605 \u3636 \u3617 \u3606 \u3638 \u3591 \u3593 \u3610 \u3633 \u3610 \u3607 \u3637 \u3656  8 \u3614 .\u3624 . 2553)</h1>\
\
<h2>\uc0\u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  1: \u3648 \u3609 \u3639 \u3657 \u3629 \u3627 \u3634 \u3626 \u3619 \u3640 \u3611 \u3626 \u3656 \u3623 \u3609 \u3626 \u3635 \u3588 \u3633 \u3597  (\u3648 \u3592 \u3634 \u3632 \u3621 \u3638 \u3585 \u3648 \u3614 \u3639 \u3656 \u3629 \u3607 \u3635 \u3586 \u3657 \u3629 \u3626 \u3629 \u3610 )</h2>\
<p>\uc0\u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3593 \u3610 \u3633 \u3610 \u3609 \u3637 \u3657 \u3648 \u3611 \u3655 \u3609 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3649 \u3617 \u3656 \u3610 \u3607 \u3651 \u3609 \u3585 \u3634 \u3619 \u3623 \u3634 \u3591 \u3585 \u3619 \u3629 \u3610 \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3649 \u3621 \u3632 \u3629 \u3635 \u3609 \u3634 \u3592 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3586 \u3629 \u3591 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3616 \u3634 \u3588 \u3619 \u3633 \u3600 \u3651 \u3609 \u3611 \u3619 \u3632 \u3648 \u3607 \u3624 \u3652 \u3607 \u3618  \u3650 \u3604 \u3618 \u3617 \u3637 \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3649 \u3621 \u3632 \u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3626 \u3635 \u3588 \u3633 \u3597 \u3604 \u3633 \u3591 \u3609 \u3637 \u3657 </p>\
\
<h3>1. \uc0\u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3585 \u3636 \u3592 \u3585 \u3634 \u3619 \u3610 \u3657 \u3634 \u3609 \u3648 \u3617 \u3639 \u3629 \u3591 \u3607 \u3637 \u3656 \u3604 \u3637  (\u3617 \u3634 \u3605 \u3619 \u3634  3/1)</h3>\
<ul>\
    <li><strong>\uc0\u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3641 \u3591 \u3626 \u3640 \u3604 :</strong> \u3605 \u3657 \u3629 \u3591 \u3617 \u3640 \u3656 \u3591 \u3648 \u3609 \u3657 \u3609 \u3648 \u3614 \u3639 \u3656 \u3629  <strong>\u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3626 \u3640 \u3586 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 </strong></li>\
    <li><strong>\uc0\u3627 \u3621 \u3633 \u3585 \u3585 \u3634 \u3619 \u3626 \u3635 \u3588 \u3633 \u3597 :</strong> \u3648 \u3609 \u3657 \u3609 \u3612 \u3621 \u3626 \u3633 \u3617 \u3620 \u3607 \u3608 \u3636 \u3660 \u3605 \u3656 \u3629 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 \u3586 \u3629 \u3591 \u3619 \u3633 \u3600 , \u3588 \u3623 \u3634 \u3617 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3588 \u3640 \u3657 \u3617 \u3588 \u3656 \u3634 , \u3585 \u3634 \u3619 \u3621 \u3604 \u3586 \u3633 \u3657 \u3609 \u3605 \u3629 \u3609 \u3649 \u3621 \u3632 \u3618 \u3640 \u3610 \u3648 \u3621 \u3636 \u3585 \u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3607 \u3637 \u3656 \u3652 \u3617 \u3656 \u3592 \u3635 \u3648 \u3611 \u3655 \u3609 , \u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3592 \u3634 \u3618 \u3629 \u3635 \u3609 \u3634 \u3592 \u3651 \u3627 \u3657 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609 , \u3585 \u3634 \u3619 \u3629 \u3635 \u3609 \u3623 \u3618 \u3588 \u3623 \u3634 \u3617 \u3626 \u3632 \u3604 \u3623 \u3585 \u3605 \u3629 \u3610 \u3626 \u3609 \u3629 \u3591 \u3588 \u3623 \u3634 \u3617 \u3605 \u3657 \u3629 \u3591 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609  \u3649 \u3621 \u3632 \u3617 \u3637 \u3588 \u3623 \u3634 \u3617 \u3619 \u3633 \u3610 \u3612 \u3636 \u3604 \u3594 \u3629 \u3610  \u3650 \u3611 \u3619 \u3656 \u3591 \u3651 \u3626 .</li>\
</ul>\
\
<h3>2. \uc0\u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3612 \u3656 \u3609 \u3604 \u3636 \u3609  (\u3617 \u3634 \u3605 \u3619 \u3634  4)</h3>\
<p>\uc0\u3649 \u3610 \u3656 \u3591 \u3629 \u3629 \u3585 \u3648 \u3611 \u3655 \u3609  3 \u3626 \u3656 \u3623 \u3609 \u3627 \u3621 \u3633 \u3585  \u3652 \u3604 \u3657 \u3649 \u3585 \u3656 ,:</p>\
<ul>\
    <li><strong>\uc0\u3626 \u3656 \u3623 \u3609 \u3585 \u3621 \u3634 \u3591 :</strong> \u3626 \u3635 \u3609 \u3633 \u3585 \u3609 \u3634 \u3618 \u3585 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637  (\u3617 \u3637 \u3600 \u3634 \u3609 \u3632 \u3648 \u3611 \u3655 \u3609 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 ), \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 , \u3607 \u3610 \u3623 \u3591 , \u3649 \u3621 \u3632  \u3585 \u3619 \u3617 . <i>\u3627 \u3609 \u3656 \u3623 \u3618 \u3591 \u3634 \u3609 \u3607 \u3633 \u3657 \u3591  4 \u3619 \u3641 \u3611 \u3649 \u3610 \u3610 \u3609 \u3637 \u3657 \u3617 \u3637 \u3600 \u3634 \u3609 \u3632 \u3648 \u3611 \u3655 \u3609  <strong>"\u3609 \u3636 \u3605 \u3636 \u3610 \u3640 \u3588 \u3588 \u3621 "</strong> (\u3626 \u3656 \u3623 \u3609  "\u3585 \u3629 \u3591 " \u3652 \u3617 \u3656 \u3617 \u3637 \u3600 \u3634 \u3609 \u3632 \u3648 \u3611 \u3655 \u3609 \u3609 \u3636 \u3605 \u3636 \u3610 \u3640 \u3588 \u3588 \u3621 )</i>,.</li>\
    <li><strong>\uc0\u3626 \u3656 \u3623 \u3609 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 :</strong> \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604  \u3649 \u3621 \u3632  \u3629 \u3635 \u3648 \u3616 \u3629 .</li>\
    <li><strong>\uc0\u3626 \u3656 \u3623 \u3609 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609 :</strong> \u3629 \u3591 \u3588 \u3660 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3626 \u3656 \u3623 \u3609 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604  (\u3629 \u3610 \u3592 .), \u3648 \u3607 \u3624 \u3610 \u3634 \u3621 , \u3626 \u3640 \u3586 \u3634 \u3616 \u3636 \u3610 \u3634 \u3621 , \u3649 \u3621 \u3632 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3626 \u3656 \u3623 \u3609 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609 \u3629 \u3639 \u3656 \u3609 \u3605 \u3634 \u3617 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618  (\u3648 \u3594 \u3656 \u3609  \u3648 \u3617 \u3639 \u3629 \u3591 \u3614 \u3633 \u3607 \u3618 \u3634 , \u3585 \u3607 \u3617 .),. <i>\u3627 \u3617 \u3634 \u3618 \u3648 \u3627 \u3605 \u3640 : \u3627 \u3617 \u3641 \u3656 \u3610 \u3657 \u3634 \u3609 \u3649 \u3621 \u3632 \u3605 \u3635 \u3610 \u3621 \u3648 \u3611 \u3655 \u3609 \u3585 \u3634 \u3619 \u3611 \u3585 \u3588 \u3619 \u3629 \u3591 \u3607 \u3657 \u3629 \u3591 \u3607 \u3637 \u3656  \u3652 \u3617 \u3656 \u3651 \u3594 \u3656 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3626 \u3656 \u3623 \u3609 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609 \u3605 \u3634 \u3617  \u3614 .\u3619 .\u3610 . \u3609 \u3637 \u3657 </i>.</li>\
</ul>\
\
<h3>3. \uc0\u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3607 \u3637 \u3656 \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3605 \u3633 \u3657 \u3591  \u3619 \u3623 \u3617  \u3650 \u3629 \u3609  \u3649 \u3621 \u3632 \u3618 \u3640 \u3610 \u3648 \u3621 \u3636 \u3585 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3626 \u3656 \u3623 \u3609 \u3585 \u3621 \u3634 \u3591 </h3>\
<ul>\
    <li><strong>\uc0\u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3605 \u3633 \u3657 \u3591  \u3619 \u3623 \u3617  \u3627 \u3619 \u3639 \u3629 \u3650 \u3629 \u3609  (\u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591  \u3607 \u3610 \u3623 \u3591  \u3585 \u3619 \u3617 ):</strong> \u3650 \u3604 \u3618 \u3611 \u3585 \u3605 \u3636 \u3651 \u3627 \u3657 \u3605 \u3619 \u3634 \u3648 \u3611 \u3655 \u3609  <strong>"\u3614 \u3619 \u3632 \u3619 \u3634 \u3594 \u3610 \u3633 \u3597 \u3597 \u3633 \u3605 \u3636 "</strong>,.</li>\
    <li><strong>\uc0\u3586 \u3657 \u3629 \u3618 \u3585 \u3648 \u3623 \u3657 \u3609 :</strong> \u3627 \u3634 \u3585 \u3585 \u3634 \u3619 \u3619 \u3623 \u3617 \u3627 \u3619 \u3639 \u3629 \u3650 \u3629 \u3609  <strong>\u3652 \u3617 \u3656 \u3617 \u3637 \u3585 \u3634 \u3619 \u3648 \u3614 \u3636 \u3656 \u3617 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3627 \u3619 \u3639 \u3629 \u3629 \u3633 \u3605 \u3619 \u3634 \u3585 \u3635 \u3621 \u3633 \u3591 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 </strong> \u3651 \u3627 \u3657 \u3605 \u3619 \u3634 \u3648 \u3611 \u3655 \u3609  <strong>"\u3614 \u3619 \u3632 \u3619 \u3634 \u3594 \u3585 \u3620 \u3625 \u3598 \u3637 \u3585 \u3634 "</strong>,.</li>\
    <li><strong>\uc0\u3585 \u3634 \u3619 \u3648 \u3611 \u3621 \u3637 \u3656 \u3618 \u3609 \u3594 \u3639 \u3656 \u3629  \u3649 \u3621 \u3632  \u3585 \u3634 \u3619 \u3618 \u3640 \u3610 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 :</strong> \u3651 \u3627 \u3657 \u3605 \u3619 \u3634 \u3648 \u3611 \u3655 \u3609  <strong>"\u3614 \u3619 \u3632 \u3619 \u3634 \u3594 \u3585 \u3620 \u3625 \u3598 \u3637 \u3585 \u3634 "</strong>,.</li>\
    <li><strong>\uc0\u3585 \u3634 \u3619 \u3649 \u3610 \u3656 \u3591 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3616 \u3634 \u3618 \u3651 \u3609 \u3585 \u3619 \u3617  (\u3585 \u3634 \u3619 \u3605 \u3633 \u3657 \u3591  "\u3585 \u3629 \u3591 "):</strong> \u3651 \u3627 \u3657 \u3629 \u3629 \u3585 \u3648 \u3611 \u3655 \u3609  <strong>"\u3585 \u3598 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 "</strong>,.</li>\
</ul>\
\
<h3>4. \uc0\u3585 \u3634 \u3619 \u3617 \u3629 \u3610 \u3629 \u3635 \u3609 \u3634 \u3592  \u3649 \u3621 \u3632  \u3585 \u3634 \u3619 \u3619 \u3633 \u3585 \u3625 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3607 \u3609 </h3>\
<ul>\
    <li><strong>\uc0\u3585 \u3634 \u3619 \u3617 \u3629 \u3610 \u3629 \u3635 \u3609 \u3634 \u3592  (\u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3607 \u3609 ):</strong> \u3605 \u3657 \u3629 \u3591 \u3607 \u3635 \u3648 \u3611 \u3655 \u3609  <strong>"\u3627 \u3609 \u3633 \u3591 \u3626 \u3639 \u3629 "</strong> \u3650 \u3604 \u3618 \u3588 \u3635 \u3609 \u3638 \u3591 \u3606 \u3638 \u3591 \u3585 \u3634 \u3619 \u3629 \u3635 \u3609 \u3623 \u3618 \u3588 \u3623 \u3634 \u3617 \u3626 \u3632 \u3604 \u3623 \u3585 \u3651 \u3627 \u3657 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 \u3649 \u3621 \u3632 \u3588 \u3623 \u3634 \u3617 \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623 ,. \u3648 \u3617 \u3639 \u3656 \u3629 \u3617 \u3629 \u3610 \u3629 \u3635 \u3609 \u3634 \u3592 \u3649 \u3621 \u3657 \u3623  \u3612 \u3641 \u3657 \u3617 \u3629 \u3610 \u3618 \u3633 \u3591 \u3588 \u3591 \u3617 \u3637 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3585 \u3635 \u3585 \u3633 \u3610 \u3604 \u3641 \u3649 \u3621 \u3649 \u3621 \u3632 \u3605 \u3636 \u3604 \u3605 \u3634 \u3617 \u3612 \u3621 .</li>\
    <li><strong>\uc0\u3585 \u3634 \u3619 \u3619 \u3633 \u3585 \u3625 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3607 \u3609 :</strong> \u3651 \u3594 \u3657 \u3651 \u3609 \u3585 \u3619 \u3603 \u3637 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3623 \u3656 \u3634 \u3591 \u3621 \u3591  \u3627 \u3619 \u3639 \u3629 \u3612 \u3641 \u3657 \u3604 \u3635 \u3619 \u3591 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3652 \u3617 \u3656 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3652 \u3604 \u3657 . \u3612 \u3641 \u3657 \u3619 \u3633 \u3585 \u3625 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3607 \u3609 \u3617 \u3637 \u3629 \u3635 \u3609 \u3634 \u3592 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3648 \u3594 \u3656 \u3609 \u3648 \u3604 \u3637 \u3618 \u3623 \u3585 \u3633 \u3610 \u3612 \u3641 \u3657 \u3604 \u3635 \u3619 \u3591 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3609 \u3633 \u3657 \u3609 \u3607 \u3640 \u3585 \u3611 \u3619 \u3632 \u3585 \u3634 \u3619 .</li>\
</ul>\
\
<hr>\
\
<h2>\uc0\u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  2: \u3650 \u3588 \u3619 \u3591 \u3626 \u3619 \u3657 \u3634 \u3591 \u3629 \u3591 \u3588 \u3660 \u3585 \u3619 \u3649 \u3621 \u3632 \u3610 \u3607 \u3610 \u3634 \u3607 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656  (\u3651 \u3588 \u3619 \u3607 \u3635 \u3629 \u3632 \u3652 \u3619 \u3610 \u3657 \u3634 \u3591 )</h2>\
<ul>\
    <li><strong>\uc0\u3609 \u3634 \u3618 \u3585 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 :</strong> \u3648 \u3611 \u3655 \u3609 \u3612 \u3641 \u3657 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3610 \u3633 \u3597 \u3594 \u3634 \u3626 \u3641 \u3591 \u3626 \u3640 \u3604 \u3586 \u3629 \u3591 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3613 \u3656 \u3634 \u3618 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619  \u3617 \u3637 \u3629 \u3635 \u3609 \u3634 \u3592 \u3618 \u3633 \u3610 \u3618 \u3633 \u3657 \u3591 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3586 \u3633 \u3604 \u3605 \u3656 \u3629 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3586 \u3629 \u3591 \u3588 \u3603 \u3632 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 , \u3617 \u3637 \u3629 \u3635 \u3609 \u3634 \u3592 \u3626 \u3633 \u3656 \u3591 \u3651 \u3627 \u3657 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3592 \u3634 \u3585 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3629 \u3639 \u3656 \u3609 \u3617 \u3634 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3626 \u3635 \u3609 \u3633 \u3585 \u3609 \u3634 \u3618 \u3585 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 \u3652 \u3604 \u3657 \u3650 \u3604 \u3618 \u3605 \u3619 \u3591 , \u3623 \u3634 \u3591 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3619 \u3623 \u3604 \u3648 \u3619 \u3655 \u3623 \u3649 \u3621 \u3632 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614  \u3649 \u3621 \u3632 \u3648 \u3611 \u3655 \u3609 \u3612 \u3641 \u3657 \u3619 \u3633 \u3585 \u3625 \u3634 \u3585 \u3634 \u3619 \u3605 \u3634 \u3617  \u3614 .\u3619 .\u3610 . \u3609 \u3637 \u3657 ,,.</li>\
    <li><strong>\uc0\u3588 \u3603 \u3632 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637  (\u3588 \u3619 \u3617 .):</strong> \u3651 \u3627 \u3657 \u3588 \u3623 \u3634 \u3617 \u3648 \u3627 \u3655 \u3609 \u3594 \u3629 \u3610 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3605 \u3656 \u3634 \u3591 \u3654  \u3607 \u3637 \u3656 \u3609 \u3634 \u3618 \u3585 \u3631  \u3623 \u3634 \u3591 \u3652 \u3623 \u3657 . \u3648 \u3611 \u3655 \u3609 \u3612 \u3641 \u3657 \u3617 \u3637 \u3629 \u3635 \u3609 \u3634 \u3592 \u3648 \u3626 \u3609 \u3629 \u3619 \u3656 \u3634 \u3591 \u3614 \u3619 \u3632 \u3619 \u3634 \u3594 \u3610 \u3633 \u3597 \u3597 \u3633 \u3605 \u3636 \u3591 \u3610 \u3611 \u3619 \u3632 \u3617 \u3634 \u3603 \u3619 \u3634 \u3618 \u3592 \u3656 \u3634 \u3618 \u3611 \u3619 \u3632 \u3592 \u3635 \u3611 \u3637 .</li>\
    <li><strong>\uc0\u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 \u3623 \u3656 \u3634 \u3585 \u3634 \u3619 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 :</strong> \u3648 \u3611 \u3655 \u3609 \u3612 \u3641 \u3657 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3610 \u3633 \u3597 \u3594 \u3634 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3651 \u3609 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591  \u3585 \u3635 \u3627 \u3609 \u3604 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618  \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618  \u3649 \u3621 \u3632 \u3612 \u3621 \u3626 \u3633 \u3617 \u3620 \u3607 \u3608 \u3636 \u3660 \u3586 \u3629 \u3591 \u3591 \u3634 \u3609 \u3651 \u3627 \u3657 \u3626 \u3629 \u3604 \u3588 \u3621 \u3657 \u3629 \u3591 \u3585 \u3633 \u3610 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 ,.</li>\
    <li><strong>\uc0\u3611 \u3621 \u3633 \u3604 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 :</strong> \u3619 \u3633 \u3610 \u3612 \u3636 \u3604 \u3594 \u3629 \u3610 \u3588 \u3623 \u3610 \u3588 \u3640 \u3617 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3611 \u3619 \u3632 \u3592 \u3635 \u3651 \u3609 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591  \u3649 \u3611 \u3621 \u3591 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3648 \u3611 \u3655 \u3609 \u3649 \u3612 \u3609 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636  \u3648 \u3611 \u3655 \u3609 \u3612 \u3641 \u3657 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3610 \u3633 \u3597 \u3594 \u3634 \u3619 \u3629 \u3591 \u3592 \u3634 \u3585 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 . \u3617 \u3637 \u3629 \u3635 \u3609 \u3634 \u3592 \u3649 \u3605 \u3656 \u3591 \u3605 \u3633 \u3657 \u3591 \u3612 \u3641 \u3657 \u3619 \u3633 \u3585 \u3625 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3607 \u3609 \u3629 \u3608 \u3636 \u3610 \u3604 \u3637  \u3627 \u3634 \u3585 \u3652 \u3617 \u3656 \u3617 \u3637 \u3619 \u3629 \u3591 \u3629 \u3608 \u3636 \u3610 \u3604 \u3637 \u3627 \u3619 \u3639 \u3629 \u3652 \u3617 \u3656 \u3629 \u3634 \u3592 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3652 \u3604 \u3657 .</li>\
    <li><strong>\uc0\u3629 \u3608 \u3636 \u3610 \u3604 \u3637 :</strong> \u3648 \u3611 \u3655 \u3609 \u3612 \u3641 \u3657 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3610 \u3633 \u3597 \u3594 \u3634 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3651 \u3609 \u3585 \u3619 \u3617  \u3619 \u3633 \u3610 \u3612 \u3636 \u3604 \u3594 \u3629 \u3610 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3591 \u3634 \u3609 \u3586 \u3629 \u3591 \u3585 \u3619 \u3617 .</li>\
    <li><strong>\uc0\u3612 \u3641 \u3657 \u3623 \u3656 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604 :</strong> \u3619 \u3633 \u3610 \u3609 \u3650 \u3618 \u3610 \u3634 \u3618 \u3649 \u3621 \u3632 \u3588 \u3635 \u3626 \u3633 \u3656 \u3591 \u3592 \u3634 \u3585 \u3619 \u3633 \u3600 \u3610 \u3634 \u3621 \u3617 \u3634 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3651 \u3609 \u3648 \u3586 \u3605 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604  \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3608 \u3634 \u3609 \u3588 \u3603 \u3632 \u3585 \u3619 \u3617 \u3585 \u3634 \u3619 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604  \u3649 \u3621 \u3632 \u3626 \u3634 \u3617 \u3634 \u3619 \u3606 \u3626 \u3633 \u3656 \u3591 \u3618 \u3633 \u3610 \u3618 \u3633 \u3657 \u3591 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3607 \u3637 \u3656 \u3586 \u3633 \u3604 \u3605 \u3656 \u3629 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3652 \u3623 \u3657 \u3594 \u3633 \u3656 \u3623 \u3588 \u3619 \u3634 \u3623 \u3649 \u3621 \u3657 \u3623 \u3619 \u3634 \u3618 \u3591 \u3634 \u3609 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3605 \u3657 \u3609 \u3626 \u3633 \u3591 \u3585 \u3633 \u3604 ,. (\u3626 \u3633 \u3591 \u3585 \u3633 \u3604 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3617 \u3627 \u3634 \u3604 \u3652 \u3607 \u3618 )</li>\
    <li><strong>\uc0\u3609 \u3634 \u3618 \u3629 \u3635 \u3648 \u3616 \u3629 :</strong> \u3648 \u3611 \u3655 \u3609 \u3627 \u3633 \u3623 \u3627 \u3609 \u3657 \u3634 \u3611 \u3585 \u3588 \u3619 \u3629 \u3591 \u3610 \u3633 \u3591 \u3588 \u3633 \u3610 \u3610 \u3633 \u3597 \u3594 \u3634 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3651 \u3609 \u3629 \u3635 \u3648 \u3616 \u3629  \u3626 \u3633 \u3591 \u3585 \u3633 \u3604 \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 \u3617 \u3627 \u3634 \u3604 \u3652 \u3607 \u3618 ,. \u3617 \u3637 \u3629 \u3635 \u3609 \u3634 \u3592 \u3614 \u3636 \u3648 \u3624 \u3625 \u3651 \u3609 \u3585 \u3634 \u3619  <strong>\u3652 \u3585 \u3621 \u3656 \u3648 \u3585 \u3621 \u3637 \u3656 \u3618 \u3586 \u3657 \u3629 \u3614 \u3636 \u3614 \u3634 \u3607 \u3607 \u3634 \u3591 \u3649 \u3614 \u3656 \u3591 \u3649 \u3621 \u3632 \u3607 \u3634 \u3591 \u3629 \u3634 \u3597 \u3634  (\u3588 \u3623 \u3634 \u3617 \u3612 \u3636 \u3604 \u3629 \u3633 \u3609 \u3618 \u3629 \u3617 \u3588 \u3623 \u3634 \u3617 \u3652 \u3604 \u3657 )</strong> \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3588 \u3604 \u3637 \u3648 \u3621 \u3636 \u3585 \u3585 \u3633 \u3609  \u3621 \u3604 \u3616 \u3634 \u3619 \u3632 \u3585 \u3619 \u3632 \u3610 \u3623 \u3609 \u3585 \u3634 \u3619 \u3618 \u3640 \u3605 \u3636 \u3608 \u3619 \u3619 \u3617 ,.</li>\
    <li><strong>\uc0\u3588 \u3603 \u3632 \u3585 \u3619 \u3619 \u3617 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619  (\u3585 .\u3614 .\u3619 .):</strong> \u3617 \u3637 \u3609 \u3634 \u3618 \u3585 \u3631  \u3627 \u3619 \u3639 \u3629 \u3619 \u3629 \u3591 \u3609 \u3634 \u3618 \u3585 \u3631  \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3608 \u3634 \u3609  \u3607 \u3635 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3651 \u3627 \u3657 \u3588 \u3635 \u3611 \u3619 \u3638 \u3585 \u3625 \u3634  \u3648 \u3626 \u3609 \u3629 \u3649 \u3609 \u3632 \u3588 \u3603 \u3632 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 \u3648 \u3585 \u3637 \u3656 \u3618 \u3623 \u3585 \u3633 \u3610 \u3585 \u3634 \u3619 \u3614 \u3633 \u3602 \u3609 \u3634 \u3619 \u3632 \u3610 \u3610 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 ,. (\u3606 \u3641 \u3585 \u3605 \u3633 \u3657 \u3591 \u3586 \u3638 \u3657 \u3609 \u3592 \u3634 \u3585 \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3619 \u3641 \u3611 \u3619 \u3632 \u3610 \u3610 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619  \u3614 .\u3624 . 2545)</li>\
    <li><strong>\uc0\u3588 \u3603 \u3632 \u3585 \u3619 \u3619 \u3617 \u3585 \u3634 \u3619 \u3608 \u3619 \u3619 \u3617 \u3634 \u3616 \u3636 \u3610 \u3634 \u3621 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604  (\u3585 .\u3608 .\u3592 .):</strong> \u3617 \u3637 \u3612 \u3641 \u3657 \u3605 \u3619 \u3623 \u3592 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3626 \u3635 \u3609 \u3633 \u3585 \u3609 \u3634 \u3618 \u3585 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 \u3648 \u3611 \u3655 \u3609 \u3611 \u3619 \u3632 \u3608 \u3634 \u3609  \u3607 \u3635 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656  <strong>"\u3626 \u3629 \u3604 \u3626 \u3656 \u3629 \u3591 \u3649 \u3621 \u3632 \u3648 \u3626 \u3609 \u3629 \u3649 \u3609 \u3632 "</strong> \u3585 \u3634 \u3619 \u3611 \u3599 \u3636 \u3610 \u3633 \u3605 \u3636 \u3591 \u3634 \u3609 \u3586 \u3629 \u3591 \u3648 \u3592 \u3657 \u3634 \u3627 \u3609 \u3657 \u3634 \u3607 \u3637 \u3656 \u3619 \u3633 \u3600 \u3651 \u3609 \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604  (\u3652 \u3617 \u3656 \u3617 \u3637 \u3629 \u3635 \u3609 \u3634 \u3592 \u3626 \u3633 \u3656 \u3591 \u3585 \u3634 \u3619 \u3627 \u3619 \u3639 \u3629 \u3621 \u3591 \u3650 \u3607 \u3625 \u3648 \u3629 \u3591  \u3627 \u3634 \u3585 \u3614 \u3610 \u3607 \u3640 \u3592 \u3619 \u3636 \u3605 \u3651 \u3627 \u3657 \u3649 \u3592 \u3657 \u3591 \u3612 \u3641 \u3657 \u3623 \u3656 \u3634 \u3631  \u3627 \u3619 \u3639 \u3629  \u3611 .\u3611 .\u3594 .),.</li>\
</ul>\
\
<hr>\
\
<h2>\uc0\u3626 \u3656 \u3623 \u3609 \u3607 \u3637 \u3656  3: \u3588 \u3635 \u3624 \u3633 \u3614 \u3607 \u3660 \u3649 \u3621 \u3632 \u3605 \u3633 \u3623 \u3648 \u3621 \u3586 \u3609 \u3656 \u3634 \u3619 \u3641 \u3657 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3607 \u3635 \u3586 \u3657 \u3629 \u3626 \u3629 \u3610 </h2>\
\
<h3><span class="vocab">\uc0\u3588 \u3635 \u3624 \u3633 \u3614 \u3607 \u3660 \u3609 \u3656 \u3634 \u3619 \u3641 \u3657 </span></h3>\
<ul>\
    <li><span class="vocab">\uc0\u3611 \u3619 \u3632 \u3650 \u3618 \u3594 \u3609 \u3660 \u3626 \u3640 \u3586 \u3586 \u3629 \u3591 \u3611 \u3619 \u3632 \u3594 \u3634 \u3594 \u3609 :</span> \u3648 \u3611 \u3657 \u3634 \u3627 \u3617 \u3634 \u3618 \u3626 \u3641 \u3591 \u3626 \u3640 \u3604 \u3586 \u3629 \u3591 \u3585 \u3634 \u3619 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3605 \u3634 \u3617  \u3614 .\u3619 .\u3610 . \u3609 \u3637 \u3657 .</li>\
    <li><span class="vocab">\uc0\u3609 \u3636 \u3605 \u3636 \u3610 \u3640 \u3588 \u3588 \u3621 :</span> \u3626 \u3606 \u3634 \u3609 \u3632 \u3607 \u3634 \u3591 \u3585 \u3598 \u3627 \u3617 \u3634 \u3618 \u3586 \u3629 \u3591  \u3626 \u3635 \u3609 \u3633 \u3585 \u3609 \u3634 \u3618 \u3585 \u3619 \u3633 \u3600 \u3617 \u3609 \u3605 \u3619 \u3637 , \u3585 \u3619 \u3632 \u3607 \u3619 \u3623 \u3591 , \u3607 \u3610 \u3623 \u3591 , \u3585 \u3619 \u3617  \u3649 \u3621 \u3632  \u3592 \u3633 \u3591 \u3627 \u3623 \u3633 \u3604 ,.</li>\
    <li><span class="vocab">\uc0\u3585 \u3621 \u3640 \u3656 \u3617 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592  (Cluster):</span> \u3585 \u3634 \u3619 \u3619 \u3623 \u3617 \u3585 \u3619 \u3617 \u3605 \u3633 \u3657 \u3591 \u3649 \u3605 \u3656  2 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3586 \u3638 \u3657 \u3609 \u3652 \u3611 \u3648 \u3586 \u3657 \u3634 \u3604 \u3657 \u3623 \u3618 \u3585 \u3633 \u3609 \u3648 \u3614 \u3639 \u3656 \u3629 \u3651 \u3627 \u3657 \u3585 \u3634 \u3619 \u3607 \u3635 \u3591 \u3634 \u3609 \u3626 \u3629 \u3604 \u3588 \u3621 \u3657 \u3629 \u3591 \u3649 \u3621 \u3632 \u3617 \u3637 \u3611 \u3619 \u3632 \u3626 \u3636 \u3607 \u3608 \u3636 \u3616 \u3634 \u3614  \u3650 \u3604 \u3618 \u3617 \u3637 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3627 \u3633 \u3623 \u3627 \u3609 \u3657 \u3634 \u3585 \u3621 \u3640 \u3656 \u3617 \u3616 \u3634 \u3619 \u3585 \u3636 \u3592 .</li>\
