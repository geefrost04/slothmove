<h3><span class="number">\uc0\u3605 \u3633 \u3623 \u3648 \u3621 \u3586 \u3609 \u3656 \u3634 \u3619 \u3641 \u3657 </span></h3>\
<ul>\
    <li><span class="number">3 \uc0\u3626 \u3656 \u3623 \u3609 :</span> \u3585 \u3634 \u3619 \u3592 \u3633 \u3604 \u3619 \u3632 \u3648 \u3610 \u3637 \u3618 \u3610 \u3610 \u3619 \u3636 \u3627 \u3634 \u3619 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3649 \u3612 \u3656 \u3609 \u3604 \u3636 \u3609 \u3649 \u3610 \u3656 \u3591 \u3648 \u3611 \u3655 \u3609  3 \u3626 \u3656 \u3623 \u3609  (\u3626 \u3656 \u3623 \u3609 \u3585 \u3621 \u3634 \u3591 , \u3626 \u3656 \u3623 \u3609 \u3616 \u3641 \u3617 \u3636 \u3616 \u3634 \u3588 , \u3626 \u3656 \u3623 \u3609 \u3607 \u3657 \u3629 \u3591 \u3606 \u3636 \u3656 \u3609 ),.</li>\
    <li><span class="number">4 \uc0\u3611 \u3637 :</span> \u3623 \u3634 \u3619 \u3632 \u3585 \u3634 \u3619 \u3604 \u3635 \u3619 \u3591 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3586 \u3629 \u3591 \u3585 \u3619 \u3619 \u3617 \u3585 \u3634 \u3619 \u3612 \u3641 \u3657 \u3607 \u3619 \u3591 \u3588 \u3640 \u3603 \u3623 \u3640 \u3602 \u3636 \u3651 \u3609  \u3585 .\u3614 .\u3619 . (\u3648 \u3611 \u3655 \u3609 \u3652 \u3604 \u3657 \u3652 \u3617 \u3656 \u3648 \u3585 \u3636 \u3609  2 \u3623 \u3634 \u3619 \u3632 \u3605 \u3636 \u3604 \u3605 \u3656 \u3629 \u3585 \u3633 \u3609 ),.</li>\
    <li><span class="number">3 \uc0\u3611 \u3637 :</span> \u3627 \u3634 \u3585 \u3617 \u3637 \u3585 \u3634 \u3619 \u3619 \u3623 \u3617 \u3627 \u3619 \u3639 \u3629 \u3650 \u3629 \u3609 \u3626 \u3656 \u3623 \u3609 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619  (\u3605 \u3619 \u3634 \u3648 \u3611 \u3655 \u3609  \u3614 .\u3619 .\u3598 .) \u3627 \u3657 \u3634 \u3617 \u3617 \u3636 \u3651 \u3627 \u3657 \u3617 \u3637 \u3585 \u3634 \u3619 \u3585 \u3635 \u3627 \u3609 \u3604 \u3605 \u3635 \u3649 \u3627 \u3609 \u3656 \u3591 \u3586 \u3657 \u3634 \u3619 \u3634 \u3594 \u3585 \u3634 \u3619 \u3648 \u3614 \u3636 \u3656 \u3617 \u3586 \u3638 \u3657 \u3609 \u3648 \u3611 \u3655 \u3609 \u3648 \u3623 \u3621 \u3634  3 \u3611 \u3637 ,.</li>\
    <li><span class="number">200,000 \uc0\u3610 \u3634 \u3607 :</span> \u3607 \u3640 \u3609 \u3607 \u3619 \u3633 \u3614 \u3618 \u3660 \u3586 \u3633 \u3657 \u3609 \u3605 \u3657 \u3609 \u3651 \u3609 \u3586 \u3657 \u3629 \u3614 \u3636 \u3614 \u3634 \u3607 \u3607 \u3634 \u3591 \u3649 \u3614 \u3656 \u3591  (\u3648 \u3594 \u3656 \u3609  \u3607 \u3637 \u3656 \u3604 \u3636 \u3609  \u3617 \u3619 \u3604 \u3585 ) \u3607 \u3637 \u3656 \u3609 \u3634 \u3618 \u3629 \u3635 \u3648 \u3616 \u3629 \u3617 \u3637 \u3629 \u3635 \u3609 \u3634 \u3592 \u3652 \u3585 \u3621 \u3656 \u3648 \u3585 \u3621 \u3637 \u3656 \u3618 \u3652 \u3604 \u3657  (\u3648 \u3623 \u3657 \u3609 \u3649 \u3605 \u3656 \u3592 \u3632 \u3585 \u3635 \u3627 \u3609 \u3604 \u3652 \u3623 \u3657 \u3648 \u3611 \u3655 \u3609 \u3629 \u3618 \u3656 \u3634 \u3591 \u3629 \u3639 \u3656 \u3609 \u3651 \u3609  \u3614 .\u3619 .\u3598 .),.</li>\
