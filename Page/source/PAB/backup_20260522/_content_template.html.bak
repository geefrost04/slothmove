  <button class="nav-tab px-3 sm:px-6 py-2 text-[11px] sm:text-xs font-kanit rounded-lg whitespace-nowrap shrink-0" data-section="quiz" onclick="showSection('quiz')" type="button">✏️ ทำข้อสอบ</button>
</div>
<div class="flex items-center gap-2 shrink-0 ml-auto sm:ml-0">
  <a id="course-back-link" class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-[color:var(--ddpm-navy)] text-slate-300 hover:text-white text-xs font-kanit border border-slate-600 hover:border-amber-500/60 transition-all whitespace-nowrap" href="indexPAB.html">← คอร์ส</a>
  <div class="relative">
    <button class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:text-white text-xs font-kanit border border-slate-600 hover:border-slate-400 transition-all" onclick="toggleDrop('courses')" type="button">
      วิชาอื่นๆ <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
    </button>
    <div class="drop-panel absolute right-0 mt-1 w-72 max-h-[min(70vh,28rem)] overflow-y-auto rounded-xl border border-slate-600 bg-slate-800 shadow-2xl z-50" id="drop-courses">
      <div class="p-2 border-b border-slate-700"><p class="text-slate-400 text-xs font-kanit px-2 py-1">ความรู้เฉพาะตำแหน่ง ปภ.</p></div>
      <div id="course-list">
