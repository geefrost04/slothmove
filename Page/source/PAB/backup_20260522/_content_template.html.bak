<!-- HOME -->
<section id="home">
<div class="bg-white py-16 px-4 border-b border-slate-100">
<div class="max-w-4xl mx-auto text-center">
  <div id="home-badge" class="inline-flex items-center gap-2 rounded-full px-4 py-1.5 mb-6 border border-amber-200/80 bg-[color:var(--ddpm-yellow-soft)]">
    <span class="text-[color:var(--ddpm-navy)] text-xs font-kanit font-bold">ส่วนที่ 1 — ฟรี</span>
  </div>
  <div class="flex justify-center mb-4">
    <img alt="ตรากรมป้องกันและบรรเทาสาธารณภัย" class="h-14 md:h-[4.25rem] w-auto object-contain opacity-90" decoding="async" fetchpriority="high" src="../../../pic/logo ปภ.png" width="180" height="72" onerror="this.style.display='none'"/>
  </div>
  <h1 id="home-title" class="font-black font-kanit text-3xl md:text-4xl text-slate-900 leading-tight mb-3">
    พ.ร.บ.ระเบียบบริหารราชการแผ่นดิน พ.ศ. 2534
  </h1>
  <p class="text-slate-500 font-sarabun text-sm mb-2">สรุป · ศัพท์ · ทบทวนเหมือนห้องเรียนชั้นเปิด</p>
  <p id="home-desc" class="text-slate-600 font-sarabun text-base mb-8 max-w-xl mx-auto">
    สรุปย่อ 6 หัวข้อหลัก และคำศัพท์น่ารู้สำหรับทบทวนก่อนสอบ — พร้อมแนวข้อสอบ <strong class="font-kanit text-[color:var(--ddpm-navy)]">50 ข้อ</strong> จากชุดฝึกในระบบ
  </p>
  <div id="home-stats" class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 max-w-xl mx-auto mb-10">
    <div class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-sm ring-1 ring-amber-100/60">
      <div class="text-2xl font-black font-kanit text-[color:var(--ddpm-navy)]">–</div>
      <div class="text-slate-500 text-xs font-kanit mt-1">คำศัพท์</div>
    </div>
    <div class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-sm ring-1 ring-amber-100/60">
      <div class="text-2xl font-black font-kanit text-[color:var(--ddpm-navy)]">6</div>
      <div class="text-slate-500 text-xs font-kanit mt-1">หัวข้อสรุป</div>
    </div>
    <div class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-sm ring-1 ring-amber-100/60">
      <div class="text-2xl font-black font-kanit text-[color:var(--ddpm-navy)]">6</div>
      <div class="text-slate-500 text-xs font-kanit mt-1">หมวดศัพท์</div>
    </div>
    <div class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-sm ring-1 ring-amber-100/60">
      <div class="text-2xl font-black font-kanit text-[color:var(--ddpm-navy)]">50</div>
      <div class="text-slate-500 text-xs font-kanit mt-1">ข้อสอบ</div>
    </div>
  </div>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-3xl mx-auto">
    <button class="bg-white border border-slate-200 hover:border-[color:var(--ddpm-yellow-strong)] rounded-2xl p-4 text-left transition-all shadow-sm hover:shadow-md" onclick="showSection('content')" type="button">
      <div id="home-icon-1" class="text-2xl mb-2">⚖️</div>
      <div class="font-kanit font-bold text-slate-800 text-sm">สรุปเนื้อหา</div>
      <div id="home-sub-1" class="text-slate-400 text-xs mt-1">หัวข้อ 6 บท</div>
    </button>
    <button class="bg-white border border-slate-200 hover:border-[color:var(--ddpm-yellow-strong)] rounded-2xl p-4 text-left transition-all shadow-sm hover:shadow-md" onclick="showSection('structure')" type="button">
      <div class="text-2xl mb-2">📋</div>
      <div class="font-kanit font-bold text-slate-800 text-sm">โครงสร้างหัวข้อ</div>
      <div class="text-slate-400 text-xs mt-1">แผนผัง 6 หัวข้อ</div>
    </button>
    <button class="bg-white border border-slate-200 hover:border-[color:var(--ddpm-yellow-strong)] rounded-2xl p-4 text-left transition-all shadow-sm hover:shadow-md" onclick="showSection('glossary')" type="button">
      <div class="text-2xl mb-2">📚</div>
      <div class="font-kanit font-bold text-slate-800 text-sm">คลังศัพท์</div>
      <div class="text-slate-400 text-xs mt-1">ค้นหา · กรองหมวด</div>
    </button>
    <a id="quiz-link-btn" class="group rounded-2xl p-4 text-left transition-all shadow-md hover:shadow-lg block overflow-hidden border border-slate-800" href="#" style="background:linear-gradient(145deg,var(--ddpm-navy) 0%,var(--ddpm-navy-mid) 100%)">
      <div class="ddpm-strip rounded-md mb-3 opacity-95"></div>
      <div class="text-2xl mb-2">✏️</div>
      <div class="font-kanit font-bold text-white text-sm">ข้อสอบ 50 ข้อ</div>
      <div class="text-amber-100/95 text-xs mt-1 font-sarabun">สุ่มตัวเลือก · เฉลยหลังตอบ · บันทึกคะแนน</div>
    </a>
  </div>
  <p class="text-center mt-8"><a class="inline-flex items-center gap-1.5 rounded-full border border-amber-200 bg-[color:var(--ddpm-yellow-soft)] px-4 py-2 text-sm font-bold font-kanit transition hover:bg-amber-100 text-[color:var(--ddpm-navy)]" href="#donate">☕ เลี้ยงกาแฟ / PromptPay</a></p>
</div>
</div>
</section>

<!-- CONTENT -->
<section class="scroll-mt-16 bg-white pb-16 active" id="content">
<div class="max-w-4xl mx-auto px-4 py-10 pb-12 summary-shell readable-wrap border-t border-slate-100 pab-rich-acc" id="summaries-start">
<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
  <div>
    <p class="text-[10px] font-kanit text-slate-400 uppercase tracking-widest mb-1.5">ส่วนที่ 1</p>
    <h2 id="content-title" class="font-kanit font-black text-2xl text-slate-900 mb-2">สรุปเนื้อหา</h2>
    <p id="content-desc" class="text-slate-500 font-sarabun text-sm">หัวข้อหลัก 6 บท เรียบเรียงจากชุดฝึกในระบบ</p>
  </div>
  <button class="px-5 py-2.5 text-white text-xs font-bold font-kanit rounded-xl border transition shrink-0 shadow-sm hover:opacity-[0.93]" onclick="expandAll()" type="button" style="background:var(--ddpm-navy);border-color:#0f1030">ขยายทั้งหมด</button>
</div>

<div id="accordionList">
<!-- Rendered by JS -->
</div>
</div>
</section>

<!-- STRUCTURE -->
<section class="scroll-mt-16 bg-slate-50 pb-16 active" id="structure">
<div class="max-w-5xl mx-auto px-4 py-10 font-kanit">
<div class="sec-break"><span class="sec-break-label">ส่วนที่ 1 · โครงสร้าง</span></div>
<h2 class="font-kanit font-black text-2xl text-slate-900 mb-2 text-center">โครงสร้างหัวข้อ</h2>
<p class="text-center text-slate-500 font-sarabun text-sm mb-10 max-w-2xl mx-auto">แตะการ์ดเพื่อเปิดหัวข้อในส่วนสรุปเนื้อหา</p>
<div id="structure-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
<!-- Rendered by JS -->
</div>
<div class="mt-10 rounded-2xl border border-amber-200/70 bg-[color:var(--ddpm-yellow-soft)] p-5 sm:p-6">
  <p class="font-kanit text-sm font-bold text-[color:var(--ddpm-navy)] mb-2">💡 ทิปทบทวน</p>
  <p id="tip-text" class="font-sarabun text-slate-800 text-[15px] leading-relaxed">อ่านตามลำดับทีละหัวข้อ แล้วทดลองทำข้อสอบดู — ข้อสอบมักถามทั้งนิยาม ขั้นตอน และบทบาทของหน่วยงาน</p>
</div>
</div>
</section>

<!-- GLOSSARY -->
<section class="bg-white active" id="glossary">
<div class="max-w-4xl mx-auto px-4 py-10">
<div class="sec-break"><span class="sec-break-label">ส่วนที่ 1 · คำศัพท์</span></div>
<h2 class="font-kanit font-black text-2xl text-slate-900 mb-2">คลังคำศัพท์</h2>
<p class="text-slate-500 font-sarabun text-sm mb-6">ศัพท์เชิงกฎหมาย ระเบียบ และคำศัพท์ทางราชการ</p>
<div id="glossary-container">
  <div id="glossaryList" class="bg-amber-50 border border-amber-100 rounded-2xl p-6">
  </div>
  <div id="glossaryEmpty" class="bg-amber-50 border border-amber-100 rounded-2xl p-6 text-center" style="display:none">
    <p class="text-amber-700 font-sarabun text-sm">📚 คำศัพท์จะเพิ่มในภายหลัง</p>
    <p class="text-amber-500 font-sarabun text-xs mt-2">Glossary content coming soon</p>
  </div>
</div>
</div>
</section>

<!-- QUIZ -->
<section id="quiz">
<div class="min-h-[70vh] flex items-center justify-center px-4 py-20" style="background:linear-gradient(135deg,var(--ddpm-navy) 0%,#262656 50%,#1a1a3e 100%)">
<div class="text-center max-w-lg">
  <div id="quiz-emoji" class="w-20 h-20 rounded-3xl bg-[color:var(--ddpm-yellow)] flex items-center justify-center text-4xl mx-auto mb-8 shadow-2xl">⚖️</div>
  <h2 class="font-kanit font-black text-3xl text-white mb-3">ทำข้อสอบ</h2>
  <p id="quiz-subtitle" class="font-sarabun text-slate-300 text-base mb-2 leading-relaxed">พ.ร.บ.ระเบียบบริหารราชการแผ่นดิน พ.ศ. 2534</p>
  <p id="quiz-desc" class="font-sarabun text-slate-400 text-sm mb-10">50 ข้อ · สุ่มตัวเลือก · เฉลยหลังตอบ · บันทึกคะแนน</p>
  <a id="quiz-link" href="#" class="inline-flex items-center gap-3 px-8 py-4 rounded-2xl font-kanit font-black text-lg shadow-xl hover:shadow-2xl transition-all hover:scale-105 active:scale-100" style="background:var(--ddpm-yellow);color:var(--ddpm-navy)">
    เริ่มทำข้อสอบ <span class="text-xl">→</span>
  </a>
  <p class="mt-8 text-slate-500 font-sarabun text-sm"><a href="indexPAB.html" class="hover:text-slate-300 transition-colors">← กลับหน้าคอร์ส</a></p>
</div>
</div>
</section>

<!-- DONATE -->
<div class="scroll-mt-16 relative overflow-hidden bg-slate-900 py-16 px-4 text-center text-white" id="donate">
<div class="pointer-events-none absolute top-0 right-0 h-64 w-64 rounded-full blur-3xl -mr-20 -mt-20" style="background:rgba(252,236,74,0.14)"></div>
<div class="pointer-events-none absolute bottom-0 left-0 h-64 w-64 rounded-full blur-3xl -ml-20 -mb-20" style="background:rgba(29,29,66,0.35)"></div>
<div class="relative z-10 mx-auto max-w-lg">
  <h2 class="mb-3 font-kanit text-2xl font-bold">เลี้ยงกาแฟ ☕</h2>
  <p class="mb-10 font-sarabun text-sm text-slate-400">หากเนื้อหามีประโยชน์ สนับสนุนได้ตามกำลังศรัทธา</p>
  <div class="mx-auto max-w-[220px] rounded-[2rem] bg-white p-5 shadow-2xl">
    <img alt="QR พร้อมเพย์สำหรับสนับสนุน SlothMove" class="mb-3 w-full rounded-xl border border-slate-100" height="200" src="../../../pic/qr.jpg" width="200"/>
    <p class="italic text-[10px] text-slate-500">สแกนผ่านแอปธนาคาร</p>
  </div>
</div>
</div>

<!-- FOOTER -->
<footer class="bg-slate-900 border-t border-slate-700 py-8">
<div class="max-w-4xl mx-auto px-4 text-center">
  <p class="text-slate-400 font-sarabun text-sm">SlothMove · E-Learning ฟรีตลอดชีพ · <a class="text-amber-300 hover:text-[color:var(--ddpm-yellow)] transition-colors font-medium" href="indexPAB.html">กลับหน้าคอร์ส →</a></p>
</div>
</footer>


<script>
var CONTENT;

function showSection(id) {
  document.querySelectorAll('section').forEach(function(s){s.classList.remove('active');});
  if (id==='content') {
    ['content','structure','glossary'].forEach(function(sid){var el=document.getElementById(sid);if(el)el.classList.add('active');});
  } else {
    var sec=document.getElementById(id);if(sec)sec.classList.add('active');
  }
  document.querySelectorAll('.nav-tab').forEach(function(t){t.classList.toggle('active',t.getAttribute('data-section')===id);});
  window.scrollTo({top:0,behavior:'smooth'});
}

function toggleAcc(id) {
  var body=document.getElementById(id);var arr=document.getElementById('arr-'+id);
  if(!body||!arr)return;body.classList.toggle('open');arr.classList.toggle('open');
}

function expandAll() {
  var d = CONTENT;
  if (!d) return;
  for (var i = 1; i <= d.chapters.length; i++) {
    var body = document.getElementById('a' + i);
    var arr = document.getElementById('arr-a' + i);
    if (body) body.classList.add('open');
    if (arr) arr.classList.add('open');
  }
}

function goTopic(n) {
  var id = 'a' + n;
  showSection('content');
  for (var i = 1; i <= (CONTENT ? CONTENT.chapters.length : 99); i++) {
    var body = document.getElementById('a' + i);
    var arr = document.getElementById('arr-a' + i);
    if (body) body.classList.toggle('open', i === n);
    if (arr) arr.classList.toggle('open', i === n);
  }
}

function toggleDrop(id) {
  var el = document.getElementById('drop-' + id);
  if (!el) return;
  el.classList.toggle('open');
  document.addEventListener('click', function handler(e) {
    if (!el.contains(e.target) && !e.target.closest('[onclick*="toggleDrop"]')) {
      el.classList.remove('open');
      document.removeEventListener('click', handler);
    }
  });
}

function scrollToSummaries() {
  var el = document.getElementById('summaries-start');
  if (el) el.scrollIntoView({behavior:'smooth'});
}

function renderBodyContent(body) {
  var html = '';
  body.forEach(function(item) {
    if (item.type === 'p') {
      html += '<p class="text-sm font-sarabun text-slate-700 leading-relaxed mb-2">' + item.text + '</p>';
    } else if (item.type === 'heading') {
      html += '<p class="font-kanit font-bold text-slate-800 text-[15px] mt-5 mb-2 pb-1 border-b border-slate-100">' + item.text + '</p>';
    } else if (item.type === 'list') {
      html += '<ul class="space-y-1.5 mb-2">';
      item.items.forEach(function(it) {
        html += '<li class="flex gap-2 text-sm font-sarabun text-slate-700"><span class="text-slate-400 shrink-0">▪</span><span>' + it + '</span></li>';
      });
      html += '</ul>';
    } else if (item.type === 'table') {
      html += '<div class="overflow-x-auto mb-3">';
      html += '<table class="w-full text-sm">';
      item.rows.forEach(function(row) {
        html += '<tr class="border-b border-slate-100">';
        html += '<td class="py-2 pr-3 font-kanit font-bold text-slate-700 text-xs whitespace-nowrap">' + row[0] + '</td>';
        html += '<td class="py-2 font-sarabun text-slate-600">' + row[1] + '</td>';
        html += '</tr>';
      });
      html += '</table></div>';
    } else if (item.type === 'box') {
      var borderColor = '#7c3aed';
      var bgColor = '#faf5ff';
      var titleColor = '#7c3aed';
      if (item.color === 'blue') { borderColor = '#2563eb'; bgColor = '#eff6ff'; titleColor = '#1e40af'; }
      else if (item.color === 'green') { borderColor = '#16a34a'; bgColor = '#f0fdf4'; titleColor = '#065f46'; }
      else if (item.color === 'amber') { borderColor = '#d97706'; bgColor = '#fffbeb'; titleColor = '#92400e'; }
      else if (item.color === 'rose') { borderColor = '#e11d48'; bgColor = '#fff1f2'; titleColor = '#9f1239'; }
      html += '<div class="rounded-xl border-l-4 p-4 mb-3" style="background:' + bgColor + ';border-color:' + borderColor + '">';
      html += '<div class="font-kanit font-bold text-sm mb-2" style="color:' + titleColor + '">' + item.title + '</div>';
      html += '<ul class="space-y-1">';
      item.items.forEach(function(it) {
        html += '<li class="flex gap-2 text-sm font-sarabun text-slate-700"><span style="color:' + borderColor + '">▪</span><span>' + it + '</span></li>';
      });
      html += '</ul></div>';
    } else if (item.type === 'keypoint') {
      html += '<div class="key-point">';
      html += '<div class="key-point-title">' + item.title + '</div>';
      html += '<div class="key-point-text">' + item.text + '</div>';
      html += '</div>';
    } else if (item.type === 'grid') {
      html += '<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">';
      item.items.forEach(function(it) {
        var bg = '#eff6ff';
        var bc = '#bfdbfe';
        var tc = '#1e40af';
        if (it.color === 'rose') { bg = '#fff1f2'; bc = '#fecdd3'; tc = '#9f1239'; }
        else if (it.color === 'amber') { bg = '#fffbeb'; bc = '#fde68a'; tc = '#92400e'; }
        else if (it.color === 'teal') { bg = '#f0fdfa'; bc = '#99f6e4'; tc = '#115e59'; }
        html += '<div class="rounded-xl p-3 border" style="background:' + bg + ';border-color:' + bc + '">';
        html += '<div class="font-kanit font-bold text-xs mb-1" style="color:' + tc + '">' + it.title + '</div>';
        html += '<div class="font-sarabun text-xs text-slate-600 leading-relaxed">' + it.text + '</div>';
        html += '</div>';
      });
      html += '</div>';
    }
  });
  return html;
}

function renderContent(data) {
  CONTENT = data;

  // Page title
  document.title = data.title + ' — SlothMove ปภ.';

  // Nav title
  var navTitle = document.getElementById('nav-title');
  if (navTitle) navTitle.textContent = data.titleShort;

  // Home section
  document.getElementById('home-badge').innerHTML = '<span class="text-[color:var(--ddpm-navy)] text-xs font-kanit font-bold">' + data.stats.sectionLabel + '</span>';
  document.getElementById('home-title').textContent = data.title;
  document.getElementById('home-desc').innerHTML =
    'สรุปย่อ <strong class="font-kanit text-[color:var(--ddpm-navy)]">' + data.stats.chapters + '</strong> หัวข้อหลัก และคำศัพท์น่ารู้สำหรับทบทวนก่อนสอบ — พร้อมแนวข้อสอบ <strong class="font-kanit text-[color:var(--ddpm-navy)]">' + data.stats.quizCount + ' ข้อ</strong> จากชุดฝึกในระบบ';

  // Stats
  var statsHTML = '';
  statsHTML += '<div class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-sm ring-1 ring-amber-100/60"><div class="text-2xl font-black font-kanit text-[color:var(--ddpm-navy)]">–</div><div class="text-slate-500 text-xs font-kanit mt-1">คำศัพท์</div></div>';
  statsHTML += '<div class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-sm ring-1 ring-amber-100/60"><div class="text-2xl font-black font-kanit text-[color:var(--ddpm-navy)]">' + data.stats.chapters + '</div><div class="text-slate-500 text-xs font-kanit mt-1">หัวข้อสรุป</div></div>';
  statsHTML += '<div class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-sm ring-1 ring-amber-100/60"><div class="text-2xl font-black font-kanit text-[color:var(--ddpm-navy)]">' + data.stats.vocabGroups + '</div><div class="text-slate-500 text-xs font-kanit mt-1">หมวดศัพท์</div></div>';
  statsHTML += '<div class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-sm ring-1 ring-amber-100/60"><div class="text-2xl font-black font-kanit text-[color:var(--ddpm-navy)]">' + data.stats.quizCount + '</div><div class="text-slate-500 text-xs font-kanit mt-1">ข้อสอบ</div></div>';
  document.getElementById('home-stats').innerHTML = statsHTML;

  // Home icons
  document.getElementById('home-icon-1').textContent = data.emoji || '📖';
  document.getElementById('home-sub-1').textContent = 'หัวข้อ ' + data.stats.chapters + ' บท';

  // Content title
  document.getElementById('content-title').textContent = data.title;
  document.getElementById('content-desc').textContent = 'หัวข้อหลัก ' + data.stats.chapters + ' บท เรียบเรียงจากชุดฝึกในระบบ';

  // Accordion list
  var chapterColors = ['#4f46e5','#7c3aed','#0891b2','#059669','#d97706','#db2777','#0d9488','#c026d3'];
  var accHTML = '';
  data.chapters.forEach(function(ch, i) {
    var idx = i + 1;
    var color = chapterColors[i % chapterColors.length];
    accHTML += '<div class="mb-4 border border-slate-200/95 rounded-2xl overflow-hidden shadow-sm bg-white summary-acc-card">';
    accHTML += '<button class="w-full flex items-center justify-between px-5 py-4 bg-slate-50 hover:bg-slate-100 transition-all text-left border-b border-slate-100" onclick="toggleAcc(\'a' + idx + '\')" type="button">';
    accHTML += '<div class="flex items-center gap-3 min-w-0">';
    accHTML += '<span class="w-8 h-8 rounded-xl flex items-center justify-center text-white font-kanit font-black text-sm theme-accent shrink-0" style="background:' + color + '">' + ch.num + '</span>';
    accHTML += '<span class="font-kanit font-bold text-slate-800 text-sm sm:text-[15px] text-left pr-2">' + ch.title + '</span>';
    accHTML += '</div>';
    accHTML += '<svg class="acc-arr w-5 h-5 text-slate-400 flex-shrink-0" fill="none" id="arr-a' + idx + '" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>';
    accHTML += '</button>';
    accHTML += '<div class="acc-body bg-white border-t border-slate-100" id="a' + idx + '">';
    accHTML += '<div class="summary-body-rich" style="padding:1.2rem 1.4rem;">';
    accHTML += renderBodyContent(ch.body);
    accHTML += '</div></div></div>';
  });
  document.getElementById('accordionList').innerHTML = accHTML;

  // Structure grid
  var structColors = ['#93c5fd','#fcd34d','#6ee7b7','#fca5a5','#67e8f9','#c4b5fd','#a5b4fc','#fdcca3'];
  var structHTML = '';
  data.chapters.forEach(function(ch, i) {
    var idx = i + 1;
    var c = structColors[i % structColors.length];
    var tc = '#1e40af';
    if (i % 8 === 1) tc = '#92400e';
    else if (i % 8 === 2) tc = '#065f46';
    else if (i % 8 === 3) tc = '#991b1b';
    else if (i % 8 === 4) tc = '#155e75';
    else if (i % 8 === 5) tc = '#5b21b6';
    else if (i % 8 === 6) tc = '#6d28d9';
    else if (i % 8 === 7) tc = '#b45309';
    structHTML += '<button class="outline-card bg-white border border-slate-100 rounded-2xl shadow-sm text-left overflow-hidden" onclick="goTopic(' + idx + ')" type="button">';
    structHTML += '<div class="h-1.5" style="background:' + c + '"></div>';
    structHTML += '<div class="p-5">';
    structHTML += '<div class="flex items-start justify-between mb-3">';
    structHTML += '<span class="inline-flex items-center justify-center w-9 h-9 rounded-xl text-xs font-black font-kanit text-white" style="background:' + tc + '">' + String(idx).padStart(2, '0') + '</span>';
    structHTML += '<span class="text-2xl">' + ch.emoji + '</span>';
    structHTML += '</div>';
    structHTML += '<p class="font-kanit font-bold text-slate-900 text-sm mb-1.5">' + ch.title + '</p>';
    structHTML += '<p class="text-xs font-sarabun leading-relaxed" style="color:' + tc + '">' + ch.title + '</p>';
    structHTML += '</div></button>';
  });
  document.getElementById('structure-grid').innerHTML = structHTML;

  // Tips
  if (data.tips && data.tips.length > 0) {
    document.getElementById('tip-text').innerHTML = data.tips[0];
  }

  // Glossary
  var glossList = document.getElementById('glossaryList');
  var glossEmpty = document.getElementById('glossaryEmpty');
  if (data.glossary && data.glossary.length > 0) {
    var ghtml = '<div class="space-y-3">';
    data.glossary.forEach(function(item) {
      ghtml += '<div class="flex gap-3 p-4 bg-white rounded-xl border border-slate-100">';
      ghtml += '<span class="font-kanit font-bold text-[color:var(--ddpm-navy)] text-sm shrink-0">' + item.term + '</span>';
      ghtml += '<span class="font-sarabun text-sm text-slate-600 leading-relaxed">' + item.meaning + '</span>';
      ghtml += '</div>';
    });
    ghtml += '</div>';
    glossList.innerHTML = ghtml;
    glossEmpty.style.display = 'none';
  } else {
    glossList.innerHTML = '';
    glossEmpty.style.display = 'block';
  }

  // Quiz section
  document.getElementById('quiz-emoji').textContent = data.emoji || '📖';
  document.getElementById('quiz-subtitle').textContent = data.title;
  document.getElementById('quiz-desc').textContent = data.stats.quizCount + ' ข้อ · สุ่มตัวเลือก · เฉลยหลังตอบ · บันทึกคะแนน';
  document.getElementById('quiz-link').href = data.quizFile;
  document.getElementById('quiz-link-btn').href = data.quizFile;
}

// Auto-render when DOM ready
document.addEventListener('DOMContentLoaded', function() {
  if (typeof CONTENT !== 'undefined') {
    renderContent(CONTENT);
  }
});
</script>

</body>
</html>