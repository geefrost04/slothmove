<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title><!-- TITLE --></title>
<meta content="" name="description"/>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&family=Kanit:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="shared.css"/>
<style>
  :root {
    --ddpm-navy:#1d1d42; --ddpm-navy-mid:#262656;
    --ddpm-yellow:#fcec4a; --ddpm-yellow-strong:#ddcf00;
    --ddpm-yellow-soft:#fffbeb; --ddpm-page:#f8fafc;
    --ddpm-chip:#f8f6e8;
  }
  body { color:#1e293b; }
  .theme-accent { background:var(--ddpm-navy); color:#fff; }
  .ddpm-strip { height:4px; background:linear-gradient(90deg,var(--ddpm-yellow) 0%,var(--ddpm-yellow) 28%,var(--ddpm-navy) 28%,var(--ddpm-navy) 100%); }
  .summary-shell {
    background: linear-gradient(180deg, #eef2f6 0%, #f8fafc 14%, #ffffff 100%);
    border-top: 1px solid #e2e8f0;
  }
  .summary-acc-card { transition: box-shadow .2s; }
  .summary-acc-card:hover { box-shadow: 0 4px 12px rgba(15,23,42,.08); }
  .mem-quick-row { display:flex; flex-wrap:wrap; gap:.45rem; margin-bottom:1.1rem; }
  .mem-q {
    display:inline-flex; align-items:center; padding:.28rem .65rem;
    border-radius:9999px; font-family:'Kanit',sans-serif;
    font-size:11px; font-weight:600; border:1px solid transparent;
  }
  .mem-q--navy { background:#e0e7ff; color:#1e3a8a; border-color:#c7d2fe; }
  .mem-q--amber { background:#fffbeb; color:#92400e; border-color:#fde68a; }
  .mem-q--teal { background:#ccfbf1; color:#115e59; border-color:#99f6e4; }
  .mem-q--rose { background:#ffe4e6; color:#9f1239; border-color:#fecdd3; }
  .summary-body-rich { padding-top:.05rem; }
  .summary-body-rich .key-point { border-radius:.875rem; border:1px solid #e2e8f0; background:linear-gradient(120deg,#f8fafc 0%,#fff 45%,#fffbeb 100%); padding:.95rem 1.1rem; margin-bottom:1rem; font-size:.98rem; line-height:1.82; color:#475569; box-shadow:0 1px 3px rgba(15,23,42,.05); }
  .summary-body-rich .key-point-title { font-family:'Kanit',sans-serif; font-weight:700; font-size:.9rem; color:#92400e; margin-bottom:.45rem; }
  .summary-body-rich .key-point-text { font-family:'Sarabun',sans-serif; line-height:1.8; }
  .summary-body-rich .key-point-text strong { color:#1e293b; font-weight:700; }
  .summary-body-rich .key-point-text em { color:#475569; }
  .summary-rich-list { list-style:none; padding:0; margin:0; }
  .summary-rich-list.readable { gap:.8rem; }
  .summary-rich-list.readable > li { border-width:1px; border-style:solid; border-right-color:#e8ecf1; border-top-color:#e8ecf1; border-bottom-color:#e8ecf1; border-radius:.75rem; padding:1rem 1.05rem 1rem 1.15rem; border-left-width:4px; }
  .summary-rich-list.readable > li:nth-child(4n+1) { border-left-color:#2563eb; background:linear-gradient(135deg,#eff6ff 0%,#ffffff 52%); }
  .summary-rich-list.readable > li:nth-child(4n+2) { border-left-color:#0d9488; background:linear-gradient(135deg,#f0fdfa 0%,#ffffff 52%); }
  .summary-rich-list.readable > li:nth-child(4n+3) { border-left-color:#c026d3; background:linear-gradient(135deg,#fdf4ff 0%,#ffffff 52%); }
  .summary-rich-list.readable > li:nth-child(4n+4) { border-left-color:#d97706; background:linear-gradient(135deg,#fffbeb 0%,#ffffff 52%); }
  .pab-rich-acc .acc-body .sub-item:nth-child(4n+1),
  .pab-rich-acc .summary-body-rich .sub-item:nth-child(4n+1) { border-left:4px solid #2563eb!important; background:linear-gradient(135deg,#eff6ff 0%,#ffffff 55%)!important; box-shadow:0 1px 3px rgba(15,23,42,.05); }
  .pab-rich-acc .acc-body .sub-item:nth-child(4n+2),
  .pab-rich-acc .summary-body-rich .sub-item:nth-child(4n+2) { border-left:4px solid #0d9488!important; background:linear-gradient(135deg,#f0fdfa 0%,#ffffff 55%)!important; box-shadow:0 1px 3px rgba(15,23,42,.05); }
  .pab-rich-acc .acc-body .sub-item:nth-child(4n+3),
  .pab-rich-acc .summary-body-rich .sub-item:nth-child(4n+3) { border-left:4px solid #c026d3!important; background:linear-gradient(135deg,#fdf4ff 0%,#ffffff 55%)!important; box-shadow:0 1px 3px rgba(15,23,42,.05); }
  .pab-rich-acc .acc-body .sub-item:nth-child(4n+4),
  .pab-rich-acc .summary-body-rich .sub-item:nth-child(4n+4) { border-left:4px solid #d97706!important; background:linear-gradient(135deg,#fffbeb 0%,#ffffff 55%)!important; box-shadow:0 1px 3px rgba(15,23,42,.05); }
  .sub-item {
    display:flex; gap:.6rem; padding:.7rem .9rem; border-radius:.75rem;
    border:1px solid #e8ecf1; margin-bottom:.6rem; align-items:flex-start;
  }
  .sub-num {
    display:inline-flex; align-items:center; justify-content:center;
    min-width:2rem; height:2rem; border-radius:.5rem;
    font-family:'Kanit',sans-serif; font-weight:700; font-size:.8rem;
    color:#1e293b; background:#f1f5f9; flex-shrink:0;
  }
  .sub-num-1 { background:#dbeafe; color:#1e40af; }
  .sub-num-2 { background:#fef3c7; color:#92400e; }
  .sub-num-3 { background:#d1fae5; color:#065f46; }
  .sub-num-4 { background:#fee2e2; color:#991b1b; }
  .sub-text { font-family:'Sarabun',sans-serif; font-size:.9rem; color:#1e293b; line-height:1.7; }
  .sub-text strong { color:#0f172a; font-weight:700; }
  .acc-body { display:none; }
  .acc-body.open { display:block; }
  .acc-arr { transition:transform .25s; }
  .acc-arr.open { transform:rotate(180deg); }
  .sum-lead-box { border-radius:.875rem; border:1px solid #e2e8f0; background:linear-gradient(120deg,#f8fafc 0%,#fff 45%,#fffbeb 100%); padding:.95rem 1.1rem; margin-bottom:1rem; font-size:.98rem; line-height:1.82; color:#475569; box-shadow:0 1px 3px rgba(15,23,42,.05); }
  .num-chip { display:inline-flex; align-items:center; justify-content:center; padding:.15rem .55rem; border-radius:.4rem; font-family:'Kanit',sans-serif; font-weight:700; font-size:.8rem; background:#1d1d42; color:#fff; }
  .outline-card { transition:all .2s; }
  .outline-card:hover { border-color:#1d1d42; transform:translateY(-1px); box-shadow:0 4px 12px rgba(15,23,42,.1); }
  .sec-break { display:flex; align-items:center; gap:.75rem; margin-bottom:1.5rem; }
  .sec-break::before, .sec-break::after { content:''; flex:1; height:1px; background:#e2e8f0; }
  .sec-break-label { font-family:'Kanit',sans-serif; font-size:.75rem; font-weight:600; color:#94a3b8; letter-spacing:.05em; background:#f8fafc; padding:.2rem .75rem; border-radius:9999px; border:1px solid #e2e8f0; white-space:nowrap; }
  .nav-tab { position:relative; transition:all .2s; color:#94a3b8; }
  .nav-tab:hover { color:#ffffff; }
  .nav-tab::after { content:''; position:absolute; bottom:0; left:50%; right:50%; height:2px; background:#fcec4a; border-radius:2px; transition:all .2s; }
  .nav-tab.active { color:#fcec4a; font-weight:700; }
  .nav-tab.active::after { left:0; right:0; }
  .drop-panel { display:none; }
  .drop-panel.open { display:block; }


  /* Chapter accordion */
  .chapter-acc { border-radius:12px; overflow:hidden; }
  .chapter-acc-header { cursor:pointer; padding:16px; display:flex; align-items:center; gap:10px; background:white; transition:background .2s; }
  .chapter-acc-header:hover { background:#f1f5f9; }
  .chapter-acc-num { width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; color:white; font-weight:700; font-size:14px; flex-shrink:0; }
  .chapter-acc-emoji { font-size:20px; }
  .chapter-acc-title { flex:1; font-weight:600; color:#1e293b; font-size:15px; }
  .chapter-acc-arrow { width:20px; height:20px; color:#94a3b8; transition:transform .25s; }
  .chapter-acc-arrow.open { transform:rotate(180deg); }
  .chapter-acc-body { display:none; padding:0 16px 16px 16px; }
  .chapter-acc-body.open { display:block; }

  /* Dark Theme Accordion */
  .dark-content { background-color: #0f172a; color: #e2e8f0; border-radius: 3rem; padding: 3rem 2rem; border: 1px solid #1e293b; }
  .acc-item-dark { background-color: #1e293b; border: 1px solid #334155; border-radius: 2rem; margin-bottom: 1rem; overflow: hidden; }
  .acc-trigger-dark { width: 100%; padding: 1.5rem; text-align: left; display: flex; justify-content: space-between; align-items: center; transition: background 0.3s; }
  .acc-trigger-dark:hover { background-color: #334155; }
  .acc-item.open .acc-trigger-dark { background-color: #334155; border-bottom: 1px solid #475569; }
  .acc-badge-dark { width: 2.5rem; height: 2.5rem; display: flex; align-items: center; justify-content: center; border-radius: 0.75rem; background-color: #0f172a; color: #3b82f6; font-weight: bold; margin-right: 1rem; }
  .acc-item.open .acc-badge-dark { background-color: #3b82f6; color: white; }
  .acc-arrow-dark { transition: transform 0.3s; color: #64748b; }
  .acc-item.open .acc-arrow-dark { transform: rotate(180deg); color: #3b82f6; }
  .acc-body { transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); max-height: 0; opacity: 0; overflow: hidden; }
  .acc-item.open .acc-body { max-height: 2000px; opacity: 1; padding-bottom: 2rem; }

</style></style>
</head>
<body class="min-h-screen">

<!-- NAV -->
<nav class="sticky top-0 z-50 bg-slate-900 border-b border-slate-700">
<div class="max-w-6xl mx-auto px-4 flex flex-wrap items-center justify-between gap-y-2 h-auto sm:h-14 py-2 sm:py-0">
<div class="flex items-center gap-3 shrink-0 min-w-0">
  <img alt="" class="h-8 w-8 object-contain shrink-0 rounded-lg border border-slate-700" height="32" loading="lazy" src="../../../pic/logo ปภ.png" width="32" onerror="this.style.visibility='hidden'"/>
  <span id="nav-title" class="font-bold text-white font-kanit text-xs sm:text-sm hidden sm:inline max-w-[11rem] md:max-w-none truncate leading-tight">พ.ร.บ.ระเบียบบริหารราชการแผ่นดิน พ.ศ. 2534</span>
</div>
<div class="flex items-center gap-0 sm:gap-1 flex-1 min-w-0 justify-center order-3 sm:order-none w-full sm:w-auto overflow-x-auto pb-1 sm:pb-0 -mx-1 px-1 sm:mx-0 sm:px-0">
