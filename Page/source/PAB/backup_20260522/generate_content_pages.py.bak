#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
generate_content_pages.py
=========================
รัน: python3 generate_content_pages.py

สร้างไฟล์ HTML สำหรับ PAB content pages
โดย inject data/*.js เข้าไปใน _content_template.html

หลักการ: data/*.js มีเนื้อหาอย่างเดียว (ไม่มี design)
       template มี design อย่างเดียว (ไม่มีเนื้อหา)
       script รวม 2 อย่าง → ได้ไฟล์ HTML สมบูรณ์
"""

import os
import re
import sys

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
TEMPLATE_FILE = os.path.join(BASE_DIR, "_content_template.html")
DATA_DIR = os.path.join(BASE_DIR, "data")
OUTPUT_DIR = BASE_DIR  # output goes to same folder as template


def load_template():
    with open(TEMPLATE_FILE, "r", encoding="utf-8") as f:
        return f.read()


def load_data_file(data_path):
    with open(data_path, "r", encoding="utf-8") as f:
        return f.read()


def extract_content_block(js_content):
    """ดึงเฉพาะส่วน CONTENT = { ... } จากไฟล์ data/*.js"""
    content = re.sub(r"//.*", "", js_content)
    match = re.search(r"const\s+CONTENT\s*=\s*(\{.*\});", content, re.DOTALL)
    if match:
        return match.group(1).rstrip(";") + ";"
    return js_content


def build_page(template, data_js_content, topic):
    """รวม template + data → HTML page"""

    title_match = re.search(r"'title'\s*:\s*\"([^\"]+)\"", data_js_content)
    page_title = title_match.group(1) if title_match else topic

    template = template.replace("<!-- TITLE -->", page_title + " | SlothMove PAB.")

    content_block = extract_content_block(data_js_content)

    # Build inline script with content block substituted
    # Use __CONTENT_BLOCK__ placeholder to avoid format() issues with JS braces
    script_template = """<script>
var CONTENT = __CONTENT_BLOCK__;
function showSection(id) {
  document.querySelectorAll('section').forEach(function(s){s.classList.remove('active');});
  document.querySelectorAll('.nav-tab').forEach(function(t){t.classList.toggle('active',t.getAttribute('data-section')===id);});
  var target = document.getElementById(id);
  if (target) target.classList.add('active');
  window.scrollTo({top:0, behavior:'smooth'});
}
function toggleDrop(id) {
  var panel = document.getElementById('drop-' + id);
  if (panel) panel.classList.toggle('open');
}
function toggleAcc(idx) {
  var body = document.getElementById('body' + idx);
  var arr = document.getElementById('arr' + idx);
  if (!body) return;
  var isOpen = body.classList.contains('open');
  document.querySelectorAll('.chapter-acc-body').forEach(function(b){b.classList.remove('open');});
  document.querySelectorAll('.chapter-acc-arrow').forEach(function(a){a.classList.remove('open');});
  if (!isOpen) {
    body.classList.add('open');
    if (arr) arr.classList.add('open');
  }
}
function expandAll() {
  document.querySelectorAll('.chapter-acc-body').forEach(function(b){b.classList.add('open');});
  document.querySelectorAll('.chapter-acc-arrow').forEach(function(a){a.classList.add('open');});
}
function renderContent(data) {
  CONTENT = data;
  document.title = data.title + ' | SlothMove PAB.';
  var navTitle = document.getElementById('nav-title');
  if (navTitle) navTitle.textContent = data.titleShort;
  var badge = document.getElementById('home-badge');
  if (badge) {
    badge.innerHTML = '<span class="text-[color:var(--ddpm-navy)] text-xs font-kanit font-bold">' + data.stats.sectionLabel + '</span>';
  }
  var homeTitle = document.getElementById('home-title');
  if (homeTitle) homeTitle.textContent = data.title;
  var homeSubtitle = document.getElementById('home-subtitle');
  if (homeSubtitle) homeSubtitle.textContent = data.subtitle || '';
  var homeDesc = document.getElementById('home-desc');
  if (homeDesc) {
    homeDesc.innerHTML = 'สรุปย่อ <strong class="font-kanit text-[color:var(--ddpm-navy)]">' + data.stats.chapters + '</strong> หัวข้อหลัก และคำศัพท์น่ารู้สำหรับทบทวนก่อนสอบ — พร้อมแนวข้อสอบ <strong class="font-kanit text-[color:var(--ddpm-navy)]">' + data.stats.quizCount + ' ข้อ</strong> จากชุดฝึกในระบบ';
  }
  var stats = document.getElementById('home-stats');
  if (stats) {
    stats.innerHTML = '<div class="bg-amber-50 border border-amber-100 rounded-2xl p-4"><div class="text-2xl font-black font-kanit text-[color:var(--ddpm-navy)]">–</div><div class="text-slate-500 text-xs font-kanit mt-1">คำศัพท์</div></div><div class="bg-amber-50 border border-amber-100 rounded-2xl p-4"><div class="text-2xl font-black font-kanit text-[color:var(--ddpm-navy)]">' + data.stats.chapters + '</div><div class="text-slate-500 text-xs font-kanit mt-1">หัวข้อสรุป</div></div><div class="bg-amber-50 border border-amber-100 rounded-2xl p-4"><div class="text-2xl font-black font-kanit text-[color:var(--ddpm-navy)]">' + data.stats.vocabGroups + '</div><div class="text-slate-500 text-xs font-kanit mt-1">หมวดศัพท์</div></div><div class="bg-amber-50 border border-amber-100 rounded-2xl p-4"><div class="text-2xl font-black font-kanit text-[color:var(--ddpm-navy)]">' + data.stats.quizCount + '</div><div class="text-slate-500 text-xs font-kanit mt-1">ข้อสอบ</div></div>';
  }
  var quizLink = document.getElementById('quiz-link');
  if (quizLink) quizLink.href = data.quizFile;
  var quizBtn = document.getElementById('quiz-btn');
  if (quizBtn) quizBtn.href = data.quizFile;
  var contentTitle = document.getElementById('content-title');
  if (contentTitle) contentTitle.textContent = data.title;
  var accList = document.getElementById('accordionList');
  if (!accList) return;
  var html = '';
  var chapterColors = ['#4f46e5','#7c3aed','#0891b2','#059669','#d97706','#db2777','#0d9488','#c026d3'];
  data.chapters.forEach(function(ch, i) {
    var color = chapterColors[i % chapterColors.length];
    html += '<div class="chapter-acc" id="acc' + i + '">';
    html += '<div class="chapter-acc-header" onclick="toggleAcc(' + i + ')">';
    html += '<div class="chapter-acc-num" style="background:' + color + '">' + ch.num + '</div>';
    html += '<span class="chapter-acc-emoji">' + ch.emoji + '</span>';
    html += '<span class="chapter-acc-title">' + ch.title + '</span>';
    html += '<svg class="chapter-acc-arrow" id="arr' + i + '" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"/></svg>';
    html += '</div>';
    html += '<div class="chapter-acc-body" id="body' + i + '"><div class="w-full h-px bg-slate-100 mb-4"></div>';
    ch.body.forEach(function(item) {
      if (item.type === 'p') {
        html += '<p class="ch-p">' + item.text + '</p>';
      } else if (item.type === 'heading') {
        html += '<p class="ch-subheading">' + item.text + '</p>';
      } else if (item.type === 'list') {
        html += '<ul class="ch-list">';
        item.items.forEach(function(it) { html += '<li>' + it + '</li>'; });
        html += '</ul>';
      } else if (item.type === 'table') {
        html += '<table class="ch-table">';
        item.rows.forEach(function(row) { html += '<tr><td>' + row[0] + '</td><td>' + row[1] + '</td></tr>'; });
        html += '</table>';
      } else if (item.type === 'box') {
        var colorClass = 'purple';
        if (item.color === 'blue') colorClass = 'blue';
        else if (item.color === 'green') colorClass = 'green';
        html += '<div class="ch-box ch-box-' + colorClass + '">';
        html += '<div class="ch-box-title ' + colorClass + '">' + item.title + '</div><ul>';
        item.items.forEach(function(it) { html += '<li>' + it + '</li>'; });
        html += '</ul></div>';
      } else if (item.type === 'keypoint') {
        html += '<div class="key-point"><div class="key-point-title">' + item.title + '</div><div class="key-point-text">' + item.text + '</div></div>';
      } else if (item.type === 'grid') {
        html += '<div class="ch-grid">';
        item.items.forEach(function(it) {
          html += '<div class="ch-grid-item ' + it.color + '"><div class="ch-grid-item-title">' + it.title + '</div><div class="ch-grid-item-text">' + it.text + '</div></div>';
        });
        html += '</div>';
      }
    });
    html += '</div></div>';
  });
  accList.innerHTML = html;
  var glossList = document.getElementById('glossaryList');
  var glossEmpty = document.getElementById('glossaryEmpty');
  if (data.glossary && data.glossary.length > 0) {
    var ghtml = '';
    data.glossary.forEach(function(item) {
      ghtml += '<div class="glossary-item"><span class="glossary-term">' + item.term + '</span><span class="glossary-meaning">' + (item.meaning || item.def || '') + '</span></div>';
    });
    if (glossList) glossList.innerHTML = ghtml;
    if (glossEmpty) glossEmpty.style.display = 'none';
  } else {
    if (glossList) glossList.innerHTML = '';
    if (glossEmpty) glossEmpty.style.display = 'block';
  }
}
document.addEventListener('DOMContentLoaded', function() { renderContent(CONTENT); });
document.addEventListener('click', function(e) {
  if (!e.target.closest('#drop-courses') && !e.target.closest('[onclick*="toggleDrop"]')) {
    var panel = document.getElementById('drop-courses');
    if (panel) panel.classList.remove('open');
  }
});
</script>""".replace('__CONTENT_BLOCK__', content_block)

    result = re.sub(
        r'<script>\s*var CONTENT;.*?</script>',
        script_template,
        template,
        flags=re.DOTALL
    )

    return result


def main():
    print("=" * 50)
    print("PAB Content Page Generator")
    print("=" * 50)

    if not os.path.exists(TEMPLATE_FILE):
        print("ERROR: Template not found: " + TEMPLATE_FILE)
        sys.exit(1)

    if not os.path.exists(DATA_DIR):
        print("ERROR: data/ directory not found: " + DATA_DIR)
        sys.exit(1)

    template = load_template()
    data_files = [f for f in os.listdir(DATA_DIR) if f.endswith(".js")]

    if not data_files:
        print("WARNING: No .js files found in " + DATA_DIR)
        sys.exit(1)

    print("Found " + str(len(data_files)) + " data file(s)")
    print()

    generated = []
    for fname in sorted(data_files):
        topic = fname.replace(".js", "")
        data_path = os.path.join(DATA_DIR, fname)

        print("  Building: " + topic + ".html")
        try:
            data_js = load_data_file(data_path)
            html = build_page(template, data_js, topic)

            output_path = os.path.join(OUTPUT_DIR, topic + ".html")
            with open(output_path, "w", encoding="utf-8") as f:
                f.write(html)

            generated.append(topic + ".html")
            print("    OK: " + output_path)
        except Exception as e:
            print("    ERROR: " + str(e))

    print()
    print("Done! Generated " + str(len(generated)) + " file(s)")


if __name__ == "__main__":
    main()